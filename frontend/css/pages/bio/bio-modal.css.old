/* Modali CSS via :target – niente JS richiesto per click backdrop/X; ESC gestito da bio-entry.js */
.modal.modal-target {
  position: fixed; inset: 0; z-index: 950;
  visibility: hidden; opacity: 0; pointer-events: none;
  transition: opacity .2s ease, visibility .2s ease;
}
.modal.modal-target:target { visibility: visible; opacity: 1; pointer-events: auto; }

.modal.modal-target .modal__backdrop {
  position: absolute; inset: 0; display: block; content: "";
  background: rgba(0,0,0,.6);
}
.modal.modal-target .modal__dialog {
  position: relative; margin: 6vh auto; max-width: 900px;
  background: #0b0b0b; border: 1px solid #2a2a2a; border-radius: 16px;
  padding: 16px; box-shadow: 0 10px 28px rgba(0,0,0,.45);
}
.modal.modal-target.modal-full .modal__dialog { margin: 3vh auto; max-width: 1100px; min-height: 60vh; }

.modal.modal-target .modal__content { max-height: 70vh; overflow: auto; }
.modal.modal-target.modal-full .modal__content { max-height: 76vh; }

.modal.modal-target .modal__close {
  position: absolute; top: 8px; right: 12px;
  background: rgba(0,0,0,.35); border: 1px solid #444; border-radius: 8px;
  color: #fff; font-size: 22px; line-height: 1; padding: 4px 10px; text-decoration: none;
}
.modal-title { margin: 0 0 12px; font-size: 1.25rem; }
@media (max-width: 720px) {
  .modal.modal-target .modal__dialog { margin: 4vh 12px; }
  .modal.modal-target .modal__content { max-height: 66vh; }
}