#concert_count {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    color: var(--light-accent);
    font-size: 1.35rem;
    margin-left: 0.25rem;
  }
  
  /* ===== TIMELINE ===== */
  #timeline {
    flex: 1 1 40vw;
    max-width: 40vw;
    padding-right: 2rem;
    overflow-y: auto;
    max-height: 85vh;
    box-sizing: border-box;
    background: none;
    color: var(--light-accent);
    font-family: 'Montserrat', sans-serif;
    scrollbar-width: thin;
    scrollbar-color: var(--accent-color) transparent;
  }
  
  #timeline::-webkit-scrollbar {
    width: 8px;
  }
  #timeline::-webkit-scrollbar-thumb {
    background-color: var(--accent-color);
    border-radius: 8px;
  }
  
  .year-block {
    border-left: 3px solid var(--accent-color);
    margin-bottom: 2.5rem;
    padding-left: 1rem;
    position: relative;
    max-width: 75%;
    box-sizing: border-box;
  }
  
  .year-block .year-header {
    cursor: pointer;
    font-size: 1.3rem;
    color: var(--light-accent);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  
  .year-arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }
  
  .year-block.expanded .year-arrow {
    transform: rotate(180deg);
  }
  
  .year-content {
    overflow: hidden;
    transition: max-height 0.5s ease;
    max-width: 75%;
    width: auto;
    padding-right: 1rem;
    box-sizing: border-box;
  }
  .concert-block {
    display: flex;
    background: #1a1a1a;
    border-radius: 8px;
    box-shadow: 0 0 8px rgba(0,0,0,0.3);
    border-left: 4px solid var(--accent-color);
    gap: 1.5rem;
    padding: 1rem;
    margin-bottom: 1.5rem;
    align-items: flex-start;
    max-width: 100%;
    box-sizing: border-box;
  }
  
  .concert-content {
    display: flex;
    gap: 1.5rem;
    width: 100%;
    align-items: flex-start;
  }
  
  .concert-poster {
    width: 120px;
    height: auto;
    max-height: 180px;
    border-radius: 4px;
    object-fit: contain;
    flex-shrink: 0;
    box-shadow: 0 0 6px rgba(0,0,0,0.18);
    background: #222;
    transition: filter 0.2s;
    cursor: pointer;
  }
  
  .concert-info {
    flex: 1 1 auto;
    text-align: left;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 0.6rem;
  }
  
  .concert-info h3 {
    margin: 0 0 0.3rem 0;
    color: var(--light-accent);
    font-size: 1.16rem;
    line-height: 1.2;
  }
  
  .concert-info p {
    margin: 0 0 0.2rem 0;
    color: #e0e0e0;
    font-size: 1.02rem;
    line-height: 1.4;
  }
  
  .concert-toggle {
    background: var(--accent-color);
    color: #0f0f0f;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    font-size: 0.85rem;
    padding: 0.3rem 0.8rem;
    margin-top: 0.3rem;
    cursor: pointer;
    transition: background 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: auto;
  }
  
  .concert-toggle .arrow {
    display: inline-block;
    transition: transform 0.3s;
    font-size: 0.9rem;
  }
  
  .concert-toggle.active .arrow {
    transform: rotate(180deg);
  }
  
  .concert-toggle:hover {
    background: var(--light-accent);
    color: black;
  }
  
  .full-details {
    margin-top: 0.7rem;
    font-size: 0.98rem;
    display: block;
  }
  
  .icon,
  .eventbrite-logo {
    width: 18px;
    height: 18px;
    margin-right: 4px;
  }