<!-- newsletter-service/views/pages/unified-dashboard.ejs -->
<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Newsletter - Dashboard Unificata</title>
  <link rel="stylesheet" href="/shared/css/admin-base.css">
  <link rel="stylesheet" href="/css/newsletter-light.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { background: #f5f7fa; }
    .hero {
      background: linear-gradient(135deg, #d4af37 0%, #c4941f 100%);
      color: white;
      padding: 2.5rem 2rem;
      margin: -2rem -2rem 2rem;
      border-radius: 0 0 16px 16px;
      box-shadow: 0 4px 20px rgba(212, 175, 55, 0.3);
    }
    .hero h1 { margin: 0 0 0.5rem; font-size: 2.5rem; font-weight: 300; }
    .hero p { margin: 0; opacity: 0.95; font-size: 1.1rem; }

    .tabs-nav {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 2rem;
      border-bottom: 2px solid #e0e0e0;
      padding-bottom: 0;
    }
    .tab-button {
      background: none;
      border: none;
      padding: 1rem 1.5rem;
      cursor: pointer;
      font-size: 1rem;
      color: #666;
      border-bottom: 3px solid transparent;
      transition: all 0.3s;
      font-weight: 500;
    }
    .tab-button:hover { color: var(--primary); background: #f0f0f0; }
    .tab-button.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
      background: white;
    }

    .tab-content { display: none; }
    .tab-content.active { display: block; animation: fadeIn 0.3s; }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .stat-card {
      background: white;
      padding: 1.5rem;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      text-align: center;
    }
    .stat-card__number {
      font-size: 2.5rem;
      font-weight: 700;
      color: var(--primary);
      margin: 0;
    }
    .stat-card__label {
      color: #666;
      font-size: 0.9rem;
      margin: 0.5rem 0 0;
    }

    .card {
      background: white;
      border-radius: 8px;
      padding: 1.5rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      margin-bottom: 1.5rem;
    }
    .card h2 {
      margin: 0 0 1rem;
      font-size: 1.5rem;
      color: #333;
    }

    .post-item {
      display: flex;
      gap: 1rem;
      padding: 1rem;
      border: 1px solid #e8e8e8;
      border-radius: 6px;
      margin-bottom: 0.75rem;
      background: #fafafa;
    }
    .post-item__thumb {
      width: 120px;
      height: 68px;
      object-fit: cover;
      border-radius: 4px;
      background: #ddd;
      flex-shrink: 0;
    }
    .post-item__content { flex: 1; }
    .post-item__title {
      font-weight: 600;
      margin: 0 0 0.25rem;
      color: #333;
    }

    .empty-state {
      text-align: center;
      padding: 3rem;
      color: #999;
    }

    .action-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      margin-top: 2rem;
    }
    .btn {
      padding: 0.75rem 1.5rem;
      border: none;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
    }
    .btn-primary {
      background: var(--primary);
      color: white;
    }
    .btn-primary:hover {
      background: var(--primary-dark);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(212, 175, 55, 0.4);
    }
    .btn-secondary {
      background: #e0e0e0;
      color: #333;
    }
    .btn-success {
      background: #4caf50;
      color: white;
    }
    .btn-success:hover {
      background: #43a047;
    }

    .preference-badges {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-top: 1rem;
    }
    .preference-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      border-radius: 20px;
      font-size: 0.9rem;
      background: #f0f0f0;
    }
    .preference-badge.concerts { background: #e3f2fd; color: #1976d2; }
    .preference-badge.news { background: #fff3e0; color: #f57c00; }
    .preference-badge.both { background: #e8f5e9; color: #388e3c; }
  </style>
</head>
<body>
  <%- include('../partials/admin-header') %>

  <div class="container">
    <!-- Stats Overview -->
    <div class="stats-grid">
      <div class="stat-card">
        <p class="stat-card__number"><%= stats.total_subscribers %></p>
        <p class="stat-card__label">Iscritti Totali</p>
      </div>
      <div class="stat-card">
        <p class="stat-card__number"><%= stats.active_subscribers %></p>
        <p class="stat-card__label">Attivi</p>
      </div>
      <div class="stat-card">
        <p class="stat-card__number"><%= digestData.selectedPosts.length %></p>
        <p class="stat-card__label">News da Inviare</p>
      </div>
      <div class="stat-card">
        <p class="stat-card__number"><%= stats.campaigns_sent %></p>
        <p class="stat-card__label">Invii Totali</p>
      </div>
    </div>

    <!-- Tabs Navigation -->
    <div class="tabs-nav">
      <button class="tab-button active" onclick="switchTab('digest')">
        📰 Digest News
        <% if (digestData.selectedPosts.length > 0) { %>
          <span style="background: #4caf50; color: white; padding: 0.2rem 0.5rem; border-radius: 10px; font-size: 0.8rem; margin-left: 0.5rem;">
            <%= digestData.selectedPosts.length %>
          </span>
        <% } %>
      </button>
      <button class="tab-button" onclick="switchTab('concerts')">
        🎼 Newsletter Concerti
      </button>
      <button class="tab-button" onclick="switchTab('campaigns')">
        📋 Campagne Inviate
      </button>
      <button class="tab-button" onclick="switchTab('subscribers')">
        👥 Iscritti (<%= stats.active_subscribers %>)
      </button>
    </div>

    <!-- Tab: Digest News -->
    <div id="tab-digest" class="tab-content active">
      <div class="card">
        <h2>📰 Digest News Daniele Camiz</h2>
        <p style="color: #666; margin-bottom: 1.5rem;">
          Articoli selezionati automaticamente da news-admin per il prossimo digest bimestrale/trimestrale
        </p>

        <% if (digestData.selectedPosts.length === 0) { %>
          <div class="empty-state">
            <p style="font-size: 1.2rem;">📭 Nessun articolo selezionato</p>
            <p><small>Vai in news-admin e spunta "Includi nella Newsletter" negli articoli</small></p>
            <a href="https://news-admin.danielecamiz.com/news" class="btn btn-primary" style="margin-top: 1rem; display: inline-block; text-decoration: none;">
              📰 Vai a News Admin
            </a>
          </div>
        <% } else { %>
          <!-- Custom Message Editor -->
          <div style="background: #f8f9fa; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem;">
            <h3 style="margin: 0 0 1rem; font-size: 1.2rem;">✍️ Personalizza il Digest</h3>

            <div style="margin-bottom: 1rem;">
              <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Oggetto Email:</label>
              <input type="text" id="digest-subject"
                     placeholder="Newsletter Daniele Camiz - [Mese Anno]"
                     value="Newsletter Daniele Camiz"
                     style="width: 100%; padding: 0.75rem; border: 2px solid #e0e0e0; border-radius: 6px; font-size: 1rem;">
            </div>

            <div style="margin-bottom: 1rem;">
              <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Messaggio Introduttivo (IT):</label>
              <textarea id="digest-intro-it" rows="3"
                        placeholder="Ciao, ecco le ultime novità dal sito di Daniele Camiz..."
                        style="width: 100%; padding: 0.75rem; border: 2px solid #e0e0e0; border-radius: 6px; font-size: 1rem; font-family: inherit; resize: vertical;">Ciao,

Ecco le ultime novità dal sito di Daniele Camiz. Troverai <%= digestData.selectedPosts.length %> <%= digestData.selectedPosts.length === 1 ? 'articolo selezionato' : 'articoli selezionati' %> per te.</textarea>
            </div>

            <div style="margin-bottom: 1rem;">
              <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Messaggio Introduttivo (EN):</label>
              <textarea id="digest-intro-en" rows="3"
                        placeholder="Hello, here are the latest news from Daniele Camiz's website..."
                        style="width: 100%; padding: 0.75rem; border: 2px solid #e0e0e0; border-radius: 6px; font-size: 1rem; font-family: inherit; resize: vertical;">Hello,

Here are the latest news from Daniele Camiz's website. You'll find <%= digestData.selectedPosts.length %> selected <%= digestData.selectedPosts.length === 1 ? 'article' : 'articles' %> for you.</textarea>
            </div>

            <div>
              <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">📝 Note Aggiuntive (opzionale):</label>
              <textarea id="digest-notes" rows="3"
                        placeholder="Eventuali comunicazioni speciali, annunci, link esterni, ecc..."
                        style="width: 100%; padding: 0.75rem; border: 2px solid #e0e0e0; border-radius: 6px; font-size: 1rem; font-family: inherit; resize: vertical;"></textarea>
              <small style="color: #666;">Queste note verranno aggiunte alla fine dell'email, prima del footer.</small>
            </div>
          </div>

          <!-- Article List -->
          <h3 style="margin: 0 0 1rem; font-size: 1.2rem;">📰 Articoli Selezionati (<%= digestData.selectedPosts.length %>)</h3>
          <% digestData.selectedPosts.forEach(post => { %>
            <div class="post-item">
              <% if (post.cover_image) { %>
                <img src="<%= post.cover_image %>" alt="" class="post-item__thumb">
              <% } else { %>
                <div class="post-item__thumb" style="display: flex; align-items: center; justify-content: center;">
                  <span style="font-size: 2rem;">📰</span>
                </div>
              <% } %>
              <div class="post-item__content">
                <h3 class="post-item__title"><%= post.title_it %></h3>
                <p style="font-size: 0.85rem; color: #666; margin: 0.25rem 0;">
                  <%= post.category || 'news' %> •
                  <%= new Date(post.publish_date || post.created_at).toLocaleDateString('it-IT') %>
                </p>
                <p style="font-size: 0.9rem; color: #666; margin: 0.5rem 0 0;">
                  <%= (post.excerpt_it || '').substring(0, 120) %>...
                </p>
              </div>
            </div>
          <% }); %>

          <div class="action-buttons">
            <button type="button" class="btn btn-secondary" onclick="refreshDigestPreview()">
              👁️ Anteprima Email
            </button>
            <button type="button" class="btn btn-primary" onclick="sendTestEmail()">
              📧 Invia Email di Prova
            </button>
            <button type="button" class="btn btn-success" onclick="sendDigestNewsletter()">
              📤 Invia Digest (<%= digestData.recipientCount %> iscritti)
            </button>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Tab: ICNT Concerts -->
    <div id="tab-concerts" class="tab-content">
      <div class="card">
        <h2>🎼 Newsletter ICNT Concerti</h2>
        <p style="color: #666; margin-bottom: 1.5rem;">
          Crea newsletter personalizzate per annunciare nuovi concerti e stagioni ICNT
        </p>
        <div class="action-buttons">
          <a href="/admin/campaign/new" class="btn btn-primary" style="text-decoration: none;">
            ✍️ Crea Nuova Newsletter Concerti
          </a>
        </div>
      </div>
    </div>

    <!-- Tab: Campaigns -->
    <div id="tab-campaigns" class="tab-content">
      <div class="card">
        <h2>📋 Campagne Newsletter Inviate</h2>
        <p style="color: #666; margin-bottom: 1.5rem;">
          Visualizza tutte le newsletter inviate (digest e campagne concerti)
        </p>
        <div class="action-buttons">
          <a href="/admin/campaigns" class="btn btn-primary" style="text-decoration: none;">
            📋 Visualizza Tutte le Campagne
          </a>
        </div>
      </div>
    </div>

    <!-- Tab: Subscribers -->
    <div id="tab-subscribers" class="tab-content">
      <div class="card">
        <h2>👥 Gestione Iscritti</h2>
        <div class="preference-badges" style="margin-bottom: 1.5rem;">
          <div class="preference-badge both">
            <span>✅ Entrambe:</span>
            <strong><%= stats.preferences_both || 0 %></strong>
          </div>
          <div class="preference-badge concerts">
            <span>🎼 Solo Concerti:</span>
            <strong><%= stats.preferences_concerts || 0 %></strong>
          </div>
          <div class="preference-badge news">
            <span>📰 Solo News:</span>
            <strong><%= stats.preferences_news || 0 %></strong>
          </div>
        </div>
        <div class="action-buttons">
          <a href="/admin/subscribers" class="btn btn-primary" style="text-decoration: none;">
            📋 Gestisci Tutti gli Iscritti
          </a>
        </div>
      </div>
    </div>
  </div>

  <footer style="text-align: center; padding: 2rem; color: #999; margin-top: 3rem;">
    <p>Newsletter Service • Daniele Camiz & ICNT</p>
  </footer>

  <script>
    function switchTab(tabName) {
      // Hide all tabs
      document.querySelectorAll('.tab-content').forEach(tab => {
        tab.classList.remove('active');
      });
      document.querySelectorAll('.tab-button').forEach(btn => {
        btn.classList.remove('active');
      });

      // Show selected tab
      document.getElementById('tab-' + tabName).classList.add('active');
      event.target.classList.add('active');
    }

    function getDigestCustomization() {
      return {
        subject: document.getElementById('digest-subject')?.value || 'Newsletter Daniele Camiz',
        introIt: document.getElementById('digest-intro-it')?.value || '',
        introEn: document.getElementById('digest-intro-en')?.value || '',
        notes: document.getElementById('digest-notes')?.value || ''
      };
    }

    async function refreshDigestPreview() {
      const custom = getDigestCustomization();
      // Pass customization as query params
      const params = new URLSearchParams(custom);
      window.open(`/admin/digest/preview?${params.toString()}`, '_blank', 'width=800,height=600');
    }

    async function sendTestEmail() {
      const email = prompt('Inserisci email per test:', 'daniele.camiz@gmail.com');
      if (!email) return;

      const custom = getDigestCustomization();

      try {
        const response = await fetch('/admin/digest/test', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            email,
            ...custom
          })
        });

        const result = await response.json();

        if (result.success) {
          alert(`✅ ${result.message}`);
        } else {
          alert(`❌ Errore: ${result.error}`);
        }
      } catch (error) {
        alert(`❌ Errore: ${error.message}`);
      }
    }

    async function sendDigestNewsletter() {
      const count = <%= digestData.recipientCount %>;
      const confirmed = confirm(
        `🚀 Sei sicuro di voler inviare il digest a ${count} iscritti?\n\n` +
        `Verranno inviati <%= digestData.selectedPosts.length %> articoli.`
      );

      if (!confirmed) return;

      const custom = getDigestCustomization();

      try {
        // Show loading state
        const button = event.target;
        button.disabled = true;
        button.textContent = '📤 Invio in corso...';

        const response = await fetch('/admin/digest/send', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(custom)
        });

        const result = await response.json();

        if (result.success) {
          alert(`✅ ${result.message}\n\nInviati: ${result.sent}\nFalliti: ${result.failed}`);
          // Reload page to update stats
          window.location.reload();
        } else {
          alert(`❌ Errore: ${result.error}`);
          button.disabled = false;
          button.textContent = '📤 Invia Digest (<%= digestData.recipientCount %> iscritti)';
        }
      } catch (error) {
        alert(`❌ Errore: ${error.message}`);
        button.disabled = false;
        button.textContent = '📤 Invia Digest (<%= digestData.recipientCount %> iscritti)';
      }
    }
  </script>
</body>
</html>
