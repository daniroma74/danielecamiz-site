<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestione Iscritti</title>
    <link rel="stylesheet" href="/shared/css/admin-base.css">
    <link rel="stylesheet" href="/css/newsletter-light.css">
</head>
<body>
    <%- include('../partials/admin-header') %>
    <div class="container">
        <div class="page-header">
            <h1>👥 Gestione Iscritti</h1>
            <div class="header-actions">
                <button class="btn btn-primary" onclick="showAddModal()">
                    ➕ Aggiungi Iscritto
                </button>
                <button class="btn btn-secondary" onclick="showImportModal()">
                    📥 Importa CSV
                </button>
                <a href="/admin/subscribers/export" class="btn btn-outline">
                    📤 Esporta CSV
                </a>
                <a href="/admin/dashboard" class="btn btn-outline">
    ← Dashboard
</a>
            </div>
        </div>

        <!-- Stats Bar -->
        <%
        const active = subscribers.filter(s => ['active', 'subscribed'].includes(s.status));
        const onlySite = active.filter(s => s.wants_site_news && !s.wants_concerts).length;
        const onlyConcerts = active.filter(s => !s.wants_site_news && s.wants_concerts).length;
        const both = active.filter(s => s.wants_site_news && s.wants_concerts).length;
        %>
        <div class="stats-grid" style="grid-template-columns: repeat(5, 1fr); margin-bottom: 24px;">
            <div class="stat-card">
                <div class="stat-label">Totale</div>
                <div class="stat-value" style="font-size: 24px;"><%= subscribers.length %></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">📰 Solo News</div>
                <div class="stat-value" style="font-size: 24px; color: #3498db;"><%= onlySite %></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">🎵 Solo Concerti</div>
                <div class="stat-value" style="font-size: 24px; color: #9b59b6;"><%= onlyConcerts %></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">🌟 Entrambi</div>
                <div class="stat-value" style="font-size: 24px; color: var(--success);"><%= both %></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">❌ Non iscritti</div>
                <div class="stat-value" style="font-size: 24px; color: var(--warning);"><%= subscribers.filter(s => s.status === 'unsubscribed').length %></div>
            </div>
        </div>

        <!-- Filters -->
        <div class="card">
            <div style="display: grid; grid-template-columns: 1fr 200px auto auto; gap: 12px; align-items: center;">
                <input type="text" 
                       id="search-input" 
                       class="form-control" 
                       style="margin-bottom: 0;"
                       placeholder="🔍 Cerca per email o nome..."
                       onkeyup="filterSubscribers()">
                
                <select id="status-filter" class="form-control" style="margin-bottom: 0;" onchange="filterSubscribers()">
                    <option value="">Tutti gli stati</option>
                    <option value="active">Attivi</option>
                    <option value="subscribed">Iscritti</option>
                    <option value="unsubscribed">Non iscritti</option>
                    <option value="bounced">Bounced</option>
                </select>
                
                <select id="per-page" class="form-control" style="margin-bottom: 0;" onchange="updatePagination()">
                    <option value="50">50 per pagina</option>
                    <option value="100">100 per pagina</option>
                    <option value="200">200 per pagina</option>
                    <option value="all">Tutti</option>
                </select>
                
                <button class="btn btn-outline" onclick="resetFilters()">
                    🔄 Reset
                </button>
            </div>
            
            <!-- Pagination Info -->
            <div id="pagination-info" style="margin-top: 12px; color: var(--text-light); font-size: 14px; text-align: center;">
                Mostrando <span id="showing-count">0</span> di <span id="total-count">0</span> iscritti
            </div>
        </div>

        <!-- Pagination Controls -->
        <div id="pagination-controls" style="display: flex; justify-content: center; gap: 8px; margin-bottom: 20px; display: none;">
            <button class="btn btn-sm btn-outline" onclick="goToPage('prev')" id="btn-prev">← Precedente</button>
            <span id="page-numbers" style="display: flex; gap: 4px;"></span>
            <button class="btn btn-sm btn-outline" onclick="goToPage('next')" id="btn-next">Successivo →</button>
        </div>

        <!-- Subscribers Table -->
        <div class="card">
            <div class="table-container">
                <table class="table" id="subscribers-table">
                    <thead>
                        <tr>
                            <th width="30">
                                <input type="checkbox" id="select-all" onchange="toggleSelectAll()">
                            </th>
                            <th>Email</th>
                            <th>Nome</th>
                            <th>Preferenze</th>
                            <th>Stato</th>
                            <th>Data Iscrizione</th>
                            <th width="150">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (subscribers && subscribers.length > 0) { %>
                            <% subscribers.forEach(subscriber => { %>
                            <tr data-id="<%= subscriber.id %>">
                                <td>
                                    <input type="checkbox" class="subscriber-checkbox" value="<%= subscriber.id %>">
                                </td>
                                <td><%= subscriber.email %></td>
                                <td><%= subscriber.name || '-' %></td>
                                <td style="font-size: 0.9em;">
                                    <%
                                    const wantsSite = subscriber.wants_site_news || false;
                                    const wantsConcerts = subscriber.wants_concerts || false;
                                    %>
                                    <% if (wantsSite && wantsConcerts) { %>
                                        📰 News + 🎵 Concerti
                                    <% } else if (wantsSite) { %>
                                        📰 Solo News
                                    <% } else if (wantsConcerts) { %>
                                        🎵 Solo Concerti
                                    <% } else { %>
                                        <span style="color: #999;">-</span>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="badge badge-<%=
                                        subscriber.status === 'active' || subscriber.status === 'subscribed' ? 'success' :
                                        subscriber.status === 'unsubscribed' ? 'warning' :
                                        'danger' %>">
                                        <%= subscriber.status %>
                                    </span>
                                </td>
                                <td><%= new Date(subscriber.created_at).toLocaleDateString('it-IT') %></td>
                                <td>
                                    <div style="display: flex; gap: 4px;">
                                        <button class="btn btn-sm" onclick="editSubscriber(<%= subscriber.id %>)" title="Modifica">
                                            ✏️
                                        </button>
                                        <button class="btn btn-sm btn-danger" onclick="deleteSubscriber(<%= subscriber.id %>)" title="Elimina">
                                            🗑️
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 60px;">
                                    <div style="font-size: 48px; margin-bottom: 20px;">📭</div>
                                    <h3>Nessun iscritto ancora</h3>
                                    <p style="color: var(--text-light);">Inizia ad aggiungere iscritti manualmente o importali da CSV</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            
            <!-- Bulk Actions -->
            <% if (subscribers && subscribers.length > 0) { %>
            <div style="padding: 16px; border-top: 2px solid var(--border); background: var(--bg); display: flex; gap: 8px; align-items: center;">
                <span style="color: var(--text-light); font-weight: 500;">Con i selezionati:</span>
                <button class="btn btn-sm btn-success" onclick="bulkUpdateStatus('active')">
                    ✅ Attiva
                </button>
                <button class="btn btn-sm btn-secondary" onclick="bulkUpdateStatus('unsubscribed')">
                    ⏸️ Disattiva
                </button>
                <button class="btn btn-sm btn-danger" onclick="bulkDelete()">
                    🗑️ Elimina
                </button>
            </div>
            <% } %>
        </div>
    </div>

    <!-- Add/Edit Modal -->
    <div id="subscriber-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modal-title">Aggiungi Iscritto</h2>
                <button class="btn btn-sm" onclick="closeModal()" style="font-size: 24px; padding: 0; width: 32px; height: 32px;">&times;</button>
            </div>
            <form id="subscriber-form">
                <div class="modal-body">
                    <input type="hidden" id="subscriber-id">
                    
                    <div class="form-group">
                        <label>Email *</label>
                        <input type="email" id="subscriber-email" class="form-control" required>
                    </div>
                    
                    <div class="form-group">
                        <label>Nome</label>
                        <input type="text" id="subscriber-name" class="form-control">
                    </div>
                    
                    <div class="form-group">
                        <label>Stato</label>
                        <select id="subscriber-status" class="form-control">
                            <option value="active">Attivo</option>
                            <option value="subscribed">Iscritto</option>
                            <option value="unsubscribed">Non iscritto</option>
                            <option value="bounced">Bounced</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">💾 Salva</button>
                    <button type="button" class="btn btn-secondary" onclick="closeModal()">Annulla</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Import Modal -->
    <div id="import-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>📥 Importa da CSV</h2>
                <button class="btn btn-sm" onclick="closeImportModal()" style="font-size: 24px; padding: 0; width: 32px; height: 32px;">&times;</button>
            </div>
            <div class="modal-body">
                <p style="margin-bottom: 16px;">Formato CSV richiesto: prima riga con intestazioni "Email,Nome"</p>
                <textarea id="csv-data" class="form-control" rows="10" 
                          placeholder="Email,Nome&#10;mario@example.com,Mario Rossi&#10;luigi@example.com,Luigi Verdi"></textarea>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" onclick="importCSV()">📥 Importa</button>
                <button class="btn btn-secondary" onclick="closeImportModal()">Annulla</button>
            </div>
        </div>
    </div>

   <script>
// ============================================
// PAGINAZIONE SUBSCRIBERS
// ============================================

let currentPage = 1;
let itemsPerPage = 50;
let filteredRows = [];

function updatePagination() {
    const perPageSelect = document.getElementById('per-page');
    itemsPerPage = perPageSelect.value === 'all' ? 999999 : parseInt(perPageSelect.value);
    currentPage = 1;
    filterSubscribers();
}

function filterSubscribers() {
    const searchTerm = document.getElementById('search-input').value.toLowerCase();
    const statusFilter = document.getElementById('status-filter').value;
    const rows = document.querySelectorAll('#subscribers-table tbody tr');
    
    filteredRows = [];
    
    rows.forEach(row => {
        if (!row.dataset.id) return;
        
        const email = row.cells[1].textContent.toLowerCase();
        const name = row.cells[2].textContent.toLowerCase();
        const status = row.cells[3].textContent.trim().toLowerCase();
        
        const matchesSearch = !searchTerm || 
            email.includes(searchTerm) || 
            name.includes(searchTerm);
            
        const matchesStatus = !statusFilter || 
            status.includes(statusFilter);
        
        if (matchesSearch && matchesStatus) {
            filteredRows.push(row);
        }
    });
    
    // Update counts
    document.getElementById('total-count').textContent = filteredRows.length;
    
    // Paginate
    showPage(currentPage);
}

function showPage(page) {
    const start = (page - 1) * itemsPerPage;
    const end = start + itemsPerPage;
    
    // Hide all rows first
    const allRows = document.querySelectorAll('#subscribers-table tbody tr');
    allRows.forEach(row => row.style.display = 'none');
    
    // Show only current page rows
    const pageRows = filteredRows.slice(start, end);
    pageRows.forEach(row => row.style.display = '');
    
    // Update showing count
    document.getElementById('showing-count').textContent = pageRows.length;
    
    // Update pagination controls
    const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
    
    if (totalPages > 1) {
        document.getElementById('pagination-controls').style.display = 'flex';
        
        // Prev/Next buttons
        document.getElementById('btn-prev').disabled = page === 1;
        document.getElementById('btn-next').disabled = page === totalPages;
        
        // Page numbers
        const pageNumbers = document.getElementById('page-numbers');
        pageNumbers.innerHTML = '';
        
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= page - 2 && i <= page + 2)) {
                const btn = document.createElement('button');
                btn.className = 'btn btn-sm' + (i === page ? ' btn-primary' : ' btn-outline');
                btn.textContent = i;
                btn.onclick = () => goToPage(i);
                pageNumbers.appendChild(btn);
            } else if (i === page - 3 || i === page + 3) {
                const span = document.createElement('span');
                span.textContent = '...';
                span.style.padding = '0 8px';
                pageNumbers.appendChild(span);
            }
        }
    } else {
        document.getElementById('pagination-controls').style.display = 'none';
    }
}

function goToPage(page) {
    if (page === 'prev') {
        currentPage = Math.max(1, currentPage - 1);
    } else if (page === 'next') {
        const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
        currentPage = Math.min(totalPages, currentPage + 1);
    } else {
        currentPage = page;
    }
    showPage(currentPage);
}

function resetFilters() {
    document.getElementById('search-input').value = '';
    document.getElementById('status-filter').value = '';
    document.getElementById('per-page').value = '50';
    itemsPerPage = 50;
    currentPage = 1;
    filterSubscribers();
}

// Init on load
document.addEventListener('DOMContentLoaded', () => {
    filterSubscribers();
});
</script>

<script src="/js/subscriber-manager.js"></script>
</body>
</html>