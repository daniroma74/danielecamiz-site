<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <style>
    body{background:#0b0c0f;color:#f1f1f1;font-family:system-ui,sans-serif;display:flex;min-height:100vh;align-items:center;justify-content:center;margin:0}
    .card{background:#13151a;padding:24px 28px;border-radius:14px;box-shadow:0 6px 20px rgba(0,0,0,.35);width:min(92vw,420px)}
    h1{margin:.2rem 0 1rem;font-size:1.25rem;color:#d4af37}
    label{display:block;margin:.6rem 0 .25rem}
    input{width:100%;padding:.6rem .75rem;background:#0b0c0f;border:1px solid #23262d;border-radius:10px;color:#fff}
    button{margin-top:1rem;width:100%;padding:.75rem 1rem;background:#d4af37;border:0;border-radius:12px;color:#0b0c0f;font-weight:700;cursor:pointer}
    .err{background:#2a0f10;border:1px solid #7a2226;color:#ffb3b5;padding:.6rem .75rem;border-radius:10px;margin-bottom:.6rem}
    small{color:#9aa0aa}
  </style>
</head>
<body>
  <form class="card" method="post" action="/auth/login">
    <h1>Newsletter Admin – Login</h1>
    <% if (error) { %><div class="err"><%= error %></div><% } %>
    <label for="u">Username</label>
    <input id="u" name="username" autocomplete="username" required>
    <label for="p">Password</label>
    <input id="p" name="password" type="password" autocomplete="current-password" required>
    <input type="hidden" name="returnTo" value="<%= returnTo %>">
    <button type="submit">Entra</button>
    <p><small>Accesso riservato. I link nelle email (disiscrizione/gestione) restano pubblici.</small></p>
  </form>
</body>
</html>
