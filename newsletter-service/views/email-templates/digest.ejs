<!-- newsletter-service/views/email-templates/digest.ejs -->
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= subject %></title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background-color: #f5f7fa;
      color: #333;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      background: white;
    }
    .header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 40px 30px;
      text-align: center;
    }
    .header h1 {
      margin: 0 0 10px;
      font-size: 28px;
      font-weight: 300;
    }
    .header p {
      margin: 0;
      opacity: 0.95;
      font-size: 16px;
    }
    .intro {
      padding: 30px;
      font-size: 16px;
      line-height: 1.6;
      border-bottom: 1px solid #e8e8e8;
    }
    .article {
      padding: 30px;
      border-bottom: 1px solid #e8e8e8;
    }
    .article:last-of-type {
      border-bottom: none;
    }
    .article-category {
      display: inline-block;
      background: #667eea;
      color: white;
      padding: 4px 12px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      margin-bottom: 15px;
    }
    .article-title {
      margin: 0 0 10px;
      font-size: 24px;
      font-weight: 600;
      color: #1a1a1a;
    }
    .article-title a {
      color: #1a1a1a;
      text-decoration: none;
    }
    .article-title a:hover {
      color: #667eea;
    }
    .article-date {
      color: #666;
      font-size: 14px;
      margin-bottom: 15px;
    }
    .article-image {
      width: 100%;
      height: auto;
      border-radius: 8px;
      margin-bottom: 20px;
    }
    .article-excerpt {
      font-size: 16px;
      line-height: 1.6;
      color: #444;
      margin-bottom: 20px;
    }
    .article-link {
      display: inline-block;
      background: #667eea;
      color: white;
      padding: 12px 24px;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 600;
      transition: background 0.3s;
    }
    .article-link:hover {
      background: #5568d3;
    }
    .footer {
      background: #f5f7fa;
      padding: 30px;
      text-align: center;
      font-size: 14px;
      color: #666;
    }
    .footer a {
      color: #667eea;
      text-decoration: none;
    }
    .social-links {
      margin: 20px 0;
    }
    .social-links a {
      display: inline-block;
      margin: 0 10px;
      color: #667eea;
      text-decoration: none;
    }
    .unsubscribe {
      margin-top: 20px;
      font-size: 12px;
      color: #999;
    }
    .unsubscribe a {
      color: #999;
      text-decoration: underline;
    }
    .notes-section {
      background: #fff8e1;
      border-left: 4px solid #ffc107;
      padding: 20px;
      margin: 20px 30px;
      border-radius: 6px;
    }
    .notes-section h3 {
      margin: 0 0 10px;
      color: #f57c00;
      font-size: 18px;
    }
    .notes-section p {
      margin: 0;
      line-height: 1.6;
      white-space: pre-wrap;
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <div class="header">
      <h1>Daniele Camiz</h1>
      <p><%= lang === 'it' ? 'Newsletter' : 'Newsletter' %></p>
    </div>

    <!-- Intro -->
    <div class="intro">
      <% if (introText) { %>
        <%- introText.replace(/\n/g, '<br>') %>
      <% } else { %>
        <% if (lang === 'it') { %>
          <p>Ciao,</p>
          <p>Ecco le ultime novità dal sito di Daniele Camiz. Troverai <%= posts.length %> <%= posts.length === 1 ? 'articolo' : 'articoli' %> selezionati per te.</p>
        <% } else { %>
          <p>Hello,</p>
          <p>Here are the latest news from Daniele Camiz's website. You'll find <%= posts.length %> selected <%= posts.length === 1 ? 'article' : 'articles' %> for you.</p>
        <% } %>
      <% } %>
    </div>

    <!-- Articles -->
    <% posts.forEach(post => { %>
      <div class="article">
        <span class="article-category"><%= post.category || 'news' %></span>

        <h2 class="article-title">
          <a href="https://www.danielecamiz.com/news/<%= post.slug %>">
            <%= lang === 'it' ? post.title_it : (post.title_en || post.title_it) %>
          </a>
        </h2>

        <div class="article-date">
          <%= new Date(post.publish_date || post.created_at).toLocaleDateString(lang === 'it' ? 'it-IT' : 'en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          }) %>
        </div>

        <% if (post.cover_image) { %>
          <img src="<%= post.cover_image %>" alt="" class="article-image">
        <% } %>

        <% if (post.excerpt_it || post.excerpt_en) { %>
          <div class="article-excerpt">
            <%= lang === 'it' ? (post.excerpt_it || post.excerpt_en) : (post.excerpt_en || post.excerpt_it) %>
          </div>
        <% } %>

        <a href="https://www.danielecamiz.com/news/<%= post.slug %>" class="article-link">
          <%= lang === 'it' ? 'Leggi tutto' : 'Read more' %>
        </a>
      </div>
    <% }); %>

    <!-- Additional Notes Section -->
    <% if (notes && notes.trim()) { %>
      <div class="notes-section">
        <h3><%= lang === 'it' ? '📝 Altre Comunicazioni' : '📝 Additional Notes' %></h3>
        <p><%- notes.replace(/\n/g, '<br>') %></p>
      </div>
    <% } %>

    <!-- Footer -->
    <div class="footer">
      <p><strong>Daniele Camiz</strong></p>
      <p><%= lang === 'it' ? 'Direttore d\'Orchestra' : 'Conductor' %></p>

      <div class="social-links">
        <a href="https://www.danielecamiz.com">Website</a> •
        <a href="https://www.facebook.com/danielecamiz">Facebook</a> •
        <a href="https://www.instagram.com/danielecamiz">Instagram</a>
      </div>

      <div class="unsubscribe">
        <% if (lang === 'it') { %>
          <p>Hai ricevuto questa email perché sei iscritto alla newsletter di Daniele Camiz.</p>
          <p><a href="<%= unsubscribeUrl %>">Gestisci le tue preferenze</a> o <a href="<%= unsubscribeUrl %>">disiscriviti</a></p>
        <% } else { %>
          <p>You received this email because you are subscribed to Daniele Camiz's newsletter.</p>
          <p><a href="<%= unsubscribeUrl %>">Manage your preferences</a> or <a href="<%= unsubscribeUrl %>">unsubscribe</a></p>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
