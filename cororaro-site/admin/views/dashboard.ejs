<div class="page-header">
  <h1>🏠 Pannello di Controllo</h1>
  <p style="color: #666; font-size: 1.1rem;">Benvenuto, <strong><%= user.fullName || user.username %></strong>!</p>
</div>

<style>
  .riepilogo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .card-numero {
    background: white;
    padding: 1.5rem;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    border-left: 4px solid var(--terracotta);
  }

  .card-numero h3 {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .card-numero .valore {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--terracotta);
  }

  .sezione-recenti {
    background: white;
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .sezione-recenti h2 {
    margin-bottom: 1.5rem;
    color: var(--terracotta);
  }

  .lista-recenti {
    list-style: none;
  }

  .elemento-recente {
    padding: 1rem;
    border-bottom: 1px solid var(--beige);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .elemento-recente:last-child {
    border-bottom: none;
  }

  .info-elemento {
    flex: 1;
  }

  .titolo-elemento {
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .meta-elemento {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .stato-vuoto {
    text-align: center;
    padding: 3rem;
    color: var(--text-secondary);
  }
</style>

<div class="riepilogo-grid">
  <div class="card-numero">
    <h3>🌍 Paesi</h3>
    <div class="valore"><%= stats.countries || 0 %></div>
    <a href="/admin/countries" style="font-size: 0.95rem; color: #666;">Gestisci Paesi →</a>
  </div>

  <div class="card-numero">
    <h3>🎵 Brani Attivi</h3>
    <div class="valore"><%= stats.activeSongs || 0 %></div>
    <a href="/admin/repertoire" style="font-size: 0.95rem; color: #666;">Gestisci Repertorio →</a>
  </div>

  <div class="card-numero">
    <h3>🎤 Concerti</h3>
    <div class="valore"><%= stats.concerts || 0 %></div>
    <a href="/admin/concerts" style="font-size: 0.95rem; color: #666;">Gestisci Concerti →</a>
  </div>

  <div class="card-numero">
    <h3>💚 Progetti Solidali</h3>
    <div class="valore"><%= stats.projects || 0 %></div>
    <a href="/admin/projects" style="font-size: 0.95rem; color: #666;">Gestisci Progetti →</a>
  </div>

  <div class="card-numero">
    <h3>🎭 Maestri</h3>
    <div class="valore"><%= stats.maestri || 0 %></div>
    <a href="/admin/maestri" style="font-size: 0.95rem; color: #666;">Gestisci Maestri →</a>
  </div>

  <div class="card-numero">
    <h3>📸 Foto Galleria</h3>
    <div class="valore"><%= stats.galleryImages || 0 %></div>
    <a href="/admin/gallery-images" style="font-size: 0.95rem; color: #666;">Gestisci Galleria →</a>
  </div>
</div>

<!-- Azioni Rapide -->
<div style="margin: 2rem 0;">
  <h2 style="margin-bottom: 1rem; font-size: 1.3rem;">⚡ Azioni Rapide</h2>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
    <a href="/admin/settings" class="btn" style="padding: 1rem; text-align: center; font-size: 1rem;">⚙️ Impostazioni Sito</a>
    <a href="/admin/concerts/new" class="btn" style="padding: 1rem; text-align: center; font-size: 1rem;">+ Nuovo Concerto</a>
    <a href="/admin/projects/new" class="btn" style="padding: 1rem; text-align: center; font-size: 1rem;">+ Nuovo Progetto</a>
    <a href="/admin/maestri/new" class="btn" style="padding: 1rem; text-align: center; font-size: 1rem;">+ Nuovo Maestro</a>
    <a href="/admin/gallery-images/new" class="btn" style="padding: 1rem; text-align: center; font-size: 1rem;">+ Nuova Foto</a>
    <a href="/admin/repertoire/new" class="btn" style="padding: 1rem; text-align: center; font-size: 1rem;">+ Nuovo Brano</a>
  </div>
</div>

<div class="sezione-recenti">
  <h2>📝 Ultimi Brani Aggiunti al Repertorio</h2>

  <% if (recentSongs && recentSongs.length > 0) { %>
    <ul class="lista-recenti">
      <% recentSongs.forEach(song => { %>
        <li class="elemento-recente">
          <div class="info-elemento">
            <div class="titolo-elemento">
              <%= song.flag %> <%= song.title %>
            </div>
            <div class="meta-elemento">
              <%= song.country_name %> • <%= song.language || 'N/D' %>
            </div>
          </div>
          <a href="/admin/repertoire/<%= song.id %>/edit" class="btn btn-small">
            Modifica
          </a>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <div class="stato-vuoto">
      <p>Nessun brano nel repertorio</p>
      <a href="/admin/repertoire/new" class="btn" style="margin-top: 1rem;">
        + Aggiungi Primo Brano
      </a>
    </div>
  <% } %>
</div>
