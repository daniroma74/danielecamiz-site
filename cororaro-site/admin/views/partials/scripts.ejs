<!-- Cloudinary Manager (Shared) -->
<script src="/shared/cloudinary-manager/client.js"></script>
<script>
  // Inizializza CloudinaryManager con account Coro Raro
  CloudinaryManager.init({
    cloudName: '<%= process.env.CLOUDINARY_CLOUD_NAME %>',
    defaultFolder: 'cororaro',
    defaultPreset: 'cororaro_general',
    apiPrefix: '/admin/cloudinary'
  });
</script>

<!-- Common scripts -->
<script>
  // Flash messages auto-hide
  setTimeout(() => {
    const alerts = document.querySelectorAll('.alert');
    alerts.forEach(alert => {
      alert.style.transition = 'opacity 0.5s';
      alert.style.opacity = '0';
      setTimeout(() => alert.remove(), 500);
    });
  }, 5000);
</script>
