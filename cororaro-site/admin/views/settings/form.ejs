<div class="page-header">
  <h1>⚙️ Impostazioni Generali del Sito</h1>
  <p style="color: #666; font-size: 1.1rem;">Configura i contenuti principali che appaiono sul sito Cororaro</p>
</div>

<!-- Navigation Tabs -->
<div style="display: flex; gap: 1rem; margin-bottom: 2rem; border-bottom: 2px solid #ddd; padding-bottom: 0;">
  <a href="/admin/settings" style="padding: 0.75rem 1.5rem; text-decoration: none; color: white; background: var(--terracotta, #8B4513); border-radius: 8px 8px 0 0; font-weight: 600;">📋 Impostazioni Generali</a>
  <a href="/admin/settings/values" style="padding: 0.75rem 1.5rem; text-decoration: none; color: #333; background: #f0f0f0; border-radius: 8px 8px 0 0;">💎 Valori del Coro</a>
  <a href="/admin/settings/join" style="padding: 0.75rem 1.5rem; text-decoration: none; color: #333; background: #f0f0f0; border-radius: 8px 8px 0 0;">🎤 Unisciti a Noi</a>
</div>

<div class="form-container" style="background: white; padding: 2.5rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); max-width: 1200px;">

  <div style="background: #e3f2fd; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem; border-left: 4px solid #2196f3;">
    <h3 style="margin: 0 0 0.5rem 0; color: #1976d2;">💡 Come funziona?</h3>
    <p style="margin: 0; color: #555;">
      Queste impostazioni controllano i testi e le immagini principali del sito.
      <br>I campi con l'icona 📝 permettono di formattare il testo (grassetto, elenchi, ecc.).
      <br>Clicca "Salva" in fondo alla pagina per applicare le modifiche.
    </p>
  </div>

  <form method="POST" action="/admin/settings">

    <!-- ========== HERO SECTION ========== -->
    <div style="background: #f5f5f5; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem;">
      <h2 style="margin-top: 0; color: #333; font-size: 1.3rem;">🎭 Sezione Hero (Prima cosa che vedono i visitatori)</h2>

      <% settings.hero.forEach(setting => { %>
        <div style="margin-bottom: 1.5rem;">
          <label for="<%= setting.setting_key %>" style="display: block; margin-bottom: 0.5rem; font-weight: 700; font-size: 1.1rem;">
            <%= setting.setting_key === 'hero_logo' ? '🎨 Logo del Coro' :
                setting.setting_key === 'hero_claim' ? '💬 Frase Principale' :
                setting.setting_key === 'hero_background' ? '🖼️ Foto di Sfondo' :
                setting.setting_key === 'hero_stat_years' ? '📅 Statistiche - Numero Anni' :
                setting.setting_key === 'hero_stat_continents' ? '🌍 Statistiche - Numero Continenti' :
                setting.setting_key === 'hero_stat_emotions' ? '❤️ Statistiche - Emozioni' :
                setting.setting_key === 'hero_cta_concerts' ? '🎵 Testo Pulsante Concerti' :
                setting.setting_key === 'hero_cta_join' ? '🎤 Testo Pulsante Unisciti' :
                setting.setting_key.replace('hero_', '').replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %>
          </label>

          <% if (setting.setting_key.includes('_url') || setting.setting_key.includes('_background') || setting.setting_key.includes('_logo') || setting.setting_key.includes('_image')) { %>
            <!-- CLOUDINARY IMAGE UPLOAD -->
            <div class="image-upload-container">
              <input
                type="text"
                id="<%= setting.setting_key %>"
                name="<%= setting.setting_key %>"
                value="<%= setting.setting_value || '' %>"
                readonly
                placeholder="Nessuna immagine caricata"
                style="width: 100%; padding: 1rem; border: 2px solid #ddd; border-radius: 8px 8px 0 0; font-size: 1.1rem; font-family: inherit; background: #f9f9f9;"
              >
              <button
                type="button"
                class="cloudinary-upload-btn"
                data-target="<%= setting.setting_key %>"
                style="width: 100%; padding: 1rem; background: #3498db; color: white; border: none; border-radius: 0 0 8px 8px; cursor: pointer; font-size: 1.1rem; font-weight: 600; transition: background 0.3s;"
                onmouseover="this.style.background='#2980b9'"
                onmouseout="this.style.background='#3498db'"
              >
                📷 <%= setting.setting_value ? 'Cambia Immagine' : 'Carica Immagine' %>
              </button>
              <% if (setting.setting_value) { %>
                <img src="<%= setting.setting_value %>" alt="Preview" style="max-width: 300px; margin-top: 1rem; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
              <% } %>
            </div>
            <small style="display: block; margin-top: 0.5rem; color: #666;">
              💬 <%= setting.setting_key.includes('background') ? 'Immagine di sfondo della sezione Hero' :
                      setting.setting_key.includes('logo') ? 'Logo del coro' :
                      setting.setting_key.includes('about_image') ? 'Foto del gruppo per la sezione Chi Siamo' :
                      'Clicca "Carica Immagine" per selezionare' %>
            </small>
          <% } else if (setting.setting_key.includes('_html') || setting.setting_key.includes('description')) { %>
            <textarea
              id="<%= setting.setting_key %>"
              name="<%= setting.setting_key %>"
              class="tinymce-editor"
              rows="4"
              style="width: 100%; padding: 1rem; border: 2px solid #ddd; border-radius: 8px; font-size: 1.1rem; font-family: inherit;"
            ><%= setting.setting_value || '' %></textarea>
            <small style="display: block; margin-top: 0.5rem; color: #666;">
              💬 📝 Puoi formattare il testo usando i bottoni dell'editor
            </small>
          <% } else { %>
            <input
              type="text"
              id="<%= setting.setting_key %>"
              name="<%= setting.setting_key %>"
              value="<%= setting.setting_value || '' %>"
              placeholder="<%= setting.setting_key.includes('title') ? 'Es: Benvenuti in Cororaro' :
                             setting.setting_key.includes('subtitle') ? 'Es: Un coro con il cuore in Africa' :
                             setting.setting_key.includes('cta') ? 'Es: Scopri i nostri concerti' : '' %>"
              style="width: 100%; padding: 1rem; border: 2px solid #ddd; border-radius: 8px; font-size: 1.1rem; font-family: inherit;"
            >
            <small style="display: block; margin-top: 0.5rem; color: #666;">
              💬 <%= setting.setting_key.includes('title') ? 'Il titolo grande che appare in homepage' :
                      setting.setting_key.includes('subtitle') ? 'Il sottotitolo sotto al titolo principale' :
                      setting.setting_key.includes('cta_text') ? 'Il testo che appare sul bottone' : '' %>
            </small>
          <% } %>
        </div>
      <% }) %>
    </div>

    <!-- ========== ABOUT SECTION ========== -->
    <div style="background: #fff3e0; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem; border-left: 4px solid #ff9800;">
      <h2 style="margin-top: 0; color: #333; font-size: 1.3rem;">ℹ️ Sezione "Chi Siamo"</h2>

      <% settings.about.forEach(setting => { %>
        <div style="margin-bottom: 1.5rem;">
          <label for="<%= setting.setting_key %>" style="display: block; margin-bottom: 0.5rem; font-weight: 700; font-size: 1.1rem;">
            <%= setting.setting_key === 'about_label' ? '🏷️ Etichetta Sezione' :
                setting.setting_key === 'about_title' ? '📌 Titolo Sezione' :
                setting.setting_key === 'about_lead' ? '📝 Testo Introduttivo (con formattazione)' :
                setting.setting_key === 'about_text_1' ? '📖 Primo Paragrafo (con formattazione)' :
                setting.setting_key === 'about_text_2' ? '📖 Secondo Paragrafo (con formattazione)' :
                setting.setting_key === 'about_image' ? '🖼️ Foto del Gruppo' :
                setting.setting_key === 'about_badge_year' ? '📅 Anno di Fondazione (badge)' :
                setting.setting_key === 'about_badge_location' ? '📍 Luogo (badge)' :
                setting.setting_key.replace('about_', '').replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %>
          </label>

          <% if (setting.setting_key.includes('_html') || setting.setting_key.includes('_text_') || setting.setting_key.includes('_lead')) { %>
            <p style="margin: 0 0 0.5rem 0; padding: 0.75rem; background: #fffde7; border-radius: 4px; border-left: 3px solid #fbc02d; font-size: 0.95rem;">
              <strong>📝 Puoi formattare il testo!</strong> Grassetto, elenchi, titoli...
            </p>
            <textarea
              id="<%= setting.setting_key %>"
              name="<%= setting.setting_key %>"
              class="tinymce-editor"
              rows="6"
              style="width: 100%; padding: 1rem; border: 2px solid #ddd; border-radius: 8px; font-size: 1.1rem; font-family: inherit;"
            ><%= setting.setting_value || '' %></textarea>
            <small style="display: block; margin-top: 0.5rem; color: #666;">
              💬 <%= setting.setting_key.includes('lead') ? 'Un\'introduzione accattivante alla storia del coro' :
                      setting.setting_key.includes('text_1') ? 'La prima parte della vostra storia' :
                      setting.setting_key.includes('text_2') ? 'La seconda parte della vostra storia' : '' %>
            </small>
          <% } else if (setting.setting_key.includes('_image')) { %>
            <!-- CLOUDINARY IMAGE UPLOAD -->
            <div class="image-upload-container">
              <input
                type="text"
                id="<%= setting.setting_key %>"
                name="<%= setting.setting_key %>"
                value="<%= setting.setting_value || '' %>"
                readonly
                placeholder="Nessuna immagine caricata"
                style="width: 100%; padding: 1rem; border: 2px solid #ddd; border-radius: 8px 8px 0 0; font-size: 1.1rem; font-family: inherit; background: #f9f9f9;"
              >
              <button
                type="button"
                class="cloudinary-upload-btn"
                data-target="<%= setting.setting_key %>"
                style="width: 100%; padding: 1rem; background: #3498db; color: white; border: none; border-radius: 0 0 8px 8px; cursor: pointer; font-size: 1.1rem; font-weight: 600; transition: background 0.3s;"
                onmouseover="this.style.background='#2980b9'"
                onmouseout="this.style.background='#3498db'"
              >
                📷 <%= setting.setting_value ? 'Cambia Immagine' : 'Carica Immagine' %>
              </button>
              <% if (setting.setting_value) { %>
                <img src="<%= setting.setting_value %>" alt="Preview" style="max-width: 300px; margin-top: 1rem; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
              <% } %>
            </div>
            <small style="display: block; margin-top: 0.5rem; color: #666;">
              💬 Foto del gruppo per la sezione "Chi Siamo"
            </small>
          <% } else { %>
            <input
              type="text"
              id="<%= setting.setting_key %>"
              name="<%= setting.setting_key %>"
              value="<%= setting.setting_value || '' %>"
              placeholder="<%= setting.setting_key.includes('title') ? 'Es: Chi Siamo' : '' %>"
              style="width: 100%; padding: 1rem; border: 2px solid #ddd; border-radius: 8px; font-size: 1.1rem; font-family: inherit;"
            >
            <small style="display: block; margin-top: 0.5rem; color: #666;">
              💬 <%= setting.setting_key.includes('title') ? 'Il titolo della sezione "Chi Siamo"' : '' %>
            </small>
          <% } %>
        </div>
      <% }) %>
    </div>

    <!-- ========== PROJECTS SECTION ========== -->
    <div style="background: #f3e5f5; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem; border-left: 4px solid #9c27b0;">
      <h2 style="margin-top: 0; color: #333; font-size: 1.3rem;">🌍 Sezione Progetti Solidali</h2>

      <% settings.projects.forEach(setting => { %>
        <div style="margin-bottom: 1.5rem;">
          <label for="<%= setting.setting_key %>" style="display: block; margin-bottom: 0.5rem; font-weight: 700; font-size: 1.1rem;">
            <%= setting.setting_key === 'projects_label' ? '🏷️ Etichetta Sezione' :
                setting.setting_key === 'projects_title' ? '📌 Titolo Sezione' :
                setting.setting_key === 'projects_subtitle' ? '📄 Sottotitolo' :
                setting.setting_key === 'projects_intro' ? '📝 Testo Introduttivo (con formattazione)' :
                setting.setting_key === 'projects_stat_funds' ? '💰 Statistiche - Fondi Raccolti' :
                setting.setting_key === 'projects_stat_projects' ? '🎯 Statistiche - Numero Progetti' :
                setting.setting_key === 'projects_stat_countries' ? '🌍 Statistiche - Numero Paesi' :
                setting.setting_key.replace('projects_', '').replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %>
          </label>

          <% if (setting.setting_key.includes('_html') || setting.setting_key.includes('_intro')) { %>
            <p style="margin: 0 0 0.5rem 0; padding: 0.75rem; background: #fffde7; border-radius: 4px; border-left: 3px solid #fbc02d; font-size: 0.95rem;">
              <strong>📝 Puoi formattare il testo!</strong> Grassetto, elenchi, titoli...
            </p>
            <textarea
              id="<%= setting.setting_key %>"
              name="<%= setting.setting_key %>"
              class="tinymce-editor"
              rows="4"
              style="width: 100%; padding: 1rem; border: 2px solid #ddd; border-radius: 8px; font-size: 1.1rem; font-family: inherit;"
            ><%= setting.setting_value || '' %></textarea>
            <small style="display: block; margin-top: 0.5rem; color: #666;">
              💬 Un'introduzione ai vostri progetti di solidarietà
            </small>
          <% } else { %>
            <input
              type="text"
              id="<%= setting.setting_key %>"
              name="<%= setting.setting_key %>"
              value="<%= setting.setting_value || '' %>"
              placeholder="<%= setting.setting_key.includes('title') ? 'Es: I Nostri Progetti' : '' %>"
              style="width: 100%; padding: 1rem; border: 2px solid #ddd; border-radius: 8px; font-size: 1.1rem; font-family: inherit;"
            >
            <small style="display: block; margin-top: 0.5rem; color: #666;">
              💬 Il titolo della sezione progetti
            </small>
          <% } %>
        </div>
      <% }) %>
    </div>

    <!-- ========== CONTACT SECTION ========== -->
    <div style="background: #e8f5e9; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem; border-left: 4px solid #4caf50;">
      <h2 style="margin-top: 0; color: #333; font-size: 1.3rem;">📧 Informazioni di Contatto</h2>

      <% settings.contact.forEach(setting => { %>
        <div style="margin-bottom: 1.5rem;">
          <label for="<%= setting.setting_key %>" style="display: block; margin-bottom: 0.5rem; font-weight: 700; font-size: 1.1rem;">
            <%= setting.setting_key === 'contact_email' ? '📧 Email' :
                setting.setting_key === 'contact_phone' ? '📱 Telefono' :
                setting.setting_key === 'contact_address' ? '📍 Indirizzo' :
                setting.setting_key.replace('contact_', '').replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %>
          </label>
          <input
            type="<%= setting.setting_key.includes('email') ? 'email' : 'text' %>"
            id="<%= setting.setting_key %>"
            name="<%= setting.setting_key %>"
            value="<%= setting.setting_value || '' %>"
            placeholder="<%= setting.setting_key.includes('email') ? 'info@cororaro.it' :
                           setting.setting_key.includes('phone') ? '+39 XXX XXX XXXX' :
                           setting.setting_key.includes('address') ? 'Via..., Roma' : '' %>"
            style="width: 100%; padding: 1rem; border: 2px solid #ddd; border-radius: 8px; font-size: 1.1rem; font-family: inherit;"
          >
          <small style="display: block; margin-top: 0.5rem; color: #666;">
            💬 <%= setting.setting_key.includes('email') ? 'Email principale del coro' :
                    setting.setting_key.includes('phone') ? 'Numero di telefono per informazioni' :
                    setting.setting_key.includes('address') ? 'Indirizzo sede delle prove o del coro' : '' %>
          </small>
        </div>
      <% }) %>
    </div>

    <!-- ========== SOCIAL MEDIA ========== -->
    <div style="background: #fce4ec; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem; border-left: 4px solid #e91e63;">
      <h2 style="margin-top: 0; color: #333; font-size: 1.3rem;">📱 Social Media</h2>

      <% settings.social.forEach(setting => { %>
        <div style="margin-bottom: 1.5rem;">
          <label for="<%= setting.setting_key %>" style="display: block; margin-bottom: 0.5rem; font-weight: 700; font-size: 1.1rem;">
            <%= setting.setting_key === 'social_facebook' ? '👍 Facebook' :
                setting.setting_key === 'social_instagram' ? '📷 Instagram' :
                setting.setting_key === 'social_youtube' ? '▶️ YouTube' :
                setting.setting_key === 'social_twitter' ? '🐦 Twitter/X' :
                setting.setting_key.replace('social_', '').replace(/\b\w/g, l => l.toUpperCase()) %>
          </label>
          <input
            type="url"
            id="<%= setting.setting_key %>"
            name="<%= setting.setting_key %>"
            value="<%= setting.setting_value || '' %>"
            placeholder="https://..."
            style="width: 100%; padding: 1rem; border: 2px solid #ddd; border-radius: 8px; font-size: 1.1rem; font-family: inherit;"
          >
          <small style="display: block; margin-top: 0.5rem; color: #666;">
            💬 Link completo al vostro profilo <%= setting.setting_key.replace('social_', '').replace(/\b\w/g, l => l.toUpperCase()) %>
          </small>
        </div>
      <% }) %>
    </div>

    <!-- ========== FOOTER ========== -->
    <div style="background: #efebe9; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem; border-left: 4px solid #795548;">
      <h2 style="margin-top: 0; color: #333; font-size: 1.3rem;">🦶 Footer (parte finale del sito)</h2>

      <% settings.footer.forEach(setting => { %>
        <div style="margin-bottom: 1.5rem;">
          <label for="<%= setting.setting_key %>" style="display: block; margin-bottom: 0.5rem; font-weight: 700; font-size: 1.1rem;">
            <%= setting.setting_key === 'footer_copyright' ? '©️ Copyright' :
                setting.setting_key.replace('footer_', '').replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %>
          </label>
          <% if (setting.setting_key.includes('_html') || setting.setting_key.includes('copyright')) { %>
            <textarea
              id="<%= setting.setting_key %>"
              name="<%= setting.setting_key %>"
              rows="3"
              style="width: 100%; padding: 1rem; border: 2px solid #ddd; border-radius: 8px; font-size: 1.1rem; font-family: inherit;"
            ><%= setting.setting_value || '' %></textarea>
            <small style="display: block; margin-top: 0.5rem; color: #666;">
              💬 Testo del copyright che appare in fondo alla pagina
            </small>
          <% } else { %>
            <input
              type="text"
              id="<%= setting.setting_key %>"
              name="<%= setting.setting_key %>"
              value="<%= setting.setting_value || '' %>"
              style="width: 100%; padding: 1rem; border: 2px solid #ddd; border-radius: 8px; font-size: 1.1rem; font-family: inherit;"
            >
          <% } %>
        </div>
      <% }) %>
    </div>

    <!-- ========== BOTTONE SALVA ========== -->
    <div style="display: flex; gap: 1.5rem; margin-top: 2.5rem; padding-top: 2rem; border-top: 2px solid #ddd;">
      <button
        type="submit"
        class="btn btn-primary"
        style="padding: 1.25rem 3rem; font-size: 1.2rem; background: #4caf50; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 700;"
      >
        💾 Salva Tutte le Impostazioni
      </button>
    </div>
  </form>
</div>

<!-- Scripts -->
<script src="/shared/vendor/tinymce/tinymce.min.js"></script>
<script src="/shared/config/editor-config.js"></script>

<script>
// ========== INIZIALIZZA TINYMCE PER TUTTI I CAMPI HTML ==========
document.addEventListener('DOMContentLoaded', function() {
  if (typeof tinymce !== 'undefined' && window.SharedEditor) {
    document.querySelectorAll('.tinymce-editor').forEach(field => {
      const isSimple = field.rows <= 4;
      window.SharedEditor.init(`#${field.id}`, 'settings', {
        height: isSimple ? 200 : 300,
        toolbar: isSimple ?
          'undo redo | bold italic | link' :
          'undo redo | formatselect | bold italic | alignleft aligncenter alignright | bullist numlist | link',
        menubar: false,
        language: 'it',
        content_style: `
          body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            font-size: 16px;
            line-height: 1.6;
            color: #333;
            padding: 20px;
          }
        `
      });
    });
  }

  // ========== CLOUDINARY MANAGER (COMPLETO!) ==========
  document.querySelectorAll('.cloudinary-upload-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const targetId = this.getAttribute('data-target');
      const inputField = document.getElementById(targetId);

      if (typeof CloudinaryManager === 'undefined') {
        alert('❌ CloudinaryManager non disponibile. Contatta l\'amministratore.');
        return;
      }

      // Usa il CloudinaryManager COMPLETO con tutte le funzionalità!
      CloudinaryManager.showImageDialog(function(imageUrl, publicId) {
        inputField.value = imageUrl;

        // Aggiorna preview
        const container = inputField.closest('.image-upload-container');
        let preview = container.querySelector('img');
        if (preview) {
          preview.src = imageUrl;
        } else {
          preview = document.createElement('img');
          preview.src = imageUrl;
          preview.alt = 'Preview';
          preview.style.cssText = 'max-width: 300px; margin-top: 1rem; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);';
          container.appendChild(preview);
        }

        // Aggiorna testo bottone
        btn.textContent = '📷 Cambia Immagine';
      }, {
        folder: 'cororaro/impostazioni',
        preset: 'cororaro_settings'
      });
    });
  });
});
</script>
