<div class="page-header">
  <h1><%= action === 'create' ? '+ Nuova Immagine Galleria' : 'Modifica Immagine' %></h1>
</div>

<div class="form-container" style="background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); max-width: 900px;">
  <form method="POST" action="<%= action === 'create' ? '/admin/gallery-images' : '/admin/gallery-images/' + image.id %>">

    <!-- Immagine -->
    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label for="image_url" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Immagine *</label>
      <div style="display: flex; gap: 1rem; align-items: flex-start;">
        <input type="text" id="image_url" name="image_url" value="<%= image.image_url || '' %>" placeholder="URL immagine" required style="flex: 1; padding: 0.75rem; border: 2px solid #ddd; border-radius: 8px;">
        <button type="button" onclick="openImagePicker()" class="btn">📸 Scegli da Cloudinary</button>
      </div>
      <% if (image.image_url) { %>
        <div style="margin-top: 1rem;">
          <img src="<%= image.image_url %>" alt="Gallery Image" style="max-width: 100%; max-height: 400px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        </div>
      <% } %>
      <div id="image-preview" style="margin-top: 1rem;"></div>
    </div>

    <!-- Hidden fields for Cloudinary data -->
    <input type="hidden" id="cloudinary_id" name="cloudinary_id" value="<%= image.cloudinary_id || '' %>">
    <input type="hidden" id="thumbnail_url" name="thumbnail_url" value="<%= image.thumbnail_url || '' %>">

    <!-- Titolo -->
    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label for="title" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Titolo</label>
      <input type="text" id="title" name="title" value="<%= image.title || '' %>" style="width: 100%; padding: 0.75rem; border: 2px solid #ddd; border-radius: 8px; font-size: 1rem;">
      <small style="color: #666;">Titolo descrittivo dell'immagine (opzionale)</small>
    </div>

    <!-- Caption -->
    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label for="caption" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Didascalia</label>
      <textarea id="caption" name="caption" rows="3" style="width: 100%; padding: 0.75rem; border: 2px solid #ddd; border-radius: 8px; font-family: inherit;"><%= image.caption || '' %></textarea>
      <small style="color: #666;">Descrizione o contesto dell'immagine</small>
    </div>

    <!-- Categoria e Ordinamento -->
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
      <div class="form-group">
        <label for="category" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Categoria *</label>
        <select id="category" name="category" required style="width: 100%; padding: 0.75rem; border: 2px solid #ddd; border-radius: 8px; font-size: 1rem;">
          <option value="concerts" <%= image.category === 'concerts' ? 'selected' : '' %>>🎵 Concerti</option>
          <option value="rehearsals" <%= image.category === 'rehearsals' ? 'selected' : '' %>>🎼 Prove</option>
          <option value="group" <%= image.category === 'group' ? 'selected' : '' %>>👥 Gruppo</option>
          <option value="events" <%= image.category === 'events' ? 'selected' : '' %>>🎉 Eventi</option>
        </select>
      </div>
      <div class="form-group">
        <label for="sort_order" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Ordinamento</label>
        <input type="number" id="sort_order" name="sort_order" value="<%= image.sort_order || 0 %>" min="0" style="width: 100%; padding: 0.75rem; border: 2px solid #ddd; border-radius: 8px;">
        <small style="color: #666;">0 = primo</small>
      </div>
    </div>

    <!-- Flags -->
    <div style="display: flex; gap: 2rem; margin-bottom: 1.5rem; padding: 1rem; background: #f9f9f9; border-radius: 8px;">
      <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
        <input type="checkbox" name="is_featured" value="1" <%= image.is_featured ? 'checked' : '' %>>
        <span>⭐ In evidenza</span>
      </label>
      <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
        <input type="checkbox" name="is_published" value="1" <%= image.is_published ? 'checked' : '' %>>
        <span>✅ Pubblicata</span>
      </label>
    </div>

    <!-- Info Box -->
    <% if (image.cloudinary_id) { %>
      <div style="background: #e3f2fd; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
        <strong>ℹ️ Info Cloudinary:</strong>
        <div style="margin-top: 0.5rem; font-size: 0.875rem; color: #555;">
          <div><strong>Public ID:</strong> <%= image.cloudinary_id %></div>
          <% if (image.thumbnail_url && image.thumbnail_url !== image.image_url) { %>
            <div><strong>Thumbnail:</strong> <%= image.thumbnail_url %></div>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- Actions -->
    <div style="display: flex; gap: 1rem; margin-top: 2rem;">
      <button type="submit" class="btn btn-primary" style="padding: 1rem 2rem; font-size: 1rem;">
        <%= action === 'create' ? 'Aggiungi Immagine' : 'Salva Modifiche' %>
      </button>
      <a href="/admin/gallery-images" class="btn btn-secondary" style="padding: 1rem 2rem; font-size: 1rem;">Annulla</a>
    </div>
  </form>
</div>

<!-- Cloudinary Widget -->
<script src="https://upload-widget.cloudinary.com/global/all.js"></script>
<script src="/shared/js/cloudinary-widget.js"></script>

<script>
  function openImagePicker() {
    const config = {
      cloudName: '<%= process.env.CLOUDINARY_CLOUD_NAME || "your-cloud-name" %>',
      uploadPreset: 'cororaro_gallery',
      folder: 'cororaro/gallery'
    };

    if (typeof openCloudinaryPicker !== 'undefined') {
      openCloudinaryPicker(config, (result) => {
        // Update form fields
        document.getElementById('image_url').value = result.url;
        document.getElementById('cloudinary_id').value = result.public_id || '';
        document.getElementById('thumbnail_url').value = result.thumbnail || result.url;

        // Show preview
        document.getElementById('image-preview').innerHTML =
          `<img src="${result.url}" alt="Gallery Image" style="max-width: 100%; max-height: 400px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">`;

        // Auto-fill title if empty
        const titleInput = document.getElementById('title');
        if (!titleInput.value && result.original_filename) {
          titleInput.value = result.original_filename.replace(/\.[^/.]+$/, '').replace(/_/g, ' ');
        }
      }, {
        multiple: false,
        cropping: false
      });
    } else {
      alert('Cloudinary widget non disponibile');
    }
  }
</script>
