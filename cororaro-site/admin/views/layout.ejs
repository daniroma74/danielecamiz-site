<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Coro Raro Admin</title>
  <style>
    :root {
      --terracotta: #D2691E;
      --terracotta-dark: #A0522D;
      --oro: #DAA520;
      --verde: #6B8E23;
      --avorio: #FFFAF0;
      --beige: #F5F0E8;
      --text-primary: #3C3020;
      --text-secondary: #6B5D4F;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Open Sans', sans-serif;
      background: var(--beige);
      color: var(--text-primary);
      line-height: 1.6;
    }

    .admin-container {
      display: flex;
      min-height: 100vh;
    }

    /* Sidebar */
    .sidebar {
      width: 260px;
      background: linear-gradient(180deg, var(--terracotta) 0%, var(--terracotta-dark) 100%);
      color: white;
      padding: 2rem 0;
      box-shadow: 4px 0 12px rgba(0, 0, 0, 0.1);
    }

    .sidebar-header {
      padding: 0 1.5rem 2rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }

    .sidebar-header h2 {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
    }

    .sidebar-header p {
      font-size: 0.9rem;
      opacity: 0.9;
    }

    .sidebar-nav {
      padding: 2rem 0;
    }

    .sidebar-nav a {
      display: flex;
      align-items: center;
      padding: 1rem 1.5rem;
      color: white;
      text-decoration: none;
      transition: background 0.2s;
      font-size: 1rem;
    }

    .sidebar-nav a:hover,
    .sidebar-nav a.active {
      background: rgba(255, 255, 255, 0.1);
    }

    .sidebar-nav a.active {
      border-left: 4px solid var(--oro);
    }

    .sidebar-footer {
      position: absolute;
      bottom: 2rem;
      width: 260px;
      padding: 0 1.5rem;
    }

    .sidebar-footer a {
      color: white;
      text-decoration: none;
      display: block;
      padding: 0.75rem;
      background: rgba(0, 0, 0, 0.2);
      border-radius: 8px;
      text-align: center;
      transition: background 0.2s;
    }

    .sidebar-footer a:hover {
      background: rgba(0, 0, 0, 0.3);
    }

    /* Main Content */
    .main-content {
      flex: 1;
      padding: 2rem;
      overflow-y: auto;
    }

    .page-header {
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid var(--oro);
    }

    .page-header h1 {
      font-size: 2rem;
      color: var(--terracotta);
      margin-bottom: 0.5rem;
    }

    .btn {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: var(--terracotta);
      color: white;
      text-decoration: none;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      font-size: 1rem;
      transition: all 0.2s;
    }

    .btn:hover {
      background: var(--terracotta-dark);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(210, 105, 30, 0.3);
    }

    .btn-secondary {
      background: var(--verde);
    }

    .btn-danger {
      background: #C41E3A;
    }

    .btn-small {
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
    }

    .alert {
      padding: 1rem;
      margin-bottom: 1.5rem;
      border-radius: 8px;
      border-left: 4px solid;
    }

    .alert-success {
      background: #d4edda;
      border-color: #28a745;
      color: #155724;
    }

    .alert-error {
      background: #f8d7da;
      border-color: #dc3545;
      color: #721c24;
    }

    .alert-info {
      background: #d1ecf1;
      border-color: #0c5460;
      color: #0c5460;
    }
  </style>
  <%- include('partials/head-extra') %>
</head>
<body>
  <div class="admin-container">
    <aside class="sidebar">
      <div class="sidebar-header">
        <h2>🎵 Coro Raro</h2>
        <p>Admin Panel</p>
      </div>

      <nav class="sidebar-nav">
        <a href="/admin/dashboard" class="<%= title === 'Dashboard' ? 'active' : '' %>">
          📊 Dashboard
        </a>
        <a href="/admin/repertoire" class="<%= title.includes('Repertorio') ? 'active' : '' %>">
          🎼 Repertorio
        </a>
        <a href="/admin/countries" class="<%= title === 'Paesi' ? 'active' : '' %>">
          🌍 Paesi
        </a>
        <a href="/admin/gallery" class="<%= title === 'Galleria' ? 'active' : '' %>">
          📸 Galleria
        </a>
        <a href="/admin/settings">
          ⚙️ Impostazioni
        </a>
      </nav>

      <div class="sidebar-footer">
        <a href="/admin/logout">🚪 Logout</a>
      </div>
    </aside>

    <main class="main-content">
      <%- body %>
    </main>
  </div>

  <%- include('partials/scripts') %>
</body>
</html>
