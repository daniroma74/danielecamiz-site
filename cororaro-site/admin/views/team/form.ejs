<div class="page-header">
  <h1><%= action === 'create' ? '+ Nuovo Membro' : 'Modifica Membro' %></h1>
</div>

<div class="form-container" style="background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); max-width: 900px;">
  <form method="POST" action="<%= action === 'create' ? '/admin/team' : '/admin/team/' + member.id %>">

    <!-- Nome Completo -->
    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label for="full_name" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Nome Completo *</label>
      <input type="text" id="full_name" name="full_name" value="<%= member.full_name || '' %>" required style="width: 100%; padding: 0.75rem; border: 2px solid #ddd; border-radius: 8px; font-size: 1rem;">
      <small style="color: #666;">Es: Mario Rossi</small>
    </div>

    <!-- Ruolo -->
    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label for="role" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Ruolo *</label>
      <select id="role" name="role" required style="width: 100%; padding: 0.75rem; border: 2px solid #ddd; border-radius: 8px; font-size: 1rem;">
        <option value="director" <%= member.role === 'director' ? 'selected' : '' %>>🎭 Direttore</option>
        <option value="co-director" <%= member.role === 'co-director' ? 'selected' : '' %>>🎼 Vice Direttore</option>
        <option value="chorister" <%= member.role === 'chorister' ? 'selected' : '' %>>🎤 Corista</option>
        <option value="staff" <%= member.role === 'staff' ? 'selected' : '' %>>⚙️ Staff</option>
      </select>
    </div>

    <!-- Bio con TinyMCE -->
    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label for="bio" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Biografia</label>
      <textarea id="bio" name="bio"><%= member.bio || '' %></textarea>
      <small style="color: #666;">Storia, esperienza, passioni musicali del membro</small>
    </div>

    <!-- Foto -->
    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label for="photo_url" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Foto Profilo</label>
      <div style="display: flex; gap: 1rem; align-items: flex-start;">
        <input type="text" id="photo_url" name="photo_url" value="<%= member.photo_url || '' %>" placeholder="URL foto" style="flex: 1; padding: 0.75rem; border: 2px solid #ddd; border-radius: 8px;">
        <button type="button" onclick="openPhotoPicker()" class="btn">📸 Scegli da Cloudinary</button>
      </div>
      <% if (member.photo_url) { %>
        <img src="<%= member.photo_url %>" alt="Photo" style="max-width: 200px; margin-top: 1rem; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
      <% } %>
      <div id="photo-preview" style="margin-top: 1rem;"></div>
    </div>

    <!-- Contatti -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
      <div class="form-group">
        <label for="email" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Email</label>
        <input type="email" id="email" name="email" value="<%= member.email || '' %>" style="width: 100%; padding: 0.75rem; border: 2px solid #ddd; border-radius: 8px;">
        <small style="color: #666;">Email di contatto (opzionale)</small>
      </div>
      <div class="form-group">
        <label for="phone" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Telefono</label>
        <input type="tel" id="phone" name="phone" value="<%= member.phone || '' %>" style="width: 100%; padding: 0.75rem; border: 2px solid #ddd; border-radius: 8px;">
        <small style="color: #666;">Numero di telefono (opzionale)</small>
      </div>
    </div>

    <!-- Sort Order -->
    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label for="sort_order" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Ordinamento</label>
      <input type="number" id="sort_order" name="sort_order" value="<%= member.sort_order || 0 %>" min="0" style="width: 100%; padding: 0.75rem; border: 2px solid #ddd; border-radius: 8px;">
      <small style="color: #666;">Numero più basso = appare prima (0 = primo)</small>
    </div>

    <!-- Flags -->
    <div style="display: flex; gap: 2rem; margin-bottom: 1.5rem; padding: 1rem; background: #f9f9f9; border-radius: 8px;">
      <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
        <input type="checkbox" name="is_active" value="1" <%= member.is_active ? 'checked' : '' %>>
        <span>✅ Attivo</span>
      </label>
    </div>

    <!-- Actions -->
    <div style="display: flex; gap: 1rem; margin-top: 2rem;">
      <button type="submit" class="btn btn-primary" style="padding: 1rem 2rem; font-size: 1rem;">
        <%= action === 'create' ? 'Aggiungi Membro' : 'Salva Modifiche' %>
      </button>
      <a href="/admin/team" class="btn btn-secondary" style="padding: 1rem 2rem; font-size: 1rem;">Annulla</a>
    </div>
  </form>
</div>

<!-- TinyMCE -->
<script src="/shared/vendor/tinymce/tinymce.min.js"></script>
<script src="/shared/config/editor-config.js"></script>

<!-- Cloudinary Widget -->
<script src="https://upload-widget.cloudinary.com/global/all.js"></script>
<script src="/shared/js/cloudinary-widget.js"></script>

<script>
  // Init TinyMCE
  if (window.SharedEditor) {
    window.SharedEditor.init('#bio', 'team', {
      getUploadOptions: () => ({
        preset: 'cororaro_team',
        folder: 'cororaro/team'
      })
    });
  }

  // Cloudinary Photo Picker
  function openPhotoPicker() {
    const config = {
      cloudName: '<%= process.env.CLOUDINARY_CLOUD_NAME || "your-cloud-name" %>',
      uploadPreset: 'cororaro_team',
      folder: 'cororaro/team'
    };

    if (typeof openCloudinaryPicker !== 'undefined') {
      openCloudinaryPicker(config, (result) => {
        document.getElementById('photo_url').value = result.url;
        document.getElementById('photo-preview').innerHTML =
          `<img src="${result.url}" alt="Photo" style="max-width: 200px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">`;
      }, {
        multiple: false,
        cropping: true,
        croppingAspectRatio: 1
      });
    } else {
      alert('Cloudinary widget non disponibile');
    }
  }
</script>
