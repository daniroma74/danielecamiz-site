<!-- Save Bar -->
<div class="save-bar">
  <button type="button" class="btn btn-outline" onclick="window.location.reload()">
    🔄 Annulla
  </button>
  <button type="button" class="btn btn-success" id="save-btn">
    💾 Salva Modifiche
  </button>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Inizializza TinyMCE per i campi HTML
  if (typeof tinymce !== 'undefined') {
    tinymce.init({
      selector: '.tinymce-editor',
      height: 300,
      menubar: false,
      plugins: 'link lists',
      toolbar: 'undo redo | formatselect | bold italic | alignleft aligncenter alignright | bullist numlist | link',
      language: 'it',
      language_url: '/shared/vendor/tinymce/langs/it.js',
      license_key: 'gpl',  // GPL license
      content_css: false,
      skin: false,
      branding: false,
      promotion: false,
      setup: function(editor) {
        editor.on('change', function() {
          editor.save();
        });
      }
    });
  } else {
    console.warn('⚠️ TinyMCE non caricato');
  }

  // CloudinaryManager per upload immagini
  document.querySelectorAll('.cloudinary-upload-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const targetId = this.getAttribute('data-target');
      const inputField = document.getElementById(targetId);

      if (typeof CloudinaryManager === 'undefined') {
        alert('❌ CloudinaryManager non disponibile.');
        return;
      }

      CloudinaryManager.showImageDialog(function(imageUrl, publicId) {
        inputField.value = imageUrl;

        // Aggiorna o crea preview
        let preview = document.getElementById(targetId + '_preview');
        if (preview) {
          preview.src = imageUrl;
        } else {
          preview = document.createElement('img');
          preview.id = targetId + '_preview';
          preview.src = imageUrl;
          preview.alt = 'Preview';
          preview.className = 'image-preview';
          inputField.parentElement.parentElement.appendChild(preview);
        }

        btn.textContent = '📷 Cambia Immagine';
      }, {
        folder: 'danielecamiz',
        preset: 'icnt_settings'
      });
    });
  });

  // Salva impostazioni
  document.getElementById('save-btn').addEventListener('click', async function() {
    const btn = this;
    const alert = document.getElementById('alert');

    // Sincronizza TinyMCE prima del submit
    if (typeof tinymce !== 'undefined') {
      tinymce.triggerSave();
    }

    // Raccogli tutti i valori del form
    const formData = new FormData(document.getElementById('settings-form'));
    const data = Object.fromEntries(formData.entries());

    btn.disabled = true;
    btn.textContent = '⏳ Salvataggio...';

    try {
      const response = await fetch('/admin/settings', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
      });

      const result = await response.json();

      if (result.success) {
        alert.className = 'alert alert-success show';
        alert.textContent = result.message;
        setTimeout(() => alert.classList.remove('show'), 5000);
      } else {
        throw new Error(result.message);
      }
    } catch (error) {
      alert.className = 'alert alert-error show';
      alert.textContent = '❌ ' + error.message;
    } finally {
      btn.disabled = false;
      btn.textContent = '💾 Salva Modifiche';
    }
  });
});
</script>

