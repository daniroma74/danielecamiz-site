<%- include('../partials/header') %>

<div class="admin-container">
  <div class="section-header">
    <h2>Impostazioni Sito</h2>
    <p>Modifica tutti i contenuti del sito Orchestra ICNT</p>
  </div>

  <!-- Alert messages -->
  <div id="alert" class="alert"></div>

  <form id="settings-form">
    <!-- HERO SECTION -->
    <div class="card">
      <div class="card-header">
        <h3>🎯 Hero Section (Intestazione)</h3>
      </div>

      <div class="form-group">
        <label for="hero_background">
          🖼️ Immagine di Sfondo
          <span class="hint">L'immagine principale visualizzata in alto nella homepage</span>
        </label>
        <div class="image-upload-container">
          <input
            type="text"
            id="hero_background"
            name="hero_background"
            value="<%= sections.hero.find(s => s.setting_key === 'hero_background')?.setting_value || '' %>"
            class="form-control"
            readonly
            placeholder="Nessuna immagine caricata"
          >
          <button type="button" class="btn btn-primary cloudinary-upload-btn" data-target="hero_background">
            📷 Carica Immagine
          </button>
        </div>
        <% if (sections.hero.find(s => s.setting_key === 'hero_background')?.setting_value) { %>
          <img src="<%= sections.hero.find(s => s.setting_key === 'hero_background').setting_value %>"
               alt="Preview" class="image-preview" id="hero_background_preview">
        <% } %>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label for="hero_title">
            📌 Titolo Principale
            <span class="hint">Es: "Orchestra ICNT"</span>
          </label>
          <input
            type="text"
            id="hero_title"
            name="hero_title"
            value="<%= sections.hero.find(s => s.setting_key === 'hero_title')?.setting_value || '' %>"
            class="form-control"
          >
        </div>

        <div class="form-group">
          <label for="hero_subtitle">
            📄 Sottotitolo
            <span class="hint">Es: "Musica Sinfonica a Roma"</span>
          </label>
          <input
            type="text"
            id="hero_subtitle"
            name="hero_subtitle"
            value="<%= sections.hero.find(s => s.setting_key === 'hero_subtitle')?.setting_value || '' %>"
            class="form-control"
          >
        </div>
      </div>

      <div class="form-group">
        <label for="hero_claim">
          💬 Frase Claim
          <span class="hint">La frase principale che descrive l'orchestra</span>
        </label>
        <textarea
          id="hero_claim"
          name="hero_claim"
          class="form-control tinymce"
        ><%= sections.hero.find(s => s.setting_key === 'hero_claim')?.setting_value || '' %></textarea>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label for="hero_cta_primary_text">
            🎯 Testo Pulsante Primario
            <span class="hint">Es: "Prossimi Concerti"</span>
          </label>
          <input
            type="text"
            id="hero_cta_primary_text"
            name="hero_cta_primary_text"
            value="<%= sections.hero.find(s => s.setting_key === 'hero_cta_primary_text')?.setting_value || '' %>"
            class="form-control"
          >
        </div>

        <div class="form-group">
          <label for="hero_cta_secondary_text">
            🔗 Testo Pulsante Secondario
            <span class="hint">Es: "Scopri di più"</span>
          </label>
          <input
            type="text"
            id="hero_cta_secondary_text"
            name="hero_cta_secondary_text"
            value="<%= sections.hero.find(s => s.setting_key === 'hero_cta_secondary_text')?.setting_value || '' %>"
            class="form-control"
          >
        </div>
      </div>
    </div>

    <!-- CHI SIAMO SECTION -->
    <div class="card">
      <div class="card-header">
        <h3>👥 Chi Siamo</h3>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label for="about_label">
            🏷️ Etichetta Sezione
            <span class="hint">Es: "La nostra storia"</span>
          </label>
          <input
            type="text"
            id="about_label"
            name="about_label"
            value="<%= sections.about.find(s => s.setting_key === 'about_label')?.setting_value || '' %>"
            class="form-control"
          >
        </div>

        <div class="form-group">
          <label for="about_title">
            📌 Titolo Sezione
            <span class="hint">Es: "Chi Siamo"</span>
          </label>
          <input
            type="text"
            id="about_title"
            name="about_title"
            value="<%= sections.about.find(s => s.setting_key === 'about_title')?.setting_value || '' %>"
            class="form-control"
          >
        </div>
      </div>

      <div class="form-group">
        <label for="about_image">
          🖼️ Foto del Gruppo
          <span class="hint">Immagine dell'orchestra</span>
        </label>
        <div class="image-upload-container">
          <input
            type="text"
            id="about_image"
            name="about_image"
            value="<%= sections.about.find(s => s.setting_key === 'about_image')?.setting_value || '' %>"
            class="form-control"
            readonly
            placeholder="Nessuna immagine caricata"
          >
          <button type="button" class="btn btn-primary cloudinary-upload-btn" data-target="about_image">
            📷 Carica Immagine
          </button>
        </div>
        <% if (sections.about.find(s => s.setting_key === 'about_image')?.setting_value) { %>
          <img src="<%= sections.about.find(s => s.setting_key === 'about_image').setting_value %>"
               alt="Preview" class="image-preview" id="about_image_preview">
        <% } %>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label for="about_badge_number">
            🔢 Badge Numero
            <span class="hint">Es: "50+"</span>
          </label>
          <input
            type="text"
            id="about_badge_number"
            name="about_badge_number"
            value="<%= sections.about.find(s => s.setting_key === 'about_badge_number')?.setting_value || '' %>"
            class="form-control"
          >
        </div>

        <div class="form-group">
          <label for="about_badge_label">
            🏷️ Badge Etichetta
            <span class="hint">Es: "Musicisti"</span>
          </label>
          <input
            type="text"
            id="about_badge_label"
            name="about_badge_label"
            value="<%= sections.about.find(s => s.setting_key === 'about_badge_label')?.setting_value || '' %>"
            class="form-control"
          >
        </div>
      </div>

      <div class="form-group">
        <label for="about_intro">
          📝 Testo Introduttivo
          <span class="hint">Il primo paragrafo della sezione Chi Siamo (con formattazione)</span>
        </label>
        <textarea
          id="about_intro"
          name="about_intro"
          class="form-control tinymce-editor"
        ><%= sections.about.find(s => s.setting_key === 'about_intro')?.setting_value || '' %></textarea>
      </div>

      <div class="form-group">
        <label for="about_description">
          📖 Descrizione Completa
          <span class="hint">Il secondo paragrafo con descrizione dettagliata (con formattazione)</span>
        </label>
        <textarea
          id="about_description"
          name="about_description"
          class="form-control tinymce-editor"
        ><%= sections.about.find(s => s.setting_key === 'about_description')?.setting_value || '' %></textarea>
      </div>

      <!-- Features -->
      <h4 style="margin: 2rem 0 1rem; font-size: 1rem; font-weight: 600; color: var(--gray-700);">
        ⭐ Caratteristiche (3 box sotto la descrizione)
      </h4>

      <div class="grid-2">
        <div class="form-group">
          <label for="about_feature_1_icon">
            Feature 1 - Icona
            <span class="hint">Emoji, es: 🎵</span>
          </label>
          <input
            type="text"
            id="about_feature_1_icon"
            name="about_feature_1_icon"
            value="<%= sections.about.find(s => s.setting_key === 'about_feature_1_icon')?.setting_value || '' %>"
            class="form-control"
          >
        </div>

        <div class="form-group">
          <label for="about_feature_1_title">
            Feature 1 - Titolo
            <span class="hint">Es: "Repertorio Classico"</span>
          </label>
          <input
            type="text"
            id="about_feature_1_title"
            name="about_feature_1_title"
            value="<%= sections.about.find(s => s.setting_key === 'about_feature_1_title')?.setting_value || '' %>"
            class="form-control"
          >
        </div>
      </div>

      <div class="form-group">
        <label for="about_feature_1_text">
          Feature 1 - Testo
        </label>
        <textarea
          id="about_feature_1_text"
          name="about_feature_1_text"
          class="form-control tinymce"
        ><%= sections.about.find(s => s.setting_key === 'about_feature_1_text')?.setting_value || '' %></textarea>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label for="about_feature_2_icon">
            Feature 2 - Icona
          </label>
          <input
            type="text"
            id="about_feature_2_icon"
            name="about_feature_2_icon"
            value="<%= sections.about.find(s => s.setting_key === 'about_feature_2_icon')?.setting_value || '' %>"
            class="form-control"
          >
        </div>

        <div class="form-group">
          <label for="about_feature_2_title">
            Feature 2 - Titolo
          </label>
          <input
            type="text"
            id="about_feature_2_title"
            name="about_feature_2_title"
            value="<%= sections.about.find(s => s.setting_key === 'about_feature_2_title')?.setting_value || '' %>"
            class="form-control"
          >
        </div>
      </div>

      <div class="form-group">
        <label for="about_feature_2_text">
          Feature 2 - Testo
        </label>
        <textarea
          id="about_feature_2_text"
          name="about_feature_2_text"
          class="form-control tinymce"
        ><%= sections.about.find(s => s.setting_key === 'about_feature_2_text')?.setting_value || '' %></textarea>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label for="about_feature_3_icon">
            Feature 3 - Icona
          </label>
          <input
            type="text"
            id="about_feature_3_icon"
            name="about_feature_3_icon"
            value="<%= sections.about.find(s => s.setting_key === 'about_feature_3_icon')?.setting_value || '' %>"
            class="form-control"
          >
        </div>

        <div class="form-group">
          <label for="about_feature_3_title">
            Feature 3 - Titolo
          </label>
          <input
            type="text"
            id="about_feature_3_title"
            name="about_feature_3_title"
            value="<%= sections.about.find(s => s.setting_key === 'about_feature_3_title')?.setting_value || '' %>"
            class="form-control"
          >
        </div>
      </div>

      <div class="form-group">
        <label for="about_feature_3_text">
          Feature 3 - Testo
        </label>
        <textarea
          id="about_feature_3_text"
          name="about_feature_3_text"
          class="form-control tinymce"
        ><%= sections.about.find(s => s.setting_key === 'about_feature_3_text')?.setting_value || '' %></textarea>
      </div>
    </div>

    <!-- CONCERTI SECTION -->
    <div class="card">
      <div class="card-header">
        <h3>🎵 Sezione Concerti</h3>
      </div>

      <div class="alert alert-info" style="background: #dbeafe; color: #1e40af; border: 1px solid #93c5fd; display: block; margin-bottom: 1.5rem;">
        ℹ️ <strong>I concerti sono gestiti centralmente</strong> - Questa sezione controlla solo l'aspetto della pagina.
        I dati dei concerti provengono automaticamente dal database condiviso (concerts-admin).
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label for="concerts_label">
            🏷️ Etichetta Sezione
            <span class="hint">Es: "Stagione 2024/25"</span>
          </label>
          <input
            type="text"
            id="concerts_label"
            name="concerts_label"
            value="<%= sections.concerts.find(s => s.setting_key === 'concerts_label')?.setting_value || '' %>"
            class="form-control"
          >
        </div>

        <div class="form-group">
          <label for="concerts_title">
            📌 Titolo Sezione
            <span class="hint">Es: "Prossimi Concerti"</span>
          </label>
          <input
            type="text"
            id="concerts_title"
            name="concerts_title"
            value="<%= sections.concerts.find(s => s.setting_key === 'concerts_title')?.setting_value || '' %>"
            class="form-control"
          >
        </div>
      </div>

      <div class="form-group">
        <label for="concerts_subtitle">
          📄 Sottotitolo
          <span class="hint">Es: "Non perdere i nostri eventi musicali"</span>
        </label>
        <input
          type="text"
          id="concerts_subtitle"
          name="concerts_subtitle"
          value="<%= sections.concerts.find(s => s.setting_key === 'concerts_subtitle')?.setting_value || '' %>"
          class="form-control"
        >
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label for="concerts_cta_text">
            🔗 Testo Pulsante "Vedi tutta la stagione"
            <span class="hint">Es: "Vedi tutta la stagione"</span>
          </label>
          <input
            type="text"
            id="concerts_cta_text"
            name="concerts_cta_text"
            value="<%= sections.concerts.find(s => s.setting_key === 'concerts_cta_text')?.setting_value || '' %>"
            class="form-control"
          >
        </div>

        <div class="form-group">
          <label for="concerts_cta_link">
            🌐 Link Pulsante (URL completo)
            <span class="hint">Es: https://icnt.danielecamiz.com</span>
          </label>
          <input
            type="url"
            id="concerts_cta_link"
            name="concerts_cta_link"
            value="<%= sections.concerts.find(s => s.setting_key === 'concerts_cta_link')?.setting_value || '' %>"
            class="form-control"
            placeholder="https://icnt.danielecamiz.com"
          >
        </div>
      </div>
    </div>

    <!-- MEDIA SECTION -->
    <div class="card">
      <div class="card-header">
        <h3>📹 Sezione Media</h3>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label for="media_label">
            🏷️ Etichetta Sezione
            <span class="hint">Es: "Ascoltaci"</span>
          </label>
          <input
            type="text"
            id="media_label"
            name="media_label"
            value="<%= sections.media.find(s => s.setting_key === 'media_label')?.setting_value || '' %>"
            class="form-control"
          >
        </div>

        <div class="form-group">
          <label for="media_title">
            📌 Titolo Sezione
            <span class="hint">Es: "Video e Registrazioni"</span>
          </label>
          <input
            type="text"
            id="media_title"
            name="media_title"
            value="<%= sections.media.find(s => s.setting_key === 'media_title')?.setting_value || '' %>"
            class="form-control"
          >
        </div>
      </div>

      <div class="form-group">
        <label for="media_subtitle">
          📄 Sottotitolo
          <span class="hint">Es: "Scopri le nostre performance"</span>
        </label>
        <input
          type="text"
          id="media_subtitle"
          name="media_subtitle"
          value="<%= sections.media.find(s => s.setting_key === 'media_subtitle')?.setting_value || '' %>"
          class="form-control"
        >
      </div>

      <h4 style="margin: 2rem 0 1rem; font-size: 1rem; font-weight: 600; color: var(--gray-700);">
        🎥 Video YouTube (max 3)
      </h4>

      <!-- Playlist ID Configuration -->
      <div class="form-group" style="background: #f8f9fa; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
        <label for="media_youtube_playlist_id">
          🎬 ID Playlist YouTube (opzionale)
          <span class="hint">Lascia vuoto per caricare dal canale. Trova l'ID nell'URL: youtube.com/playlist?list=<strong>PLxxxxxx</strong></span>
        </label>
        <input
          type="text"
          id="media_youtube_playlist_id"
          name="media_youtube_playlist_id"
          value="<%= sections.media.find(s => s.setting_key === 'media_youtube_playlist_id')?.setting_value || '' %>"
          class="form-control"
          placeholder="PLxxxxxxxxxxxxxxxxxxxxxx"
        >
      </div>

      <% for (let i = 1; i <= 3; i++) { %>
      <%
        const videoMode = sections.media.find(s => s.setting_key === `media_video_${i}_mode`)?.setting_value || 'manual';
        const videoUrl = sections.media.find(s => s.setting_key === `media_video_${i}_url`)?.setting_value || '';
        const videoTitle = sections.media.find(s => s.setting_key === `media_video_${i}_title`)?.setting_value || '';
      %>
      <!-- Video <%= i %> -->
      <div style="border: 1px solid #e0e0e0; padding: 1.5rem; border-radius: 8px; margin-bottom: 1.5rem;">
        <h5 style="margin: 0 0 1rem; font-size: 0.95rem; font-weight: 600; color: var(--gray-700);">
          Video <%= i %>
        </h5>

        <!-- Mode Toggle -->
        <div class="form-group">
          <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Modalità</label>
          <div style="display: flex; gap: 2rem;">
            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
              <input
                type="radio"
                name="media_video_<%= i %>_mode"
                value="auto"
                <%= videoMode === 'auto' ? 'checked' : '' %>
                onchange="toggleVideoMode(<%= i %>, 'auto')"
              >
              <span>🤖 Automatico (da playlist/canale)</span>
            </label>
            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
              <input
                type="radio"
                name="media_video_<%= i %>_mode"
                value="manual"
                <%= videoMode === 'manual' ? 'checked' : '' %>
                onchange="toggleVideoMode(<%= i %>, 'manual')"
              >
              <span>✋ Manuale (URL personalizzato)</span>
            </label>
          </div>
        </div>

        <!-- Manual Fields (shown only if mode=manual) -->
        <div id="video_<%= i %>_manual_fields" style="<%= videoMode === 'auto' ? 'display: none;' : '' %>">
          <div class="grid-2">
            <div class="form-group">
              <label for="media_video_<%= i %>_url">
                URL YouTube
                <span class="hint">URL completo del video</span>
              </label>
              <input
                type="url"
                id="media_video_<%= i %>_url"
                name="media_video_<%= i %>_url"
                value="<%= videoUrl %>"
                class="form-control"
                placeholder="https://www.youtube.com/watch?v=..."
              >
            </div>
            <div class="form-group">
              <label for="media_video_<%= i %>_title">
                Titolo
                <span class="hint">Titolo descrittivo</span>
              </label>
              <input
                type="text"
                id="media_video_<%= i %>_title"
                name="media_video_<%= i %>_title"
                value="<%= videoTitle %>"
                class="form-control"
                placeholder="Es: Concerto di Natale 2024"
              >
            </div>
          </div>
        </div>

        <!-- Auto Mode Info -->
        <div id="video_<%= i %>_auto_info" style="<%= videoMode === 'manual' ? 'display: none;' : '' %>">
          <p style="font-size: 0.875rem; color: #666; background: #e8f4fd; padding: 0.75rem; border-radius: 6px; margin: 0;">
            ℹ️ Video <%= i %> sarà caricato automaticamente dalla posizione #<%= i %> della playlist (o dal canale se non configurata).
          </p>
        </div>
      </div>
      <% } %>

      <script>
      function toggleVideoMode(videoNum, mode) {
        const manualFields = document.getElementById(`video_${videoNum}_manual_fields`);
        const autoInfo = document.getElementById(`video_${videoNum}_auto_info`);

        if (mode === 'auto') {
          manualFields.style.display = 'none';
          autoInfo.style.display = 'block';
        } else {
          manualFields.style.display = 'block';
          autoInfo.style.display = 'none';
        }
      }
      </script>
    </div>

    <!-- DIRETTORE SECTION -->
    <div class="card">
      <div class="card-header">
        <h3>🎼 Il Direttore</h3>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label for="director_name">
            👤 Nome Completo
            <span class="hint">Nome e cognome del direttore</span>
          </label>
          <input
            type="text"
            id="director_name"
            name="director_name"
            value="<%= sections.director.find(s => s.setting_key === 'director_name')?.setting_value || '' %>"
            class="form-control"
            placeholder="Es: Daniele Camiz"
          >
        </div>

        <div class="form-group">
          <label for="director_title">
            🎯 Titolo/Ruolo
            <span class="hint">Es: Direttore d'Orchestra</span>
          </label>
          <input
            type="text"
            id="director_title"
            name="director_title"
            value="<%= sections.director.find(s => s.setting_key === 'director_title')?.setting_value || '' %>"
            class="form-control"
            placeholder="Es: Direttore d'Orchestra"
          >
        </div>
      </div>

      <div class="form-group">
        <label for="director_photo">
          📸 Foto Profilo
          <span class="hint">Cloudinary ID dell'immagine (verrà ritagliata in cerchio)</span>
        </label>
        <div class="image-upload-container">
          <input
            type="text"
            id="director_photo"
            name="director_photo"
            value="<%= sections.director.find(s => s.setting_key === 'director_photo')?.setting_value || '' %>"
            class="form-control"
            readonly
            placeholder="Nessuna immagine caricata"
          >
          <button type="button" class="btn btn-primary cloudinary-upload-btn" data-target="director_photo">
            📷 Carica Immagine
          </button>
        </div>
        <% if (sections.director.find(s => s.setting_key === 'director_photo')?.setting_value) { %>
          <img src="https://res.cloudinary.com/dnwhnz2xy/image/upload/c_fill,w_200,h_200,g_face/<%= sections.director.find(s => s.setting_key === 'director_photo').setting_value %>"
               alt="Preview" class="image-preview" id="director_photo_preview">
        <% } %>
      </div>

      <div class="form-group">
        <label for="director_quote">
          💬 Citazione
          <span class="hint">Una frase rappresentativa (opzionale)</span>
        </label>
        <input
          type="text"
          id="director_quote"
          name="director_quote"
          value="<%= sections.director.find(s => s.setting_key === 'director_quote')?.setting_value || '' %>"
          class="form-control"
          placeholder='Es: "La musica è l\'arte più diretta, entra nell\'orecchio e va al cuore"'
        >
      </div>

      <div class="form-group">
        <label for="director_bio">
          📝 Biografia
          <span class="hint">Biografia completa (supporta HTML)</span>
        </label>
        <textarea
          id="director_bio"
          name="director_bio"
          class="form-control tinymce"
          rows="8"
        ><%= sections.director.find(s => s.setting_key === 'director_bio')?.setting_value || '' %></textarea>
      </div>
    </div>

    <!-- CONTATTI SECTION -->
