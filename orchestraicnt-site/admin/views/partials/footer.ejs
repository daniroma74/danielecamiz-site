<!-- Cloudinary Manager (from shared) -->
<script src="/shared/cloudinary-manager/client.js"></script>
<script>
  // Inizializza CloudinaryManager
  if (typeof CloudinaryManager !== 'undefined') {
    CloudinaryManager.init({
      cloudName: '<%= process.env.CLOUDINARY_CLOUD_NAME %>',
      defaultFolder: 'danielecamiz',
      defaultPreset: 'icnt_general',
      apiPrefix: '/api/cloudinary'
    });
    console.log('DEBUG CloudinaryManager config:', {
      cloudName: '<%= process.env.CLOUDINARY_CLOUD_NAME %>',
      defaultFolder: 'danielecamiz',
      defaultPreset: 'icnt_general'
    });
  }
</script>

</body>
</html>
