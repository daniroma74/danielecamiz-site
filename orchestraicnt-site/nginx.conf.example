# ============================================
# SETUP INSTRUCTIONS
# ============================================

# 1. Copia questo file in sites-available:
#    sudo cp nginx.conf.example /etc/nginx/sites-available/orchestraicnt
#
# 2. Crea symlink in sites-enabled:
#    sudo ln -s /etc/nginx/sites-available/orchestraicnt /etc/nginx/sites-enabled/
#
# 3. Testa la configurazione:
#    sudo nginx -t
#
# 4. Ricarica Nginx:
#    sudo systemctl reload nginx
#
# 5. Setup SSL con Let's Encrypt:
#    sudo certbot --nginx -d orchestraicnt.danielecamiz.com
#
# 6. Verifica rinnovo automatico:
#    sudo certbot renew --dry-run
