# Server Configuration
PORT=4012
NODE_ENV=development

# Cloudinary Configuration (for image uploads in admin)
# ⚠️ IMPORTANTE: Usa le STESSE credenziali dei siti admin (concerts-admin, gallery-admin, ecc.)
#                NON quelle di cororaro (ha account separato)
#                NON quelle di orchestraicnt-portal (ancora in sviluppo)
# Copia i valori da /home/daniele/danielecamiz-site/concerts-admin/.env
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email Configuration (per form contatti)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# CONTACT_EMAIL=info@orchestraicnt.it

# SendGrid (alternativa)
# SENDGRID_API_KEY=your-sendgrid-api-key

# Newsletter Service (opzionale)
# MAILCHIMP_API_KEY=your-mailchimp-key
# MAILCHIMP_LIST_ID=your-list-id

# Analytics (opzionale)
# GA_TRACKING_ID=G-XXXXXXXXXX

# Social Media
FACEBOOK_URL=https://facebook.com/orchestraicnt
INSTAGRAM_URL=https://instagram.com/orchestraicnt
YOUTUBE_URL=https://youtube.com/@orchestraicnt

# Portal Link
PORTAL_URL=https://portal.orchestraicnt.danielecamiz.com
