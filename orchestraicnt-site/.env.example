# Server Configuration
PORT=4012
NODE_ENV=development

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password
SESSION_SECRET=your-random-secret-key

# Cloudinary Configuration (for image uploads in admin)
# ⚠️ IMPORTANTE: Queste sono le credenziali CONDIVISE da cms/.env
#                Stessi valori usati da tutti gli admin (concerts-admin, gallery-admin, ecc.)
#                NON quelle di cororaro (ha account separato)
#                NON quelle di orchestraicnt-portal (ancora in sviluppo)
#
# L'account condiviso è configurato in: /home/daniele/danielecamiz-site/cms/.env
# Il CloudinaryManager backend usa automaticamente cms/.env
# Questi valori servono per il widget client-side nel footer
CLOUDINARY_CLOUD_NAME=dnwhnz2xy
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email Configuration (per form contatti)
# Il form usa sendmail del server (nessuna configurazione SMTP necessaria)
# Imposta l'email dove ricevere i messaggi dal form contatti:
CONTACT_EMAIL=orchestraicnt@danielecamiz.com

# Opzionale: configurazione SMTP (se vuoi usare SMTP invece di sendmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# SendGrid (alternativa)
# SENDGRID_API_KEY=your-sendgrid-api-key

# Newsletter Service (opzionale)
# MAILCHIMP_API_KEY=your-mailchimp-key
# MAILCHIMP_LIST_ID=your-list-id

# Analytics (opzionale)
# GA_TRACKING_ID=G-XXXXXXXXXX

# Social Media
FACEBOOK_URL=https://facebook.com/orchestraicnt
INSTAGRAM_URL=https://instagram.com/orchestraicnt
YOUTUBE_URL=https://youtube.com/@orchestraicnt

# Portal Link
PORTAL_URL=https://portal.orchestraicnt.danielecamiz.com
