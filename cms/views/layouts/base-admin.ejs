<!DOCTYPE html>
<html lang="<%= lang || 'it' %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= (pageMeta && pageMeta.title) ? pageMeta.title : 'Admin' %></title>
  <meta name="description" content="<%= (pageMeta && pageMeta.description) ? pageMeta.description : '' %>" />
  <% (pageStyles || []).forEach(href => { %>
    <link rel="stylesheet" href="<%= href %>" />
  <% }) %>
</head>
<body class="admin-body">
  <div id="admin_app">
    <%- include('../partials/admin/header') %>
    <div class="admin-shell">
      <aside class="admin-sidebar">
        <%- include('../partials/admin/sidebar') %>
      </aside>
      <main class="admin-main">
        <%- include('../partials/admin/toolbar') %>
        <section class="admin-content">
          <%- body %>
        </section>
      </main>
    </div>
  </div>

  <%- include('../partials/admin/confirm-modal') %>
  <%- include('../partials/admin/toast') %>

  <% (pageScripts || []).forEach(src => { %>
    <script src="<%= src %>" defer></script>
  <% }) %>
</body>
</html>