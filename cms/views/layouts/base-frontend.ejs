<!DOCTYPE html>
<html lang="<%= lang || 'it' %>">
  <head>
    <%-
      // Head comune (meta, favicon, preload, css base)
      // I metadati provengono da res.locals (title, description, keywords, canonical, ogImage)
      include('../partials/frontend/head')
    %>

    <% /* --- Open Graph & Twitter meta (unified, 2025-ready) --- */
      const isArticle = (typeof post !== 'undefined' && post);
      const ogType    = isArticle ? 'article' : 'website';
      const ogLocale  = (lang === 'en') ? 'en_GB' : 'it_IT';
      const ogTitle   = title || '';
      const ogDesc    = description || '';
      const ogUrl     = canonical || '';
      const ogImg     = ogImage || '/img/icons/favicon-180.png';
      const postDate  = (isArticle && post.date) ? post.date : null;
      const postTags  = (isArticle && Array.isArray(post.tags)) ? post.tags : []; %>

    <meta property="og:type" content="<%= ogType %>">
    <meta property="og:locale" content="<%= ogLocale %>">
    <meta property="og:title" content="<%= ogTitle %>">
    <meta property="og:description" content="<%= ogDesc %>">
    <meta property="og:url" content="<%= ogUrl %>">
    <meta property="og:image" content="<%= ogImg %>">
    <% if (isArticle) { %>
      <% if (postDate) { %><meta property="article:published_time" content="<%= postDate %>"><% } %>
      <% postTags.forEach(function(tag){ %>
        <meta property="article:tag" content="<%= tag %>">
      <% }) %>
    <% } %>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= ogTitle %>">
    <meta name="twitter:description" content="<%= ogDesc %>">
    <meta name="twitter:image" content="<%= ogImg %>">

    <% /* Hreflang alternates for news-post (only if post + alternates present) */ %>
    <% if (isArticle && Array.isArray(alternates) && alternates.length) { %>
      <% alternates.forEach(function(a){ if (a && a.lang && a.url) { %>
        <link rel="alternate" hreflang="<%= a.lang %>" href="<%= a.url %>">
      <% } }) %>
    <% } %>

    <% /* Prev/Next for paginated lists (e.g., /news?pg=2) */ %>
    <% if (typeof pageMeta !== 'undefined' && pageMeta && (pageMeta.relPrev || pageMeta.relNext)) { %>
      <% if (pageMeta.relPrev) { %>
        <link rel="prev" href="<%= pageMeta.relPrev %>">
      <% } %>
      <% if (pageMeta.relNext) { %>
        <link rel="next" href="<%= pageMeta.relNext %>">
      <% } %>
    <% } %>

    <!-- CSS GLOBALI (brand, layout, componenti) con ordine garantito: components -> altri -> responsive (per ultimo) -->
    <%
      const inArr   = Array.isArray(cssGlobal) ? cssGlobal.filter(Boolean) : [];
      const isStr   = v => typeof v === 'string';
      const isComp  = h => isStr(h) && h.includes('/frontend/css/components/');
      const isResp  = h => isStr(h) && h.includes('/frontend/css/utils/responsive.css');

      const comps   = inArr.filter(isComp);
      const others  = inArr.filter(h => !isComp(h) && !isResp(h));
      // stampiamo responsive sempre per ultimo (se assente lo iniettiamo)
      const RESP    = '/frontend/css/utils/responsive.css';
    %>
    <% comps.forEach(href => { %>
      <link rel="stylesheet" href="<%= href %>?v=<%= Date.now() %>">
    <% }) %>
    <% others.forEach(href => { %>
      <link rel="stylesheet" href="<%= href %>?v=<%= Date.now() %>">
    <% }) %>
    <link rel="stylesheet" href="<%= RESP %>?v=<%= Date.now() %>"><!-- responsive.css sempre ultimo -->

    <!-- CLOSE BUTTON STANDARDIZED - SITE WIDE -->
    <link rel="stylesheet" href="/css/components/close-button-standard.css?v=<%= Date.now() %>">

    <!-- CSS PER-PAGINA (pageStyles preferito; compat: cssFiles) -->
    <%
      const __cssA = Array.isArray(pageStyles) ? pageStyles : [];
      const __cssB = Array.isArray(cssFiles)   ? cssFiles   : [];
      const __css  = Array.from(new Set([...__cssA, ...__cssB].filter(Boolean)));
      __css.forEach(function(href){
        const h = (typeof href === 'string' && href[0] !== '/') ? ('/css/' + href) : href;
    %>
      <link rel="stylesheet" href="<%= h %>">
    <% }); %>
    <!-- RSS feed (News) -->
    <link rel="alternate" type="application/rss+xml" title="News RSS" href="/news/feed.xml">

    <% /* Google Analytics 4 - Cookie Consent compliant */ %>
    <% if (process.env.GA4_MEASUREMENT_ID && process.env.GA4_MEASUREMENT_ID !== 'G-XXXXXXXXXX') { %>
    <script>
      // Initialize dataLayer
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      // Check cookie consent
      const cookieConsent = '<%= typeof cookieConsent !== "undefined" ? cookieConsent : "unknown" %>';
      const hasAnalyticsConsent = (cookieConsent === 'all' || cookieConsent === 'measurement' ||
                                   cookieConsent.includes?.('measurement'));

      // Only load GA4 if user consented to measurement cookies
      if (hasAnalyticsConsent) {
        // Load GA4 script
        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=<%= process.env.GA4_MEASUREMENT_ID %>';
        document.head.appendChild(script);

        // Configure GA4
        gtag('js', new Date());
        gtag('config', '<%= process.env.GA4_MEASUREMENT_ID %>', {
          page_path: window.location.pathname,
          page_title: document.title,
          page_language: '<%= lang || "it" %>',
          anonymize_ip: true, // GDPR compliance
          cookie_flags: 'SameSite=None;Secure'
        });

        console.log('[Analytics] GA4 initialized with consent');
      } else {
        console.log('[Analytics] GA4 not loaded - no measurement cookie consent');
      }
    </script>
    <% } %>
  </head>

  <body class="<%= bodyClass || '' %>">
    <%-
      // Navbar frontend
      include('../partials/frontend/navbar', { lang, labels })
    %>

    <main id="main_content" tabindex="-1">
      <%- body %>
    </main>

    <%-
      // Footer frontend
      include('../partials/frontend/footer', { lang, labels })
    %>

    <%-
      // Cookie banner (mostrato se non c'è consenso)
      include('../partials/frontend/cookie-banner', { lang, labels })
    %>

    <!-- JS GLOBALI -->
    <script src="/js/navbar.js?v=<%= Date.now() %>" defer></script>
    <script src="/js/modules/navbar/navbar-dropdown.js?v=<%= Date.now() %>" defer></script>
    <script src="/js/cookie-consent.js?v=<%= Date.now() %>" defer></script>

    <!-- JS PER-PAGINA (opzionali, dal controller) -->
    <% (pageScripts || []).forEach(src => {
         let s = (typeof src === 'string') ? src : '';
         if (s && s.charAt(0) !== '/') { s = '/js/' + s; }
    %>
      <script src="<%= s %>" type="module"></script>
    <% }) %>

    <!-- Service Worker Registration (PWA) -->
    <!-- DISABLED: blocca caricamento immagini da Cloudinary
    <script src="/js/sw-register.js?v=<%= Date.now() %>" defer></script>
    -->
  </body>
</html>