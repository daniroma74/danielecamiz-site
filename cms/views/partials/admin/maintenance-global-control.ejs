<form id="maintenance-global-form">
  <label>
    <input type="checkbox" id="maintenance-global-toggle" />
    Modalità manutenzione globale (tutto il sito offline)
  </label>
  <button type="submit">Salva impostazione</button>
</form>

<script>
  // Carica stato corrente
  async function loadGlobalMaintenance() {
    try {
      const res = await fetch('/api/maintenance/global');
      const data = await res.json();
      document.getElementById('maintenance-global-toggle').checked = data.enabled;
    } catch (e) {
      alert('Errore caricando stato manutenzione globale');
    }
  }

  // Salva stato
  document.getElementById('maintenance-global-form').addEventListener('submit', async e => {
    e.preventDefault();
    const enabled = document.getElementById('maintenance-global-toggle').checked;
    try {
      const res = await fetch('/api/maintenance/global', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ enabled })
      });
      if (res.ok) alert('Impostazione salvata');
      else alert('Errore nel salvataggio');
    } catch {
      alert('Errore di rete');
    }
  });

  loadGlobalMaintenance();
</script>