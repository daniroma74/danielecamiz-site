<div id="manutenzione-status-box" style="margin-bottom: 1rem; font-weight: bold;"></div>
<script>
  async function aggiornaStatoManutenzione() {
    // Stato globale
    const global = await fetch('/api/maintenance/global', { credentials: 'include' }).then(r => r.json());
    let html = `<b>Manutenzione globale:</b> ${global.enabled ? '🟠 ATTIVA' : '🟢 DISATTIVA'}<br><ul>`;

    const pagine = ['concerti', 'bio', 'contatti', 'galleria', 'video', 'repertorio', 'press'];
    for (const pagina of pagine) {
      const stato = await fetch(`/api/maintenance/pages/${pagina}`, { credentials: 'include' }).then(r => r.json());
      html += `<li>${pagina}: ${stato.enabled ? '🟠 ATTIVA' : '🟢 DISATTIVA'}</li>`;
    }
    html += '</ul>';

    document.getElementById('manutenzione-status-box').innerHTML = html;
  }
  aggiornaStatoManutenzione();
</script>