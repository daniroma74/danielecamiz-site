<div id="confirm_modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="confirm_title">
  <div class="modal-dialog">
    <h3 id="confirm_title" class="modal-title">Confermi?</h3>
    <p id="confirm_message" class="modal-message"></p>
    <div class="modal-actions">
      <button type="button" class="btn btn-secondary" data-confirm="no">Annulla</button>
      <button type="button" class="btn btn-primary" data-confirm="yes">Conferma</button>
    </div>
  </div>
</div>