<style>
  .maintenance-page {
    background: #222;
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
    color: #ffd700;
    font-family: 'Cormorant Garamond', serif;
  }
  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: bold;
  }
  .status-indicator .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
  }
  .status-online {
    background-color: #4caf50;
  }
  .status-maintenance {
    background-color: #ff9800;
  }
</style>

<div class="maintenance-page">
  <p>La pagina <strong><%= pageName %></strong> è</p>
  <div id="status-container" class="status-indicator">
    <span class="dot status-online"></span>
    <span>Caricamento stato...</span>
  </div>
</div>

<script>
  const pageName = "<%= pageName %>";
  const statusContainer = document.getElementById('status-container');

  async function loadPageMaintenanceStatus() {
    try {
      const res = await fetch(`/api/maintenance/pages/${pageName}`);
      const data = await res.json();

      statusContainer.innerHTML = `
        <span class="dot ${data.enabled ? 'status-maintenance' : 'status-online'}"></span>
        <span>${data.enabled ? 'in manutenzione' : 'online'}</span>
      `;
    } catch {
      statusContainer.innerHTML = `<span>Errore caricando stato</span>`;
    }
  }

  loadPageMaintenanceStatus();
</script>