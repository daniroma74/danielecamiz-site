<nav class="navbar navbar--fixed" id="site_navbar" role="navigation" aria-label="<%= t('navbar.menu') %>">
  <div class="nav-left">
    <a href="/"
       class="logo"
       id="navbar_nav_home"
       role="menuitem"
       tabindex="0">
      <%= t('navbar.nav_home') %>
    </a>
  </div>

  <!-- Mobile toggle (CSS-only, no JS required). Hidden off-screen by CSS in navbar.css -->
  <input id="nav_toggle"
         class="nav-toggle"
         type="checkbox"
         aria-hidden="true">

  <div class="nav-center">
    <ul id="main_menu" class="menu" role="menubar">
      <% const items = [
           { path: '/bio',        key: 'navbar.nav_bio' },
           { path: '/concerts',   key: 'navbar.nav_concerts' },
           {
             path: '/gallery',
             key: 'navbar.nav_gallery',
             dropdown: [
               { path: '/gallery#category_concert', label: 'Concerto' },
               { path: '/gallery#category_official', label: 'Foto ufficiali' },
               { path: '/gallery#category_rehearsal', label: 'In prova' }
             ]
           },
           { path: '/press',      key: 'navbar.nav_press' },
           { path: '/video',      key: 'navbar.nav_video' },
           { path: '/repertoire', key: 'navbar.nav_repertoire' },
           { path: 'https://contact.danielecamiz.com', key: 'navbar.nav_contact', external: true },
           { path: '/news',       key: 'navbar.nav_news' }
         ];
      %>
      <% items.forEach(item => { %>
        <li role="none" <%= item.dropdown ? 'class="nav-item-dropdown"' : '' %>>
          <% if (item.dropdown) { %>
            <button class="nav-link nav-dropdown-toggle"
                    role="menuitem"
                    tabindex="-1"
                    aria-haspopup="true"
                    aria-expanded="false">
              <%= t(item.key) %>
              <i class="fas fa-chevron-down"></i>
            </button>
            <ul class="nav-dropdown-menu" role="menu">
              <li role="none">
                <a href="<%= item.path %>"
                   role="menuitem"
                   class="nav-dropdown-item">
                  <%= t(item.key + '_all') || 'Tutte le gallerie' %>
                </a>
              </li>
              <% item.dropdown.forEach(sub => { %>
                <li role="none">
                  <a href="<%= sub.path %>"
                     role="menuitem"
                     class="nav-dropdown-item">
                    <%= sub.label %>
                  </a>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <a href="<%= item.path %>"
               role="menuitem"
               tabindex="-1"
               class="nav-link"
               <% if (item.external) { %>target="_blank" rel="noopener noreferrer"<% } %>>
              <%= t(item.key) %>
            </a>
          <% } %>
        </li>
      <% }) %>
    </ul>
  </div>

  <div class="nav-right">
    <div id="language_switcher" class="lang-switch" role="radiogroup" aria-label="<%= t('navbar.switch_language') %>">
      <!-- IT -->
      <button id="btn_it"
              type="button"
              data-lang="it"
              role="radio"
              aria-checked="<%= lang === 'it' %>"
              tabindex="<%= lang === 'it' ? 0 : -1 %>">
        <%= t('navbar.language_it') %>
      </button>

      <!-- EN -->
      <button id="btn_en"
              type="button"
              data-lang="en"
              role="radio"
              aria-checked="<%= lang === 'en' %>"
              tabindex="<%= lang === 'en' ? 0 : -1 %>">
        <%= t('navbar.language_en') %>
      </button>
    </div>

    <!-- Hamburger is a label tied to #nav_toggle for CSS-only toggle on mobile -->
    <label id="hamburger"
           for="nav_toggle"
           class="hamburger"
           aria-label="<%= t('navbar.menu') %>"
           aria-controls="main_menu"
           role="button">
      <span></span><span></span><span></span>
    </label>
  </div>
</nav>
