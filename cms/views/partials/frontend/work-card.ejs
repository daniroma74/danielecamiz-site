<%
/* Partial: work-card.ejs
   Props richiesti: work
   Rendering: card moderna per brano musicale con compositore, categoria, media
*/
const w = work || {};
const composerName = w.composer_name || w.composer || '';
const categoryName = w.category_name || w.category || '';
const hasMedia = !!(w.media_video || w.media_audio);
%>
<article class="work-card" data-composer="<%= composerName %>" data-category="<%= categoryName %>">
  <div class="work-card__header">
    <h3 class="work-card__title"><%= w.title || 'Untitled' %></h3>
    <% if (w.subtitle) { %>
      <p class="work-card__subtitle"><%= w.subtitle %></p>
    <% } %>
  </div>

  <div class="work-card__meta">
    <% if (composerName) { %>
      <div class="work-card__meta-item work-card__composer">
        <i class="fas fa-user-tie"></i>
        <span><%= composerName %></span>
      </div>
    <% } %>

    <% if (categoryName) { %>
      <div class="work-card__meta-item work-card__category">
        <i class="fas fa-folder"></i>
        <span><%= categoryName %></span>
      </div>
    <% } %>

    <% if (w.catalogue) { %>
      <div class="work-card__meta-item work-card__catalogue">
        <i class="fas fa-barcode"></i>
        <span><%= w.catalogue %></span>
      </div>
    <% } %>

    <% if (w.work_key) { %>
      <div class="work-card__meta-item work-card__key">
        <i class="fas fa-music"></i>
        <span><%= w.work_key %></span>
      </div>
    <% } %>

    <% if (w.year) { %>
      <div class="work-card__meta-item work-card__year">
        <i class="fas fa-calendar"></i>
        <span><%= w.year %></span>
      </div>
    <% } %>
  </div>

  <% if (hasMedia) { %>
    <div class="work-card__media">
      <% if (w.media_video) { %>
        <a href="<%= w.media_video %>" target="_blank" rel="noopener noreferrer" class="work-card__media-link work-card__media-link--video">
          <i class="fab fa-youtube"></i>
          <span><%= (lang === 'en') ? 'Video' : 'Video' %></span>
        </a>
      <% } %>
      <% if (w.media_audio) { %>
        <a href="<%= w.media_audio %>" target="_blank" rel="noopener noreferrer" class="work-card__media-link work-card__media-link--audio">
          <i class="fas fa-headphones"></i>
          <span><%= (lang === 'en') ? 'Audio' : 'Audio' %></span>
        </a>
      <% } %>
    </div>
  <% } %>

  <% if (w.notes_it || w.notes_en) { %>
    <div class="work-card__notes">
      <%= (lang === 'en' && w.notes_en) ? w.notes_en : (w.notes_it || '') %>
    </div>
  <% } %>
</article>
