<% /* news/card.ejs – expects: post, lang, (optional) href */ %>
<%
  function esc(s){
    return String(s||'').replace(/[&<>"']/g, (ch) => ({
      '&':'&amp;',
      '<':'&lt;',
      '>':'&gt;',
      '"':'&quot;',
      "'":'&#39;'
    }[ch]));
  }
  function fmtDate(d){ try { return new Date(d).toLocaleDateString((lang==='en'?'en-GB':'it-IT'), { year:'numeric', month:'long', day:'numeric' }); } catch(e){ return d||''; } }
  function snakeId(str){
    return String(str||'')
      .normalize('NFKD').replace(/[\u0300-\u036f]/g,'')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g,'_')
      .replace(/^_+|_+$/g,'')
      .replace(/_+/g,'_');
  }
  const _href  = (typeof href === 'string' && href) ? href : `/news/${post?.id}`;
  const _tags  = Array.isArray(post?.tags) ? post.tags : [];
  const _cover = post?.cover_url || post?.image || (post?.seo ? post.seo.og_image : '') || '';
  const _alt   = post?.image_alt ? post.image_alt : (post?.title || '');
  const COVER_W = 1200;
  const COVER_H = 675;
  const _catId = post?.category_id || (post?.category ? snakeId(post.category) : '');

  // Prefer srcset provided by server (local responsive variants)
  const hasLocalSet = !!(post && post.image_srcset);
  let finalSrc     = hasLocalSet ? (post.image_src || _cover) : _cover;
  let finalSrcset  = hasLocalSet ? post.image_srcset : '';
  let finalSizes   = hasLocalSet ? (post.image_sizes || '(max-width: 600px) 100vw, (max-width: 1024px) 50vw, 33vw') : '';

  // Cloudinary-aware responsive variants (fallback if no local set)
  if (!hasLocalSet) {
    const isCloudinary = /res\.cloudinary\.com\//.test(String(_cover));
    function cl(u, w){
      try {
        const i = String(u).indexOf('/upload/');
        if (i === -1) return u; // not a standard Cloudinary delivery URL
        const before = u.slice(0, i + 8); // include '/upload/'
        const after  = u.slice(i + 8);
        return before + `f_auto,q_auto,w_${w}/` + after;
      } catch(e){ return u; }
    }
    if (isCloudinary) {
      finalSrcset = [480, 768, 1024, 1200].map(w => `${cl(_cover, w)} ${w}w`).join(', ');
      finalSizes  = '(max-width: 600px) 100vw, (max-width: 1024px) 50vw, 33vw';
    }
  }
%>
<li class="news-card" data-cat="<%= _catId %>" data-tags="<%= _tags.join('|') %>">
  <article class="news-card__body">
    <a class="news-card__media" href="<%= _href %>" aria-label="<%= esc(_alt) %>">
      <% if (post && post.image_lqip) { %>
        <img class="lqip" src="<%= post.image_lqip %>" alt="" aria-hidden="true" />
      <% } %>
      <% if (_cover) { %>
        <img
          src="<%= finalSrc %>"
          <% if (finalSrcset) { %>srcset="<%= finalSrcset %>" sizes="<%= finalSizes %>"<% } %>
          alt="<%= esc(_alt) %>"
          loading="lazy"
          decoding="async"
          width="<%= COVER_W %>"
          height="<%= COVER_H %>"
        />
      <% } else { %>
        <div class="news-card__media--placeholder" aria-hidden="true"></div>
      <% } %>
    </a>
    <div class="news-card__content">
      <h2 class="news-card__title"><a href="<%= _href %>"><%= post?.title %></a></h2>
      <div class="news-card__meta">
        <% if (post?.date) { %>
          <time datetime="<%= post.date %>"><%= fmtDate(post.date) %></time>
        <% } %>
        <% if (post?.reading_time) { %>
          · <span class="news-card__reading"><%= post.reading_time %> <%= (lang==='en') ? 'min read' : 'min di lettura' %></span>
        <% } %>
      </div>
      <% if (post?.excerpt) { %>
        <p class="news-card__excerpt"><%= post.excerpt %></p>
      <% } %>
      <% if (_tags.length) { %>
        <div class="news-card__tags">
          <% _tags.forEach(t => { %>
            <span class="tag"><%= t %></span>
          <% }) %>
        </div>
      <% } %>
      <p class="news-card__cta"><a class="link-more" href="<%= _href %>"><%= (lang==='en') ? 'Read more' : 'Leggi di più' %></a></p>
    </div>
  </article>
</li>