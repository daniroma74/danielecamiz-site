<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Concerto d'Autunno 2025 - Orchestra ICNT</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
      font-family: 'Segoe UI', Arial, sans-serif; 
      line-height: 1.6; 
      color: #333;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
    }
    .container { 
      max-width: 800px; 
      margin: 0 auto; 
      padding: 20px;
    }
    .card {
      background: white;
      border-radius: 20px;
      padding: 40px;
      margin: 20px 0;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }
    h1 { 
      color: #764ba2;
      margin-bottom: 10px;
      font-size: 2.5em;
    }
    .subtitle {
      color: #666;
      font-size: 1.2em;
      margin-bottom: 30px;
    }
    .info-grid {
      display: grid;
      gap: 20px;
      margin: 30px 0;
    }
    .info-item {
      padding: 15px;
      background: #f8f9fa;
      border-radius: 10px;
    }
    .info-label {
      font-weight: bold;
      color: #764ba2;
    }
    .form {
      margin-top: 40px;
      padding-top: 30px;
      border-top: 2px solid #eee;
    }
    input, button {
      width: 100%;
      padding: 15px;
      margin: 10px 0;
      border: 2px solid #ddd;
      border-radius: 8px;
      font-size: 16px;
    }
    button {
      background: #764ba2;
      color: white;
      border: none;
      cursor: pointer;
      font-weight: bold;
      transition: all 0.3s;
    }
    button:hover {
      background: #667eea;
      transform: translateY(-2px);
    }
    .program {
      margin: 30px 0;
      padding: 20px;
      background: #fafafa;
      border-left: 4px solid #764ba2;
    }
    .success {
      padding: 20px;
      background: #4caf50;
      color: white;
      border-radius: 8px;
      margin: 20px 0;
      display: none;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <h1>Concerto d'Autunno 2025</h1>
      <p class="subtitle">Orchestra ICNT</p>
      
      <div class="info-grid">
        <div class="info-item">
          <span class="info-label">📅 Data:</span> Sabato 27 settembre 2025, ore 20:00
        </div>
        <div class="info-item">
          <span class="info-label">📍 Luogo:</span> Chiesa Valdese di Piazza Cavour, Roma
        </div>
        <div class="info-item">
          <span class="info-label">🎫 Ingresso:</span> Libero con prenotazione consigliata
        </div>
      </div>
      
      <div class="program">
        <h3>Programma</h3>
        <p>• Marco Enrico Bossi - Concerto per organo e orchestra in la minore Op.100</p>
        <p>• Pëtr Il'ič Čajkovskij - Sinfonia n.6 in si minore "Patetica" Op.74</p>
        <br>
        <p><strong>Stefano Vasselli</strong>, organo</p>
        <p><strong>Daniele Camiz</strong>, direttore</p>
      </div>
      
      <div class="form">
        <h3>Prenota il tuo posto</h3>
        <div id="success" class="success">
          ✓ Prenotazione confermata! Ti abbiamo inviato una email di conferma.
        </div>
        <form id="bookingForm">
          <input type="text" id="nome" placeholder="Nome e Cognome" required>
          <input type="email" id="email" placeholder="Email" required>
          <input type="tel" id="telefono" placeholder="Telefono (opzionale)">
          <label>
            <input type="checkbox" id="newsletter">
            Desidero ricevere aggiornamenti sui prossimi concerti
          </label>
          <button type="submit">PRENOTA ORA</button>
        </form>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('bookingForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const data = {
        nome: document.getElementById('nome').value,
        email: document.getElementById('email').value,
        telefono: document.getElementById('telefono').value,
        newsletter: document.getElementById('newsletter').checked
      };
      
      try {
        const response = await fetch('/concerto-autunno/prenota', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        
        const result = await response.json();
        if (result.success) {
          document.getElementById('success').style.display = 'block';
          document.getElementById('bookingForm').reset();
        }
      } catch (error) {
        alert('Errore nella prenotazione. Riprova.');
      }
    });
  </script>
</body>
</html>