<%-
  // Attesi:
  //   isOverview: boolean - true se overview, false se subcategory
  //   subcategories: [{ id, title, description, url, icon, count }] (per overview)
  //   claimHTML: string (per photos)
  //   categories: [{ categoryKey, folder, title, cover, photos:[{src, alt, description}] }] (per photos)
  //   t(), lang in res.locals
-%>
<%
  const isOverviewMode = typeof isOverview !== 'undefined' ? isOverview : false;
  const subcats = (typeof subcategories !== 'undefined' && Array.isArray(subcategories)) ? subcategories : [];
  const list = (typeof categories !== 'undefined' && Array.isArray(categories)) ? categories : [];
  const _t = (k, def='') => { try { const v=(typeof t==='function'?t(k):''); return (v && v!==k) ? v : def; } catch { return def; } };
%>

<section id="gallery">
  <% if (isOverviewMode) { %>
    <!-- OVERVIEW MODE: Show subcategory cards -->
    <h1 id="gallery_title"><%= (lang==='en' ? 'Gallery' : 'Galleria') %></h1>
    <p id="gallery_claim" class="claim-text"><%= description || '' %></p>

    <% if (!subcats.length) { %>
      <p class="empty-state"><%= lang==='en' ? 'No galleries available.' : 'Nessuna galleria disponibile.' %></p>
    <% } %>

    <% if (subcats.length) { %>
      <div class="gallery-subcategories">
        <% subcats.forEach((sub) => { %>
          <a class="subcategory-card" href="<%= sub.url %>">
            <% if (sub.previewImages && sub.previewImages.length > 0) { %>
              <!-- Photo grid preview (3 images) -->
              <div class="subcategory-preview subcategory-preview--grid">
                <% sub.previewImages.forEach((img, idx) => { %>
                  <div class="preview-image preview-image--<%= idx + 1 %>">
                    <img src="<%= img %>" alt="<%= sub.title %>" loading="lazy">
                  </div>
                <% }) %>
              </div>
            <% } else if (sub.previewImage) { %>
              <!-- Single video preview -->
              <div class="subcategory-preview subcategory-preview--single">
                <img src="<%= sub.previewImage %>" alt="<%= sub.title %>" loading="lazy">
                <div class="preview-overlay">
                  <i class="fas fa-play-circle"></i>
                </div>
              </div>
            <% } else { %>
              <!-- Fallback icon -->
              <div class="subcategory-icon">
                <i class="fas <%= sub.icon %>"></i>
              </div>
            <% } %>
            <div class="subcategory-content">
              <h2 class="subcategory-title"><%= sub.title %></h2>
              <p class="subcategory-description"><%= sub.description %></p>
              <% if (sub.count > 0) { %>
                <span class="subcategory-count"><%= sub.count %></span>
              <% } %>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>

  <% } else { %>
    <!-- PHOTO GALLERY MODE: Show photo categories -->
    <h1 id="gallery_title"><%= title || _t('gallery.title', lang==='en' ? 'Photo gallery' : 'Galleria fotografica') %></h1>
    <p id="gallery_claim" class="claim-text"><%- claimHTML || '' %></p>

    <% if (!list.length) { %>
      <p class="empty-state"><%= lang==='en' ? 'No photos available.' : 'Nessuna foto disponibile.' %></p>
    <% } %>

  <% if (list.length) { %>
    <div class="gallery-covers">
      <% list.forEach((cat) => {
           const catId = `gallery_category_${cat.folder}`;
      %>
        <a
          class="cover-block"
          href="#<%= catId %>"
          data-target="<%= catId %>"
          aria-controls="<%= catId %>"
          aria-expanded="false"
          role="button">
          <% if (cat.cover) { %>
            <img
              src="<%= cat.cover %>"
              alt="<%= cat.title || _t('gallery.' + cat.categoryKey, '') %>"
              loading="lazy" />
          <% } %>
          <div class="cover-title"><%= _t('gallery.' + cat.categoryKey, cat.title || '') %></div>
        </a>
      <% }) %>
    </div>
  <% } %>

  <% list.forEach((cat) => {
       const catId = `gallery_category_${cat.folder}`;
  %>
    <section class="gallery-category" id="<%= catId %>">
      <!-- TITOLO SOTTOGALLERIA: nascosto finché la sezione non è aperta -->
      <h2 class="gallery-category-title" hidden style="display:none;">
        <%= _t('gallery.' + cat.categoryKey, cat.title || '') %>
      </h2>

      <!-- GRIGLIA: parte chiusa -->
      <div class="gallery-grid" data-collapsed="true" hidden style="display:none;">
        <% (cat.photos || []).forEach((p, idx) => { %>
          <figure class="gallery-photo">
            <img
              src="<%= p.src %>"
              alt="<%= p.alt || (cat.title || '') %>"
              loading="lazy"
              data-category="<%= cat.folder %>"
              data-index="<%= idx %>"
              onclick="openGalleryImage('<%= cat.folder %>', <%= idx %>)" />
            <% if (p.description) { %>
              <figcaption><%= p.description %></figcaption>
            <% } %>
          </figure>
        <% }) %>
      </div>
    </section>
  <% }) %>

  <!-- LIGHTBOX (only for photo mode) -->
  <% if (!isOverviewMode) { %>
    <div id="lightbox" role="dialog" aria-modal="true" tabindex="-1" aria-label="Image viewer">
      <button class="lightbox-close close-btn-standard" aria-label="Close" onclick="closeGallery()">×</button>
      <div class="lightbox-image-wrapper">
        <span class="lightbox-arrow left" onclick="prevGallery()" aria-label="Previous">‹</span>
        <img id="lightbox_img" alt="" />
        <span class="lightbox-arrow right" onclick="nextGallery()" aria-label="Next">›</span>
        <div class="lightbox-counter" id="lightbox_counter"></div>
      </div>
    </div>
  <% } %>
  <% } /* end else (photo mode) */ %>
</section>
