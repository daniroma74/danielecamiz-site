<%
  const _items = Array.isArray(items) ? items : [];
  const photoItems = _items.filter(i => i.item_type === 'photo');
  const videoItems = _items.filter(i => i.item_type === 'video');
  const audioItems = _items.filter(i => i.item_type === 'audio');
%>

<section id="gallery-detail" class="gallery-page">
  <div class="gallery-header">
    <a href="<%= backUrl %>" class="gallery-back-link">
      <i class="fas fa-arrow-left"></i>
      <span><%= lang === 'en' ? 'Back' : 'Indietro' %></span>
    </a>
    <h1 class="gallery-header__title"><%= collection.title %></h1>
    <% if (collection.description) { %>
      <p class="gallery-header__description"><%= collection.description %></p>
    <% } %>
  </div>

  <% if (!_items.length) { %>
    <div class="gallery-empty">
      <i class="fas fa-images"></i>
      <p><%= lang === 'en' ? 'No items in this collection yet' : 'Nessun elemento in questa collezione' %></p>
    </div>
  <% } %>

  <!-- PHOTO GRID -->
  <% if (photoItems.length) { %>
    <div class="gallery-items gallery-items--photos">
      <% photoItems.forEach((item, idx) => { %>
        <div class="gallery-item gallery-item--photo"
             data-index="<%= idx %>"
             data-full="<%= item.media?.full || '' %>"
             data-title="<%= item.title || '' %>"
             data-description="<%= item.description || '' %>">
          <img src="<%= item.media?.thumbnail || '' %>" alt="<%= item.alt || item.title || '' %>" loading="lazy" width="500" height="375">
          <% if (item.title) { %>
            <div class="gallery-item__overlay">
              <h4><%= item.title %></h4>
              <% if (item.credits) { %>
                <p class="gallery-item__credits"><%= item.credits %></p>
              <% } %>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>

    <!-- LIGHTBOX -->
    <div id="lightbox" class="lightbox">
      <button class="lightbox__close" aria-label="Close">×</button>
      <button class="lightbox__prev" aria-label="Previous">‹</button>
      <button class="lightbox__next" aria-label="Next">›</button>
      <div class="lightbox__content">
        <img id="lightbox-img" src="" alt="" loading="eager">
        <div id="lightbox-info" class="lightbox__info">
          <h3 id="lightbox-title"></h3>
          <p id="lightbox-description"></p>
        </div>
      </div>
      <div class="lightbox__counter">
        <span id="lightbox-current">1</span> / <span id="lightbox-total"><%= photoItems.length %></span>
      </div>
    </div>

    <!-- Lightbox Script -->
    <script>
      (function() {
        'use strict';

        console.log('[LIGHTBOX] Script loaded');

        let currentIndex = 0;
        let photos = [];
        let lightbox = null;

        function init() {
          console.log('[LIGHTBOX] Initializing...');

          lightbox = document.getElementById('lightbox');
          if (!lightbox) {
            console.error('[LIGHTBOX] Lightbox element not found!');
            return;
          }

          // Collect photo data from DOM
          const photoElements = document.querySelectorAll('.gallery-item--photo');
          console.log('[LIGHTBOX] Found photo elements:', photoElements.length);

          photos = Array.from(photoElements).map((el, idx) => ({
            index: idx,
            full: el.getAttribute('data-full') || '',
            title: el.getAttribute('data-title') || '',
            description: el.getAttribute('data-description') || ''
          }));

          console.log('[LIGHTBOX] Photos collected:', photos.length);

          if (photos.length === 0) {
            console.warn('[LIGHTBOX] No photos found');
            return;
          }

          // Update total count
          const totalEl = document.getElementById('lightbox-total');
          if (totalEl) totalEl.textContent = photos.length;

          // Event delegation on parent container
          const container = document.querySelector('.gallery-items--photos');
          if (container) {
            container.addEventListener('click', handlePhotoClick);
            console.log('[LIGHTBOX] Click listener attached to container');
          } else {
            console.error('[LIGHTBOX] Container not found!');
          }

          // Lightbox controls
          const closeBtn = lightbox.querySelector('.lightbox__close');
          if (closeBtn) {
            closeBtn.addEventListener('click', function(e) {
              e.stopPropagation();
              closeLightbox();
            });
          }

          const prevBtn = lightbox.querySelector('.lightbox__prev');
          if (prevBtn) {
            prevBtn.addEventListener('click', function(e) {
              e.stopPropagation();
              prevPhoto();
            });
          }

          const nextBtn = lightbox.querySelector('.lightbox__next');
          if (nextBtn) {
            nextBtn.addEventListener('click', function(e) {
              e.stopPropagation();
              nextPhoto();
            });
          }

          // Click outside to close
          lightbox.addEventListener('click', function(e) {
            if (e.target === lightbox) closeLightbox();
          });

          // Keyboard navigation
          document.addEventListener('keydown', handleKeyboard);

          console.log('[LIGHTBOX] Initialization complete!');
        }

        function handlePhotoClick(e) {
          const photoItem = e.target.closest('.gallery-item--photo');
          if (!photoItem) return;

          const index = parseInt(photoItem.getAttribute('data-index'), 10);
          if (isNaN(index)) return;

          console.log('[LIGHTBOX] Photo clicked, index:', index);
          openLightbox(index);
        }

        function openLightbox(index) {
          if (!lightbox || !photos.length) return;

          currentIndex = Math.max(0, Math.min(index, photos.length - 1));
          console.log('[LIGHTBOX] Opening lightbox at index:', currentIndex);
          console.log('[LIGHTBOX] Lightbox element:', lightbox);
          console.log('[LIGHTBOX] Has active class before:', lightbox.classList.contains('active'));

          updateLightbox();
          lightbox.classList.add('active');

          console.log('[LIGHTBOX] Has active class after:', lightbox.classList.contains('active'));
          console.log('[LIGHTBOX] Computed display:', window.getComputedStyle(lightbox).display);
          console.log('[LIGHTBOX] Computed z-index:', window.getComputedStyle(lightbox).zIndex);

          document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
          if (!lightbox) return;

          console.log('[LIGHTBOX] Closing lightbox');
          lightbox.classList.remove('active');
          document.body.style.overflow = '';
        }

        function prevPhoto() {
          if (!photos.length) return;
          currentIndex = (currentIndex - 1 + photos.length) % photos.length;
          console.log('[LIGHTBOX] Previous photo, index:', currentIndex);
          updateLightbox();
        }

        function nextPhoto() {
          if (!photos.length) return;
          currentIndex = (currentIndex + 1) % photos.length;
          console.log('[LIGHTBOX] Next photo, index:', currentIndex);
          updateLightbox();
        }

        function updateLightbox() {
          if (!lightbox || !photos[currentIndex]) return;

          const photo = photos[currentIndex];
          console.log('[LIGHTBOX] Photo data:', photo);

          const img = document.getElementById('lightbox-img');
          if (img) {
            console.log('[LIGHTBOX] Setting image src to:', photo.full);
            img.src = photo.full;
            img.alt = photo.title;
          } else {
            console.error('[LIGHTBOX] Image element not found!');
          }

          const title = document.getElementById('lightbox-title');
          if (title) title.textContent = photo.title;

          const description = document.getElementById('lightbox-description');
          if (description) description.textContent = photo.description;

          const current = document.getElementById('lightbox-current');
          if (current) current.textContent = currentIndex + 1;

          // Preload adjacent images for faster navigation
          preloadAdjacentImages();

          console.log('[LIGHTBOX] Updated to photo:', photo.title || 'Untitled');
        }

        function preloadAdjacentImages() {
          const prevIndex = (currentIndex - 1 + photos.length) % photos.length;
          const nextIndex = (currentIndex + 1) % photos.length;

          [prevIndex, nextIndex].forEach(idx => {
            if (photos[idx] && photos[idx].full) {
              const preloadImg = new Image();
              preloadImg.src = photos[idx].full;
            }
          });
        }

        function handleKeyboard(e) {
          if (!lightbox || !lightbox.classList.contains('active')) return;

          if (e.key === 'Escape') {
            closeLightbox();
          } else if (e.key === 'ArrowLeft') {
            prevPhoto();
          } else if (e.key === 'ArrowRight') {
            nextPhoto();
          }
        }

        // Start when DOM is ready
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>
  <% } %>

  <!-- VIDEO GRID -->
  <% if (videoItems.length) { %>
    <div class="gallery-items gallery-items--videos">
      <% videoItems.forEach(item => { %>
        <div class="gallery-item gallery-item--video">
          <div class="video-embed">
            <% if (item.media?.embed) { %>
              <iframe src="<%= item.media.embed %>"
                      frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen></iframe>
            <% } %>
          </div>
          <% if (item.title || item.description) { %>
            <div class="gallery-item__info">
              <% if (item.title) { %>
                <h4><%= item.title %></h4>
              <% } %>
              <% if (item.description) { %>
                <p><%= item.description %></p>
              <% } %>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>

  <!-- AUDIO GRID -->
  <% if (audioItems.length) { %>
    <div class="gallery-items gallery-items--audio">
      <% audioItems.forEach(item => { %>
        <div class="gallery-item gallery-item--audio">
          <% if (item.media?.embed) { %>
            <div class="audio-embed">
              <%- item.media.embed %>
            </div>
          <% } else if (item.media?.url) { %>
            <a href="<%= item.media.url %>" target="_blank" rel="noopener noreferrer" class="audio-link">
              <i class="fab fa-bandcamp"></i>
              <span><%= item.title || 'Listen on Bandcamp' %></span>
            </a>
          <% } %>
          <% if (item.title || item.description) { %>
            <div class="gallery-item__info">
              <% if (item.title) { %>
                <h4><%= item.title %></h4>
              <% } %>
              <% if (item.description) { %>
                <p><%= item.description %></p>
              <% } %>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>
