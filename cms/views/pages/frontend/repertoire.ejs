<%
// Helper per i18n labels
const L = (labels && labels.repertoire) ? labels.repertoire : {};
const _t = (k, def='') => { try { const v=(typeof t==='function'?t(k):''); return (v&&v!==k)?v:def; } catch { return def; } };

// Collaborators labels
const txtCollab = lang === 'en' ? 'Collaborators' : 'Collaboratori';
const txtSoloists = lang === 'en' ? 'Soloists' : 'Solisti';
const txtChoruses = lang === 'en' ? 'Choruses' : 'Cori';
const txtOrchestras = lang === 'en' ? 'Orchestras' : 'Orchestre';
const txtConcerts = lang === 'en' ? 'concerts' : 'concerti';

const hasSoloists = collaborators && collaborators.soloists && collaborators.soloists.length > 0;
const hasChoruses = collaborators && collaborators.choruses && collaborators.choruses.length > 0;
const hasOrchestras = collaborators && collaborators.orchestras && collaborators.orchestras.length > 0;
const hasAnyCollab = hasSoloists || hasChoruses || hasOrchestras;

// Helper to check if work is upcoming (in programma)
const upcomingWorkIds = (comingSoon || []).map(w => w.id);
const isUpcoming = (workId) => upcomingWorkIds.includes(workId);
const upcomingBadge = lang === 'en' ? 'Coming Soon' : 'In Programma';
%>

<main class="repertoire-page-new">
  <!-- Hero Section - Compact Modern -->
  <section class="rep-hero-modern">
    <div class="rep-container">
      <div class="rep-hero-content">
        <div class="rep-hero-text">
          <h1 class="rep-hero-title"><%= L.title || _t('repertoire.title', lang === 'en' ? 'Repertoire' : 'Repertorio') %></h1>
          <p class="rep-hero-subtitle"><%= L.subtitle || L.claim || (lang === 'en' ? 'Explore my musical journey through numbers' : 'Esplora il mio percorso musicale attraverso i numeri') %></p>
        </div>

        <!-- Stats Inline -->
        <div class="rep-stats-inline">
          <div class="rep-stat-inline">
            <span class="rep-stat-number"><%= stats.total_works %></span>
            <span class="rep-stat-label"><%= lang === 'en' ? 'Works' : 'Brani' %></span>
          </div>
          <div class="rep-stat-divider"></div>
          <div class="rep-stat-inline">
            <span class="rep-stat-number"><%= stats.total_composers %></span>
            <span class="rep-stat-label"><%= lang === 'en' ? 'Composers' : 'Compositori' %></span>
          </div>
          <div class="rep-stat-divider"></div>
          <div class="rep-stat-inline">
            <span class="rep-stat-number"><%= stats.total_concerts %></span>
            <span class="rep-stat-label"><%= lang === 'en' ? 'Concerts' : 'Concerti' %></span>
          </div>
        </div>
      </div>

      <!-- Quick Access Cards -->
      <div class="rep-quick-access">
        <div class="rep-access-card" data-scroll-to="highlights">
          <div class="rep-access-icon"><i class="fas fa-star"></i></div>
          <div class="rep-access-content">
            <h3><%= lang === 'en' ? 'Highlights' : 'In Evidenza' %></h3>
            <p><%= lang === 'en' ? 'Most performed works' : 'Brani più eseguiti' %></p>
          </div>
        </div>
        <div class="rep-access-card" data-scroll-to="composers">
          <div class="rep-access-icon"><i class="fas fa-user-music"></i></div>
          <div class="rep-access-content">
            <h3><%= lang === 'en' ? 'By Composer' : 'Per Compositore' %></h3>
            <p><%= lang === 'en' ? 'Complete catalogs' : 'Cataloghi completi' %></p>
          </div>
        </div>
        <div class="rep-access-card" data-scroll-to="timeline">
          <div class="rep-access-icon"><i class="fas fa-clock"></i></div>
          <div class="rep-access-content">
            <h3><%= lang === 'en' ? 'Timeline' : 'Cronologia' %></h3>
            <p><%= lang === 'en' ? 'Historical periods' : 'Periodi storici' %></p>
          </div>
        </div>
        <div class="rep-access-card" data-scroll-to="all-works">
          <div class="rep-access-icon"><i class="fas fa-th-list"></i></div>
          <div class="rep-access-content">
            <h3><%= lang === 'en' ? 'All Works' : 'Tutti i Brani' %></h3>
            <p><%= lang === 'en' ? 'Complete list' : 'Elenco completo' %></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Top Composers Section -->
  <% if (topComposers && topComposers.length > 0) { %>
    <section class="rep-top-composers">
      <div class="rep-container">
        <h2 class="rep-section-title-center">
          <%= lang === 'en' ? 'Featured Composers' : 'Compositori in Evidenza' %>
        </h2>
        <p class="rep-section-subtitle-center">
          <%= lang === 'en' ? 'The composers I perform most frequently' : 'I compositori che eseguo più frequentemente' %>
        </p>

        <div class="rep-top-composers-grid">
          <% topComposers.forEach((composer, index) => { %>
            <div class="rep-top-composer-card" data-rank="<%= index + 1 %>" data-composer-id="<%= composer.id %>" data-composer-name="<%= composer.name %>">
              <div class="rep-top-composer-rank"><%= index + 1 %></div>
              <div class="rep-top-composer-avatar <%= composer.portrait_url ? 'has-portrait' : '' %>">
                <% if (composer.portrait_url) { %>
                  <img src="<%= composer.portrait_url %>" alt="<%= composer.name %>" class="rep-top-composer-portrait">
                <% } else { %>
                  <span class="rep-top-composer-initials">
                    <%= composer.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() %>
                  </span>
                <% } %>
              </div>
              <h3 class="rep-top-composer-name"><%= composer.name %></h3>
              <div class="rep-top-composer-stats">
                <div class="rep-top-composer-stat">
                  <i class="fas fa-music"></i>
                  <span><%= composer.works_count %> <%= lang === 'en' ? 'works' : 'brani' %></span>
                </div>
                <div class="rep-top-composer-stat">
                  <i class="fas fa-calendar"></i>
                  <span><%= composer.concerts_count %> <%= lang === 'en' ? 'concerts' : 'concerti' %></span>
                </div>
                <% if (composer.total_performances > 0) { %>
                  <div class="rep-top-composer-stat">
                    <i class="fas fa-repeat"></i>
                    <span><%= composer.total_performances %> <%= lang === 'en' ? 'performances' : 'esecuzioni' %></span>
                  </div>
                <% } %>
                <% if (composer.total_performed_minutes > 0) { %>
                  <div class="rep-top-composer-stat" style="opacity: 0.8; font-size: 0.85em;">
                    <i class="fas fa-clock"></i>
                    <span><%= Math.round(composer.total_performed_minutes / 60) %>h <%= lang === 'en' ? 'performed' : 'sul palco' %></span>
                  </div>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <!-- Collaborators Section - DOPO compositori, compatta e collassabile -->
  <% if (hasAnyCollab) { %>
    <section class="rep-collaborators">
      <div class="rep-container">
        <h2 class="rep-section-title">
          <i class="fas fa-users"></i>
          <%= txtCollab %>
        </h2>
        <p class="rep-section-subtitle">
          <%= lang === 'en' ? 'Artists I have performed with' : 'Artisti con cui ho collaborato' %>
        </p>

        <button class="rep-collaborators-toggle" id="collaboratorsToggle">
          <i class="fas fa-chevron-down"></i>
          <span class="toggle-text-show"><%= lang === 'en' ? 'Explore Collaborators' : 'Esplora Collaboratori' %></span>
          <span class="toggle-text-hide"><%= lang === 'en' ? 'Hide Collaborators' : 'Nascondi Collaboratori' %></span>
        </button>

        <div class="rep-collab-grid">
          <!-- Soloists - raggruppati per strumento -->
          <% if (hasSoloists && collaborators.soloistGroups && collaborators.soloistGroups.length > 0) { %>
            <div class="rep-collab-category">
              <h3 class="rep-collab-cat-title">
                <i class="fas fa-microphone"></i>
                <%= txtSoloists %> <span class="rep-collab-count">(<%= collaborators.soloists.length %>)</span>
              </h3>

              <% collaborators.soloistGroups.forEach((group, groupIdx) => { %>
                <div style="margin-bottom: 20px;">
                  <h4 class="soloist-group-toggle" data-group-id="soloist-group-<%= groupIdx %>" style="color: #d4af37; font-size: 16px; font-weight: 600; margin-bottom: 12px; padding-left: 10px; border-left: 3px solid #d4af37; cursor: pointer; user-select: none; display: flex; align-items: center; gap: 10px;">
                    <i class="fas fa-chevron-down" id="icon-soloist-group-<%= groupIdx %>" style="font-size: 12px; transition: transform 0.3s; transform: rotate(-90deg);"></i>
                    <span><%= group.instrument %> <span style="color: #9ca3af; font-size: 14px; font-weight: 400;">(<%= group.soloists.length %>)</span></span>
                  </h4>

                  <div id="soloist-group-<%= groupIdx %>" class="rep-collab-list" style="display: none;">
                    <% group.soloists.forEach(soloist => { %>
                      <div class="rep-collab-item clickable-performer" data-performer-name="<%= soloist.name %>" data-performer-role="soloist">
                        <div class="rep-collab-name"><%= soloist.name %></div>
                        <% if (group.instrument === 'Voce' && soloist.displayInstrument) { %>
                          <div class="rep-collab-instrument"><%= soloist.displayInstrument %></div>
                        <% } %>
                        <div class="rep-collab-badge"><%= soloist.concert_count %></div>
                      </div>
                    <% }) %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>

          <!-- Orchestras -->
          <% if (hasOrchestras) { %>
            <div class="rep-collab-category">
              <h3 class="rep-collab-cat-title">
                <i class="fas fa-music"></i>
                <%= txtOrchestras %>
              </h3>
              <div class="rep-collab-list">
                <% collaborators.orchestras.forEach(orchestra => { %>
                  <div class="rep-collab-item clickable-performer" data-performer-name="<%= orchestra.name %>" data-performer-role="orchestra">
                    <div class="rep-collab-name"><%= orchestra.name %></div>
                    <div class="rep-collab-badge"><%= orchestra.concert_count %></div>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>

          <!-- Choruses -->
          <% if (hasChoruses) { %>
            <div class="rep-collab-category">
              <h3 class="rep-collab-cat-title">
                <i class="fas fa-user-friends"></i>
                <%= txtChoruses %>
              </h3>
              <div class="rep-collab-list">
                <% collaborators.choruses.forEach(chorus => { %>
                  <div class="rep-collab-item clickable-performer" data-performer-name="<%= chorus.name %>" data-performer-role="chorus">
                    <div class="rep-collab-name"><%= chorus.name %></div>
                    <div class="rep-collab-badge"><%= chorus.concert_count %></div>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </section>
  <% } %>

  <!-- Main Content -->
  <div class="rep-container">
    <!-- Navigation Tabs (Desktop) -->
    <div class="rep-tabs">
      <button class="rep-tab active" data-view="highlights">
        <i class="fas fa-star"></i>
        <span class="rep-tab-label"><%= lang === 'en' ? 'Highlights' : 'In Evidenza' %></span>
        <% if (frequentlyPerformed && frequentlyPerformed.length > 0) { %>
          <span class="rep-tab-badge"><%= frequentlyPerformed.length %></span>
        <% } %>
      </button>
      <button class="rep-tab" data-view="composers">
        <i class="fas fa-user-tie"></i>
        <span class="rep-tab-label"><%= lang === 'en' ? 'By Composer' : 'Per Compositore' %></span>
        <% if (composers && composers.length > 0) { %>
          <span class="rep-tab-badge"><%= composers.length %></span>
        <% } %>
      </button>
      <button class="rep-tab" data-view="timeline">
        <i class="fas fa-clock"></i>
        <span class="rep-tab-label"><%= lang === 'en' ? 'Timeline' : 'Periodi' %></span>
        <% if (timeline && timeline.length > 0) { %>
          <span class="rep-tab-badge"><%= timeline.length %> <%= lang === 'en' ? 'eras' : 'epoche' %></span>
        <% } %>
      </button>
      <button class="rep-tab" data-view="all">
        <i class="fas fa-th"></i>
        <span class="rep-tab-label"><%= lang === 'en' ? 'All Works' : 'Tutti i Brani' %></span>
        <span class="rep-tab-count"><%= works.length %></span>
      </button>
    </div>

    <!-- Mobile Select Dropdown -->
    <select class="rep-mobile-select" id="repMobileSelect">
      <option value="highlights">⭐ <%= lang === 'en' ? 'Highlights' : 'In Evidenza' %><% if (frequentlyPerformed && frequentlyPerformed.length > 0) { %> (<%= frequentlyPerformed.length %>)<% } %></option>
      <option value="composers">👤 <%= lang === 'en' ? 'By Composer' : 'Per Compositore' %><% if (composers && composers.length > 0) { %> (<%= composers.length %>)<% } %></option>
      <option value="timeline">🕐 <%= lang === 'en' ? 'Timeline' : 'Periodi' %><% if (timeline && timeline.length > 0) { %> (<%= timeline.length %>)<% } %></option>
      <option value="all">📋 <%= lang === 'en' ? 'All Works' : 'Tutti i Brani' %> (<%= works.length %>)</option>
    </select>

    <!-- Highlights View (Default) -->
    <div id="highlightsView" class="rep-view active">
      <% if (frequentlyPerformed && frequentlyPerformed.length > 0) { %>
        <h3 class="rep-subsection-title"><%= lang === 'en' ? 'Most Performed Works' : 'Brani Più Eseguiti' %></h3>
        <div class="rep-works-grid">
          <% frequentlyPerformed.slice(0, 8).forEach(work => { %>
            <div class="rep-work-card rep-work-row" data-work-id="<%= work.id %>" data-composer-name="<%= work.composer_name %>">
              <div class="rep-work-header">
                <h4 class="rep-work-title">
                  <%= work.title || (lang === 'en' ? 'Untitled' : 'Senza titolo') %>
                  <% if (work.catalogue) { %>
                    <span style="color: var(--gold); font-weight: 400; font-size: 0.9em;"><%= work.catalogue %></span>
                  <% } %>
                </h4>
                <% if (work.subtitle) { %>
                  <p class="rep-work-subtitle" style="color: var(--text-secondary); font-size: 0.9em; font-style: italic; margin-top: 4px;"><%= work.subtitle %></p>
                <% } %>
                <p class="rep-work-composer"><%= work.composer_name %></p>
              </div>
              <div class="rep-work-meta">
                <span class="rep-work-perf-count">
                  <i class="fas fa-calendar-check"></i>
                  <% if (work.partial_performances > 0) { %>
                    <%= work.complete_performances %> <%= lang === 'en' ? 'complete' : 'complete' %><% if (work.partial_performances > 0) { %>, <%= work.partial_performances %> <%= lang === 'en' ? 'partial' : 'parziali' %><% } %>
                  <% } else { %>
                    <%= work.complete_performances %> <%= lang === 'en' ? (work.complete_performances === 1 ? 'performance' : 'performances') : (work.complete_performances === 1 ? 'esecuzione' : 'esecuzioni') %>
                  <% } %>
                </span>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

      <% if (comingSoon && comingSoon.length > 0) { %>
        <h3 class="rep-subsection-title"><%= lang === 'en' ? 'Upcoming Concerts' : 'Prossimi Concerti' %></h3>
        <div class="rep-works-grid">
          <% comingSoon.slice(0, 8).forEach(work => { %>
            <div class="rep-work-card rep-work-card-new rep-work-row" data-work-id="<%= work.id %>" data-composer-name="<%= work.composer_name %>">
              <div class="rep-work-header">
                <h4 class="rep-work-title">
                  <%= work.title || (lang === 'en' ? 'Untitled' : 'Senza titolo') %>
                  <% if (work.catalogue) { %>
                    <span style="color: var(--gold); font-weight: 400; font-size: 0.9em;"><%= work.catalogue %></span>
                  <% } %>
                </h4>
                <% if (work.subtitle) { %>
                  <p class="rep-work-subtitle" style="color: var(--text-secondary); font-size: 0.9em; font-style: italic; margin-top: 4px;"><%= work.subtitle %></p>
                <% } %>
                <p class="rep-work-composer"><%= work.composer_name %></p>
              </div>
              <div class="rep-work-badge-new">
                <i class="fas fa-calendar-alt"></i>
                <%= lang === 'en' ? 'Coming Soon' : 'In Programma' %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- Composers View -->
    <div id="composersView" class="rep-view">
      <div class="rep-composers-grid">
        <% composers.forEach(composer => { %>
          <div class="rep-composer-card">
            <div class="rep-composer-header">
              <div class="rep-composer-avatar <% if (composer.portrait_url) { %>has-portrait<% } %>">
                <% if (composer.portrait_url) { %>
                  <img src="<%= composer.portrait_url %>" alt="<%= composer.name %>" class="rep-composer-portrait">
                <% } else { %>
                  <%= composer.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() %>
                <% } %>
              </div>
              <div class="rep-composer-info">
                <h3 class="rep-composer-name"><%= composer.name %></h3>
                <% if (composer.birth_year || composer.death_year) { %>
                  <p class="rep-composer-years">(<%= composer.birth_year || '?' %> - <%= composer.death_year || '?' %>)</p>
                <% } %>
              </div>
            </div>
            <div class="rep-composer-stats">
              <span><i class="fas fa-music"></i> <%= composer.works.length %> <%= lang === 'en' ? 'works' : 'brani' %></span>
              <% if (composer.concerts_count > 0) { %>
                <span><i class="fas fa-calendar"></i> <%= composer.concerts_count %> <%= lang === 'en' ? 'concerts' : 'concerti' %></span>
              <% } %>
            </div>
            <button class="rep-composer-toggle" data-composer="<%= composer.id %>">
              <i class="fas fa-chevron-down"></i>
              <%= lang === 'en' ? 'View works' : 'Vedi brani' %>
            </button>
            <div class="rep-composer-works" id="composer_<%= composer.id %>" style="display: none;">
              <% composer.works.forEach(work => { %>
                <div class="rep-work-item <%= isUpcoming(work.id) ? 'upcoming' : '' %>" data-work-id="<%= work.id %>" data-composer-name="<%= composer.full_name %>">
                  <span class="rep-work-item-title">
                    <%= work.title %>
                    <% if (work.catalogue) { %>
                      <span style="color: var(--gold); font-weight: 400; margin-left: 8px;"><%= work.catalogue %></span>
                    <% } %>
                    <% if (work.subtitle) { %>
                      <span style="color: var(--text-secondary); font-style: italic; margin-left: 8px;"><%= work.subtitle %></span>
                    <% } %>
                  </span>
                  <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <% if (isUpcoming(work.id)) { %>
                      <span class="rep-work-badge-upcoming">
                        <i class="fas fa-calendar-alt"></i>
                        <%= upcomingBadge %>
                      </span>
                    <% } %>
                    <% if (work.category_name) { %>
                      <span class="rep-work-item-cat" data-category="<%= work.category_id %>"><%= work.category_name %></span>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Timeline View -->
    <div id="timelineView" class="rep-view">
      <% if (timeline && timeline.length > 0) { %>
        <div class="rep-timeline">
          <div class="rep-timeline-header">
            <h3 class="rep-subsection-title">
              <%= lang === 'en' ? 'Repertoire by Historical Period' : 'Repertorio per Periodo Storico' %>
            </h3>
            <p style="color: #999; margin-bottom: 2rem;">
              <%= lang === 'en' ? 'From Baroque to 20th Century' : 'Dal Barocco al Novecento' %>
            </p>
          </div>

          <div class="rep-timeline-container">
            <div class="rep-timeline-line"></div>
            <%
            const periodLabels = {
              'Barocco': { en: 'Baroque', color: 'baroque' },
              'Classicismo': { en: 'Classical', color: 'classical' },
              'Romanticismo': { en: 'Romantic', color: 'romantic' },
              'Novecento': { en: '20th Century', color: 'modern' }
            };

            timeline.forEach((item, index) => {
              const periodInfo = periodLabels[item.period] || { en: item.period, color: 'default' };
              const displayName = lang === 'en' ? periodInfo.en : item.period;
              const periodWorks = timelineByPeriod[item.period] || {};
              const decades = Object.keys(periodWorks).sort((a, b) => parseInt(a) - parseInt(b));
            %>
              <div class="rep-timeline-item period-<%= periodInfo.color %>">
                <div class="rep-timeline-dot"></div>
                <div class="rep-timeline-content">
                  <div class="rep-timeline-period-name"><%= displayName %></div>
                  <div class="rep-timeline-years"><%= item.first_year %> - <%= item.last_year %></div>
                  <div class="rep-timeline-stats">
                    <div class="rep-timeline-stat">
                      <i class="fas fa-music"></i>
                      <span><%= item.works_count %> <%= lang === 'en' ? 'works' : 'brani' %></span>
                    </div>
                    <div class="rep-timeline-stat">
                      <i class="fas fa-user-tie"></i>
                      <span><%= item.composers_count %> <%= lang === 'en' ? 'composers' : 'compositori' %></span>
                    </div>
                  </div>

                  <% if (decades.length > 0) { %>
                    <button class="rep-timeline-expand-btn" data-period="<%= item.period %>">
                      <i class="fas fa-chevron-down"></i>
                      <%= lang === 'en' ? 'View works' : 'Vedi brani' %>
                    </button>

                    <div class="rep-timeline-details" id="timeline-<%= item.period %>" style="display: none;">
                      <% decades.forEach(decade => {
                        const decadeWorks = periodWorks[decade];
                      %>
                        <div class="rep-timeline-decade">
                          <h4 class="rep-timeline-decade-title">
                            <%= decade %>s
                            <span class="rep-timeline-decade-count">(<%= decadeWorks.length %>)</span>
                          </h4>
                          <div class="rep-timeline-works-list">
                            <% decadeWorks.forEach(work => { %>
                              <div class="rep-timeline-work-item rep-timeline-work" data-work-id="<%= work.id %>">
                                <span class="rep-timeline-work-year"><%= work.year %></span>
                                <div class="rep-timeline-work-info">
                                  <div class="rep-timeline-work-title"><%= work.title %></div>
                                  <div class="rep-timeline-work-composer"><%= work.composer_name %></div>
                                </div>
                              </div>
                            <% }) %>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>

    <!-- All Works View -->
    <div id="allView" class="rep-view">
      <div class="rep-search-box">
        <i class="fas fa-search"></i>
        <input type="text" id="repSearch" placeholder="<%= lang === 'en' ? 'Search works or composers...' : 'Cerca brani o compositori...' %>">
      </div>
      <div class="rep-works-list">
        <% works.forEach(work => { %>
          <div class="rep-work-row <%= isUpcoming(work.id) ? 'upcoming' : '' %>" data-search="<%= (work.title + ' ' + work.composer_name).toLowerCase() %>" data-work-id="<%= work.id %>" data-composer-name="<%= work.composer_name %>">
            <div class="rep-work-row-main">
              <h4 class="rep-work-row-title rep-work-title"><%= work.title %></h4>
              <p class="rep-work-row-composer"><%= work.composer_name %></p>
            </div>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <% if (isUpcoming(work.id)) { %>
                <span class="rep-work-badge-upcoming">
                  <i class="fas fa-calendar-alt"></i>
                  <%= upcomingBadge %>
                </span>
              <% } %>
              <% if (work.category_name) { %>
                <span class="rep-work-row-cat" data-category="<%= work.category_id %>"><%= work.category_name %></span>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</main>

