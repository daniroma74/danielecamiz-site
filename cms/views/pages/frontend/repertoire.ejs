<script>
// Quick Access Cards - Smooth scroll to sections
document.querySelectorAll('.rep-access-card').forEach(card => {
  card.addEventListener('click', () => {
    const viewName = card.dataset.scrollTo;
    // Activate the corresponding tab
    document.querySelectorAll('.rep-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.rep-view').forEach(v => v.classList.remove('active'));

    const tabBtn = document.querySelector(`.rep-tab[data-view="${viewName}"]`);
    const viewEl = document.getElementById(viewName + 'View');

    if (tabBtn) tabBtn.classList.add('active');
    if (viewEl) {
      viewEl.classList.add('active');
      // Smooth scroll to tabs
      setTimeout(() => {
        document.querySelector('.rep-tabs')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 100);
    }
  });
});

// Tab switching (desktop)
document.querySelectorAll('.rep-tab').forEach(tab => {
  tab.addEventListener('click', () => {
    const view = tab.dataset.view;
    document.querySelectorAll('.rep-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.rep-view').forEach(v => v.classList.remove('active'));
    tab.classList.add('active');
    document.getElementById(view + 'View').classList.add('active');
  });
});

// Mobile select dropdown
const mobileSelect = document.getElementById('repMobileSelect');
if (mobileSelect) {
  mobileSelect.addEventListener('change', (e) => {
    const view = e.target.value;
    document.querySelectorAll('.rep-view').forEach(v => v.classList.remove('active'));
    document.getElementById(view + 'View').classList.add('active');
  });
}

// Composer toggle
document.querySelectorAll('.rep-composer-toggle').forEach(btn => {
  btn.addEventListener('click', () => {
    const id = btn.dataset.composer;
    const works = document.getElementById('composer_' + id);
    const icon = btn.querySelector('i');
    if (works.style.display === 'none') {
      works.style.display = 'block';
      icon.style.transform = 'rotate(180deg)';
    } else {
      works.style.display = 'none';
      icon.style.transform = 'rotate(0deg)';
    }
  });
});

// Soloist groups toggle (per strumento)
function toggleSoloistGroup(groupId) {
  const group = document.getElementById(groupId);
  const icon = document.getElementById('icon-' + groupId);

  if (group.style.display === 'none') {
    group.style.display = 'grid';
    icon.style.transform = 'rotate(0deg)';
  } else {
    group.style.display = 'none';
    icon.style.transform = 'rotate(-90deg)';
  }
}

// Collaborators toggle
document.querySelectorAll('.rep-collab-toggle').forEach(btn => {
  btn.addEventListener('click', () => {
    const targetId = btn.dataset.target;
    const list = document.getElementById(targetId);
    const hiddenItems = list.querySelectorAll('.rep-collab-hidden');
    const moreText = btn.querySelector('.rep-toggle-more');
    const lessText = btn.querySelector('.rep-toggle-less');

    hiddenItems.forEach(item => {
      if (item.style.display === 'none' || !item.style.display) {
        item.style.display = 'flex';
      } else {
        item.style.display = 'none';
      }
    });

    if (moreText.style.display === 'none') {
      moreText.style.display = 'inline';
      lessText.style.display = 'none';
    } else {
      moreText.style.display = 'none';
      lessText.style.display = 'inline';
    }
  });
});

// Search
const searchInput = document.getElementById('repSearch');
if (searchInput) {
  searchInput.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase();
    document.querySelectorAll('.rep-work-row').forEach(row => {
      const text = row.dataset.search;
      row.style.display = text.includes(query) ? 'flex' : 'none';
    });
  });
}

// Timeline expand/collapse
document.querySelectorAll('.rep-timeline-expand-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const period = btn.dataset.period;
    const details = document.getElementById('timeline-' + period);
    const icon = btn.querySelector('i');

    if (details.style.display === 'none') {
      details.style.display = 'block';
      icon.style.transform = 'rotate(180deg)';
      btn.textContent = btn.textContent.includes('View') ? 'Hide works' : 'Nascondi brani';
      btn.prepend(icon);
    } else {
      details.style.display = 'none';
      icon.style.transform = 'rotate(0deg)';
      btn.textContent = btn.textContent.includes('Hide') ? 'View works' : 'Vedi brani';
      btn.prepend(icon);
    }
  });
});

// Work concert history functionality
function openWorkModal(workId, workTitle, composerName) {
  const modal = document.getElementById('workConcertsModal');
  const modalTitle = document.getElementById('modalWorkTitle');
  const modalComposer = document.getElementById('modalWorkComposer');
  const concertsList = document.getElementById('modalConcertsList');

  // Set title and composer
  modalTitle.textContent = workTitle;
  modalComposer.textContent = composerName;

  // Show modal with loading spinner
  modal.style.display = 'flex';
  concertsList.innerHTML = '<div class="loading-spinner" style="text-align: center; padding: 2rem;"><i class="fas fa-spinner fa-spin" style="font-size: 2rem; color: var(--gold);"></i></div>';

  // Fetch concerts
  fetch('/api/repertoire/work/' + workId)
    .then(function(response) { return response.json(); })
    .then(function(data) {
      if (data.success && data.performances && data.performances.length > 0) {
        const lang = '<%= lang %>';
        const concertsHTML = data.performances.map(function(concert) {
          const concertDate = new Date(concert.date);
          const dateStr = concertDate.toLocaleDateString(lang === 'en' ? 'en-US' : 'it-IT', {
            year: 'numeric',
            month: 'short',
            day: 'numeric'
          });

          const concertTitle = concert.title || (lang === 'en' ? 'Concert' : 'Concerto');
          const concertLocation = concert.location || '';

          return '<div class="concert-history-item" data-concert-id="' + concert.id + '">' +
              '<div class="concert-history-date">' + dateStr + '</div>' +
              '<div class="concert-history-details">' +
                '<div class="concert-history-title">' + concertTitle + '</div>' +
                (concertLocation ? '<div class="concert-history-location"><i class="fas fa-map-marker-alt"></i> ' + concertLocation + '</div>' : '') +
              '</div>' +
              '<div class="concert-history-icon">' +
                '<i class="fas fa-chevron-right"></i>' +
              '</div>' +
            '</div>';
        }).join('');

        concertsList.innerHTML = concertsHTML;

        // Add click handlers to concert items - open detail modal instead of navigation
        document.querySelectorAll('.concert-history-item').forEach(function(item) {
          item.addEventListener('click', function(e) {
            e.stopPropagation();
            const concertId = this.getAttribute('data-concert-id');
            openConcertDetailModal(concertId);
          });
        });
      } else {
        const lang = '<%= lang %>';
        concertsList.innerHTML = '<div style="text-align: center; padding: 2rem; color: var(--text-secondary);">' +
            '<i class="fas fa-calendar-times" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;"></i>' +
            '<p>' + (lang === 'en' ? 'No concert history available' : 'Nessuno storico disponibile') + '</p>' +
          '</div>';
      }
    })
    .catch(function(error) {
      console.error('Error fetching work concerts:', error);
      const lang = '<%= lang %>';
      concertsList.innerHTML = '<div style="text-align: center; padding: 2rem; color: var(--text-secondary);">' +
          '<i class="fas fa-exclamation-triangle" style="font-size: 3rem; margin-bottom: 1rem; color: #ff6b6b;"></i>' +
          '<p>' + (lang === 'en' ? 'Error loading concert history' : 'Errore caricamento storico') + '</p>' +
        '</div>';
    });

  // Prevent body scroll when modal is open
  document.body.style.overflow = 'hidden';
}

function closeWorkModal() {
  const modal = document.getElementById('workConcertsModal');
  modal.style.display = 'none';
  document.body.style.overflow = '';
}

// Concert detail modal functionality
function openConcertDetailModal(concertId) {
  const modal = document.getElementById('concertDetailModal');
  const modalTitle = document.getElementById('concertModalTitle');
  const modalDetails = document.getElementById('concertModalDetails');

  // Show modal with loading spinner
  modal.style.display = 'flex';
  modalTitle.textContent = '<%= lang === "en" ? "Loading..." : "Caricamento..." %>';
  modalDetails.innerHTML = '<div class="loading-spinner" style="text-align: center; padding: 2rem;"><i class="fas fa-spinner fa-spin" style="font-size: 2rem; color: var(--gold);"></i></div>';

  // Fetch concert details
  fetch('/api/repertoire/concert/' + concertId)
    .then(function(response) { return response.json(); })
    .then(function(data) {
      if (data.success && data.concert) {
        const lang = '<%= lang %>';
        const concert = data.concert;
        const program = data.program || [];

        // Set title
        modalTitle.textContent = concert.title || (lang === 'en' ? 'Concert' : 'Concerto');

        // Build concert details HTML
        let detailsHTML = '<div style="margin-bottom: 2rem;">';

        // Date
        if (concert.date) {
          const concertDate = new Date(concert.date);
          const dateStr = concertDate.toLocaleDateString(lang === 'en' ? 'en-US' : 'it-IT', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          });
          detailsHTML += '<div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">' +
              '<i class="fas fa-calendar-alt" style="color: #d4af37; font-size: 1.2rem;"></i>' +
              '<span style="color: #f0f0f0; font-size: 1.1rem;">' + dateStr + '</span>' +
            '</div>';
        }

        // Location
        if (concert.location) {
          detailsHTML += '<div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">' +
              '<i class="fas fa-map-marker-alt" style="color: #d4af37; font-size: 1.2rem;"></i>' +
              '<span style="color: #d0d0d0; font-size: 1rem;">' + concert.location + '</span>' +
            '</div>';
        }

        // Performers
        if (concert.performers) {
          detailsHTML += '<div style="display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 1.5rem;">' +
              '<i class="fas fa-users" style="color: #d4af37; font-size: 1.2rem; margin-top: 2px;"></i>' +
              '<span style="color: #d0d0d0; font-size: 0.95rem;">' + concert.performers + '</span>' +
            '</div>';
        }

        detailsHTML += '</div>';

        // Program
        if (program.length > 0) {
          detailsHTML += '<div style="border-top: 1px solid rgba(212, 175, 55, 0.2); padding-top: 1.5rem;">' +
              '<h4 style="color: #f0f0f0; margin-bottom: 1rem; font-size: 1.2rem;">' +
                '<i class="fas fa-list-music" style="color: #d4af37;"></i> ' +
                (lang === 'en' ? 'Program' : 'Programma') +
              '</h4>' +
              '<div style="display: flex; flex-direction: column; gap: 1rem;">';

          program.forEach(function(item, idx) {
            const workTitle = item.title || '';
            const composerName = item.composer_name || '';
            const catalogue = item.catalogue ? ' ' + item.catalogue : '';
            const workKey = item.work_key ? ', ' + item.work_key : '';
            const movementTitle = item.movement_title ? ' - ' + item.movement_title : '';

            detailsHTML += '<div style="padding: 1rem; background: rgba(255, 255, 255, 0.03); border-left: 3px solid #d4af37; border-radius: 4px;">' +
                '<div style="color: #d4af37; font-weight: 600; margin-bottom: 0.25rem;">' + composerName + '</div>' +
                '<div style="color: #f0f0f0; font-size: 1.05rem;">' + workTitle + catalogue + workKey + movementTitle + '</div>' +
              '</div>';
          });

          detailsHTML += '</div></div>';
        }

        modalDetails.innerHTML = detailsHTML;
      } else {
        const lang = '<%= lang %>';
        modalTitle.textContent = lang === 'en' ? 'Concert Not Found' : 'Concerto Non Trovato';
        modalDetails.innerHTML = '<div style="text-align: center; padding: 2rem; color: var(--text-secondary);">' +
            '<i class="fas fa-exclamation-circle" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;"></i>' +
            '<p>' + (lang === 'en' ? 'Concert details not available' : 'Dettagli concerto non disponibili') + '</p>' +
          '</div>';
      }
    })
    .catch(function(error) {
      console.error('Error fetching concert details:', error);
      const lang = '<%= lang %>';
      modalTitle.textContent = lang === 'en' ? 'Error' : 'Errore';
      modalDetails.innerHTML = '<div style="text-align: center; padding: 2rem; color: var(--text-secondary);">' +
          '<i class="fas fa-exclamation-triangle" style="font-size: 3rem; margin-bottom: 1rem; color: #ff6b6b;"></i>' +
          '<p>' + (lang === 'en' ? 'Error loading concert details' : 'Errore caricamento dettagli concerto') + '</p>' +
        '</div>';
    });

  // Prevent body scroll when modal is open
  document.body.style.overflow = 'hidden';
}

function closeConcertDetailModal() {
  const modal = document.getElementById('concertDetailModal');
  modal.style.display = 'none';
  document.body.style.overflow = '';
}

// Composer concerts modal functionality
function openComposerConcertsModal(composerId, composerName) {
  const modal = document.getElementById('workConcertsModal');
  const modalTitle = document.getElementById('modalWorkTitle');
  const modalComposer = document.getElementById('modalWorkComposer');
  const concertsList = document.getElementById('modalConcertsList');

  const lang = '<%= lang %>';

  // Set title and subtitle
  modalTitle.textContent = lang === 'en' ? 'Concert History' : 'Storico Concerti';
  modalComposer.textContent = composerName;

  // Show modal with loading spinner
  modal.style.display = 'flex';
  concertsList.innerHTML = '<div class="loading-spinner" style="text-align: center; padding: 2rem;"><i class="fas fa-spinner fa-spin" style="font-size: 2rem; color: var(--gold);"></i></div>';

  // Fetch composer concerts
  fetch('/api/repertoire/composer/' + composerId + '/concerts')
    .then(function(response) { return response.json(); })
    .then(function(data) {
      if (data.success && data.concerts && data.concerts.length > 0) {
        const concertsHTML = data.concerts.map(function(concert) {
          const concertDate = new Date(concert.date);
          const dateStr = concertDate.toLocaleDateString(lang === 'en' ? 'en-US' : 'it-IT', {
            year: 'numeric',
            month: 'short',
            day: 'numeric'
          });

          const concertTitle = concert.title || (lang === 'en' ? 'Concert' : 'Concerto');
          const concertLocation = concert.location || '';
          const worksCount = concert.works_count || 0;

          return '<div class="concert-history-item" data-concert-id="' + concert.id + '">' +
              '<div class="concert-history-date">' + dateStr + '</div>' +
              '<div class="concert-history-details">' +
                '<div class="concert-history-title">' + concertTitle + '</div>' +
                (concertLocation ? '<div class="concert-history-location"><i class="fas fa-map-marker-alt"></i> ' + concertLocation + '</div>' : '') +
                (worksCount > 0 ? '<div style="color: #d4af37; font-size: 0.85rem; margin-top: 0.25rem;"><i class="fas fa-music"></i> ' + worksCount + ' ' + (lang === 'en' ? 'works' : 'brani') + '</div>' : '') +
              '</div>' +
              '<div class="concert-history-icon">' +
                '<i class="fas fa-chevron-right"></i>' +
              '</div>' +
            '</div>';
        }).join('');

        concertsList.innerHTML = concertsHTML;

        // Add click handlers to concert items
        document.querySelectorAll('.concert-history-item').forEach(function(item) {
          item.addEventListener('click', function(e) {
            e.stopPropagation();
            const concertId = this.getAttribute('data-concert-id');
            closeWorkModal();
            setTimeout(function() {
              openConcertDetailModal(concertId);
            }, 300);
          });
        });
      } else {
        concertsList.innerHTML = '<div style="text-align: center; padding: 2rem; color: var(--text-secondary);">' +
            '<i class="fas fa-calendar-times" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;"></i>' +
            '<p>' + (lang === 'en' ? 'No concerts found for this composer' : 'Nessun concerto trovato per questo compositore') + '</p>' +
          '</div>';
      }
    })
    .catch(function(error) {
      console.error('Error fetching composer concerts:', error);
      concertsList.innerHTML = '<div style="text-align: center; padding: 2rem; color: var(--text-secondary);">' +
          '<i class="fas fa-exclamation-triangle" style="font-size: 3rem; margin-bottom: 1rem; color: #ff6b6b;"></i>' +
          '<p>' + (lang === 'en' ? 'Error loading concerts' : 'Errore caricamento concerti') + '</p>' +
        '</div>';
    });

  // Prevent body scroll when modal is open
  document.body.style.overflow = 'hidden';
}

// Performer concerts modal functionality
function openPerformerConcertsModal(performerName, performerRole) {
  const modal = document.getElementById('workConcertsModal');
  const modalTitle = document.getElementById('modalWorkTitle');
  const modalComposer = document.getElementById('modalWorkComposer');
  const concertsList = document.getElementById('modalConcertsList');

  const lang = '<%= lang %>';
  const roleNames = {
    'soloist': lang === 'en' ? 'Soloist' : 'Solista',
    'orchestra': lang === 'en' ? 'Orchestra' : 'Orchestra',
    'chorus': lang === 'en' ? 'Chorus' : 'Coro'
  };

  // Set title and subtitle
  modalTitle.textContent = lang === 'en' ? 'Concert History' : 'Storico Concerti';
  modalComposer.textContent = performerName + (performerRole ? ' - ' + roleNames[performerRole] : '');

  // Show modal with loading spinner
  modal.style.display = 'flex';
  concertsList.innerHTML = '<div class="loading-spinner" style="text-align: center; padding: 2rem;"><i class="fas fa-spinner fa-spin" style="font-size: 2rem; color: var(--gold);"></i></div>';

  // Fetch performer concerts
  const url = '/api/repertoire/performer/concerts?name=' + encodeURIComponent(performerName) +
              (performerRole ? '&role=' + encodeURIComponent(performerRole) : '');

  fetch(url)
    .then(function(response) { return response.json(); })
    .then(function(data) {
      if (data.success && data.concerts && data.concerts.length > 0) {
        const concertsHTML = data.concerts.map(function(concert) {
          const concertDate = new Date(concert.date);
          const dateStr = concertDate.toLocaleDateString(lang === 'en' ? 'en-US' : 'it-IT', {
            year: 'numeric',
            month: 'short',
            day: 'numeric'
          });

          const concertTitle = concert.title || (lang === 'en' ? 'Concert' : 'Concerto');
          const concertLocation = concert.location || '';
          const worksCount = concert.works_count || 0;

          return '<div class="concert-history-item" data-concert-id="' + concert.id + '">' +
              '<div class="concert-history-date">' + dateStr + '</div>' +
              '<div class="concert-history-details">' +
                '<div class="concert-history-title">' + concertTitle + '</div>' +
                (concertLocation ? '<div class="concert-history-location"><i class="fas fa-map-marker-alt"></i> ' + concertLocation + '</div>' : '') +
                (worksCount > 0 ? '<div style="color: #d4af37; font-size: 0.85rem; margin-top: 0.25rem;"><i class="fas fa-music"></i> ' + worksCount + ' ' + (lang === 'en' ? 'works' : 'brani') + '</div>' : '') +
              '</div>' +
              '<div class="concert-history-icon">' +
                '<i class="fas fa-chevron-right"></i>' +
              '</div>' +
            '</div>';
        }).join('');

        concertsList.innerHTML = concertsHTML;

        // Add click handlers to concert items
        document.querySelectorAll('.concert-history-item').forEach(function(item) {
          item.addEventListener('click', function(e) {
            e.stopPropagation();
            const concertId = this.getAttribute('data-concert-id');
            closeWorkModal();
            setTimeout(function() {
              openConcertDetailModal(concertId);
            }, 300);
          });
        });
      } else {
        concertsList.innerHTML = '<div style="text-align: center; padding: 2rem; color: var(--text-secondary);">' +
            '<i class="fas fa-calendar-times" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;"></i>' +
            '<p>' + (lang === 'en' ? 'No concerts found for this performer' : 'Nessun concerto trovato per questo artista') + '</p>' +
          '</div>';
      }
    })
    .catch(function(error) {
      console.error('Error fetching performer concerts:', error);
      concertsList.innerHTML = '<div style="text-align: center; padding: 2rem; color: var(--text-secondary);">' +
          '<i class="fas fa-exclamation-triangle" style="font-size: 3rem; margin-bottom: 1rem; color: #ff6b6b;"></i>' +
          '<p>' + (lang === 'en' ? 'Error loading concerts' : 'Errore caricamento concerti') + '</p>' +
        '</div>';
    });

  // Prevent body scroll when modal is open
  document.body.style.overflow = 'hidden';
}

// Initialize on DOM load
document.addEventListener('DOMContentLoaded', function() {
  // Modal close handlers
  const modal = document.getElementById('workConcertsModal');
  const closeBtn = document.querySelector('.work-modal-close');
  const overlay = document.querySelector('.work-modal-overlay');

  if (closeBtn) {
    closeBtn.addEventListener('click', closeWorkModal);
  }

  if (overlay) {
    overlay.addEventListener('click', closeWorkModal);
  }

  // Concert detail modal close handlers
  const concertModal = document.getElementById('concertDetailModal');
  const concertCloseBtn = document.querySelector('.concert-modal-close');
  const concertOverlay = concertModal ? concertModal.querySelector('.work-modal-overlay') : null;

  if (concertCloseBtn) {
    concertCloseBtn.addEventListener('click', closeConcertDetailModal);
  }

  if (concertOverlay) {
    concertOverlay.addEventListener('click', closeConcertDetailModal);
  }

  // ESC key handler for both modals
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      if (concertModal && concertModal.style.display === 'flex') {
        closeConcertDetailModal();
      } else if (modal && modal.style.display === 'flex') {
        closeWorkModal();
      }
    }
  });

  // Collaborators toggle
  const collabToggle = document.getElementById('collaboratorsToggle');
  if (collabToggle) {
    collabToggle.addEventListener('click', function() {
      const section = document.querySelector('.rep-collaborators');
      if (section) {
        section.classList.toggle('expanded');
      }
    });
  }

  // Work title click handlers - All Works and Composer sections
  document.querySelectorAll('.rep-work-item').forEach(function(item) {
    const titleEl = item.querySelector('.rep-work-item-title');
    if (titleEl && item.dataset.workId) {
      titleEl.style.cursor = 'pointer';
      titleEl.addEventListener('click', function(e) {
        e.stopPropagation();
        const workId = item.dataset.workId;
        const workTitle = titleEl.textContent.trim();
        const composerName = item.dataset.composerName || '';
        openWorkModal(workId, workTitle, composerName);
      });
    }
  });

  // Work cards - Highlights and upcoming sections - ENTIRE CARD CLICKABLE
  document.querySelectorAll('.rep-work-card').forEach(function(card) {
    if (card.dataset.workId) {
      card.style.cursor = 'pointer';
      card.addEventListener('click', function(e) {
        e.stopPropagation();
        const workId = card.dataset.workId;
        const titleEl = card.querySelector('.rep-work-title');
        const workTitle = titleEl ? titleEl.textContent.trim() : '';
        const composerName = card.dataset.composerName || '';
        openWorkModal(workId, workTitle, composerName);
      });
    }
  });

  // All works list (fallback for rep-work-row that are not cards)
  document.querySelectorAll('.rep-work-row:not(.rep-work-card)').forEach(function(row) {
    const titleEl = row.querySelector('.rep-work-title');
    if (titleEl && row.dataset.workId) {
      titleEl.style.cursor = 'pointer';
      titleEl.addEventListener('click', function(e) {
        e.stopPropagation();
        const workId = row.dataset.workId;
        const workTitle = titleEl.textContent.trim();
        const composerName = row.dataset.composerName || '';
        openWorkModal(workId, workTitle, composerName);
      });
    }
  });

  // Timeline view
  document.querySelectorAll('.rep-timeline-work').forEach(function(workEl) {
    const titleEl = workEl.querySelector('.rep-timeline-work-title');
    if (titleEl && workEl.dataset.workId) {
      workEl.style.cursor = 'pointer';
      workEl.addEventListener('click', function(e) {
        e.stopPropagation();
        const workId = workEl.dataset.workId;
        const workTitle = titleEl.textContent.trim();
        const composerEl = workEl.querySelector('.rep-timeline-work-composer');
        const composerName = composerEl ? composerEl.textContent.trim() : '';
        openWorkModal(workId, workTitle, composerName);
      });
    }
  });

  // Composer cards click handlers
  document.querySelectorAll('.rep-top-composer-card').forEach(function(card) {
    if (card.dataset.composerId) {
      card.addEventListener('click', function(e) {
        e.stopPropagation();
        const composerId = card.dataset.composerId;
        const composerName = card.dataset.composerName || '';
        openComposerConcertsModal(composerId, composerName);
      });
    }
  });

  // Soloist group toggle handlers
  document.querySelectorAll('.soloist-group-toggle').forEach(function(toggle) {
    toggle.addEventListener('click', function() {
      const groupId = this.getAttribute('data-group-id');
      toggleSoloistGroup(groupId);
    });
  });

  // Performer click handlers (soloists, orchestras, choruses)
  document.querySelectorAll('.clickable-performer').forEach(function(item) {
    item.addEventListener('click', function(e) {
      e.stopPropagation();
      const performerName = this.getAttribute('data-performer-name');
      const performerRole = this.getAttribute('data-performer-role');
      openPerformerConcertsModal(performerName, performerRole);
    });
  });
});
</script>
