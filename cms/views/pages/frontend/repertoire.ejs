<%
// Helper per i18n labels (come bio.ejs)
const L = (labels && labels.repertoire) ? labels.repertoire : {};
const _t = (k, def='') => { try { const v=(typeof t==='function'?t(k):''); return (v&&v!==k)?v:def; } catch { return def; } };
%>

<main class="repertoire-page">
  <!-- Hero Section -->
  <section class="repertoire-hero">
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title">
          <i class="fas fa-book-open"></i>
          <%= L.title || _t('repertoire.title', 'Repertorio') %>
        </h1>
        <p class="hero-subtitle">
          <%= L.subtitle || L.claim || 'Esplora il mio repertorio musicale' %>
        </p>
      </div>

      <!-- Stats Overview -->
      <div class="repertoire-stats">
        <div class="stat-item">
          <div class="stat-number"><%= stats.total_works %></div>
          <div class="stat-label"><%= L.total_works || 'Brani' %></div>
        </div>
        <div class="stat-item">
          <div class="stat-number"><%= stats.total_composers %></div>
          <div class="stat-label"><%= L.composers || 'Compositori' %></div>
        </div>
        <div class="stat-item">
          <div class="stat-number"><%= stats.total_genres %></div>
          <div class="stat-label"><%= L.genres || 'Generi' %></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Filters Section -->
  <section class="repertoire-filters">
    <div class="container">
      <div class="filters-container">
        <div class="filter-tabs">
          <button class="filter-tab active" data-filter="all">
            <i class="fas fa-th"></i>
            <span><%= L.all || 'Tutto' %></span>
          </button>
          <button class="filter-tab" data-filter="composers">
            <i class="fas fa-user-tie"></i>
            <span><%= L.by_composer || 'Per Compositore' %></span>
          </button>
          <button class="filter-tab" data-filter="genres">
            <i class="fas fa-list"></i>
            <span><%= L.by_genre || 'Per Genere' %></span>
          </button>
          <button class="filter-tab" data-filter="frequent">
            <i class="fas fa-star"></i>
            <span><%= L.frequently_performed || '+ Eseguiti' %></span>
          </button>
          <button class="filter-tab" data-filter="coming">
            <i class="fas fa-clock"></i>
            <span><%= L.coming_soon || 'In Arrivo' %></span>
          </button>
        </div>

        <div class="search-container">
          <i class="fas fa-search"></i>
          <input type="text"
                 id="repertoireSearch"
                 class="search-input"
                 placeholder="<%= L.search_placeholder || 'Cerca brano o compositore...' %>">
        </div>
      </div>
    </div>
  </section>

  <!-- View Mode Controls -->
  <section class="repertoire-controls">
    <div class="container">
      <div class="view-mode-switcher">
        <button class="view-mode-btn active" data-view="grid">
          <i class="fas fa-th"></i>
          <span><%= L.view_grid || 'Griglia' %></span>
        </button>
        <button class="view-mode-btn" data-view="list">
          <i class="fas fa-list"></i>
          <span><%= L.view_list || 'Lista' %></span>
        </button>
        <button class="view-mode-btn" data-view="timeline">
          <i class="fas fa-stream"></i>
          <span><%= L.view_timeline || 'Timeline' %></span>
        </button>
      </div>

      <!-- Timeline Sort Options (visible only in timeline view) -->
      <div class="timeline-sort-options" style="display: none;">
        <label class="timeline-sort-label">
          <i class="fas fa-sort"></i>
          <span><%= L.timeline_sort || 'Ordina per' %>:</span>
        </label>
        <div class="timeline-sort-buttons">
          <button class="timeline-sort-btn active" data-sort="composition">
            <i class="fas fa-feather"></i>
            <span><%= L.composition_year || 'Anno composizione' %></span>
          </button>
          <button class="timeline-sort-btn" data-sort="first">
            <i class="fas fa-play"></i>
            <span><%= L.first_performance || 'Prima esecuzione' %></span>
          </button>
          <button class="timeline-sort-btn" data-sort="last">
            <i class="fas fa-clock"></i>
            <span><%= L.last_performance || 'Ultima esecuzione' %></span>
          </button>
        </div>
      </div>

      <div class="repertoire-search">
        <i class="fas fa-search"></i>
        <input type="text"
               id="repertoireQuickSearch"
               class="search-input"
               placeholder="<%= L.quick_search || 'Ricerca rapida...' %>">
      </div>
    </div>
  </section>

  <!-- Content Sections -->
  <div class="container">
    <!-- All Works View -->
    <section id="allView" class="repertoire-section active">
      <div class="section-header">
        <h2><%= L.all_works || 'Tutto il Repertorio' %></h2>
        <p class="section-subtitle"><%= works.length %> brani totali</p>
      </div>
      
      <div class="works-grid" id="allWorksGrid">
        <% works.forEach(work => { %>
          <%- include('../../partials/frontend/work-card', { work }) %>
        <% }) %>
      </div>
    </section>

    <!-- Composers View -->
    <section id="composersView" class="repertoire-section">
      <div class="section-header">
        <h2><%= L.composers_title || 'Compositori' %></h2>
        <p class="section-subtitle"><%= composers.length %> compositori</p>
      </div>
      
      <div class="composers-grid">
        <% composers.forEach(composer => { %>
          <div class="composer-card" data-composer="<%= composer.name %>">
            <div class="composer-header">
              <div class="composer-avatar">
                <%= composer.name.split(' ').map(n => n[0]).join('').substring(0, 2) %>
              </div>
              <div class="composer-info">
                <h3 class="composer-name"><%= composer.name %></h3>
                <p class="composer-years">
                  <% if (composer.birth_year || composer.death_year) { %>
                    (<%= composer.birth_year || '?' %> - <%= composer.death_year || '?' %>)
                  <% } %>
                </p>
              </div>
            </div>
            <div class="composer-stats">
              <div class="composer-stat">
                <i class="fas fa-music"></i>
                <span><%= composer.works.length %> brani</span>
              </div>
              <% if (composer.frequently_performed_count > 0) { %>
                <div class="composer-stat">
                  <i class="fas fa-star"></i>
                  <span><%= composer.frequently_performed_count %> + eseguiti</span>
                </div>
              <% } %>
            </div>
            <button class="composer-expand-btn" data-composer="<%= composer.name %>">
              <i class="fas fa-chevron-down"></i>
              <span><%= L.view_works || 'Visualizza brani' %></span>
            </button>
            
            <div class="composer-works" style="display: none;">
              <% composer.works.forEach(work => { %>
                <%- include('../../partials/frontend/work-card', { work }) %>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

    <!-- Genres View -->
    <section id="genresView" class="repertoire-section">
      <div class="section-header">
        <h2><%= L.genres_title || 'Generi Musicali' %></h2>
        <p class="section-subtitle"><%= genres.length %> generi</p>
      </div>
      
      <div class="genres-grid">
        <% genres.forEach(genre => { %>
          <div class="genre-card" data-genre="<%= genre.name %>">
            <div class="genre-header">
              <div class="genre-icon">
                <% if (genre.name === 'Sinfonia') { %>
                  <i class="fas fa-drum"></i>
                <% } else if (genre.name === 'Concerto') { %>
                  <i class="fas fa-guitar"></i>
                <% } else if (genre.name === 'Opera') { %>
                  <i class="fas fa-theater-masks"></i>
                <% } else if (genre.name === 'Sonata') { %>
                  <i class="fas fa-file-audio"></i>
                <% } else if (genre.name === 'Quartetto') { %>
                  <i class="fas fa-users"></i>
                <% } else { %>
                  <i class="fas fa-music"></i>
                <% } %>
              </div>
              <div class="genre-info">
                <h3 class="genre-name"><%= genre.name %></h3>
                <p class="genre-count"><%= genre.count %> brani</p>
              </div>
            </div>
            <button class="genre-expand-btn" data-genre="<%= genre.name %>">
              <i class="fas fa-chevron-down"></i>
              <span><%= L.view_works || 'Visualizza brani' %></span>
            </button>
            
            <div class="genre-works" style="display: none;">
              <% genre.works.forEach(work => { %>
                <%- include('../../partials/frontend/work-card', { work }) %>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

    <!-- Frequently Performed View -->
    <section id="frequentView" class="repertoire-section">
      <div class="section-header">
        <h2>
          <i class="fas fa-star"></i>
          <%= L.frequently_performed_title || 'Brani Più Eseguiti' %>
        </h2>
        <p class="section-subtitle">
          <%= L.frequently_performed_desc || 'Il mio repertorio principale' %>
        </p>
      </div>
      
      <% if (frequentlyPerformed.length === 0) { %>
        <div class="empty-state">
          <i class="fas fa-music"></i>
          <p><%= L.no_frequent || 'Nessun brano contrassegnato come frequentemente eseguito' %></p>
        </div>
      <% } else { %>
        <div class="works-grid">
          <% frequentlyPerformed.forEach(work => { %>
            <%- include('../../partials/frontend/work-card', { work }) %>
          <% }) %>
        </div>
      <% } %>
    </section>

    <!-- Coming Soon View -->
    <section id="comingView" class="repertoire-section">
      <div class="section-header">
        <h2>
          <i class="fas fa-clock"></i>
          <%= L.coming_soon_title || 'Repertorio in Arrivo' %>
        </h2>
        <p class="section-subtitle">
          <%= L.coming_soon_desc || 'Brani che sto attualmente studiando' %>
        </p>
      </div>
      
      <% if (comingSoon.length === 0) { %>
        <div class="empty-state">
          <i class="fas fa-music"></i>
          <p><%= L.no_coming || 'Nessun brano in studio al momento' %></p>
        </div>
      <% } else { %>
        <div class="works-grid">
          <% comingSoon.forEach(work => { %>
            <%- include('../../partials/frontend/work-card', { work }) %>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>
</main>