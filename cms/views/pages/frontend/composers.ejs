<%- include('partials/header') %>

<style>
.composer-hero {
  background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
  padding: 100px 0 60px;
  color: white;
  position: relative;
}

.composer-hero::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100px;
  background: linear-gradient(to top, white, transparent);
}

.composer-info {
  display: flex;
  align-items: center;
  gap: 3rem;
  position: relative;
  z-index: 1;
}

.composer-avatar {
  width: 200px;
  height: 200px;
  background: linear-gradient(135deg, #d4af37, #f4e4c1);
  border-radius: 20px;
}

.works-section {
  padding: 60px 0;
}

.works-filters {
  display: flex;
  gap: 1rem;
  margin-bottom: 2rem;
  flex-wrap: wrap;
}

.filter-btn {
  padding: 0.6rem 1.2rem;
  border: 2px solid #e0e0e0;
  background: white;
  border-radius: 25px;
  cursor: pointer;
  transition: all 0.3s;
}

.filter-btn.active {
  background: #d4af37;
  color: white;
  border-color: #d4af37;
}

.works-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
  gap: 2rem;
}

.work-card {
  background: white;
  border: 1px solid #e0e0e0;
  border-radius: 12px;
  padding: 1.5rem;
  transition: all 0.3s;
  cursor: pointer;
}

.work-card:hover {
  box-shadow: 0 8px 20px rgba(0,0,0,0.1);
  transform: translateY(-3px);
  border-color: #d4af37;
}

.work-title {
  font-size: 1.2rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  color: #2c3e50;
}

.work-meta {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-top: 1rem;
  font-size: 0.9rem;
  color: #666;
}

.work-meta span {
  display: flex;
  align-items: center;
  gap: 0.3rem;
}

.performance-badge {
  display: inline-block;
  padding: 0.3rem 0.8rem;
  background: #e8f4f8;
  color: #2c3e50;
  border-radius: 15px;
  font-size: 0.85rem;
}

.performances-section {
  background: #f8f9fa;
  padding: 60px 0;
}

.performance-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.performance-item {
  background: white;
  padding: 1.5rem;
  border-radius: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.performance-date {
  font-weight: 600;
  color: #d4af37;
}
</style>

<div class="composer-page">
  <!-- Hero Section -->
  <section class="composer-hero">
    <div class="container">
      <div class="composer-info">
        <div class="composer-avatar">
          <%= composer.full_name.split(' ').map(n => n[0]).join('') %>
        </div>
        <div class="composer-details">
          <h1><%= composer.full_name %></h1>
          <% if (composer.birth_year) { %>
          <p class="composer-lifespan">
            <%= composer.birth_year %> - <%= composer.death_year || 'presente' %>
            <% if (composer.nationality) { %>
              • <%= composer.nationality %>
            <% } %>
          </p>
          <% } %>
          <div class="composer-meta">
            <div class="meta-item">
              <i class="fas fa-music"></i>
              <span><%= totalWorks %> opere in repertorio</span>
            </div>
            <div class="meta-item">
              <i class="fas fa-calendar"></i>
              <span><%= totalPerformances %> esecuzioni totali</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Works Section -->
  <section class="works-section">
    <div class="container">
      <h2 class="section-title">Opere in Repertorio</h2>
      
      <div class="works-filters">
        <button class="filter-btn active" data-filter="all">Tutte</button>
        <% Object.keys(worksByCategory).forEach(category => { %>
        <button class="filter-btn" data-filter="<%= category.toLowerCase().replace(/\s+/g, '-') %>">
          <%= category %> (<%= worksByCategory[category].length %>)
        </button>
        <% }) %>
      </div>
      
      <div class="works-container">
        <% Object.entries(worksByCategory).forEach(([category, works]) => { %>
        <div class="category-section" data-category="<%= category.toLowerCase().replace(/\s+/g, '-') %>">
          <h3 class="category-title"><%= category %></h3>
          <div class="works-grid">
            <% works.forEach(work => { %>
            <div class="work-card" onclick="window.location.href='/repertorio/opera/<%= work.id %>'">
              <h4 class="work-title"><%= work.title %></h4>
              <% if (work.subtitle) { %>
              <p class="work-subtitle text-muted"><%= work.subtitle %></p>
              <% } %>
              <div class="work-meta">
                <% if (work.catalogue) { %>
                <span><i class="fas fa-tag"></i> <%= work.catalogue %></span>
                <% } %>
                <% if (work.year) { %>
                <span><i class="fas fa-calendar"></i> <%= work.year %></span>
                <% } %>
                <% if (work.performance_count) { %>
                <span class="performance-badge">
                  <%= work.performance_count %> esecuzioni
                </span>
                <% } %>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Recent Performances -->
  <% if (recentPerformances && recentPerformances.length > 0) { %>
  <section class="performances-section">
    <div class="container">
      <h2 class="section-title">Esecuzioni Recenti</h2>
      <div class="performance-list">
        <% recentPerformances.forEach(perf => { %>
        <div class="performance-item">
          <div>
            <h4><%= perf.title %></h4>
            <p class="text-muted"><%= perf.location %></p>
          </div>
          <div class="performance-date">
            <%= new Date(perf.date).toLocaleDateString('it-IT', { 
              year: 'numeric', 
              month: 'long', 
              day: 'numeric' 
            }) %>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const filterBtns = document.querySelectorAll('.filter-btn');
  const categorySections = document.querySelectorAll('.category-section');
  
  filterBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      const filter = this.dataset.filter;
      
      filterBtns.forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      
      categorySections.forEach(section => {
        if (filter === 'all' || section.dataset.category === filter) {
          section.style.display = 'block';
        } else {
          section.style.display = 'none';
        }
      });
    });
  });
});
</script>

