<%-
  /*
    Concerts page – SSR (hero a destra, contenuti a sinistra)
    Ingressi:
      - lang, t
      - labels (opzionale)
      - title (string), claimHTML (HTML string)
      - page: { hero_image, hero_min_height, hero_focus_y, hero_zoom }
      - upcomingConcerts: []
      - concertsByYear: [{year, concerts:[]}]
      - yearsList: [ "2024", "2023", ... ]
      - pageScripts, cssFiles (inclusi da layout)
  */
-%>
<%
  const L = labels && labels.concerts ? labels.concerts : {};
  const _t = (k, def='') => { try { const v=(typeof t==='function'?t(k):''); return (v && v!==k) ? v : def; } catch { return def; } };

  // Titolo/claim: stile universale (base.css)
  const titleTxt = typeof title === 'string' && title ? title : (L.title || _t('concerts.title', (lang==='en'?'Concerts':'Concerti')));
  const claim    = typeof claimHTML === 'string' ? claimHTML : (L.claim2 || _t('concerts.claim2', (lang==='en'?'Upcoming + archive':'Prossimi + archivio')));

  // Hero: controlli SOLO dal JSON pagina
  const minH    = Number(page?.hero_min_height) || 520;
  let   focusY  = Number(page?.hero_focus_y);
  focusY = Number.isFinite(focusY) ? Math.max(0, Math.min(100, focusY)) : 50;
  const zoomVal = Number.isFinite(Number(page?.hero_zoom)) ? Number(page.hero_zoom) : 1;
  const heroImg = page?.hero_image || '/img/daniele-camiz-indica.png';
  const heroStyle = `--concert-hero-min-h:${minH}px;--concert-hero-focus-y:${focusY}%;--concert-hero-zoom:${zoomVal};`;

  const txtUpcoming   = L.upcoming    || _t('concerts.upcoming', (lang==='en'?'Upcoming performances':'Prossimi concerti'));
  const txtPast       = L.past        || _t('concerts.past',     (lang==='en'?'Past concerts':'Concerti passati'));
  const txtDetails    = L.view_details|| _t('concerts.view_details', (lang==='en'?'View details':'Vedi dettagli'));
  const txtNoUpcoming = L.no_upcoming || _t('concerts.no_upcoming', (lang==='en'?'No scheduled concerts.':'Nessun concerto in programma.'));
  const txtMore       = L.show_more   || _t('buttons.show_more',  (lang==='en'?'Show more':'Mostra di più'));
  const txtLess       = L.show_less   || _t('buttons.show_less',  (lang==='en'?'Show less':'Mostra di meno'));

  function parseISO(d){ try{ if(!d) return null; const p=d.trim(); return new Date(p.length===10 ? (p+'T00:00:00') : p); }catch{ return null; } }
%>

<section id="concerts_section" class="concerts-layout">
  <header class="page-header">
    <h1 id="concerts_title" class="page-title"><%= titleTxt %></h1>
    <p id="concerts_claim" class="page-claim"><%- claim %></p>
  </header>

  <!-- Stats Hero -->
  <% if (stats && stats.totalConcerts > 0) { %>
    <section class="concerts-stats-hero">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number"><%= stats.totalConcerts %></div>
          <div class="stat-label"><%= lang === 'en' ? 'Concerts' : 'Concerti' %></div>
        </div>
        <div class="stat-card">
          <div class="stat-number"><%= stats.yearsCount %></div>
          <div class="stat-label"><%= lang === 'en' ? 'Years' : 'Anni' %></div>
          <div class="stat-sublabel"><%= stats.startYear %> - <%= stats.endYear %></div>
        </div>
        <div class="stat-card">
          <div class="stat-number"><%= stats.uniqueVenues %></div>
          <div class="stat-label"><%= lang === 'en' ? 'Venues' : 'Location' %></div>
        </div>
      </div>
    </section>
  <% } %>

  <div class="layout-grid">
    <!-- Colonna sinistra -->
    <div class="left-col">
      <!-- FUTURI -->
      <section id="upcoming_section" aria-labelledby="upcoming_title">
        <h2 id="upcoming_title" class="section-title"><%= txtUpcoming %></h2>

        <% if (Array.isArray(upcomingConcerts) && upcomingConcerts.length) { %>
          <div class="upcoming-table" role="list">
            <% upcomingConcerts.forEach((c, upIdx) => {
                 const poster = c.poster || c.locandina || '';
                 const hasLandingPage = c.booking_enabled && c.slug;
                 const landingUrl = hasLandingPage ? `https://${c.slug}.danielecamiz.com` : null;
                 const concertId = `concert_upcoming_${upIdx}`;
                 const dateObj = parseISO(c.date);
                 const month  = dateObj ? dateObj.toLocaleString(lang==='en'?'en-GB':'it-IT', { month:'long' }) : '';
                 const day    = dateObj ? String(dateObj.getDate()).padStart(2,'0') : '';
                 const txtBook = lang==='en' ? 'Book Now' : 'Prenota';
            %>
              <article class="up-row" role="listitem" data-concert-id="<%= concertId %>">
                <div class="up-date">
                  <div class="up-month"><%= month %></div>
                  <div class="up-day"><%= day %></div>
                </div>
                <div class="up-main">
                  <div class="up-title-row">
                    <h3 class="up-title"><%= c.title || (lang==='en'?'Concert':'Concerto') %></h3>
                    <% if (upIdx === 0) { %>
                      <span class="badge badge-upcoming"><%= lang === 'en' ? 'NEXT' : 'PROSSIMO' %></span>
                    <% } %>
                  </div>
                  <% if (c.location) { %><div class="up-place"><i class="fas fa-map-marker-alt"></i> <%= c.location %></div><% } %>
                  <% if (c.orchestra) { %><div class="up-line"><i class="fas fa-users"></i> <%= c.orchestra %></div><% } %>
                </div>
                <div class="up-cta">
                  <% if (hasLandingPage) { %>
                    <button class="btn btn-secondary" type="button"
                            onclick="openConcertPreview(null, '<%= landingUrl %>')"><%= txtDetails %></button>
                    <a href="<%= landingUrl %>" class="btn btn-primary" style="margin-left: 0.5rem;"><%= txtBook %></a>
                  <% } else { %>
                    <button class="btn btn-secondary" type="button"
                            onclick="openConcertFromDOM('<%= concertId %>')"><%= txtDetails %></button>
                  <% } %>
                </div>

                <!-- Dettagli completi nascosti per lightbox (dal DB) -->
                <div class="concert-full-details" id="details_<%= concertId %>" style="display: none;">
                  <div class="concert-lightbox-poster-view">
                    <div class="concert-lightbox-img">
                      <% if (poster) { %><img src="<%= poster %>" alt="<%= c.title || 'Poster' %>" /><% } %>
                    </div>
                    <div class="concert-lightbox-info">
                      <h3><%= c.title || (lang==='en'?'Concert':'Concerto') %></h3>
                      <% if (c.date || c.location) { %>
                        <p style="margin:.25rem 0 1rem 0;opacity:.9;">
                          <%= c.date || '' %><% if (c.date && c.location) { %> – <% } %><%= c.location || '' %>
                        </p>
                      <% } %>

                      <% if (c.orchestra || c.conductor || c.soloists) { %>
                        <ul style="margin:.25rem 0 1rem 0;line-height:1.5;list-style:none;padding:0;">
                          <% if (c.orchestra) { %><li><strong><%= _t('concerts.orchestra','Orchestra') %>:</strong> <%= c.orchestra %></li><% } %>
                          <% if (c.conductor) { %><li><strong><%= _t('concerts.conductor','Direttore') %>:</strong> <%= c.conductor %></li><% } %>
                          <%
                            if (c.soloists) {
                              const soloistLabel = (c.soloists && (c.soloists.includes(',') || c.soloists.includes(' e ') || c.soloists.includes(' and ')))
                                ? (lang==='en' ? 'Soloists' : 'Solisti')
                                : _t('concerts.soloist','Solista');
                          %>
                            <li><strong><%= soloistLabel %>:</strong> <%= c.soloists %></li>
                          <% } %>
                        </ul>
                      <% } %>

                      <% if (c.program) { %>
                        <div style="margin:.5rem 0 0 0;">
                          <strong><%= lang==='en'?'Program':'Programma' %>:</strong>
                          <ul style="margin:.25rem 0 0 1.1rem;line-height:1.5;">
                            <% const programLines = (typeof c.program === 'string' ? c.program.split(/\r?\n/) : (Array.isArray(c.program) ? c.program : [])); %>
                            <% programLines.forEach(line => { %>
                              <% if (line.trim()) { %><li><%= line.trim() %></li><% } %>
                            <% }) %>
                          </ul>
                        </div>
                      <% } %>

                      <% if (c.notes) { %>
                        <p style="margin:.75rem 0 0 0;white-space:pre-wrap;"><%= c.notes %></p>
                      <% } %>

                      <% if (c.youtube) { %>
                        <div class="lightbox-buttons" style="margin-top: 1.5rem;">
                          <a class="btn" href="<%= c.youtube %>" target="_blank" rel="noopener">YouTube</a>
                        </div>
                      <% } %>
                    </div>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <p class="empty-state"><%= txtNoUpcoming %></p>
        <% } %>
      </section>
    </div>
  </div>

  <!-- ARCHIVIO: fisso sulla sinistra su desktop, dopo i futuri su mobile -->
  <section id="past_section" aria-labelledby="past_title">
        <h2 id="past_title" class="section-title"><%= txtPast %></h2>

        <% const pastYears = (Array.isArray(concertsByYear) ? concertsByYear : []).filter(g => (g.concerts||[]).length); %>
        <div class="year-pills" role="tablist" aria-label="Archive by year">
          <% pastYears.forEach((g) => { %>
            <button class="year-pill"
                    role="tab"
                    aria-selected="false"
                    data-year="<%= g.year %>"><%= g.year %></button>
          <% }) %>
        </div>

        <div id="year_contents">
          <% pastYears.forEach((g) => { %>
            <div class="year-content" id="year_<%= g.year %>" role="tabpanel"
                 aria-labelledby="pill_<%= g.year %>" hidden>
              <ul class="concerts-year-list">
                <% g.concerts.forEach((c, idx) => {
                     const poster = c.poster || c.locandina || '';
                     const concertId = `concert_${g.year}_${idx}`;
                %>
                  <li class="concert-item" role="listitem" style="--item-index: <%= idx %>" data-concert-id="<%= concertId %>">
                    <div class="concert-block">
                      <!-- Metà superiore: poster sx + info dx -->
                      <div class="concert-top-section">
                        <% if (poster) { %>
                          <a class="concert-thumb-link"
                             href="<%= poster %>"
                             onclick="event.preventDefault(); openConcertFromDOM('<%= concertId %>');"
                             aria-label="<%= (lang==='en'?'Open poster':'Apri locandina') %>">
                            <img class="concert-poster" src="<%= poster %>" alt="<%= c.title || 'Poster' %>" loading="lazy" />
                          </a>
                        <% } %>

                        <div class="concert-info">
                          <div class="concert-title-row">
                            <h4 class="concert-title"><%= c.title || (lang==='en'?'Concert':'Concerto') %></h4>
                            <span class="badge badge-year"><%= g.year %></span>
                          </div>
                          <% if (c.date)     { %><p class="concert-date"><i class="fas fa-calendar"></i> <%= c.date %></p><% } %>
                          <% if (c.location) { %><p class="concert-place"><i class="fas fa-map-marker-alt"></i> <%= c.location %></p><% } %>
                        </div>
                      </div>

                      <!-- Metà inferiore: programma + dettagli a tutta larghezza -->
                      <div class="concert-bottom-section">
                        <% if (c.program || c.orchestra || c.conductor || c.soloists || c.notes) { %>
                          <div class="concert-extra">
                            <% if (c.program) { %><div class="concert-program"><pre><%= c.program %></pre></div><% } %>
                            <ul class="concert-facts">
                              <% if (c.orchestra) { %><li><strong><%= _t('concerts.orchestra','Orchestra') %>:</strong> <%= c.orchestra %></li><% } %>
                              <% if (c.conductor) { %><li><strong><%= _t('concerts.conductor','Direttore') %>:</strong> <%= c.conductor %></li><% } %>
                              <%
                                if (c.soloists) {
                                  const soloistLabel = (c.soloists && (c.soloists.includes(',') || c.soloists.includes(' e ') || c.soloists.includes(' and ')))
                                    ? (lang==='en' ? 'Soloists' : 'Solisti')
                                    : _t('concerts.soloist','Solista');
                              %>
                                <li><strong><%= soloistLabel %>:</strong> <%= c.soloists %></li>
                              <% } %>
                              <% if (c.notes)     { %><li><strong>Note:</strong> <%= c.notes %></li><% } %>
                            </ul>
                          </div>
                        <% } %>

                        <% if (c.youtube) { %>
                          <div class="concert-actions">
                            <a class="btn" href="<%= c.youtube %>" target="_blank" rel="noopener">YouTube</a>
                          </div>
                        <% } %>
                      </div>

                      <!-- Dettagli completi nascosti per lightbox (dal DB) -->
                      <div class="concert-full-details" id="details_<%= concertId %>" style="display: none;">
                          <div class="concert-lightbox-poster-view">
                            <div class="concert-lightbox-img">
                              <% if (poster) { %><img src="<%= poster %>" alt="<%= c.title || 'Poster' %>" /><% } %>
                            </div>
                            <div class="concert-lightbox-info">
                              <h3><%= c.title || (lang==='en'?'Concert':'Concerto') %></h3>
                              <% if (c.date || c.location) { %>
                                <p style="margin:.25rem 0 1rem 0;opacity:.9;">
                                  <%= c.date || '' %><% if (c.date && c.location) { %> – <% } %><%= c.location || '' %>
                                </p>
                              <% } %>

                              <% if (c.orchestra || c.conductor || c.soloists) { %>
                                <ul style="margin:.25rem 0 1rem 0;line-height:1.5;list-style:none;padding:0;">
                                  <% if (c.orchestra) { %><li><strong><%= _t('concerts.orchestra','Orchestra') %>:</strong> <%= c.orchestra %></li><% } %>
                                  <% if (c.conductor) { %><li><strong><%= _t('concerts.conductor','Direttore') %>:</strong> <%= c.conductor %></li><% } %>
                                  <% if (c.soloists) { %><li><strong><%= _t('concerts.soloist','Solista') %>:</strong> <%= c.soloists %></li><% } %>
                                </ul>
                              <% } %>

                              <% if (c.program) { %>
                                <div style="margin:.5rem 0 0 0;">
                                  <strong><%= lang==='en'?'Program':'Programma' %>:</strong>
                                  <ul style="margin:.25rem 0 0 1.1rem;line-height:1.5;">
                                    <% const programLines = (typeof c.program === 'string' ? c.program.split(/\r?\n/) : (Array.isArray(c.program) ? c.program : [])); %>
                                    <% programLines.forEach(line => { %>
                                      <% if (line.trim()) { %><li><%= line.trim() %></li><% } %>
                                    <% }) %>
                                  </ul>
                                </div>
                              <% } %>

                              <% if (c.notes) { %>
                                <p style="margin:.75rem 0 0 0;white-space:pre-wrap;"><%= c.notes %></p>
                              <% } %>

                              <% if (c.youtube) { %>
                                <div class="lightbox-buttons" style="margin-top: 1.5rem;">
                                  <a class="btn" href="<%= c.youtube %>" target="_blank" rel="noopener">YouTube</a>
                                </div>
                              <% } %>
                            </div>
                          </div>
                        </div>
                    </div>
                  </li>
                <% }) %>
              </ul>
            </div>
          <% }) %>
        </div>
  </section>

  <!-- Colonna destra: HERO sticky (fuori dal layout-grid) -->
  <aside class="right-hero hero-concerts" style="<%= heroStyle %>">
    <div class="hero-media" aria-hidden="true">
      <img class="hero-media-img" src="<%= heroImg %>" alt="" loading="eager" />
    </div>
  </aside>

  <!-- Lightbox (NASCOSTA di default) -->
  <div id="concert_lightbox" role="dialog" aria-modal="true" tabindex="-1" hidden>
    <div class="concert-lightbox-content">
      <button class="concert-lightbox-close" aria-label="Close" onclick="closeConcertLightbox()">×</button>
      <div class="concert-lightbox-body">
        <!-- Iframe per LP (nascosto di default) -->
        <div id="concert_iframe_container" class="concert-lightbox-iframe" style="display: none;">
          <iframe id="concert_iframe" frameborder="0" allowfullscreen></iframe>
        </div>
        <!-- Poster + dettagli (il contenuto viene copiato dal DOM nascosto) -->
        <div id="concert_poster_container">
          <!-- Il contenuto viene popolato dinamicamente da openConcertFromDOM() -->
        </div>
      </div>
    </div>
  </div>
</section>