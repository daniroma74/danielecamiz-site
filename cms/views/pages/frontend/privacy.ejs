<section id="privacy_section" class="legal-section page-privacy">
  <h1 class="legal-title" id="privacy_title">
    <%= content?.title
      || labels?.title
      || ((typeof t === 'function' && t('privacy.title') !== 'privacy.title') ? t('privacy.title') : (lang === 'en' ? 'Privacy Policy' : 'Privacy Policy')) %>
  </h1>

  <% if (content?.updatedAt) { %>
    <p class="legal-updated" id="privacy_updated">
      <%= (lang === 'en' ? 'Last update: ' : 'Ultimo aggiornamento: ') + content.updatedAt %>
    </p>
  <% } %>

  <% if (content?.body) { %>
    <!-- Se esiste un corpo HTML unico, lo renderizziamo direttamente -->
    <div class="legal-body" id="privacy_body">
      <%- content.body %>
    </div>
  <% } else { %>
    <!-- Struttura a sezioni con fallback su labels -->
    <% if (content?.intro || labels?.intro) { %>
      <p class="legal-intro" id="privacy_intro">
        <%= content?.intro || labels?.intro %>
      </p>
    <% } %>

    <% const dataCollectedTitle = content?.data_collected_title || labels?.data_collected_title; %>
    <% const dataCollectedList  = content?.data_collected_list  || labels?.data_collected_list; %>
    <% if (dataCollectedTitle || (Array.isArray(dataCollectedList) && dataCollectedList.length)) { %>
      <h2 class="legal-subtitle" id="privacy_data_collected_title"><%= dataCollectedTitle %></h2>
      <% if (Array.isArray(dataCollectedList) && dataCollectedList.length) { %>
        <ul class="legal-list" id="privacy_data_collected_list">
          <% dataCollectedList.forEach(item => { %><li><%= item %></li><% }) %>
        </ul>
      <% } %>
    <% } %>

    <% if (content?.purpose_title || labels?.purpose_title) { %>
      <h2 class="legal-subtitle" id="privacy_purpose_title"><%= content?.purpose_title || labels?.purpose_title %></h2>
      <p class="legal-text" id="privacy_purpose_text"><%= content?.purpose_text || labels?.purpose_text || '' %></p>
    <% } %>

    <% if (content?.cookie_title || labels?.cookie_title) { %>
      <h2 class="legal-subtitle" id="privacy_cookie_title"><%= content?.cookie_title || labels?.cookie_title %></h2>
      <p class="legal-text" id="privacy_cookie_text"><%= content?.cookie_text || labels?.cookie_text || '' %></p>
    <% } %>

    <% if (content?.rights_title || labels?.rights_title) { %>
      <h2 class="legal-subtitle" id="privacy_rights_title"><%= content?.rights_title || labels?.rights_title %></h2>
      <p class="legal-text" id="privacy_rights_text"><%= content?.rights_text || labels?.rights_text || '' %></p>
    <% } %>

    <% if (content?.controller_title || labels?.controller_title) { %>
      <h2 class="legal-subtitle" id="privacy_controller_title"><%= content?.controller_title || labels?.controller_title %></h2>
      <p class="legal-text" id="privacy_controller_text"><%= content?.controller_text || labels?.controller_text || '' %></p>
    <% } %>
  <% } %>
</section>

<style>
  /* Stili legali coerenti con il design del sito */
  .legal-section {
    max-width: 900px;
    margin: 2rem auto 4rem;
    padding: 2.5rem;
    background: linear-gradient(135deg, rgba(255,255,255,0.02), rgba(212,175,55,0.03));
    border: 1px solid rgba(212, 175, 55, 0.15);
    border-radius: 12px;
    line-height: 1.7;
  }
  .legal-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #f4eed4;
    margin: 0 0 1rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid rgba(212, 175, 55, 0.3);
  }
  .legal-updated {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.9rem;
    font-style: italic;
    margin-bottom: 2rem;
  }
  .legal-intro {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: rgba(212, 175, 55, 0.05);
    border-left: 4px solid #d4af37;
    border-radius: 4px;
  }
  .legal-subtitle {
    font-size: 1.6rem;
    font-weight: 600;
    color: #d4af37;
    margin: 2.5rem 0 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .legal-subtitle::before {
    content: '▸';
    color: #d4af37;
    font-size: 1.2rem;
  }
  .legal-text {
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 1.5rem;
    font-size: 1rem;
  }
  .legal-list {
    margin: 1rem 0 1.5rem 1.5rem;
    color: rgba(255, 255, 255, 0.8);
  }
  .legal-list li {
    margin-bottom: 0.75rem;
    padding-left: 0.5rem;
  }
  .legal-list li::marker {
    color: #d4af37;
  }
  .legal-body {
    color: rgba(255, 255, 255, 0.8);
  }
  .legal-body h2 {
    font-size: 1.6rem;
    font-weight: 600;
    color: #d4af37;
    margin: 2.5rem 0 1rem;
  }
  .legal-body p {
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }
  .legal-body ul, .legal-body ol {
    margin: 1rem 0 1.5rem 1.5rem;
  }
  .legal-body li {
    margin-bottom: 0.75rem;
  }

  @media (max-width: 768px) {
    .legal-section {
      padding: 1.5rem 1rem;
      margin: 1rem;
    }
    .legal-title {
      font-size: 2rem;
    }
    .legal-subtitle {
      font-size: 1.3rem;
    }
  }
</style>
