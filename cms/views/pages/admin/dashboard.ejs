<div class="dashboard-grid">
  <div class="dash-card">
    <div class="dash-card__title">Benvenuto</div>
    <div class="dash-card__body">
      <p>Questa è la nuova dashboard admin. Tutte le sezioni useranno questo layout.</p>
      <button class="btn btn-primary" id="btn_fake_audit">Esegui azione fittizia (audit)</button>
    </div>
  </div>
  <div class="dash-card">
    <div class="dash-card__title">Stato</div>
    <div class="dash-card__body">
      <ul class="dash-list">
        <li>Assets: caricati correttamente</li>
        <li>Sicurezza: ensureAuthenticated attivo</li>
        <li>Audit: scrittura log abilitata</li>
      </ul>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('btn_fake_audit');
    if (btn) {
      btn.addEventListener('click', async () => {
        try {
          const res = await fetch('/admin/audit/demo', { method: 'POST' });
          const data = await res.json();
          window.Toast.show(data?.ok ? 'Audit scritto ✅' : 'Errore audit ❌');
        } catch {
          window.Toast.show('Errore audit ❌');
        }
      });
    }
  });
</script>