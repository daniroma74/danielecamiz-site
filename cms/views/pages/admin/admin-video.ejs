<div class="top-controls">
  <h1>Gestione Video</h1>
</div>
<%- include('../../partials/admin/maintenance-page-control') %>
<div class="controls">
  <button id="btn-aggiungi-video" class="btn-aggiungi">+ Aggiungi video</button>
</div>

<div id="lista-video" class="video-list"></div>

<!-- Modale aggiungi/modifica video -->
<div id="modal-video" class="modal-overlay hidden">
  <div class="modal-box">
    <span class="modal-close" id="chiudi-modal-video">&times;</span>
    <h2 id="modal-titolo">Nuovo Video</h2>
    <form id="form-video">
      <label>Titolo (IT)</label>
      <input type="text" id="titolo-it" required />
      <label>Titolo (EN)</label>
      <input type="text" id="titolo-en" />
      
      <label>Descrizione (IT)</label>
      <textarea id="descrizione-it"></textarea>
      <label>Descrizione (EN)</label>
      <textarea id="descrizione-en"></textarea>

      <label>URL YouTube</label>
      <input type="url" id="url-youtube" required placeholder="https://www.youtube.com/watch?v=..." />
      
      <button type="submit" class="save-btn">Salva Video</button>
    </form>
  </div>
</div>