<h1>Pannello Admin – Concerti</h1>
<%- include('../../partials/admin/maintenance-page-control') %>
<div class="aggiungi-wrapper">
  <button id="btn-nuovo-concerto" class="btn-aggiungi">+ Aggiungi concerto</button>
</div>
<!-- Modal Nuovo Concerto -->
<div id="modal-nuovo-concerto" class="modal-overlay hidden">
  <div class="modal-box">
    <span class="modal-close" id="chiudi-nuovo-concerto">&times;</span>
    <h2>Aggiungi Nuovo Concerto</h2>
    <form id="form-nuovo-concerto">
      <div class="concert-entry">
        <label for="new-data">Data:</label>
        <input type="date" id="new-data" required />
        <label for="new-luogo">Luogo:</label>
        <input type="text" id="new-luogo" />
        <label for="new-titolo">Titolo:</label>
        <input type="text" id="new-titolo" />
        <label for="new-solisti">Solisti:</label>
        <textarea id="new-solisti"></textarea>
        <label for="new-programma">Programma:</label>
        <textarea id="new-programma"></textarea>
        <label for="new-eventbrite">Link Eventbrite:</label>
        <input type="url" id="new-eventbrite" />
        <label for="new-youtube">Link YouTube:</label>
        <input type="url" id="new-youtube" />
        <label for="new-locandina">Carica locandina:</label>
        <input type="file" id="new-locandina" accept="image/*" />
        <div class="anteprima-locandina" id="preview-locandina"></div>
        <p class="note">Le locandine dei concerti passati saranno caricate automaticamente su Cloudinary.</p>
        <button type="submit" class="save-btn">Salva Concerto</button>
      </div>
    </form>
  </div>
</div>

<!-- Timeline concerti -->
<div id="timeline-concerti" class="concerti-container"></div>

<!-- Modal Modifica Concerto -->
<div id="modal-modifica-concerto" class="modal-overlay hidden">
  <div class="modal-box">
    <button id="chiudi-modifica-concerto" class="btn-chiudi">&times;</button>
    <h2>Modifica Concerto</h2>
    <form id="form-modifica-concerto">
      <label>Data</label>
      <input type="date" id="edit-data" name="edit-data" required />
      <label>Luogo</label>
      <input type="text" id="edit-luogo" name="edit-luogo" />
      <label>Titolo</label>
      <input type="text" id="edit-titolo" name="edit-titolo" />
      <label>Solisti</label>
      <textarea id="edit-solisti" name="edit-solisti" rows="2"></textarea>
      <label>Programma</label>
      <textarea id="edit-programma" name="edit-programma" rows="4"></textarea>
      <label>Link Eventbrite</label>
      <input type="url" id="edit-eventbrite" name="edit-eventbrite" />
      <label>Link YouTube</label>
      <input type="url" id="edit-youtube" name="edit-youtube" />
      <label>Locandina</label>
      <input type="file" id="edit-locandina" name="edit-locandina" accept="image/*" />
      <div id="edit-locandina-preview" class="preview-locandina"></div>
      <div class="modale-btns">
        <button type="button" id="btn-salva-modifiche" class="btn-salva">Salva modifiche</button>
        <button type="button" id="btn-elimina-concerto" class="btn-elimina">Elimina concerto</button>
      </div>
    </form>
  </div>
</div>