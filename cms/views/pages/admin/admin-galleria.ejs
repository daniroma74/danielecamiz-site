<h1>Gestione Galleria</h1>
<%- include('../../partials/admin/maintenance-page-control') %>
<button id="btn-aggiungi-galleria" class="btn-aggiungi">+ Aggiungi galleria</button>

<div class="galleria-list" id="lista-gallerie"></div>

<!-- Modale Copertina -->
<div id="modale-copertina" class="modal-overlay">
  <div class="modal-box">
    <span class="modal-close" id="chiudi-copertina">&times;</span>
    <h2>Modifica Copertina</h2>
    <label>Carica Copertina:
      <input type="file" id="copertina-input" accept="image/*" />
    </label>
    <div><img id="copertina-preview" class="image-preview" alt="Anteprima copertina" /></div>
    <button id="btn-salva-copertina" class="save-btn">Salva Copertina</button>
  </div>
</div>

<!-- Modale Immagini -->
<div id="modale-immagini" class="modal-overlay">
  <div class="modal-box">
    <span class="modal-close" id="chiudi-immagini">&times;</span>
    <h2>Modifica Immagini Galleria</h2>

    <div id="preview-galleria"></div>

    <div id="upload-section">
      <label>Carica nuova immagine:
        <input type="file" id="input-immagine" accept="image/*" />
      </label>
      <div id="suggested-filename" class="seo-suggestion"></div>
      <button id="btn-upload-immagine" class="save-btn">Aggiungi immagine</button>
    </div>

    <div id="lista-immagini"></div>

    <button id="btn-salva-ordine" class="save-btn">Salva ordine</button>
  </div>
</div>