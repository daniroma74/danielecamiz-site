<h1>Pannello Admin</h1>

<button id="btnMaintenanceGlobal" class="btn-maintenance" aria-pressed="false">
  <span class="led"></span>
  <span class="btn-text"></span> <!-- Vuoto, riempito da JS -->
</button>

<div class="panel-list" role="list">
  <% 
    const panels = [
      { slug: 'bio', label: 'Bio' },
      { slug: 'concerti', label: 'Concerti' },
      { slug: 'contact', label: 'Contatti' },
      { slug: 'galleria', label: 'Galleria' },
      { slug: 'video', label: 'Video' },
      { slug: 'repertorio', label: 'Repertorio' },
      { slug: 'press', label: 'Press' },
      { slug: 'certificati', label: 'Certificati' },
      { slug: 'news', label: 'News' }
    ];
    panels.forEach(({ slug, label }) => { 
  %>
  <div class="panel-item" role="listitem">
    <button class="btn-panel" data-panel="<%= slug %>">Gestione <%= label %></button>
    <button class="btn-status" aria-label="Manutenzione <%= label %>"></button>
    <span class="status-text" style="display:none;">in manutenzione</span>
  </div>
  <% }) %>
</div>