<div class="top-controls">
  <h1>Gestione Pagina Repertorio</h1>
</div>
<%- include('../../partials/admin/maintenance-page-control') %>

<form id="form-repertorio">
  <label for="repertorio-testo-it">Testo (IT)</label>
  <textarea id="repertorio-testo-it" rows="10" placeholder="Inserisci il testo italiano..."></textarea>

  <label for="repertorio-testo-en">Testo (EN)</label>
  <textarea id="repertorio-testo-en" rows="10" placeholder="Inserisci il testo inglese..."></textarea>

  <button type="submit" class="save-btn">Salva</button>
</form>

<script>
  async function caricaRepertorio() {
    try {
      const res = await fetch('/api/repertorio');
      const data = await res.json();
      document.getElementById('repertorio-testo-it').value = data.it || '';
      document.getElementById('repertorio-testo-en').value = data.en || '';
    } catch(e) {
      alert('Errore caricando dati repertorio');
    }
  }

  document.getElementById('form-repertorio').addEventListener('submit', async e => {
    e.preventDefault();
    const it = document.getElementById('repertorio-testo-it').value.trim();
    const en = document.getElementById('repertorio-testo-en').value.trim();
    try {
      const res = await fetch('/api/repertorio', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ it, en })
      });
      if (res.ok) alert('Repertorio salvato con successo');
      else alert('Errore salvataggio repertorio');
    } catch {
      alert('Errore di rete durante il salvataggio');
    }
  });

  caricaRepertorio();
</script>