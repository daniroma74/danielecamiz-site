<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <title>Verifica 2FA</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #111;
      color: #eee;
      display: flex;
      height: 100vh;
      justify-content: center;
      align-items: center;
      margin: 0;
    }
    form {
      background: #222;
      padding: 2rem;
      border-radius: 8px;
      width: 320px;
      box-sizing: border-box;
      text-align: center;
    }
    #otp-container {
      display: flex;
      gap: 0.5em;
      justify-content: center;
      margin: 1em 0;
    }
    .otp-input {
      width: 3rem;
      height: 3rem;
      font-size: 2rem;
      text-align: center;
      border-radius: 6px;
      border: none;
      background: #444;
      color: #eee;
      outline: none;
      caret-color: #f0b700;
    }
    .otp-input:focus {
      background: #f0b700;
      color: #000;
      font-weight: bold;
    }
    label {
      display: block;
      margin-bottom: 0.6em;
      font-weight: bold;
    }
    button {
      width: 100%;
      padding: 0.6rem;
      background: #f0b700;
      border: none;
      color: #000;
      font-weight: bold;
      font-size: 1rem;
      cursor: pointer;
      border-radius: 6px;
    }
    button:hover {
      background: #ddb300;
    }
  </style>
</head>
<body>
  <form method="POST" action="/auth/2fa" class="twofa-form" onsubmit="return concatOTP()">
    <h2>Verifica codice 2FA</h2>
    <label for="otp-1">Inserisci il codice OTP da Google Authenticator</label>
    <div id="otp-container" aria-label="Inserisci codice OTP a 6 cifre" role="group">
      <input id="otp-1" type="text" maxlength="1" pattern="[0-9]" inputmode="numeric" class="otp-input" required autocomplete="one-time-code" />
      <input type="text" maxlength="1" pattern="[0-9]" inputmode="numeric" class="otp-input" required autocomplete="one-time-code" />
      <input type="text" maxlength="1" pattern="[0-9]" inputmode="numeric" class="otp-input" required autocomplete="one-time-code" />
      <input type="text" maxlength="1" pattern="[0-9]" inputmode="numeric" class="otp-input" required autocomplete="one-time-code" />
      <input type="text" maxlength="1" pattern="[0-9]" inputmode="numeric" class="otp-input" required autocomplete="one-time-code" />
      <input type="text" maxlength="1" pattern="[0-9]" inputmode="numeric" class="otp-input" required autocomplete="one-time-code" />
    </div>
    <input type="hidden" name="token" id="otp-hidden" />
    <button type="submit">Verifica</button>
  </form>

  <script>
    const inputs = document.querySelectorAll('.otp-input');
    inputs.forEach((input, idx) => {
      input.addEventListener('input', () => {
        if (input.value.length === 1 && idx < inputs.length - 1) {
          inputs[idx + 1].focus();
        }
      });
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && input.value === '' && idx > 0) {
          inputs[idx - 1].focus();
        }
      });
    });

    function concatOTP() {
      let otp = '';
      inputs.forEach(input => { otp += input.value; });
      document.getElementById('otp-hidden').value = otp;
      return true;
    }
    window.onload = () => { inputs[0].focus(); };
  </script>
</body>
</html>
