<h1>Pannello Admin – Press</h1>

<%- include('../../partials/admin/maintenance-page-control') %>

<div class="container">
  <div class="left-panel">
    <section>
      <h2>Citazioni</h2>
      <button id="add-quote" type="button">+ Aggiungi citazione</button>
      <ul id="quotes-list" class="item-list"></ul>
    </section>

    <section>
      <h2>Articoli</h2>
      <button id="add-press-article" type="button">+ Aggiungi articolo</button>
      <ul id="press-articles-list" class="item-list"></ul>
    </section>

    <button id="save-press" type="button" class="save-btn">Salva</button>
  </div>

  <div class="right-panel">
    <h2>Anteprima</h2>
    <div id="press-preview" class="preview-box"></div>
  </div>
</div>