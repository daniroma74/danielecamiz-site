      </div>
      <div class="group right">
        <button id="btn_attendance_reload" class="btn btn-secondary">Ricarica</button>
        <button id="btn_attendance_save" class="btn btn-primary">Salva presenze</button>
      </div>
    </div>

    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Nome</th>
            <th style="width:20%">Ruolo</th>
            <th style="width:120px">Presente</th>
            <th style="width:120px">Ore</th>
            <th style="width:35%">Note</th>
          </tr>
        </thead>
        <tbody id="attendance_tbody">
          <!-- popolato via JS -->
        </tbody>
      </table>
    </div>
  </section>

  <!-- PROGRAMMA -->
