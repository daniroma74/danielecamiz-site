      </table>
    </div>
  </section>

  <!-- POSTER -->
  <section id="tab_poster" class="tab-panel" role="tabpanel" aria-labelledby="tab_poster_btn" hidden>
    <div class="panel-actions">
      <div class="group" style="flex:1">
        <label for="poster_cloudinary_id">Cloudinary ID</label>
        <input id="poster_cloudinary_id" class="input" type="text" placeholder="es. icnt/posters/2025/slug-file" autocomplete="off" value="<%= event.poster_cloudinary_id || '' %>" />
      </div>
      <div class="group" style="flex:1">
        <label for="poster_local_filename">File locale</label>
        <input id="poster_local_filename" class="input" type="text" placeholder="es. 2025-10-12-concerto.jpg" autocomplete="off" value="<%= 