      <div class="group right">
        <button id="btn_program_reload" class="btn btn-secondary">Ricarica</button>
        <button id="btn_program_add" class="btn">Aggiungi</button>
        <button id="btn_program_save_order" class="btn btn-secondary">Salva ordine</button>
      </div>
    </div>

    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th style="width:56px">Ordine</th>
            <th>Titolo</th>
            <th style="width:20%">Catalogo</th>
            <th style="width:18%">Arrangiatore</th>
            <th style="width:25%">Note</th>
            <th style="width:110px">Azioni</th>
