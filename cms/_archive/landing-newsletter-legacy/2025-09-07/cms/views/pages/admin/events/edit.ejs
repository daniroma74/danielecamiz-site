      <div class="group">
        <label for="program_title">Titolo</label>
        <input id="program_title" class="input" type="text" placeholder="Es. Sinfonia n.40 in sol minore" autocomplete="off" />
      </div>
      <div class="group">
        <label for="program_catalogue">Catalogo/Opus</label>
        <input id="program_catalogue" class="input" type="text" placeholder="Es. K.550 / Op. ..." autocomplete="off" />
      </div>
      <div class="group">
        <label for="program_arranger">Arrangiatore</label>
        <input id="program_arranger" class="input" type="text" placeholder="(facoltativo)" autocomplete="off" />
      </div>
      <div class="group" style="flex:1">
        <label for="program_notes">Note</label>
        <textarea id="program_notes" class="input" rows="2" placeholder="(facoltative)"></textarea>
