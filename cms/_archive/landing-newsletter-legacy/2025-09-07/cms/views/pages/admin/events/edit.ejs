        <div id="instrument_search_results" class="dropdown"></div>
      </div>
      <div class="group">
        <label for="assignment_instrument_label">Etichetta</label>
        <input id="assignment_instrument_label" class="input" type="text" placeholder="Es. Violino I, Oboe, ecc." autocomplete="off" />
      </div>
      <div class="group">
        <label for="assignment_chair">Posto/Chair</label>
        <input id="assignment_chair" class="input" type="text" placeholder="Es. 1, 2, A, B..." autocomplete="off" />
      </div>
      <div class="group">
        <label for="assignment_desk">Leggio/Desk</label>
        <input id="assignment_desk" class="input" type="text" placeholder="(facoltativo)" autocomplete="off" />
      </div>
      <div class="group">
        <label for="assignment_artist_search">Artista</label>
        <input id="assignment_artist_search" class="input" type="text" placeholder="Cerca artista..." autocomplete="off" />
