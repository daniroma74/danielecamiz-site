<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= data.pageTitle %></title>
  <meta name="description" content="<%= data.description %>">

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/img/icons/favicon-32.png" sizes="32x32">
  <link rel="icon" type="image/png" href="/img/icons/favicon-16.png" sizes="16x16">

  <!-- Open Graph -->
  <meta property="og:title" content="<%= data.pageTitle %>">
  <meta property="og:description" content="<%= data.description %>">
  <meta property="og:image" content="<%= data.avatar %>">

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <div class="container">
    <!-- Language Toggle -->
    <div class="language-toggle">
      <a href="/set-language/<%= data.langToggle.other %>">
        <%= data.langToggle.label %>
      </a>
    </div>

    <!-- Header -->
    <header class="header">
      <div class="avatar-container">
        <img src="<%= data.avatar %>" alt="<%= data.name %>" class="avatar">
      </div>
      <h1 class="name"><%= data.name %></h1>
      <% if (data.role) { %>
        <p class="role"><%= data.role %></p>
      <% } %>
      <% if (data.bio) { %>
        <p class="bio"><%= data.bio %></p>
      <% } %>
    </header>

    <!-- Highlights Section -->
    <% if (data.highlights && data.highlights.length > 0) { %>
      <section class="section">
        <h2 class="section-title"><%= data.highlightTitle || data.highlightsTitle %></h2>
        <div class="highlights-grid">
          <% data.highlights.forEach(link => { %>
            <a href="<%= link.url %>"
               class="highlight-card"
               target="<%= link.target || '_blank' %>"
               rel="noopener noreferrer"
               data-category="highlight"
               data-label="<%= link.text %>">
              <% if (link.icon) { %>
                <img src="/img/icons/<%= link.icon %>" alt="" class="link-icon">
              <% } %>
              <span class="link-text"><%= link.text %></span>
              <% if (link.badge) { %>
                <span class="link-badge" style="background: <%= link.badgeColor || '#FFD700' %>"><%= link.badge %></span>
              <% } %>
            </a>
          <% }); %>
        </div>
      </section>
    <% } %>

    <!-- Social Links -->
    <% if (data.socialLinks && data.socialLinks.length > 0) { %>
      <section class="section">
        <h2 class="section-title"><%= data.socialTitle %></h2>
        <div class="links-container">
          <% data.socialLinks.forEach(link => { %>
            <a href="<%= link.url %>"
               class="link-item"
               target="<%= link.target || '_blank' %>"
               rel="noopener noreferrer"
               data-category="social"
               data-label="<%= link.text %>">
              <% if (link.icon) { %>
                <img src="/img/icons/<%= link.icon %>" alt="" class="link-icon">
              <% } %>
              <span class="link-text"><%= link.text %></span>
              <% if (link.badge) { %>
                <span class="link-badge" style="background: <%= link.badgeColor || '#FFD700' %>"><%= link.badge %></span>
              <% } %>
            </a>
          <% }); %>
        </div>
      </section>
    <% } %>

    <!-- Contact Links -->
    <% if (data.contactLinks && data.contactLinks.length > 0) { %>
      <section class="section">
        <h2 class="section-title"><%= data.contactTitle %></h2>
        <div class="links-container">
          <% data.contactLinks.forEach(link => { %>
            <%
              const isEmail = link.url.startsWith('mailto:');
              const isCopyable = isEmail || link.url.startsWith('tel:');
              const copyValue = isEmail ? link.url.replace('mailto:', '') : (link.url.startsWith('tel:') ? link.url.replace('tel:', '') : null);
            %>
            <a href="<%= link.url %>"
               class="link-item <%= isCopyable ? 'copyable-link' : '' %>"
               target="<%= link.target || '_blank' %>"
               rel="noopener noreferrer"
               data-category="contact"
               data-label="<%= link.text %>"
               <% if (copyValue) { %>data-copy="<%= copyValue %>"<% } %>>
              <% if (link.icon) { %>
                <img src="/img/icons/<%= link.icon %>" alt="" class="link-icon">
              <% } %>
              <span class="link-text"><%= link.text %></span>
              <% if (link.badge) { %>
                <span class="link-badge" style="background: <%= link.badgeColor || '#FFD700' %>"><%= link.badge %></span>
              <% } %>
            </a>
          <% }); %>
        </div>
      </section>
    <% } %>

    <!-- Extra Links -->
    <% if (data.extraLinks && data.extraLinks.length > 0) { %>
      <section class="section">
        <h2 class="section-title"><%= data.extraTitle %></h2>
        <div class="links-container">
          <% data.extraLinks.forEach(link => { %>
            <a href="<%= link.url %>"
               class="link-item"
               target="<%= link.target || '_blank' %>"
               rel="noopener noreferrer"
               data-category="extra"
               data-label="<%= link.text %>">
              <% if (link.icon) { %>
                <img src="/img/icons/<%= link.icon %>" alt="" class="link-icon">
              <% } %>
              <span class="link-text"><%= link.text %></span>
              <% if (link.badge) { %>
                <span class="link-badge" style="background: <%= link.badgeColor || '#FFD700' %>"><%= link.badge %></span>
              <% } %>
            </a>
          <% }); %>
        </div>
      </section>
    <% } %>

    <!-- Footer -->
    <footer class="footer">
      <p><%= data.footerText %></p>
    </footer>
  </div>

  <!-- Copy Feedback Toast -->
  <div id="copyFeedback" class="copy-feedback"></div>

  <!-- Analytics & Interactivity -->
  <script>
    (function() {
      'use strict';

      const HUB_ANALYTICS_URL = '<%= hubAnalyticsUrl %>';

      // Analytics tracking
      function trackEvent(type, category, label, value = 1) {
        if (!HUB_ANALYTICS_URL) return;

        fetch(HUB_ANALYTICS_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            module: 'contact-site',
            type: type,
            category: category,
            label: label,
            value: value
          })
        }).catch(() => {}); // Silent fail
      }

      // Track page view on load
      trackEvent('page_view', 'contact', 'landing');

      // Track link clicks
      document.addEventListener('DOMContentLoaded', function() {
        // Track all link clicks
        document.querySelectorAll('.link-item, .highlight-card').forEach(function(link) {
          link.addEventListener('click', function() {
            const category = link.dataset.category || 'unknown';
            const label = link.dataset.label || link.href;
            trackEvent('link_click', category, label);
          });
        });

        // Copy to clipboard functionality
        const copyableLinks = document.querySelectorAll('.copyable-link');
        copyableLinks.forEach(function(link) {
          link.addEventListener('click', function(e) {
            const copyValue = link.dataset.copy;
            if (!copyValue) return;

            // Only handle copy if it's a mailto: or tel: link
            if (link.href.startsWith('mailto:') || link.href.startsWith('tel:')) {
              e.preventDefault();

              // Copy to clipboard
              if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(copyValue)
                  .then(function() {
                    showCopyFeedback('<%= lang === "it" ? "Copiato!" : "Copied!" %>');
                    trackEvent('copy', 'contact', copyValue);
                  })
                  .catch(function() {
                    // Fallback: still open the link
                    window.location.href = link.href;
                  });
              } else {
                // Fallback for older browsers
                window.location.href = link.href;
              }
            }
          });
        });

        // Show copy feedback
        function showCopyFeedback(message) {
          const feedback = document.getElementById('copyFeedback');
          feedback.textContent = message;
          feedback.classList.add('show');

          setTimeout(function() {
            feedback.classList.remove('show');
          }, 3000);
        }

        // Track language toggle
        const langToggle = document.querySelector('.language-toggle a');
        if (langToggle) {
          langToggle.addEventListener('click', function() {
            trackEvent('language_change', 'ui', langToggle.textContent.trim());
          });
        }
      });
    })();
  </script>
</body>
</html>
