<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <!-- CSS TEMA CHIARO -->
  <link rel="stylesheet" href="/shared/css/admin-base.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/repertoire.css">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    .performer-card {
      background: white;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 15px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      transition: all 0.3s ease;
      border-left: 4px solid #667eea;
    }

    .performer-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    }

    .performer-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }

    .performer-name {
      font-size: 18px;
      font-weight: 700;
      color: #111827;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .performer-name i {
      color: #667eea;
    }

    .performer-instrument {
      font-size: 14px;
      color: #6b7280;
      font-style: italic;
    }

    .performer-stats {
      display: flex;
      gap: 15px;
      align-items: center;
    }

    .stat-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: #6b7280;
    }

    .stat-item i {
      color: #667eea;
    }

    .concerts-list {
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid #f3f4f6;
    }

    .concert-link {
      display: inline-block;
      padding: 4px 10px;
      margin: 4px;
      background: #f3f4f6;
      border-radius: 6px;
      color: #374151;
      text-decoration: none;
      font-size: 13px;
      transition: all 0.2s ease;
    }

    .concert-link:hover {
      background: #667eea;
      color: white;
    }

    .section-divider {
      margin: 30px 0;
      border: none;
      height: 2px;
      background: linear-gradient(to right, transparent, #e5e7eb, transparent);
    }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <!-- MAIN CONTENT -->
  <main class="admin-main">
    <!-- STATS CARDS -->
    <div class="stats-cards">
      <div class="stat-card">
        <i class="fas fa-user-music"></i>
        <div class="stat-card-content">
          <h3><%= stats.total_soloists %></h3>
          <p>Solisti</p>
        </div>
      </div>
      <div class="stat-card">
        <i class="fas fa-users"></i>
        <div class="stat-card-content">
          <h3><%= stats.total_choruses %></h3>
          <p>Cori</p>
        </div>
      </div>
      <div class="stat-card">
        <i class="fas fa-guitar"></i>
        <div class="stat-card-content">
          <h3><%= stats.total_orchestras %></h3>
          <p>Orchestre</p>
        </div>
      </div>
    </div>

    <!-- SOLOISTS SECTION -->
    <% if (instrumentGroups && instrumentGroups.length > 0) { %>
      <div class="section-header">
        <h2><i class="fas fa-user-music"></i> Solisti <span class="badge-count"><%= stats.total_soloists %></span></h2>
      </div>

      <% instrumentGroups.forEach((group, idx) => { %>
        <div style="margin-bottom: 30px;">
          <h3 style="color: #667eea; font-size: 16px; font-weight: 600; margin-bottom: 15px; padding-left: 10px; border-left: 3px solid #667eea; cursor: pointer; user-select: none; display: flex; align-items: center; gap: 10px;"
              onclick="toggleGroup('instrument-group-<%= idx %>')">
            <i class="fas fa-chevron-down" id="icon-instrument-group-<%= idx %>" style="font-size: 12px; transition: transform 0.3s; transform: rotate(-90deg);"></i>
            <span><i class="fas fa-guitar"></i> <%= group.instrument %>
            <span style="color: #9ca3af; font-size: 14px; font-weight: 400;">(<%= group.soloists.length %>)</span></span>
          </h3>

          <div id="instrument-group-<%= idx %>" style="display: none;">
          <% group.soloists.forEach(soloist => { %>
            <div class="performer-card">
              <div class="performer-header">
                <div>
                  <div class="performer-name">
                    <i class="fas fa-microphone"></i>
                    <%= soloist.name %>
                  </div>
                  <% if (soloist.displayInstrument && group.instrument === 'Voce') { %>
                    <div class="performer-instrument"><%= soloist.displayInstrument %></div>
                  <% } %>
                </div>
                <div class="performer-stats">
                  <div class="stat-item">
                    <i class="fas fa-calendar-check"></i>
                    <%= soloist.concert_count %> <%= soloist.concert_count === 1 ? 'concerto' : 'concerti' %>
                  </div>
                </div>
              </div>
              <% if (soloist.concerts && soloist.concerts.length > 0) { %>
                <div class="concerts-list">
                  <% soloist.concerts.forEach(concert => { %>
                    <a href="/admin/concert/<%= concert.id %>/edit" class="concert-link">
                      <%= concert.title %> (<%= new Date(concert.date).getFullYear() %>)
                    </a>
                  <% }) %>
                </div>
              <% } %>
            </div>
          <% }) %>
          </div>
        </div>
      <% }) %>
    <% } %>

    <!-- CHORUSES SECTION -->
    <% if (choruses && choruses.length > 0) { %>
      <hr class="section-divider">

      <div class="section-header">
        <h2><i class="fas fa-users"></i> Cori <span class="badge-count"><%= choruses.length %></span></h2>
      </div>

      <% choruses.forEach(chorus => { %>
        <div class="performer-card" style="border-left-color: #10b981;">
          <div class="performer-header">
            <div>
              <div class="performer-name">
                <i class="fas fa-music"></i>
                <%= chorus.name %>
              </div>
            </div>
            <div class="performer-stats">
              <div class="stat-item">
                <i class="fas fa-calendar-check"></i>
                <%= chorus.concert_count %> <%= chorus.concert_count === 1 ? 'concerto' : 'concerti' %>
              </div>
            </div>
          </div>
          <% if (chorus.concerts && chorus.concerts.length > 0) { %>
            <div class="concerts-list">
              <% chorus.concerts.forEach(concert => { %>
                <a href="/admin/concert/<%= concert.id %>/edit" class="concert-link">
                  <%= concert.title %> (<%= new Date(concert.date).getFullYear() %>)
                </a>
              <% }) %>
            </div>
          <% } %>
        </div>
      <% }) %>
    <% } %>

    <!-- ORCHESTRAS SECTION -->
    <% if (orchestras && orchestras.length > 0) { %>
      <hr class="section-divider">

      <div class="section-header">
        <h2><i class="fas fa-guitar"></i> Orchestre <span class="badge-count"><%= orchestras.length %></span></h2>
      </div>

      <% orchestras.forEach(orchestra => { %>
        <div class="performer-card" style="border-left-color: #f59e0b;">
          <div class="performer-header">
            <div>
              <div class="performer-name">
                <i class="fas fa-guitar"></i>
                <%= orchestra.name %>
              </div>
            </div>
            <div class="performer-stats">
              <div class="stat-item">
                <i class="fas fa-calendar-check"></i>
                <%= orchestra.concert_count %> <%= orchestra.concert_count === 1 ? 'concerto' : 'concerti' %>
              </div>
            </div>
          </div>
          <% if (orchestra.concerts && orchestra.concerts.length > 0) { %>
            <div class="concerts-list">
              <% orchestra.concerts.forEach(concert => { %>
                <a href="/admin/concert/<%= concert.id %>/edit" class="concert-link">
                  <%= concert.title %> (<%= new Date(concert.date).getFullYear() %>)
                </a>
              <% }) %>
            </div>
          <% } %>
        </div>
      <% }) %>
    <% } %>

  </main>

  <script>
    function toggleGroup(groupId) {
      const group = document.getElementById(groupId);
      const icon = document.getElementById('icon-' + groupId);

      if (group.style.display === 'none') {
        group.style.display = 'block';
        icon.style.transform = 'rotate(0deg)';
      } else {
        group.style.display = 'none';
        icon.style.transform = 'rotate(-90deg)';
      }
    }
  </script>

</body>
</html>
