<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <!-- CSS TEMA CHIARO -->
  <link rel="stylesheet" href="/shared/css/admin-base.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/repertoire.css">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    .performer-card {
      background: white;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 15px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      transition: all 0.3s ease;
      border-left: 4px solid #667eea;
    }

    .performer-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    }

    .performer-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }

    .performer-name {
      font-size: 18px;
      font-weight: 700;
      color: #111827;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .performer-name i {
      color: #667eea;
    }

    .performer-instrument {
      font-size: 14px;
      color: #6b7280;
      font-style: italic;
    }

    .performer-stats {
      display: flex;
      gap: 15px;
      align-items: center;
    }

    .stat-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: #6b7280;
    }

    .stat-item i {
      color: #667eea;
    }

    .concerts-list {
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid #f3f4f6;
    }

    .concert-link {
      display: inline-block;
      padding: 4px 10px;
      margin: 4px;
      background: #f3f4f6;
      border-radius: 6px;
      color: #374151;
      text-decoration: none;
      font-size: 13px;
      transition: all 0.2s ease;
    }

    .concert-link:hover {
      background: #667eea;
      color: white;
    }

    .section-divider {
      margin: 30px 0;
      border: none;
      height: 2px;
      background: linear-gradient(to right, transparent, #e5e7eb, transparent);
    }
  </style>
</head>
<body>
  <!-- Back to Hub Button -->
  <div style="position: fixed; top: 90px; right: 30px; z-index: 10000;">
    <a href="https://hub.danielecamiz.com/dashboard" title="Torna all'Admin HUB" style="display: inline-flex; align-items: center; gap: 0.5rem; background: linear-gradient(135deg, #d4af37 0%, #b8941f 100%); color: white; padding: 0.6rem 1rem; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.9rem; box-shadow: 0 4px 12px rgba(212, 175, 55, 0.3); transition: all 0.3s ease;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      <span>Hub</span>
    </a>
  </div>

  <!-- NAVBAR -->
  <nav class="admin-nav">
    <div class="nav-container">
      <a href="/admin" class="nav-brand">
        <i class="fas fa-music"></i> Concerts Admin
      </a>
      <div class="nav-links">
        <a href="/admin/dashboard" class="<%= currentPage === 'dashboard' ? 'active' : '' %>">
          <i class="fas fa-calendar"></i> Concerti
        </a>
        <a href="/admin/repertoire" class="<%= currentPage === 'repertoire' ? 'active' : '' %>">
          <i class="fas fa-book"></i> Repertorio
        </a>
        <a href="/admin/performers" class="<%= currentPage === 'performers' ? 'active' : '' %>">
          <i class="fas fa-users"></i> Solisti & Ensemble
        </a>
        <a href="<%= stagingUrl || 'https://www.danielecamiz.com' %>/concerts" target="_blank" class="nav-link-external">
          <i class="fas fa-external-link-alt"></i> Frontend
        </a>
        <a href="/auth/logout" class="btn-logout">
          <i class="fas fa-sign-out-alt"></i> Esci
        </a>
      </div>
    </div>
  </nav>

  <!-- MAIN CONTENT -->
  <main class="admin-main">

    <!-- PAGE HEADER -->
    <div class="page-header">
      <div class="page-title-section">
        <h1><i class="fas fa-users"></i> Solisti & Ensemble</h1>
        <p class="page-subtitle">Artisti e formazioni collaboratori</p>
      </div>
    </div>

    <!-- STATS CARDS -->
    <div class="stats-cards">
      <div class="stat-card">
        <i class="fas fa-user-music"></i>
        <div class="stat-card-content">
          <h3><%= stats.total_soloists %></h3>
          <p>Solisti</p>
        </div>
      </div>
      <div class="stat-card">
        <i class="fas fa-users"></i>
        <div class="stat-card-content">
          <h3><%= stats.total_choruses %></h3>
          <p>Cori</p>
        </div>
      </div>
      <div class="stat-card">
        <i class="fas fa-guitar"></i>
        <div class="stat-card-content">
          <h3><%= stats.total_orchestras %></h3>
          <p>Orchestre</p>
        </div>
      </div>
    </div>

    <!-- SOLOISTS SECTION -->
    <% if (soloists && soloists.length > 0) { %>
      <div class="section-header">
        <h2><i class="fas fa-user-music"></i> Solisti <span class="badge-count"><%= soloists.length %></span></h2>
      </div>

      <% soloists.forEach(soloist => { %>
        <div class="performer-card">
          <div class="performer-header">
            <div>
              <div class="performer-name">
                <i class="fas fa-microphone"></i>
                <%= soloist.name %>
              </div>
              <% if (soloist.instrument) { %>
                <div class="performer-instrument"><%= soloist.instrument %></div>
              <% } %>
            </div>
            <div class="performer-stats">
              <div class="stat-item">
                <i class="fas fa-calendar-check"></i>
                <%= soloist.concert_count %> <%= soloist.concert_count === 1 ? 'concerto' : 'concerti' %>
              </div>
            </div>
          </div>
          <% if (soloist.concerts && soloist.concerts.length > 0) { %>
            <div class="concerts-list">
              <% soloist.concerts.forEach(concert => { %>
                <a href="/admin/concert/<%= concert.id %>/edit" class="concert-link">
                  <%= concert.title %> (<%= new Date(concert.date).getFullYear() %>)
                </a>
              <% }) %>
            </div>
          <% } %>
        </div>
      <% }) %>
    <% } %>

    <!-- CHORUSES SECTION -->
    <% if (choruses && choruses.length > 0) { %>
      <hr class="section-divider">

      <div class="section-header">
        <h2><i class="fas fa-users"></i> Cori <span class="badge-count"><%= choruses.length %></span></h2>
      </div>

      <% choruses.forEach(chorus => { %>
        <div class="performer-card" style="border-left-color: #10b981;">
          <div class="performer-header">
            <div>
              <div class="performer-name">
                <i class="fas fa-music"></i>
                <%= chorus.name %>
              </div>
            </div>
            <div class="performer-stats">
              <div class="stat-item">
                <i class="fas fa-calendar-check"></i>
                <%= chorus.concert_count %> <%= chorus.concert_count === 1 ? 'concerto' : 'concerti' %>
              </div>
            </div>
          </div>
          <% if (chorus.concerts && chorus.concerts.length > 0) { %>
            <div class="concerts-list">
              <% chorus.concerts.forEach(concert => { %>
                <a href="/admin/concert/<%= concert.id %>/edit" class="concert-link">
                  <%= concert.title %> (<%= new Date(concert.date).getFullYear() %>)
                </a>
              <% }) %>
            </div>
          <% } %>
        </div>
      <% }) %>
    <% } %>

    <!-- ORCHESTRAS SECTION -->
    <% if (orchestras && orchestras.length > 0) { %>
      <hr class="section-divider">

      <div class="section-header">
        <h2><i class="fas fa-guitar"></i> Orchestre <span class="badge-count"><%= orchestras.length %></span></h2>
      </div>

      <% orchestras.forEach(orchestra => { %>
        <div class="performer-card" style="border-left-color: #f59e0b;">
          <div class="performer-header">
            <div>
              <div class="performer-name">
                <i class="fas fa-guitar"></i>
                <%= orchestra.name %>
              </div>
            </div>
            <div class="performer-stats">
              <div class="stat-item">
                <i class="fas fa-calendar-check"></i>
                <%= orchestra.concert_count %> <%= orchestra.concert_count === 1 ? 'concerto' : 'concerti' %>
              </div>
            </div>
          </div>
          <% if (orchestra.concerts && orchestra.concerts.length > 0) { %>
            <div class="concerts-list">
              <% orchestra.concerts.forEach(concert => { %>
                <a href="/admin/concert/<%= concert.id %>/edit" class="concert-link">
                  <%= concert.title %> (<%= new Date(concert.date).getFullYear() %>)
                </a>
              <% }) %>
            </div>
          <% } %>
        </div>
      <% }) %>
    <% } %>

  </main>
</body>
</html>
