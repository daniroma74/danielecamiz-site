<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <!-- CSS TEMA CHIARO -->
  <link rel="stylesheet" href="/shared/css/admin-base.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/repertoire.css">
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  
  <!-- NAVBAR -->
<nav class="admin-nav">
  <div class="nav-container">
    <a href="/admin" class="nav-brand">
      <i class="fas fa-music"></i> Concerts Admin
    </a>
    <div class="nav-links">
      <a href="/admin/dashboard" class="<%= currentPage === 'dashboard' ? 'active' : '' %>">
        <i class="fas fa-calendar"></i> Concerti
      </a>
      <a href="/admin/repertoire" class="<%= currentPage === 'repertoire' ? 'active' : '' %>">
        <i class="fas fa-book"></i> Repertorio
      </a>
      <a href="<%= stagingUrl || 'https://www.danielecamiz.com' %>/concerts" target="_blank" class="nav-link-external">
        <i class="fas fa-external-link-alt"></i> Frontend
      </a>
      <a href="/auth/logout" class="btn-logout">
        <i class="fas fa-sign-out-alt"></i> Esci
      </a>
    </div>
  </div>
</nav>
  <!-- MAIN CONTENT -->
  <main class="admin-main">
    
    <!-- PAGE HEADER -->
    <div class="page-header">
      <div class="page-title-section">
        <h1><i class="fas fa-book"></i> Gestione Repertorio</h1>
        <p class="page-subtitle">Catalogo completo delle opere musicali</p>
      </div>
      <div class="header-actions">
        <button onclick="showAddWork()" class="btn btn-primary">
          <i class="fas fa-plus"></i> Nuovo Brano
        </button>
      </div>
    </div>

    <!-- STATS CARDS -->
    <div class="stats-cards">
      <div class="stat-card">
        <i class="fas fa-music"></i>
        <div class="stat-card-content">
          <h3><%= stats.total_works.count || works.length %></h3>
          <p>Brani Totali</p>
        </div>
      </div>
      <div class="stat-card">
        <i class="fas fa-user-tie"></i>
        <div class="stat-card-content">
          <h3><%= stats.total_composers.count || composers.length %></h3>
          <p>Compositori</p>
        </div>
      </div>
      <div class="stat-card">
        <i class="fas fa-folder"></i>
        <div class="stat-card-content">
          <h3><%= stats.total_categories.count || categories.length %></h3>
          <p>Categorie</p>
        </div>
      </div>
    </div>

    <!-- FILTERS -->
    <div class="filters-section">
      <form method="GET" action="/admin/repertoire">
        <div class="filters-row">
          <div class="filter-group">
            <label for="search">Cerca</label>
            <input type="text" 
                   id="search" 
                   name="search" 
                   placeholder="Titolo, compositore o catalogo..."
                   value="<%= filters.search || '' %>">
          </div>
          
          <div class="filter-group">
            <label for="composer">Compositore</label>
            <select id="composer" name="composer">
              <option value="">Tutti i compositori</option>
              <% composers.forEach(c => { %>
                <option value="<%= c.id %>" <%= filters.composer == c.id ? 'selected' : '' %>>
                  <%= c.full_name %>
                </option>
              <% }) %>
            </select>
          </div>
          
          <div class="filter-group">
            <label for="category">Categoria</label>
            <select id="category" name="category">
              <option value="">Tutte le categorie</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>" <%= filters.category == cat.id ? 'selected' : '' %>>
                  <%= cat.label_it %>
                </option>
              <% }) %>
            </select>
          </div>
          
          <div class="filter-group">
            <button type="submit" class="btn btn-primary">
              <i class="fas fa-filter"></i> Filtra
            </button>
          </div>
        </div>
      </form>
    </div>

    <!-- WORKS TABLE -->
    <div class="works-table-container">
      <table class="works-table">
        <thead>
          <tr>
            <th>Brano</th>
            <th>Compositore</th>
            <th>Catalogo</th>
            <th>Categoria</th>
            <th>Esecuzioni</th>
            <th class="actions-cell">Azioni</th>
          </tr>
        </thead>
        <tbody>
          <% if (works && works.length > 0) { %>
            <% works.forEach(work => { %>
              <tr>
                <td>
                  <div class="work-title">
                    <strong><%= work.title %></strong>
                    <% if (work.subtitle) { %>
                      <small><%= work.subtitle %></small>
                    <% } %>
                  </div>
                </td>
                <td class="work-composer">
                  <%= work.composer_name || work.composer_short || '-' %>
                </td>
                <td class="work-catalogue">
                  <%= work.catalogue || '-' %>
                </td>
                <td>
                  <span class="category-badge">
                    <%= work.category_label || 'Non categorizzato' %>
                  </span>
                </td>
                <td>
                  <div class="stats-badges">
                    <% if (work.past_count > 0) { %>
                      <span class="stat-badge past">
                        <i class="fas fa-check-circle"></i>
                        <%= work.past_count %>
                      </span>
                    <% } %>
                    <% if (work.future_count > 0) { %>
                      <span class="stat-badge future">
                        <i class="fas fa-calendar-plus"></i>
                        <%= work.future_count %>
                      </span>
                    <% } %>
                    <% if (work.past_count === 0 && work.future_count === 0) { %>
                      <span class="text-muted">-</span>
                    <% } %>
                  </div>
                </td>
                <td class="actions-cell">
                  <div class="action-buttons">
                    <button onclick="editWork(<%= work.id %>)" 
                            class="btn-icon" 
                            title="Modifica brano">
                      <i class="fas fa-edit"></i>
                    </button>
                    <button onclick="showWorkDetails(<%= work.id %>)" 
                            class="btn-icon btn-movements" 
                            title="Dettagli e movimenti">
                      <i class="fas fa-list"></i>
                    </button>
                    <button onclick="deleteWork(<%= work.id %>, '<%= work.title.replace(/'/g, "\\'") %>')" 
                            class="btn-icon btn-danger" 
                            title="Elimina brano">
                      <i class="fas fa-trash"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6">
                <div class="empty-state">
                  <i class="fas fa-music fa-3x"></i>
                  <h3>Nessun brano trovato</h3>
                  <p>Aggiungi il primo brano al repertorio</p>
                  <button onclick="showAddWork()" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Nuovo Brano
                  </button>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </main>

  <!-- MODAL NUOVO/MODIFICA BRANO -->
<div id="workModal" class="modal">
  <div class="modal-content modal-large">
    <div class="modal-header">
      <h2 id="workModalTitle">Nuovo Brano</h2>
      <button class="modal-close" onclick="closeWorkModal()">&times;</button>
    </div>
    <form id="workForm">
      <div class="modal-body">
        <input type="hidden" id="workId" name="id">
        
        <div class="work-form-grid">
          
          <!-- Prima riga: Compositore e Categoria -->
          <div class="form-group">
            <label for="composer_id">Compositore *</label>
            <select id="composer_id" name="composer_id" required>
              <option value="">Seleziona compositore</option>
              <% composers.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.full_name %></option>
              <% }) %>
            </select>
          </div>
          
          <div class="form-group">
            <label for="category_id">Categoria *</label>
            <select id="category_id" name="category_id" required>
              <option value="">Seleziona categoria</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>"><%= cat.label_it %></option>
              <% }) %>
            </select>
          </div>
          
          <!-- Titolo (tutta la larghezza) -->
          <div class="form-group full-width">
            <label for="title">Titolo Opera *</label>
            <input type="text" id="title" name="title" required placeholder="Sinfonia n. 40">
          </div>
          
          <!-- Sottotitolo (tutta la larghezza) -->
          <div class="form-group full-width">
            <label for="subtitle">Sottotitolo</label>
            <input type="text" id="subtitle" name="subtitle" placeholder="Grande">
          </div>
          
          <!-- Seconda riga: Catalogo, Tonalità, Anno -->
          <div class="form-group">
            <label for="catalogue">Numero Catalogo</label>
            <input type="text" id="catalogue" name="catalogue" placeholder="K. 550">
            <small class="help-text">Es: K. 550, Op. 73, BWV 1007</small>
          </div>
          
          <div class="form-group">
            <label for="work_key">Tonalità</label>
            <input type="text" id="work_key" name="work_key" placeholder="sol minore">
            <small class="help-text">Es: sol minore, Do maggiore</small>
          </div>
          
          <div class="form-group">
            <label for="year">Anno Composizione</label>
            <input type="number" id="year" name="year" min="1000" max="2100" placeholder="1788">
            <small class="help-text">Anno di composizione</small>
          </div>
          
          <!-- Note in italiano (tutta la larghezza) -->
          <div class="form-group full-width">
            <label for="notes_it">Note di Programma (IT)</label>
            <textarea id="notes_it" name="notes_it" rows="3" placeholder="Note in italiano..."></textarea>
          </div>
          
          <!-- Note in inglese (tutta la larghezza) -->
          <div class="form-group full-width">
            <label for="notes_en">Program Notes (EN)</label>
            <textarea id="notes_en" name="notes_en" rows="3" placeholder="Notes in English..."></textarea>
          </div>
          
          <!-- Media: Video e Audio -->
          <div class="form-group">
            <label for="media_video">Video URL</label>
            <input type="url" id="media_video" name="media_video" placeholder="https://youtube.com/...">
            <small class="help-text">Link video esecuzione</small>
          </div>
          
          <div class="form-group">
            <label for="media_audio">Audio URL</label>
            <input type="url" id="media_audio" name="media_audio" placeholder="https://soundcloud.com/...">
            <small class="help-text">Link audio esecuzione</small>
          </div>
          
        </div>
      </div>
      <div class="modal-footer">
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-save"></i> Salva Brano
        </button>
        <button type="button" class="btn btn-secondary" onclick="closeWorkModal()">
          <i class="fas fa-times"></i> Annulla
        </button>
      </div>
    </form>
  </div>
</div>

  <!-- SCRIPTS -->
  <script src="/js/repertoire-admin.js"></script>
</body>
</html>