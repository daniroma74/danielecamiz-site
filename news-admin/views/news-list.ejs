<!-- news-admin/views/news-list.ejs -->
<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestione News - Admin</title>
  <link rel="stylesheet" href="/shared/css/admin-base.css">
  <link rel="stylesheet" href="/static/css/news-admin.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="admin-container" style="max-width: 1400px; margin: 0 auto; padding: 2rem;">
    <!-- Tabs -->
    <%- include('../../shared/partials/admin-tabs', {
      tabs: [
        { label: 'News', url: '/news', icon: 'newspaper' },
        { label: 'Newsletter Digest', url: '/news/newsletter', icon: 'envelope' }
      ],
      currentPath: '/news',
      baseUrl: 'news'
    }) %>

    <!-- Action Button -->
    <div style="display: flex; justify-content: flex-end; margin-bottom: 1.5rem;">
      <a href="/news/new" class="btn btn-primary"><i class="fas fa-plus"></i> Nuovo Articolo</a>
    </div>

    <!-- Filtri -->
    <%- include('../../shared/partials/admin-filters', {
      filterGroups: [{
        label: 'Stato',
        filters: [
          {
            label: 'Tutti',
            url: '?status=all',
            active: status === 'all',
            icon: 'list',
            count: total
          },
          {
            label: 'Pubblicati',
            url: '?status=published',
            active: status === 'published',
            icon: 'check-circle'
          },
          {
            label: 'Bozze',
            url: '?status=draft',
            active: status === 'draft',
            icon: 'edit'
          },
          {
            label: 'Programmati',
            url: '?status=scheduled',
            active: status === 'scheduled',
            icon: 'calendar'
          }
        ]
      }]
    }) %>

    <!-- Lista news -->
    <div class="news-list">
      <% if (posts && posts.length > 0) { %>
        <table class="data-table">
          <thead>
            <tr>
              <th>Titolo</th>
              <th>Categoria</th>
              <th>Stato</th>
              <th>Data Pubblicazione</th>
              <th>Aggiornato</th>
              <th>Azioni</th>
            </tr>
          </thead>
          <tbody>
            <% posts.forEach(post => { %>
              <tr>
                <td>
                  <div class="post-title">
                    <% if (post.cover_image) { %>
                      <img src="<%= post.cover_image %>" alt="" class="post-thumb">
                    <% } %>
                    <div style="flex: 1;">
                      <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                        <strong><%= post.title_it %></strong>
                        <% if (post.newsletter_sent_at) { %>
                          <span class="badge" style="background: #4caf50; color: white; font-size: 0.7rem; padding: 0.2rem 0.5rem;" title="Newsletter inviata il <%= new Date(post.newsletter_sent_at).toLocaleDateString('it-IT') %>">
                            ✅ Newsletter
                          </span>
                        <% } else if (post.include_in_newsletter) { %>
                          <span class="badge" style="background: #4a90e2; color: white; font-size: 0.7rem; padding: 0.2rem 0.5rem;" title="Selezionato per prossima newsletter">
                            📧 In Newsletter
                          </span>
                        <% } %>
                      </div>
                      <% if (post.title_en) { %>
                        <br><small class="text-muted"><%= post.title_en %></small>
                      <% } %>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="badge badge-category"><%= post.category || 'news' %></span>
                </td>
                <td>
                  <span class="badge badge-<%= post.status %>">
                    <% if (post.status === 'published') { %>✅ Pubblicato
                    <% } else if (post.status === 'scheduled') { %>📅 Programmato
                    <% } else { %>📝 Bozza<% } %>
                  </span>
                </td>
                <td>
                  <% if (post.publish_date) { %>
                    <%= new Date(post.publish_date).toLocaleDateString('it-IT') %>
                  <% } else { %>
                    <span class="text-muted">—</span>
                  <% } %>
                </td>
                <td>
                  <small><%= new Date(post.updated_at).toLocaleDateString('it-IT') %></small>
                </td>
                <td>
                  <div class="action-buttons">
                    <a href="/news/<%= post.id %>/edit" class="btn btn-sm btn-secondary" title="Modifica">
                      <i class="fas fa-edit"></i> Modifica
                    </a>
                    <% if (post.status === 'published') { %>
                      <a href="<%= config.frontendUrl %>/news/<%= post.slug %>"
                         target="_blank"
                         class="btn btn-sm btn-info"
                         title="Visualizza su staging">
                        <i class="fas fa-eye"></i> Staging
                      </a>
                    <% } %>
                    <button onclick="deletePost(<%= post.id %>)"
                            class="btn btn-sm btn-danger"
                            title="Elimina">
                      <i class="fas fa-trash"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>

        <!-- Paginazione -->
        <% if (totalPages > 1) { %>
          <div class="pagination">
            <% if (page > 1) { %>
              <a href="?status=<%= status %>&page=<%= page - 1 %>" class="btn btn-sm">← Precedente</a>
            <% } %>
            <span class="page-info">Pagina <%= page %> di <%= totalPages %></span>
            <% if (page < totalPages) { %>
              <a href="?status=<%= status %>&page=<%= page + 1 %>" class="btn btn-sm">Successiva →</a>
            <% } %>
          </div>
        <% } %>

      <% } else { %>
        <div class="empty-state">
          <p><i class="fas fa-inbox"></i> Nessun articolo trovato</p>
          <a href="/news/new" class="btn btn-primary">Crea il primo articolo</a>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script>
    async function deletePost(id) {
      if (!confirm('Sei sicuro di voler eliminare questo articolo?')) return;
      
      try {
        const response = await fetch(`/news/${id}`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' }
        });
        
        if (response.ok) {
          alert('✅ Articolo eliminato');
          location.reload();
        } else {
          alert('❌ Errore durante l\'eliminazione');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('❌ Errore di connessione');
      }
    }
  </script>
</body>
</html>