<%- include('../../../shared/partials/admin-header.ejs', {
  panelName: 'News Admin',
  panelIcon: '📰',
  user: locals.user,
  hubUrl: process.env.HUB_URL || 'https://hub.danielecamiz.com'
}) %>

<!-- Navbar Interna News -->
<nav class="admin-subnav">
  <div class="subnav-container">
    <a href="/news" class="subnav-link <%= currentPath.startsWith('/news') && !currentPath.includes('/new') ? 'active' : '' %>">
      <i class="fas fa-list"></i> Lista News
    </a>
    <a href="/news/new" class="subnav-link <%= currentPath.includes('/new') ? 'active' : '' %>">
      <i class="fas fa-plus"></i> Nuovo
    </a>
  </div>
</nav>
