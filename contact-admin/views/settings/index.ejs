<!DOCTYPE html>
<html>
<head><title>Settings</title><link rel="stylesheet" href="/public/css/admin.css"></head>
<body>
  <%- include('../partials/nav') %>
  <main class="container">
    <h1>Settings</h1>
    <form method="POST" action="/settings">
      <label>Name: <input name="name" value="<%= settings.name || '' %>" required></label>
      <label>Role IT: <input name="role_it" value="<%= settings.role_it || '' %>"></label>
      <label>Role EN: <input name="role_en" value="<%= settings.role_en || '' %>"></label>
      <label>Bio IT: <textarea name="bio_it"><%= settings.bio_it || '' %></textarea></label>
      <label>Bio EN: <textarea name="bio_en"><%= settings.bio_en || '' %></textarea></label>
      <label>Avatar URL: <input name="avatar_url" value="<%= settings.avatar_url || '' %>"></label>
      <button type="submit" class="btn btn-primary">Save</button>
    </form>
  </main>
</body>
</html>
