<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Contact Admin</title>

  <!-- Shared admin base styles -->
  <link rel="stylesheet" href="/shared/css/admin-base.css">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Module-specific styles -->
  <link rel="stylesheet" href="/public/css/admin.css">
</head>
<body>
  <!-- Navigation -->
  <%- include('partials/nav') %>

  <!-- Dashboard Content -->
  <div class="dashboard-container">
    <h1 class="dashboard-title">
      <i class="fas fa-envelope"></i> Contact Admin Dashboard
    </h1>

    <div class="quick-links">
      <a href="/editor/visual" class="quick-link-card primary">
        <div class="card-icon"><i class="fas fa-palette"></i></div>
        <div class="card-title">Visual Editor</div>
        <div class="card-description">Gestisci link, gruppi e contenuti con drag & drop</div>
      </a>

      <a href="/settings" class="quick-link-card secondary">
        <div class="card-icon"><i class="fas fa-cog"></i></div>
        <div class="card-title">Settings</div>
        <div class="card-description">Profilo, bio e avatar</div>
      </a>

      <a href="/editor/export" class="quick-link-card tertiary">
        <div class="card-icon"><i class="fas fa-download"></i></div>
        <div class="card-title">Export</div>
        <div class="card-description">Backup dati (JSON)</div>
      </a>
    </div>
  </div>
</body>
</html>
