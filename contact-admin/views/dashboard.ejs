<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Contact Admin</title>

  <!-- Shared admin base styles -->
  <link rel="stylesheet" href="/shared/css/admin-base.css">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Module-specific styles -->
  <link rel="stylesheet" href="/public/css/admin.css">
</head>
<body>
  <%- include('partials/header') %>

  <!-- Dashboard Content -->
  <div class="dashboard-container" style="max-width: 1400px; margin: 0 auto; padding: 2rem;">
    <!-- TABS -->
    <%- include('../../shared/partials/admin-tabs', {
      tabs: [
        { label: 'Dashboard', url: '/dashboard', icon: 'home' },
        { label: 'Visual Editor', url: '/editor/visual', icon: 'palette' },
        { label: 'Settings', url: '/settings', icon: 'cog' }
      ],
      currentPath: '/dashboard',
      baseUrl: ''
    }) %>

    <!-- Stats Grid -->
    <div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
      <div class="stat-card" style="background: white; padding: 1.5rem; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); text-align: center;">
        <h3 style="margin: 0 0 0.5rem; font-size: 0.9rem; color: #666; text-transform: uppercase; font-weight: 600;">Link Totali</h3>
        <p class="stat-number" style="font-size: 2.5rem; font-weight: 700; color: var(--primary); margin: 0;"><%= stats.links || 0 %></p>
      </div>
      <div class="stat-card" style="background: white; padding: 1.5rem; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); text-align: center;">
        <h3 style="margin: 0 0 0.5rem; font-size: 0.9rem; color: #666; text-transform: uppercase; font-weight: 600;">Gruppi</h3>
        <p class="stat-number" style="font-size: 2.5rem; font-weight: 700; color: var(--primary); margin: 0;"><%= stats.groups || 0 %></p>
      </div>
      <div class="stat-card" style="background: white; padding: 1.5rem; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); text-align: center;">
        <h3 style="margin: 0 0 0.5rem; font-size: 0.9rem; color: #666; text-transform: uppercase; font-weight: 600;">Ultimo Aggiornamento</h3>
        <p class="stat-number" style="font-size: 1.2rem; font-weight: 600; color: #333; margin: 0;">
          <% if (stats.lastUpdate) { %>
            <%= new Date(stats.lastUpdate).toLocaleDateString('it-IT') %>
          <% } else { %>
            Mai
          <% } %>
        </p>
        <p style="color: #999; font-size: 0.85rem; margin: 0.5rem 0 0;">
          <% if (stats.lastUpdate) { %>
            <i class="fas fa-clock"></i> <%= new Date(stats.lastUpdate).toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' }) %>
          <% } %>
        </p>
      </div>
    </div>
  </div>
</body>
</html>
