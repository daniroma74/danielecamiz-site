<!DOCTYPE html>
<html>
<head><title><%= isEdit ? 'Edit' : 'New' %> Link</title><link rel="stylesheet" href="/public/css/admin.css"></head>
<body>
  <%- include('../partials/nav') %>
  <main class="container">
    <h1><%= isEdit ? 'Edit' : 'New' %> Link</h1>
    <form method="POST" action="<%= isEdit ? `/links/${link.id}` : '/links' %>">
      <input type="hidden" name="category" value="<%= category %>">
      <label>Title IT: <input name="title_it" value="<%= link ? link.title_it : '' %>" required></label>
      <label>Title EN: <input name="title_en" value="<%= link ? link.title_en : '' %>" required></label>
      <label>URL: <input name="url" value="<%= link ? link.url : '' %>" required></label>
      <label>Icon: <input name="icon" value="<%= link ? link.icon : '' %>"></label>
      <label>Visible: <input type="checkbox" name="visible" value="1" <%= (link && link.visible) || !link ? 'checked' : '' %>></label>
      <label>Order: <input type="number" name="order_index" value="<%= link ? link.order_index : 0 %>"></label>
      <button type="submit" class="btn btn-primary">Save</button>
      <a href="/links?category=<%= category %>">Cancel</a>
    </form>
  </main>
</body>
</html>
