<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/x-icon" href="/public/img/favicon.ico">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        
        .twofa-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            overflow: hidden;
            width: 100%;
            max-width: 420px;
            animation: slideIn 0.5s ease-out;
        }
        
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .twofa-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 40px 30px;
            text-align: center;
        }
        
        .lock-icon {
            width: 80px;
            height: 80px;
            background: white;
            border-radius: 50%;
            margin: 0 auto 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
        }
        
        .twofa-header h1 {
            color: white;
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 10px;
        }
        
        .twofa-header p {
            color: rgba(255, 255, 255, 0.9);
            font-size: 14px;
        }
        
        .user-badge {
            display: inline-block;
            background: rgba(255, 255, 255, 0.2);
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            margin-top: 10px;
            font-weight: 500;
        }
        
        .twofa-body {
            padding: 40px 30px;
        }
        
        .instruction {
            text-align: center;
            color: #666;
            margin-bottom: 30px;
            font-size: 14px;
            line-height: 1.5;
        }
        
        .error-message {
            background: #fee;
            color: #c33;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
            text-align: center;
            animation: shake 0.5s;
        }
        
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            75% { transform: translateX(10px); }
        }
        
        .code-input-container {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 30px;
        }
        
        .code-input {
            width: 45px;
            height: 55px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            font-size: 24px;
            font-weight: 600;
            text-align: center;
            transition: all 0.3s;
        }
        
        .code-input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            transform: scale(1.05);
        }
        
        .code-input.filled {
            background: #f8f9ff;
            border-color: #667eea;
        }
        
        .verify-button {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
        }
        
        .verify-button:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
        }
        
        .verify-button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .verify-button.loading {
            color: transparent;
        }
        
        .verify-button.loading::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 20px;
            height: 20px;
            margin: -10px 0 0 -10px;
            border: 2px solid white;
            border-top-color: transparent;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        .help-section {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #e0e0e0;
            text-align: center;
        }
        
        .help-link {
            color: #667eea;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: color 0.3s;
        }
        
        .help-link:hover {
            color: #5a67d8;
            text-decoration: underline;
        }
        
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-top: 10px;
            color: #999;
            font-size: 13px;
            text-decoration: none;
            transition: color 0.3s;
        }
        
        .back-link:hover {
            color: #666;
        }
        
        .security-info {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 20px;
            padding: 12px;
            background: #f8f9fa;
            border-radius: 8px;
            font-size: 13px;
            color: #666;
        }
        
        .security-info .icon {
            font-size: 16px;
        }
    </style>
</head>
<body>
    <div class="twofa-container">
        <div class="twofa-header">
            <div class="lock-icon">🔐</div>
            <h1>Verifica in Due Passaggi</h1>
            <p>Inserisci il codice dall'app di autenticazione</p>
            <div class="user-badge">👤 <%= username %></div>
        </div>
        
        <div class="twofa-body">
            <% if (error) { %>
                <div class="error-message">
                    ⚠️ <%= error %>
                </div>
            <% } %>
            
            <p class="instruction">
                Apri l'app di autenticazione sul tuo telefono (Google Authenticator, Authy, etc.) 
                e inserisci il codice a 6 cifre visualizzato.
            </p>
            
            <form method="POST" action="/auth/two-factor/verify" id="twoFactorForm">
                <div class="code-input-container" id="codeInputs">
                    <input type="text" class="code-input" maxlength="1" pattern="[0-9]" required>
                    <input type="text" class="code-input" maxlength="1" pattern="[0-9]" required>
                    <input type="text" class="code-input" maxlength="1" pattern="[0-9]" required>
                    <input type="text" class="code-input" maxlength="1" pattern="[0-9]" required>
                    <input type="text" class="code-input" maxlength="1" pattern="[0-9]" required>
                    <input type="text" class="code-input" maxlength="1" pattern="[0-9]" required>
                </div>
                
                <input type="hidden" name="code" id="codeValue">
                
                <button type="submit" class="verify-button" id="verifyBtn" disabled>
                    Verifica Codice
                </button>
            </form>
            
            <div class="help-section">
                <a href="#" class="help-link" onclick="showHelp(event)">
                    Non riesci ad accedere all'app?
                </a>
                <br>
                <a href="/auth/logout" class="back-link">
                    ← Torna al login
                </a>
            </div>
            
            <div class="security-info">
                <span class="icon">🔒</span>
                <span>La tua sessione è protetta con crittografia end-to-end</span>
            </div>
        </div>
    </div>
    
    <script>
        // Gestione input codice
        const inputs = document.querySelectorAll('.code-input');
        const codeValue = document.getElementById('codeValue');
        const verifyBtn = document.getElementById('verifyBtn');
        const form = document.getElementById('twoFactorForm');
        
        // Auto-focus primo input
        inputs[0].focus();
        
        // Gestione input e navigazione
        inputs.forEach((input, index) => {
            input.addEventListener('input', (e) => {
                const value = e.target.value;
                
                if (value.length === 1 && /[0-9]/.test(value)) {
                    input.classList.add('filled');
                    
                    // Passa al prossimo input
                    if (index < inputs.length - 1) {
                        inputs[index + 1].focus();
                    }
                    
                    // Controlla se tutti sono compilati
                    checkCode();
                }
            });
            
            input.addEventListener('keydown', (e) => {
                // Backspace - torna all'input precedente
                if (e.key === 'Backspace' && !input.value && index > 0) {
                    inputs[index - 1].focus();
                    inputs[index - 1].value = '';
                    inputs[index - 1].classList.remove('filled');
                }
                
                // Permetti solo numeri
                if (e.key.length === 1 && !/[0-9]/.test(e.key)) {
                    e.preventDefault();
                }
            });
            
            // Paste handling
            input.addEventListener('paste', (e) => {
                e.preventDefault();
                const pasteData = e.clipboardData.getData('text');
                const numbers = pasteData.replace(/\D/g, '').slice(0, 6);
                
                if (numbers.length === 6) {
                    numbers.split('').forEach((num, i) => {
                        inputs[i].value = num;
                        inputs[i].classList.add('filled');
                    });
                    checkCode();
                }
            });
        });
        
        function checkCode() {
            const code = Array.from(inputs).map(input => input.value).join('');
            
            if (code.length === 6) {
                codeValue.value = code;
                verifyBtn.disabled = false;
            } else {
                verifyBtn.disabled = true;
            }
        }
        
        // Form submission
        form.addEventListener('submit', function(e) {
            const btn = document.getElementById('verifyBtn');
            btn.classList.add('loading');
            btn.disabled = true;
        });
        
        // Mostra help
        function showHelp(e) {
            e.preventDefault();
            alert('Contatta l\'amministratore del sistema per assistenza con il recupero dell\'accesso.');
        }
        
        // Auto-submit quando tutti i campi sono compilati
        let autoSubmitTimer;
        inputs[inputs.length - 1].addEventListener('input', () => {
            if (!verifyBtn.disabled) {
                clearTimeout(autoSubmitTimer);
                autoSubmitTimer = setTimeout(() => {
                    form.submit();
                }, 500);
            }
        });
    </script>
</body>
</html>