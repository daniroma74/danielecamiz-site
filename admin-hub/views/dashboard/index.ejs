<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Dashboard - Admin HUB' %></title>
    <link rel="stylesheet" href="/shared/css/admin-base.css">
    <style>
        /* Admin HUB - Gold Theme */
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #e8eaf0 100%);
            min-height: 100vh;
            padding: 2rem;
        }

        .hub-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* Header Card */
        .hub-header {
            background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
            color: white;
            border-radius: var(--radius);
            padding: 2.5rem;
            margin-bottom: 2rem;
            box-shadow: var(--shadow-lg);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1.5rem;
        }

        .hub-header h1 {
            font-size: 2.5rem;
            margin: 0;
            color: white;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .hub-header h1::before {
            content: '🎯';
            font-size: 3rem;
        }

        .hub-header p {
            margin: 0.5rem 0 0 0;
            opacity: 0.95;
            font-size: 1.1rem;
        }

        .hub-header-actions {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .btn-logout {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            border: 2px solid white;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 600;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-logout:hover {
            background: white;
            color: var(--gold);
        }

        /* Modules Grid */
        .modules-section {
            margin-bottom: 2rem;
        }

        .modules-section h2 {
            font-size: 1.75rem;
            color: var(--text-primary);
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 3px solid var(--gold);
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .modules-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 1.5rem;
        }

        .module-card {
            background: var(--surface);
            border-radius: var(--radius);
            padding: 2rem;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: var(--shadow);
            border: 2px solid transparent;
            position: relative;
            overflow: hidden;
        }

        .module-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
        }

        .module-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
            border-color: var(--gold);
        }

        .module-icon {
            font-size: 3.5rem;
            margin-bottom: 1rem;
            display: block;
        }

        .module-card h3 {
            font-size: 1.4rem;
            color: var(--text-primary);
            margin-bottom: 0.75rem;
        }

        .module-card p {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 1rem;
        }

        .module-status {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.4rem 1rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-active {
            background: rgba(39, 174, 96, 0.15);
            color: var(--success);
            border: 1px solid var(--success);
        }

        .status-planned {
            background: rgba(52, 152, 219, 0.15);
            color: var(--info);
            border: 1px solid var(--info);
        }

        .status-inactive {
            background: rgba(231, 76, 60, 0.15);
            color: var(--danger);
            border: 1px solid var(--danger);
        }

        /* Activities Section */
        .activities-card {
            background: var(--surface);
            border-radius: var(--radius);
            padding: 2rem;
            box-shadow: var(--shadow);
            margin-top: 2rem;
        }

        .activities-card h2 {
            font-size: 1.5rem;
            color: var(--text-primary);
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid var(--border);
        }

        .activity-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .activity-item {
            padding: 1rem 0;
            border-bottom: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .activity-item:last-child {
            border-bottom: none;
        }

        .activity-icon {
            font-size: 1.5rem;
        }

        .activity-description {
            flex: 1;
            color: var(--text-secondary);
            font-size: 0.95rem;
        }

        .activity-time {
            color: var(--text-muted);
            font-size: 0.85rem;
            white-space: nowrap;
        }

        /* Loading Overlay */
        .loading {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.95);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            flex-direction: column;
            gap: 1rem;
        }

        .loading.active {
            display: flex;
        }

        .loading-spinner {
            width: 60px;
            height: 60px;
            border: 5px solid var(--border);
            border-top-color: var(--gold);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        .loading-text {
            color: var(--text-primary);
            font-size: 1.1rem;
            font-weight: 600;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Error Message */
        .error-message {
            background: rgba(231, 76, 60, 0.1);
            border: 2px solid var(--danger);
            color: var(--danger);
            padding: 1rem 1.5rem;
            border-radius: var(--radius);
            margin-bottom: 1.5rem;
            display: none;
            align-items: center;
            gap: 1rem;
            font-weight: 600;
        }

        .error-message.active {
            display: flex;
        }

        .error-message::before {
            content: '⚠️';
            font-size: 1.5rem;
        }

        /* Responsive */
        @media (max-width: 768px) {
            body {
                padding: 1rem;
            }

            .hub-header {
                padding: 1.5rem;
            }

            .hub-header h1 {
                font-size: 1.75rem;
            }

            .modules-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="loading" id="loadingOverlay">
        <div class="loading-spinner"></div>
        <div class="loading-text">Accesso in corso...</div>
    </div>

    <div class="hub-container">
        <div class="hub-header">
            <div>
                <h1>Admin HUB</h1>
                <p>Benvenuto, <strong><%= user.username %></strong> | Ultimo accesso: <%= lastLogin || 'N/D' %></p>
            </div>
            <div class="hub-header-actions">
                <button class="btn-logout" onclick="logout()">
                    <span>🚪</span> Logout
                </button>
            </div>
        </div>

        <div class="error-message" id="errorMessage"></div>

        <% if (stats) { %>
        <div class="stats-grid">
            <div class="stat-card">
                <h3>⚡ Moduli Attivi</h3>
                <p class="stat-number"><%= stats.activeModules || 0 %></p>
            </div>
            <div class="stat-card">
                <h3>👥 Utenti Online</h3>
                <p class="stat-number"><%= stats.onlineUsers || 0 %></p>
            </div>
            <div class="stat-card">
                <h3>🕐 Ultima Attività</h3>
                <p class="stat-status"><%= stats.lastActivity || 'N/D' %></p>
            </div>
            <div class="stat-card">
                <h3>🔒 Sicurezza</h3>
                <p class="stat-status" style="color: <%= stats.securityStatus === 'secure' ? 'var(--success)' : 'var(--warning)' %>">
                    <%= stats.securityText || 'N/D' %>
                </p>
            </div>
        </div>
        <% } %>

        <div class="modules-section">
            <h2>🎯 Pannelli Admin Disponibili</h2>
            <div class="modules-grid">
                <% if (modules && modules.length > 0) { %>
                    <% modules.forEach(module => { %>
                        <div class="module-card"
                             data-module-id="<%= module.id %>"
                             data-module-url="<%= module.url %>"
                             style="cursor: pointer;">
                            <span class="module-icon"><%= module.icon %></span>
                            <h3><%= module.name %></h3>
                            <p><%= module.description %></p>
                            <span class="module-status status-<%= module.status %>">
                                <%= module.status === 'active' ? '✅' : module.status === 'planned' ? '📅' : '⚠️' %>
                                <%= module.status %>
                            </span>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="empty-state">
                        <i>📭</i>
                        <h3>Nessun modulo disponibile</h3>
                        <p>Contatta l'amministratore per ottenere i permessi necessari</p>
                    </div>
                <% } %>
            </div>
        </div>

        <% if (analyticsData) { %>
        <div class="analytics-section">
            <h2 style="font-size: 1.75rem; color: var(--text-primary); margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 3px solid var(--gold); display: flex; align-items: center; gap: 0.75rem;">
                📊 Analytics Dashboard (Ultimi <%= analyticsData.days %> giorni)
            </h2>

            <div class="stats-grid" style="margin-bottom: 2rem;">
                <div class="stat-card">
                    <h3>📈 Eventi Totali</h3>
                    <p class="stat-number"><%= analyticsData.totalEvents %></p>
                </div>
                <div class="stat-card">
                    <h3>🎯 Moduli Attivi</h3>
                    <p class="stat-number"><%= analyticsData.eventsByModule.length %></p>
                </div>
                <div class="stat-card">
                    <h3>🔥 Eventi/Giorno</h3>
                    <p class="stat-number"><%= Math.round(analyticsData.totalEvents / analyticsData.days) %></p>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 2rem; margin-bottom: 2rem;">
                <div style="background: white; border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow);">
                    <h3 style="margin: 0 0 1rem 0; color: var(--text-primary); font-size: 1.25rem;">Top Moduli</h3>
                    <% if (analyticsData.eventsByModule.length > 0) { %>
                        <ul style="list-style: none; padding: 0; margin: 0;">
                            <% analyticsData.eventsByModule.forEach((item, index) => { %>
                                <li style="display: flex; justify-content: space-between; padding: 0.75rem 0; border-bottom: 1px solid var(--border-color);">
                                    <span style="display: flex; align-items: center; gap: 0.5rem;">
                                        <span style="font-weight: 600; color: var(--gold);">#<%= index + 1 %></span>
                                        <%= item.module_id %>
                                    </span>
                                    <span style="font-weight: 600; color: var(--text-primary);"><%= item.count %> eventi</span>
                                </li>
                            <% }) %>
                        </ul>
                    <% } else { %>
                        <p style="color: var(--text-secondary); font-style: italic;">Nessun dato disponibile</p>
                    <% } %>
                </div>

                <div style="background: white; border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow);">
                    <h3 style="margin: 0 0 1rem 0; color: var(--text-primary); font-size: 1.25rem;">Tipi di Eventi</h3>
                    <% if (analyticsData.eventsByType.length > 0) { %>
                        <ul style="list-style: none; padding: 0; margin: 0;">
                            <% analyticsData.eventsByType.forEach((item, index) => { %>
                                <li style="display: flex; justify-content: space-between; padding: 0.75rem 0; border-bottom: 1px solid var(--border-color);">
                                    <span style="display: flex; align-items: center; gap: 0.5rem;">
                                        <span style="font-weight: 600; color: var(--gold);">#<%= index + 1 %></span>
                                        <%= item.event_type %>
                                    </span>
                                    <span style="font-weight: 600; color: var(--text-primary);"><%= item.count %></span>
                                </li>
                            <% }) %>
                        </ul>
                    <% } else { %>
                        <p style="color: var(--text-secondary); font-style: italic;">Nessun dato disponibile</p>
                    <% } %>
                </div>
            </div>

            <% if (analyticsData.dailyTrend && analyticsData.dailyTrend.length > 0) { %>
            <div style="background: white; border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow); margin-bottom: 2rem;">
                <h3 style="margin: 0 0 1rem 0; color: var(--text-primary); font-size: 1.25rem;">Trend Giornaliero</h3>
                <div style="display: flex; align-items: flex-end; gap: 0.5rem; height: 150px;">
                    <% const maxCount = Math.max(...analyticsData.dailyTrend.map(d => d.count)); %>
                    <% analyticsData.dailyTrend.forEach(day => { %>
                        <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 0.5rem;">
                            <span style="font-size: 0.875rem; font-weight: 600; color: var(--text-primary);"><%= day.count %></span>
                            <div style="width: 100%; background: linear-gradient(180deg, var(--gold), var(--gold-dark)); border-radius: 4px 4px 0 0; height: <%= (day.count / maxCount) * 100 %>%;"></div>
                            <span style="font-size: 0.75rem; color: var(--text-secondary);"><%= new Date(day.date).toLocaleDateString('it-IT', { day: '2-digit', month: '2-digit' }) %></span>
                        </div>
                    <% }) %>
                </div>
            </div>
            <% } %>
        </div>
        <% } %>

        <% if (activities && activities.length > 0) { %>
        <div class="activities-card">
            <h2>📊 Attività Recenti</h2>
            <ul class="activity-list">
                <% activities.forEach(activity => { %>
                    <li class="activity-item">
                        <span class="activity-icon"><%= activity.icon %></span>
                        <span class="activity-description"><%= activity.description %></span>
                        <span class="activity-time"><%= activity.time %></span>
                    </li>
                <% }); %>
            </ul>
        </div>
        <% } %>
    </div>

    <script>
        // DOMContentLoaded event listener
        document.addEventListener('DOMContentLoaded', function() {
            // Add click listeners to all module cards
            const moduleCards = document.querySelectorAll('.module-card');
            moduleCards.forEach(card => {
                card.addEventListener('click', function() {
                    const moduleId = this.getAttribute('data-module-id');
                    const moduleUrl = this.getAttribute('data-module-url');
                    if (moduleId && moduleUrl) {
                        accessModule(moduleId, moduleUrl);
                    }
                });
            });
        });

        // Access module with JWT token generation
        async function accessModule(moduleId, moduleUrl) {
            const loadingOverlay = document.getElementById('loadingOverlay');
            const errorMessage = document.getElementById('errorMessage');

            try {
                loadingOverlay.classList.add('active');
                errorMessage.classList.remove('active');

                console.log(`[Hub] Generating JWT token for module: ${moduleId}`);

                const response = await fetch(`/api/generate-module-token/${moduleId}`, {
                    method: 'POST',
                    credentials: 'include',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                const data = await response.json();

                if (!response.ok || !data.success) {
                    throw new Error(data.message || 'Failed to generate access token');
                }

                console.log('[Hub] JWT token generated successfully');
                console.log('[Hub] Redirecting to:', moduleUrl);

                // Navigate to module
                window.location.href = moduleUrl;

            } catch (error) {
                console.error('[Hub] Error accessing module:', error);
                loadingOverlay.classList.remove('active');
                errorMessage.textContent = error.message;
                errorMessage.classList.add('active');

                setTimeout(() => {
                    errorMessage.classList.remove('active');
                }, 5000);
            }
        }

        // Logout function
        function logout() {
            if (confirm('Sei sicuro di voler uscire da Admin HUB?')) {
                window.location.href = '/auth/logout';
            }
        }
    </script>
</body>
</html>
