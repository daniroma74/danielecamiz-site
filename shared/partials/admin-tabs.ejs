<!-- shared/partials/admin-tabs.ejs -->
<!-- Tabs Navigation Component -->
<style>
  .admin-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2rem;
    border-bottom: 2px solid #e0e0e0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .admin-tabs::-webkit-scrollbar {
    height: 4px;
  }

  .admin-tabs::-webkit-scrollbar-thumb {
    background: var(--primary);
    border-radius: 2px;
  }

  .tab-link {
    background: none;
    border: none;
    padding: 1rem 1.5rem;
    cursor: pointer;
    font-size: 1rem;
    color: #666;
    border-bottom: 3px solid transparent;
    transition: all 0.3s;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tab-link:hover {
    color: var(--primary);
    background: #f9f9f9;
  }

  .tab-link.active {
    color: var(--primary);
    border-bottom-color: var(--primary);
    background: white;
  }

  .tab-link i {
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    .tab-link {
      padding: 0.875rem 1.25rem;
      font-size: 0.95rem;
    }
  }
</style>

<nav class="admin-tabs">
  <% tabs.forEach(tab => { %>
    <a href="<%= tab.url %>" class="tab-link <%= currentPath.startsWith(tab.url) || (currentPath === '/' + baseUrl && tab.url === '/' + baseUrl) ? 'active' : '' %>">
      <% if (tab.icon) { %>
        <i class="fas fa-<%= tab.icon %>"></i>
      <% } %>
      <span><%= tab.label %></span>
      <% if (tab.badge) { %>
        <span class="badge" style="background: var(--primary); color: white; padding: 0.2rem 0.5rem; border-radius: 10px; font-size: 0.8rem; margin-left: 0.25rem;">
          <%= tab.badge %>
        </span>
      <% } %>
    </a>
  <% }) %>
</nav>
