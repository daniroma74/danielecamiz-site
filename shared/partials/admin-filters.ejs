<!-- shared/partials/admin-filters.ejs -->
<!-- Filters Bar Component -->
<style>
  .filters-bar {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1.5rem;
    background: white;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .filter-group {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .filter-group label {
    font-weight: 600;
    color: #666;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .filter-btn {
    padding: 0.5rem 1rem;
    border: 1px solid #e0e0e0;
    background: white;
    color: #666;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.3s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: #fff9f0;
  }

  .filter-btn.active {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
  }

  .filter-btn .badge {
    background: rgba(0,0,0,0.1);
    padding: 0.2rem 0.5rem;
    border-radius: 10px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .filter-btn.active .badge {
    background: rgba(255,255,255,0.3);
  }

  .search-box {
    flex: 1;
    min-width: 250px;
    position: relative;
  }

  .search-box i {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: #999;
  }

  .search-box input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.5rem;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    font-size: 0.95rem;
    transition: all 0.3s;
  }

  .search-box input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
  }

  @media (max-width: 768px) {
    .filters-bar {
      flex-direction: column;
      align-items: stretch;
    }

    .filter-group {
      flex-wrap: wrap;
    }

    .search-box {
      width: 100%;
      min-width: auto;
    }
  }
</style>

<div class="filters-bar">
  <% if (locals.search) { %>
    <div class="search-box">
      <i class="fas fa-search"></i>
      <input
        type="text"
        id="<%= search.id || 'search-input' %>"
        placeholder="<%= search.placeholder || 'Cerca...' %>"
        value="<%= search.value || '' %>"
        <% if (search.onInput) { %>
          oninput="<%= search.onInput %>"
        <% } %>
      >
    </div>
  <% } %>

  <% if (locals.filterGroups) { %>
    <% filterGroups.forEach(group => { %>
      <div class="filter-group">
        <% if (group.label) { %>
          <label><%= group.label %>:</label>
        <% } %>
        <% group.filters.forEach(filter => { %>
          <a
            href="<%= filter.url %>"
            class="filter-btn <%= filter.active ? 'active' : '' %>"
          >
            <% if (filter.icon) { %>
              <i class="fas fa-<%= filter.icon %>"></i>
            <% } %>
            <%= filter.label %>
            <% if (filter.count !== undefined) { %>
              <span class="badge"><%= filter.count %></span>
            <% } %>
          </a>
        <% }) %>
      </div>
    <% }) %>
  <% } %>
</div>
