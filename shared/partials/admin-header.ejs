<%
  // Admin Header Unificato - Usato da tutti i pannelli admin
  const panelName = locals.panelName || 'Admin Panel';
  const hubUrl = locals.hubUrl || process.env.HUB_URL || 'https://hub.danielecamiz.com';
  const userName = locals.user?.username || locals.user?.name || 'Admin';
  const panelIcon = locals.panelIcon || '⚙️';
%>
<header class="admin-header">
  <div class="admin-header__container">
    <!-- Left: Back to HUB + Panel Name -->
    <div class="admin-header__left">
      <a href="<%= hubUrl %>" class="admin-header__hub-link" title="Torna all'Admin HUB">
        <svg class="admin-header__hub-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span class="admin-header__hub-text">HUB</span>
      </a>
      <div class="admin-header__divider"></div>
      <h1 class="admin-header__title">
        <span class="admin-header__icon"><%= panelIcon %></span>
        <span class="admin-header__name"><%= panelName %></span>
      </h1>
    </div>

    <!-- Right: Actions -->
    <div class="admin-header__right">
      <a href="/logout" class="admin-header__logout" title="Logout">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        <span class="admin-header__logout-text">Esci</span>
      </a>

      <!-- Mobile Menu Toggle -->
      <button class="admin-header__mobile-toggle" aria-label="Menu" id="mobileMenuToggle">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div class="admin-header__mobile-menu" id="mobileMenu">
    <a href="<%= hubUrl %>" class="admin-header__mobile-item">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
      </svg>
      <span>Torna all'HUB</span>
    </a>
    <div class="admin-header__mobile-divider"></div>
    <a href="/logout" class="admin-header__mobile-item admin-header__mobile-logout">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
        <polyline points="16 17 21 12 16 7"></polyline>
        <line x1="21" y1="12" x2="9" y2="12"></line>
      </svg>
      <span>Logout</span>
    </a>
  </div>
</header>

<script>
  // Mobile menu toggle
  (function() {
    const toggle = document.getElementById('mobileMenuToggle');
    const menu = document.getElementById('mobileMenu');

    if (toggle && menu) {
      toggle.addEventListener('click', function(e) {
        e.stopPropagation();
        toggle.classList.toggle('active');
        menu.classList.toggle('active');
      });

      // Close on click outside
      document.addEventListener('click', function(e) {
        if (!menu.contains(e.target) && !toggle.contains(e.target)) {
          toggle.classList.remove('active');
          menu.classList.remove('active');
        }
      });

      // Close on ESC
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          toggle.classList.remove('active');
          menu.classList.remove('active');
        }
      });
    }
  })();
</script>
