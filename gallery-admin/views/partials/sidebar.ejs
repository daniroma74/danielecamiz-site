<aside class="sidebar">
  <div class="sidebar-header">
    <h2>Gallery Admin</h2>
  </div>
  <nav class="sidebar-nav">
    <a href="/gallery" class="nav-item <%= currentPath === '/gallery' || currentPath === '/' ? 'active' : '' %>">
      <span class="icon">📊</span>
      <span>Dashboard</span>
    </a>
    <a href="/gallery/collections" class="nav-item <%= currentPath.startsWith('/gallery/collections') ? 'active' : '' %>">
      <span class="icon">📚</span>
      <span>Collezioni</span>
    </a>
    <a href="/gallery/media" class="nav-item <%= currentPath.startsWith('/gallery/media') || currentPath.startsWith('/gallery/photos') || currentPath.startsWith('/gallery/videos') || currentPath.startsWith('/gallery/audios') ? 'active' : '' %>">
      <span class="icon">🎨</span>
      <span>Media Manager</span>
    </a>
  </nav>
  <div class="sidebar-footer">
    <a href="https://staging.danielecamiz.com/gallery" target="_blank" class="btn btn-sm btn-outline">
      Staging Gallery
    </a>
  </div>
</aside>
