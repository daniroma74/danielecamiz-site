<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/shared/css/admin-base.css">
  <link rel="stylesheet" href="/static/css/gallery-admin.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <div class="admin-layout">
    <%- include('../partials/sidebar') %>
    <div class="main-content">
      <%- include('../partials/header') %>
      <main class="content-area">
        <div class="page-header">
          <h2>Gestione Categorie</h2>
          <button onclick="addNewCategory()" class="btn btn-primary">Nuova Categoria</button>
        </div>

        <% if (categories && categories.length > 0) { %>
          <table class="data-table">
            <thead>
              <tr>
                <th>Slug</th>
                <th>Nome (IT)</th>
                <th>Nome (EN)</th>
                <th>Immagini</th>
                <th>Ordine</th>
                <th>Azioni</th>
              </tr>
            </thead>
            <tbody>
              <% categories.forEach(cat => { %>
                <tr>
                  <td><%= cat.slug %></td>
                  <td><%= cat.name_it %></td>
                  <td><%= cat.name_en %></td>
                  <td><%= cat.image_count %></td>
                  <td><%= cat.display_order %></td>
                  <td>
                    <button onclick="editCategory(<%= cat.id %>)" class="btn btn-sm">Modifica</button>
                    <button onclick="deleteCategory(<%= cat.id %>)" class="btn btn-sm btn-danger">Elimina</button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <p>Nessuna categoria creata. <button onclick="addNewCategory()" class="btn btn-primary">Crea la prima categoria</button></p>
        <% } %>
      </main>
    </div>
  </div>

  <script>
    const categories = <%- JSON.stringify(categories) %>;
  </script>
  <script src="/static/js/gallery-admin.js"></script>
</body>
</html>
