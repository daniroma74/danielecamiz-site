<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/shared/css/admin-base.css">
  <link rel="stylesheet" href="/static/css/gallery-admin.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="/shared/cloudinary-manager/client.js"></script>
</head>
<body>
  <%- include('../../../shared/partials/admin-header') %>

  <main class="admin-container" style="max-width: 1400px; margin: 0 auto; padding: 2rem;">
        <div class="page-header">
          <h2>Gestione Immagini</h2>
          <button onclick="uploadNewImage()" class="btn btn-primary">Carica Nuova Immagine</button>
        </div>

        <div class="filters-bar" style="margin-bottom: 20px;">
          <select id="category-filter" onchange="filterByCategory(this.value)" style="padding: 8px; border-radius: 4px;">
            <option value="">Tutte le categorie</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.slug %>" <%= selectedCategory === cat.slug ? 'selected' : '' %>><%= cat.name_it %></option>
            <% }) %>
          </select>
        </div>

        <% if (images && images.length > 0) { %>
          <div class="gallery-grid">
            <% images.forEach(img => { %>
              <div class="gallery-item" data-id="<%= img.id %>">
                <img src="https://res.cloudinary.com/dnwhnz2xy/image/upload/c_fill,w_400,h_300,q_auto/<%= img.cloudinary_id %>" alt="<%= img.title_it || 'Immagine' %>">
                <div class="gallery-item-overlay">
                  <button onclick="editImage(<%= img.id %>)" class="btn btn-sm">Modifica</button>
                  <button onclick="deleteImage(<%= img.id %>)" class="btn btn-sm btn-danger">Elimina</button>
                </div>
                <div class="gallery-item-info">
                  <p><strong><%= img.title_it || 'Senza titolo' %></strong></p>
                  <p class="text-sm"><%= img.category || 'Nessuna categoria' %></p>
                  <p class="text-xs">
                    <%= img.is_published ? '✅ Pubblicata' : '⚠️ Bozza' %>
                    <%= img.is_featured ? ' | ⭐ In evidenza' : '' %>
                  </p>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p>Nessuna immagine trovata. <button onclick="uploadNewImage()" class="btn btn-primary">Carica la prima immagine</button></p>
        <% } %>
  </main>

  <script>
    const categories = <%- JSON.stringify(categories) %>;
    const images = <%- JSON.stringify(images) %>;
  </script>
  <script src="/static/js/gallery-admin.js"></script>
</body>
</html>
