<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/shared/css/admin-base.css">
  <link rel="stylesheet" href="/static/css/gallery-admin.css">
</head>
<body>
  <div class="admin-layout">
    <%- include('../partials/sidebar') %>
    <div class="main-content">
      <%- include('../partials/header') %>
      <main class="content-area">
        <div class="content-header">
          <h1>Gestione Audio</h1>
          <div class="header-actions">
            <button id="add-audio-btn" class="btn btn-primary">Aggiungi Audio</button>
          </div>
        </div>

        <% if (audios && audios.length > 0) { %>
          <div class="audios-list">
            <% audios.forEach(audio => { %>
              <div class="audio-card" data-id="<%= audio.id %>">
                <div class="audio-preview">
                  <% if (audio.bandcamp_embed_code) { %>
                    <div class="audio-embed">
                      <%- audio.bandcamp_embed_code %>
                    </div>
                  <% } else { %>
                    <div class="audio-placeholder">
                      <span class="icon-large">🎵</span>
                      <% if (audio.bandcamp_url) { %>
                        <a href="<%= audio.bandcamp_url %>" target="_blank" class="btn btn-sm">
                          Apri su Bandcamp
                        </a>
                      <% } %>
                    </div>
                  <% } %>
                </div>

                <div class="audio-info">
                  <div class="audio-header">
                    <h3><%= audio.title_it || 'Senza titolo' %></h3>
                    <div class="audio-badges">
                      <% if (!audio.is_published) { %>
                        <span class="badge">Bozza</span>
                      <% } %>
                    </div>
                  </div>

                  <% if (audio.title_en) { %>
                    <p class="subtitle"><%= audio.title_en %></p>
                  <% } %>

                  <% if (audio.description_it) { %>
                    <p class="description"><%= audio.description_it %></p>
                  <% } %>

                  <div class="audio-meta">
                    <% if (audio.duration) { %>
                      <span class="meta-item">
                        ⏱️ <%= Math.floor(audio.duration / 60) %>:<%= String(audio.duration % 60).padStart(2, '0') %>
                      </span>
                    <% } %>
                    <% if (audio.bandcamp_url) { %>
                      <span class="meta-item">
                        <a href="<%= audio.bandcamp_url %>" target="_blank">🔗 Bandcamp</a>
                      </span>
                    <% } %>
                  </div>
                </div>

                <div class="audio-actions">
                  <button class="btn btn-sm" onclick="editAudio(<%= audio.id %>)">Modifica</button>
                  <button class="btn btn-sm btn-danger" onclick="deleteAudio(<%= audio.id %>)">Elimina</button>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <span class="icon-large">🎵</span>
            <h2>Nessun audio caricato</h2>
            <p>Aggiungi audio dalla tua libreria Bandcamp</p>
            <button id="add-first-audio-btn" class="btn btn-primary">Aggiungi Audio</button>
          </div>
        <% } %>
      </main>
    </div>
  </div>

  <!-- Add/Edit Audio Modal -->
  <div id="audio-modal" class="modal" style="display: none;">
    <div class="modal-content modal-large">
      <div class="modal-header">
        <h2 id="modal-title">Aggiungi Audio</h2>
        <button class="modal-close" onclick="closeAudioModal()">&times;</button>
      </div>

      <div class="modal-body">
        <input type="hidden" id="audio-id">

        <div class="form-group">
          <label for="audio-collection">Collezione</label>
          <select id="audio-collection">
            <option value="">Nessuna collezione</option>
            <% collections.forEach(col => { %>
              <option value="<%= col.id %>"><%= col.title_it %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-section">
          <h3>Informazioni Bandcamp</h3>

          <div class="form-group">
            <label for="audio-bandcamp-url">URL Bandcamp *</label>
            <input type="url" id="audio-bandcamp-url" placeholder="https://example.bandcamp.com/track/my-track" required>
            <small>L'URL completo del brano su Bandcamp</small>
          </div>

          <div class="form-group">
            <label for="audio-bandcamp-embed">Codice Embed Bandcamp</label>
            <textarea id="audio-bandcamp-embed" rows="6" placeholder='<iframe style="border: 0; width: 350px; height: 470px;" src="..."></iframe>'></textarea>
            <small>Incolla il codice embed generato da Bandcamp</small>
            <button type="button" id="generate-embed-btn" class="btn btn-sm btn-outline" style="margin-top: 8px;">
              Genera embed dall'URL
            </button>
          </div>

          <div id="audio-embed-preview" style="display: none;">
            <h4>Anteprima Embed</h4>
            <div id="embed-preview-container"></div>
          </div>
        </div>

        <div class="form-section">
          <h3>Metadata</h3>

          <div class="form-row">
            <div class="form-group">
              <label for="audio-title-it">Titolo IT *</label>
              <input type="text" id="audio-title-it" required>
            </div>
            <div class="form-group">
              <label for="audio-title-en">Titolo EN</label>
              <input type="text" id="audio-title-en">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="audio-description-it">Descrizione IT</label>
              <textarea id="audio-description-it" rows="4"></textarea>
            </div>
            <div class="form-group">
              <label for="audio-description-en">Descrizione EN</label>
              <textarea id="audio-description-en" rows="4"></textarea>
            </div>
          </div>

          <div class="form-group">
            <label for="audio-duration">Durata (secondi)</label>
            <input type="number" id="audio-duration" min="0">
            <small>Durata del brano in secondi</small>
          </div>

          <div class="form-group">
            <label for="audio-display-order">Ordine di visualizzazione</label>
            <input type="number" id="audio-display-order" value="0" min="0">
          </div>

          <div class="form-group">
            <label class="checkbox-label">
              <input type="checkbox" id="audio-is-published" checked>
              Pubblicato
            </label>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-outline" onclick="closeAudioModal()">Annulla</button>
        <button id="save-audio-btn" class="btn btn-primary">Salva Audio</button>
      </div>
    </div>
  </div>

  <script src="/static/js/gallery-admin.js"></script>
  <script>
    // Open add audio modal
    document.getElementById('add-audio-btn')?.addEventListener('click', () => openAudioModal());
    document.getElementById('add-first-audio-btn')?.addEventListener('click', () => openAudioModal());

    function openAudioModal(audioData = null) {
      document.getElementById('modal-title').textContent = audioData ? 'Modifica Audio' : 'Aggiungi Audio';

      if (audioData) {
        document.getElementById('audio-id').value = audioData.id;
        document.getElementById('audio-collection').value = audioData.collection_id || '';
        document.getElementById('audio-bandcamp-url').value = audioData.bandcamp_url || '';
        document.getElementById('audio-bandcamp-embed').value = audioData.bandcamp_embed_code || '';
        document.getElementById('audio-title-it').value = audioData.title_it || '';
        document.getElementById('audio-title-en').value = audioData.title_en || '';
        document.getElementById('audio-description-it').value = audioData.description_it || '';
        document.getElementById('audio-description-en').value = audioData.description_en || '';
        document.getElementById('audio-duration').value = audioData.duration || '';
        document.getElementById('audio-display-order').value = audioData.display_order || 0;
        document.getElementById('audio-is-published').checked = audioData.is_published !== false;

        if (audioData.bandcamp_embed_code) {
          showEmbedPreview(audioData.bandcamp_embed_code);
        }
      }

      document.getElementById('audio-modal').style.display = 'flex';
    }

    function closeAudioModal() {
      document.getElementById('audio-modal').style.display = 'none';
      document.getElementById('audio-modal').querySelector('form')?.reset();
      document.getElementById('audio-embed-preview').style.display = 'none';
    }

    // Generate embed code from URL
    document.getElementById('generate-embed-btn').addEventListener('click', function() {
      const url = document.getElementById('audio-bandcamp-url').value;

      if (!url || !url.includes('bandcamp.com')) {
        alert('Inserisci un URL Bandcamp valido');
        return;
      }

      // Extract album/track ID from URL
      // Example URL: https://artist.bandcamp.com/track/song-name
      // or: https://artist.bandcamp.com/album/album-name

      // Generate basic embed code
      const isAlbum = url.includes('/album/');
      const embedUrl = url.replace(/^https?:\/\//, 'https://bandcamp.com/EmbeddedPlayer/');

      const embedCode = `<iframe style="border: 0; width: 350px; height: ${isAlbum ? '470px' : '442px'};" src="${embedUrl}" seamless></iframe>`;

      document.getElementById('audio-bandcamp-embed').value = embedCode;
      showEmbedPreview(embedCode);

      alert('Nota: Questo è un codice embed generato automaticamente.\nPer risultati migliori, copia il codice embed direttamente da Bandcamp:\n1. Vai sulla pagina del brano\n2. Clicca su "Share / Embed"\n3. Copia il codice embed\n4. Incollalo nel campo "Codice Embed"');
    });

    // Preview embed code
    document.getElementById('audio-bandcamp-embed').addEventListener('blur', function() {
      const embedCode = this.value.trim();
      if (embedCode) {
        showEmbedPreview(embedCode);
      }
    });

    function showEmbedPreview(embedCode) {
      const previewContainer = document.getElementById('embed-preview-container');
      previewContainer.innerHTML = embedCode;
      document.getElementById('audio-embed-preview').style.display = 'block';
    }

    // Save audio
    document.getElementById('save-audio-btn').addEventListener('click', async function() {
      const audioId = document.getElementById('audio-id').value;
      const formData = {
        collection_id: document.getElementById('audio-collection').value || null,
        bandcamp_url: document.getElementById('audio-bandcamp-url').value,
        bandcamp_embed_code: document.getElementById('audio-bandcamp-embed').value || null,
        title_it: document.getElementById('audio-title-it').value,
        title_en: document.getElementById('audio-title-en').value,
        description_it: document.getElementById('audio-description-it').value,
        description_en: document.getElementById('audio-description-en').value,
        duration: parseInt(document.getElementById('audio-duration').value) || null,
        display_order: parseInt(document.getElementById('audio-display-order').value) || 0,
        is_published: document.getElementById('audio-is-published').checked
      };

      try {
        const url = audioId ? `/gallery/api/audios/${audioId}` : '/gallery/api/audios';
        const method = audioId ? 'PUT' : 'POST';

        const response = await fetch(url, {
          method: method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData)
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Errore durante il salvataggio');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Errore durante il salvataggio');
      }
    });

    // Edit audio
    async function editAudio(id) {
      // Placeholder - fetch audio data and populate modal
      alert('Funzionalità di modifica da implementare\n\nPermette di modificare tutti i campi dell\'audio');
      // In production, fetch the audio data and call openAudioModal(audioData)
    }

    // Delete audio
    async function deleteAudio(id) {
      if (!confirm('Sei sicuro di voler eliminare questo audio?')) return;

      try {
        const response = await fetch(`/gallery/api/audios/${id}`, {
          method: 'DELETE'
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Errore durante l\'eliminazione');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Errore durante l\'eliminazione');
      }
    }
  </script>
</body>
</html>
