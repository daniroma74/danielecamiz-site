<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/shared/css/admin-base.css">
  <link rel="stylesheet" href="/static/css/gallery-admin.css">
</head>
<body>
  <div class="admin-layout">
    <%- include('../partials/sidebar') %>
    <div class="main-content">
      <%- include('../partials/header') %>
      <main class="content-area">
        <div class="content-header">
          <h1>Gestione Foto</h1>
          <div class="header-actions">
            <select id="collection-filter" class="filter-select">
              <option value="">Tutte le collezioni</option>
              <% collections.forEach(col => { %>
                <option value="<%= col.id %>" <%= selectedCollection == col.id ? 'selected' : '' %>>
                  <%= col.title_it %>
                </option>
              <% }) %>
            </select>
            <button id="upload-photos-btn" class="btn btn-primary">Carica Foto</button>
          </div>
        </div>

        <% if (photos && photos.length > 0) { %>
          <div class="photos-grid">
            <% photos.forEach(photo => { %>
              <div class="photo-card" data-id="<%= photo.id %>">
                <div class="photo-preview">
                  <% if (photo.cloudinary_id) { %>
                    <img src="https://res.cloudinary.com/<%= process.env.CLOUDINARY_CLOUD_NAME %>/image/upload/c_fill,w_400,h_400,g_auto/<%= photo.cloudinary_id %>"
                         alt="<%= photo.alt_it || photo.title_it %>">
                  <% } else { %>
                    <div class="no-preview">
                      <span class="icon-large">📷</span>
                    </div>
                  <% } %>

                  <div class="photo-overlay">
                    <button class="btn btn-sm" onclick="editPhoto(<%= photo.id %>)">Modifica</button>
                    <button class="btn btn-sm btn-danger" onclick="deletePhoto(<%= photo.id %>)">Elimina</button>
                  </div>

                  <div class="photo-badges">
                    <% if (!photo.is_published) { %>
                      <span class="badge">Bozza</span>
                    <% } %>
                  </div>
                </div>

                <div class="photo-info">
                  <h4><%= photo.title_it || 'Senza titolo' %></h4>
                  <% if (photo.credits) { %>
                    <p class="credits"><small><%= photo.credits %></small></p>
                  <% } %>
                  <% if (photo.width && photo.height) { %>
                    <p class="dimensions"><small><%= photo.width %> × <%= photo.height %>px</small></p>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <span class="icon-large">📷</span>
            <h2>Nessuna foto caricata</h2>
            <p>Carica le tue prime foto dalla libreria Cloudinary</p>
            <button id="upload-first-photo-btn" class="btn btn-primary">Carica Foto</button>
          </div>
        <% } %>
      </main>
    </div>
  </div>

  <!-- Upload Modal -->
  <div id="upload-modal" class="modal" style="display: none;">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Carica Foto da Cloudinary</h2>
        <button class="modal-close" onclick="closeUploadModal()">&times;</button>
      </div>

      <div class="modal-body">
        <div class="form-group">
          <label for="photo-collection">Collezione</label>
          <select id="photo-collection">
            <option value="">Nessuna collezione</option>
            <% collections.forEach(col => { %>
              <option value="<%= col.id %>" <%= selectedCollection == col.id ? 'selected' : '' %>>
                <%= col.title_it %>
              </option>
            <% }) %>
          </select>
        </div>

        <div id="cloudinary-widget-container">
          <button id="cloudinary-upload-btn" class="btn btn-primary btn-large">
            Seleziona da Cloudinary
          </button>
          <p class="text-muted">Carica nuove immagini o seleziona dalla tua libreria</p>
        </div>

        <div id="selected-photos" style="display: none;">
          <h3>Foto Selezionate</h3>
          <div id="selected-photos-list"></div>
        </div>

        <div id="photo-metadata-form" style="display: none;">
          <h3>Metadata Foto</h3>

          <div class="form-row">
            <div class="form-group">
              <label for="photo-title-it">Titolo IT</label>
              <input type="text" id="photo-title-it">
            </div>
            <div class="form-group">
              <label for="photo-title-en">Titolo EN</label>
              <input type="text" id="photo-title-en">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="photo-alt-it">Alt Text IT</label>
              <input type="text" id="photo-alt-it">
            </div>
            <div class="form-group">
              <label for="photo-alt-en">Alt Text EN</label>
              <input type="text" id="photo-alt-en">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="photo-description-it">Descrizione IT</label>
              <textarea id="photo-description-it" rows="3"></textarea>
            </div>
            <div class="form-group">
              <label for="photo-description-en">Descrizione EN</label>
              <textarea id="photo-description-en" rows="3"></textarea>
            </div>
          </div>

          <div class="form-group">
            <label for="photo-credits">Crediti</label>
            <input type="text" id="photo-credits" placeholder="Nome fotografo">
          </div>

          <div class="form-group">
            <label for="photo-taken-date">Data scatto</label>
            <input type="date" id="photo-taken-date">
          </div>

          <div class="form-group">
            <label class="checkbox-label">
              <input type="checkbox" id="photo-is-published" checked>
              Pubblica immediatamente
            </label>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-outline" onclick="closeUploadModal()">Annulla</button>
        <button id="save-photos-btn" class="btn btn-primary" style="display: none;">Salva Foto</button>
      </div>
    </div>
  </div>

  <!-- Edit Modal -->
  <div id="edit-modal" class="modal" style="display: none;">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Modifica Foto</h2>
        <button class="modal-close" onclick="closeEditModal()">&times;</button>
      </div>

      <div class="modal-body">
        <input type="hidden" id="edit-photo-id">

        <div id="edit-photo-preview"></div>

        <div class="form-group">
          <label for="edit-collection">Collezione</label>
          <select id="edit-collection">
            <option value="">Nessuna collezione</option>
            <% collections.forEach(col => { %>
              <option value="<%= col.id %>"><%= col.title_it %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="edit-title-it">Titolo IT</label>
            <input type="text" id="edit-title-it">
          </div>
          <div class="form-group">
            <label for="edit-title-en">Titolo EN</label>
            <input type="text" id="edit-title-en">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="edit-alt-it">Alt Text IT</label>
            <input type="text" id="edit-alt-it">
          </div>
          <div class="form-group">
            <label for="edit-alt-en">Alt Text EN</label>
            <input type="text" id="edit-alt-en">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="edit-description-it">Descrizione IT</label>
            <textarea id="edit-description-it" rows="3"></textarea>
          </div>
          <div class="form-group">
            <label for="edit-description-en">Descrizione EN</label>
            <textarea id="edit-description-en" rows="3"></textarea>
          </div>
        </div>

        <div class="form-group">
          <label for="edit-credits">Crediti</label>
          <input type="text" id="edit-credits">
        </div>

        <div class="form-group">
          <label for="edit-taken-date">Data scatto</label>
          <input type="date" id="edit-taken-date">
        </div>

        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" id="edit-is-published">
            Pubblicata
          </label>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-outline" onclick="closeEditModal()">Annulla</button>
        <button id="update-photo-btn" class="btn btn-primary">Aggiorna</button>
      </div>
    </div>
  </div>

  <!-- Cloudinary Manager -->
  <script src="/shared/cloudinary-manager/client.js"></script>
  <script src="/static/js/gallery-admin.js"></script>
  <script>
    let selectedPhotos = [];
    let currentEditPhoto = null;

    // Filter by collection
    document.getElementById('collection-filter').addEventListener('change', function() {
      const collectionId = this.value;
      const url = collectionId ? `/gallery/photos?collection=${collectionId}` : '/gallery/photos';
      window.location.href = url;
    });

    // Open upload modal
    document.getElementById('upload-photos-btn')?.addEventListener('click', openUploadModal);
    document.getElementById('upload-first-photo-btn')?.addEventListener('click', openUploadModal);

    function openUploadModal() {
      document.getElementById('upload-modal').style.display = 'flex';
    }

    function closeUploadModal() {
      document.getElementById('upload-modal').style.display = 'none';
      selectedPhotos = [];
      document.getElementById('selected-photos').style.display = 'none';
      document.getElementById('photo-metadata-form').style.display = 'none';
    }

    // Cloudinary upload button - usa CloudinaryManager
    document.getElementById('cloudinary-upload-btn').addEventListener('click', function() {
      // Use CloudinaryManager from shared/cloudinary-manager/client.js
      CloudinaryManager.showImageDialog((result) => {
        if (!result || !result.publicId) {
          console.error('No image selected');
          return;
        }

        // Add photo to selection
        selectedPhotos.push({
          publicId: result.publicId,
          url: result.url,
          width: result.width || 0,
          height: result.height || 0,
          bytes: result.bytes || 0,
          format: result.format || '',
          thumbnail: result.url
        });

        // Show selected photos section
        document.getElementById('selected-photos').style.display = 'block';
        document.getElementById('photo-metadata-form').style.display = 'block';
        document.getElementById('save-photos-btn').style.display = 'block';

        // Update selected photos list
        const listHtml = selectedPhotos.map((photo, index) => `
          <div class="selected-photo-item" style="display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem; padding: 0.5rem; background: #f5f5f5; border-radius: 4px;">
            <img src="${photo.thumbnail || photo.url}" style="width: 60px; height: 60px; object-fit: cover; border-radius: 4px;">
            <div style="flex: 1;">
              <strong>${photo.publicId.split('/').pop()}</strong><br>
              <small>${(photo.width && photo.height) ? photo.width + ' × ' + photo.height + 'px' : 'Dimensioni sconosciute'}</small>
            </div>
            <button onclick="removeSelectedPhoto(${index})" class="btn btn-sm btn-danger">Rimuovi</button>
          </div>
        `).join('');

        document.getElementById('selected-photos-list').innerHTML = listHtml;
      }, {
        folder: 'danielecamiz/gallery',
        preset: 'gallery_unsigned'
      });
    });

    // Remove photo from selection
    function removeSelectedPhoto(index) {
      selectedPhotos.splice(index, 1);

      if (selectedPhotos.length === 0) {
        document.getElementById('selected-photos').style.display = 'none';
        document.getElementById('photo-metadata-form').style.display = 'none';
        document.getElementById('save-photos-btn').style.display = 'none';
      } else {
        // Update list
        const listHtml = selectedPhotos.map((photo, idx) => `
          <div class="selected-photo-item" style="display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem; padding: 0.5rem; background: #f5f5f5; border-radius: 4px;">
            <img src="${photo.thumbnail || photo.url}" style="width: 60px; height: 60px; object-fit: cover; border-radius: 4px;">
            <div style="flex: 1;">
              <strong>${photo.publicId.split('/').pop()}</strong><br>
              <small>${photo.width} × ${photo.height}px</small>
            </div>
            <button onclick="removeSelectedPhoto(${idx})" class="btn btn-sm btn-danger">Rimuovi</button>
          </div>
        `).join('');

        document.getElementById('selected-photos-list').innerHTML = listHtml;
      }
    }

    // Save selected photos
    document.getElementById('save-photos-btn').addEventListener('click', async function() {
      const collection_id = document.getElementById('photo-collection').value || null;
      const metadata = {
        title_it: document.getElementById('photo-title-it').value,
        title_en: document.getElementById('photo-title-en').value,
        description_it: document.getElementById('photo-description-it').value,
        description_en: document.getElementById('photo-description-en').value,
        alt_it: document.getElementById('photo-alt-it').value,
        alt_en: document.getElementById('photo-alt-en').value,
        credits: document.getElementById('photo-credits').value,
        taken_date: document.getElementById('photo-taken-date').value,
        is_published: document.getElementById('photo-is-published').checked
      };

      try {
        // Save each photo
        for (const photo of selectedPhotos) {
          const photoData = {
            collection_id,
            cloudinary_id: photo.publicId,
            cloudinary_folder: photo.publicId.split('/').slice(0, -1).join('/'),
            width: photo.width,
            height: photo.height,
            file_size: photo.bytes,
            file_format: photo.format,
            ...metadata
          };

          const response = await fetch('/gallery/api/photos', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(photoData)
          });

          if (!response.ok) {
            throw new Error('Failed to save photo');
          }
        }

        // Success! Reload page
        window.location.reload();
      } catch (error) {
        console.error('Error saving photos:', error);
        alert('Errore durante il salvataggio delle foto');
      }
    });

    // Delete photo
    async function deletePhoto(id) {
      if (!confirm('Sei sicuro di voler eliminare questa foto?')) return;

      try {
        const response = await fetch(`/gallery/api/photos/${id}`, {
          method: 'DELETE'
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Errore durante l\'eliminazione');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Errore durante l\'eliminazione');
      }
    }

    // Edit photo
    async function editPhoto(id) {
      try {
        // Fetch photo data (placeholder - needs API endpoint)
        // const response = await fetch(`/gallery/api/photos/${id}`);
        // const photo = await response.json();

        // For now, show modal with placeholder
        alert('Modal di modifica da implementare\n\nPermette di modificare:\n- Metadata bilingue\n- Collezione di appartenenza\n- Stato pubblicazione\n- Crediti e data scatto');

        // document.getElementById('edit-photo-id').value = photo.id;
        // ... populate form fields ...
        // document.getElementById('edit-modal').style.display = 'flex';
      } catch (error) {
        console.error('Error:', error);
        alert('Errore durante il caricamento');
      }
    }

    function closeEditModal() {
      document.getElementById('edit-modal').style.display = 'none';
    }

    // Update photo
    document.getElementById('update-photo-btn').addEventListener('click', async function() {
      const id = document.getElementById('edit-photo-id').value;
      const formData = {
        collection_id: document.getElementById('edit-collection').value || null,
        title_it: document.getElementById('edit-title-it').value,
        title_en: document.getElementById('edit-title-en').value,
        description_it: document.getElementById('edit-description-it').value,
        description_en: document.getElementById('edit-description-en').value,
        alt_it: document.getElementById('edit-alt-it').value,
        alt_en: document.getElementById('edit-alt-en').value,
        credits: document.getElementById('edit-credits').value,
        taken_date: document.getElementById('edit-taken-date').value,
        is_published: document.getElementById('edit-is-published').checked
      };

      try {
        const response = await fetch(`/gallery/api/photos/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData)
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Errore durante l\'aggiornamento');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Errore durante l\'aggiornamento');
      }
    });
  </script>
</body>
</html>
