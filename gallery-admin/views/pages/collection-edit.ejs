<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/shared/css/admin-base.css">
  <link rel="stylesheet" href="/static/css/gallery-admin.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <%- include('../../../shared/partials/admin-header') %>

  <main class="admin-container" style="max-width: 1400px; margin: 0 auto; padding: 2rem;">
        <div class="content-header">
          <h1><%= isNew ? 'Nuova Collezione' : 'Modifica Collezione' %></h1>
          <div class="header-actions">
            <a href="/gallery" class="btn btn-outline">
              <i class="fas fa-arrow-left"></i> Indietro
            </a>
            <button id="save-btn" class="btn btn-primary">
              <i class="fas fa-save"></i> Salva
            </button>
          </div>
        </div>

        <form id="collection-form" class="edit-form">
          <input type="hidden" id="collection-id" value="<%= collection ? collection.id : '' %>">

          <div class="form-section">
            <h2>Informazioni Base</h2>

            <div class="form-group">
              <label for="slug">Slug URL *</label>
              <input type="text" id="slug" name="slug" required
                     value="<%= collection ? collection.slug : '' %>"
                     placeholder="mia-collezione">
              <small>URL univoco per la collezione (es: mia-collezione)</small>
            </div>

            <div class="form-group">
              <label for="type">Tipo *</label>
              <select id="type" name="type" required>
                <option value="photo" <%= collection && collection.type === 'photo' ? 'selected' : '' %>>Foto</option>
                <option value="video" <%= collection && collection.type === 'video' ? 'selected' : '' %>>Video</option>
                <option value="audio" <%= collection && collection.type === 'audio' ? 'selected' : '' %>>Audio</option>
                <option value="mixed" <%= collection && collection.type === 'mixed' ? 'selected' : '' %>>Misto</option>
              </select>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="title_it">Titolo IT *</label>
                <input type="text" id="title_it" name="title_it" required
                       value="<%= collection ? collection.title_it : '' %>">
              </div>
              <div class="form-group">
                <label for="title_en">Titolo EN</label>
                <input type="text" id="title_en" name="title_en"
                       value="<%= collection ? collection.title_en : '' %>">
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="description_it">Descrizione IT</label>
                <textarea id="description_it" name="description_it" rows="4"><%= collection ? collection.description_it : '' %></textarea>
              </div>
              <div class="form-group">
                <label for="description_en">Descrizione EN</label>
                <textarea id="description_en" name="description_en" rows="4"><%= collection ? collection.description_en : '' %></textarea>
              </div>
            </div>
          </div>

          <div class="form-section">
            <h2>Immagine di Copertina</h2>

            <div class="cover-preview">
              <% if (collection && collection.cover_cloudinary_id) { %>
                <img id="cover-img" src="https://res.cloudinary.com/<%= process.env.CLOUDINARY_CLOUD_NAME %>/image/upload/c_fill,w_600,h_400/<%= collection.cover_cloudinary_id %>" alt="Cover">
              <% } else { %>
                <div id="cover-placeholder" class="no-cover-preview">
                  <span class="icon-large">📷</span>
                  <p>Nessuna immagine di copertina</p>
                </div>
              <% } %>
            </div>

            <input type="hidden" id="cover_cloudinary_id" name="cover_cloudinary_id"
                   value="<%= collection ? collection.cover_cloudinary_id : '' %>">

            <div class="form-group">
              <button type="button" id="upload-cover-btn" class="btn btn-outline">
                Carica Copertina da Cloudinary
              </button>
              <% if (collection && collection.cover_cloudinary_id) { %>
                <button type="button" id="remove-cover-btn" class="btn btn-sm btn-danger">
                  Rimuovi Copertina
                </button>
              <% } %>
            </div>
          </div>

          <div class="form-section">
            <h2>Impostazioni</h2>

            <% if (!collection || collection.type === 'video') { %>
            <div class="form-group" style="background: #f0f7ff; padding: 1rem; border-radius: 8px; border: 2px solid #4a9eff;">
              <label class="checkbox-label" style="font-weight: bold; font-size: 1.1em;">
                <input type="checkbox" id="is_auto_sync" name="is_auto_sync"
                       <%= collection && collection.is_auto_sync ? 'checked' : '' %>>
                🔄 Collezione Auto-Sync YouTube
              </label>
              <small style="display: block; margin-top: 0.5rem; color: #333;">
                I video più recenti dal canale YouTube vengono mostrati automaticamente. Non devi aggiungere video manualmente!
              </small>

              <div id="auto-sync-settings" style="margin-top: 1rem; <%= collection && collection.is_auto_sync ? '' : 'display: none;' %>">
                <label for="auto_sync_max_videos">Numero di video da mostrare:</label>
                <input type="number" id="auto_sync_max_videos" name="auto_sync_max_videos"
                       value="<%= collection ? collection.auto_sync_max_videos || 4 : 4 %>"
                       min="1" max="50" style="width: 100px; margin-left: 0.5rem;">
                <small style="display: block; margin-top: 0.25rem;">Ultimi video pubblicati sul canale</small>
              </div>
            </div>
            <% } %>

            <div class="form-group">
              <label for="display_order">Ordine di visualizzazione</label>
              <input type="number" id="display_order" name="display_order"
                     value="<%= collection ? collection.display_order : 0 %>" min="0">
              <small>Numero più basso = posizione più alta</small>
            </div>

            <div class="form-group">
              <label class="checkbox-label">
                <input type="checkbox" id="is_published" name="is_published"
                       <%= collection && collection.is_published ? 'checked' : '' %>>
                Pubblicata
              </label>
              <small>La collezione sarà visibile sul sito pubblico</small>
            </div>

            <div class="form-group">
              <label class="checkbox-label">
                <input type="checkbox" id="is_featured" name="is_featured"
                       <%= collection && collection.is_featured ? 'checked' : '' %>>
                In evidenza
              </label>
              <small>La collezione apparirà nella sezione in evidenza</small>
            </div>
          </div>
        </form>

        <!-- Sezione Contenuto Collezione (solo se modifica) -->
        <% if (!isNew) { %>
        <div class="form-section">
          <div class="content-header" style="margin-bottom: 1rem;">
            <h2>Contenuto Collezione</h2>
            <button id="add-item-btn" class="btn btn-primary">
              <i class="fas fa-plus"></i> Aggiungi Media
            </button>
          </div>

          <% if (items && items.length > 0) { %>
            <div class="items-grid">
              <% items.forEach(item => { %>
                <div class="item-card" data-id="<%= item.id %>">
                  <div class="item-preview">
                    <% if (item.item_type === 'photo' && item.cloudinary_id) { %>
                      <img src="https://res.cloudinary.com/<%= process.env.CLOUDINARY_CLOUD_NAME %>/image/upload/c_fill,w_300,h_300/<%= item.cloudinary_id %>"
                           alt="<%= item.alt_it || item.title_it %>">
                    <% } else if (item.item_type === 'video' && item.youtube_id) { %>
                      <div class="video-preview">
                        <img src="https://img.youtube.com/vi/<%= item.youtube_id %>/hqdefault.jpg"
                             alt="<%= item.title_it %>"
                             onerror="this.onerror=null; this.src='https://img.youtube.com/vi/<%= item.youtube_id %>/default.jpg'; this.parentElement.classList.add('thumbnail-failed');">
                        <span class="play-icon">▶️</span>
                      </div>
                    <% } else if (item.item_type === 'audio') { %>
                      <div class="audio-preview">
                        <span class="icon-large">🎵</span>
                        <% if (item.duration) { %>
                          <span class="duration"><%= Math.floor(item.duration / 60) %>:<%= String(item.duration % 60).padStart(2, '0') %></span>
                        <% } %>
                      </div>
                    <% } else { %>
                      <div class="no-preview">
                        <span class="icon-large">📄</span>
                      </div>
                    <% } %>

                    <div class="item-badges">
                      <span class="badge badge-<%= item.item_type %>"><%= item.item_type %></span>
                      <% if (!item.is_published) { %>
                        <span class="badge">Bozza</span>
                      <% } %>
                      <% if (item.is_spotlight) { %>
                        <span class="badge badge-featured">Spotlight</span>
                      <% } %>
                    </div>
                  </div>

                  <div class="item-info">
                    <h4><%= item.title_it || 'Senza titolo' %></h4>
                    <% if (item.title_en) { %>
                      <p class="subtitle"><%= item.title_en %></p>
                    <% } %>
                    <% if (item.credits) { %>
                      <p class="credits"><small><%= item.credits %></small></p>
                    <% } %>
                  </div>

                  <div class="item-actions">
                    <button class="btn btn-sm btn-primary" onclick="editItem(<%= item.id %>, '<%= item.item_type %>')">
                      <i class="fas fa-edit"></i> Modifica
                    </button>
                    <button class="btn btn-sm btn-danger" onclick="deleteItem(<%= item.id %>, '<%= item.item_type %>')">
                      <i class="fas fa-trash"></i> Elimina
                    </button>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="empty-state" style="padding: 2rem; text-align: center; background: #f8f9fa; border-radius: 8px;">
              <span class="icon-large">
                <% if (collection && collection.type === 'photo') { %>📷
                <% } else if (collection && collection.type === 'video') { %>🎬
                <% } else if (collection && collection.type === 'audio') { %>🎵
                <% } else { %>📚<% } %>
              </span>
              <h3>Nessun elemento</h3>
              <p>Aggiungi foto, video o audio a questa collezione</p>
              <button id="add-first-item-btn" class="btn btn-primary">
                <i class="fas fa-plus"></i> Aggiungi Primo Media
              </button>
            </div>
          <% } %>
        </div>
        <% } %>

        <!-- Modale Modifica Media -->
        <div id="edit-item-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); z-index: 9999; align-items: center; justify-content: center;">
          <div style="background: white; border-radius: 12px; max-width: 700px; width: 90%; max-height: 85vh; overflow-y: auto; padding: 2rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
              <h2 id="modal-title">Modifica Media</h2>
              <button onclick="closeEditModal()" style="background: none; border: none; font-size: 28px; cursor: pointer; color: #999;">&times;</button>
            </div>

            <form id="edit-item-form">
              <input type="hidden" id="edit-item-id">
              <input type="hidden" id="edit-item-type">

              <!-- Titoli -->
              <div class="form-row">
                <div class="form-group">
                  <label for="edit-title-it">Titolo IT</label>
                  <input type="text" id="edit-title-it" class="form-control">
                </div>
                <div class="form-group">
                  <label for="edit-title-en">Titolo EN</label>
                  <input type="text" id="edit-title-en" class="form-control">
                </div>
              </div>

              <!-- Descrizioni -->
              <div class="form-row">
                <div class="form-group">
                  <label for="edit-description-it">Descrizione IT</label>
                  <textarea id="edit-description-it" rows="3" class="form-control"></textarea>
                </div>
                <div class="form-group">
                  <label for="edit-description-en">Descrizione EN</label>
                  <textarea id="edit-description-en" rows="3" class="form-control"></textarea>
                </div>
              </div>

              <!-- Cambio foto (solo foto) -->
              <div id="edit-photo-section" style="display: none; margin-bottom: 1.5rem;">
                <div style="background: #f0f7ff; padding: 1.5rem; border-radius: 8px; border: 2px solid #4a9eff;">
                  <h4 style="margin-top: 0; color: #2563eb;">📸 Cambia Foto</h4>
                  <p style="font-size: 0.9rem; color: #666; margin-bottom: 1rem;">
                    Sostituisci l'immagine mantenendo tutte le descrizioni e informazioni
                  </p>
                  <div id="current-photo-preview" style="margin-bottom: 1rem;">
                    <!-- Anteprima foto attuale -->
                  </div>
                  <input type="hidden" id="edit-cloudinary-id">
                  <button type="button" id="change-photo-btn" class="btn btn-primary" style="width: 100%;">
                    <i class="fas fa-camera"></i> Seleziona Nuova Foto da Cloudinary
                  </button>
                </div>
              </div>

              <!-- Alt text (solo foto) -->
              <div id="edit-alt-section" style="display: none;">
                <div class="form-row">
                  <div class="form-group">
                    <label for="edit-alt-it">Alt Text IT</label>
                    <input type="text" id="edit-alt-it" class="form-control">
                  </div>
                  <div class="form-group">
                    <label for="edit-alt-en">Alt Text EN</label>
                    <input type="text" id="edit-alt-en" class="form-control">
                  </div>
                </div>
              </div>

              <!-- Credits (solo foto) -->
              <div id="edit-credits-section" style="display: none;">
                <div class="form-group">
                  <label for="edit-credits">Credits (Fotografo)</label>
                  <input type="text" id="edit-credits" class="form-control" placeholder="Foto di Mario Rossi">
                </div>
              </div>

              <!-- Data scatto (solo foto) -->
              <div id="edit-date-section" style="display: none;">
                <div class="form-group">
                  <label for="edit-taken-date">Data Scatto</label>
                  <input type="date" id="edit-taken-date" class="form-control">
                </div>
              </div>

              <!-- YouTube ID (solo video) -->
              <div id="edit-video-section" style="display: none; margin-bottom: 1.5rem;">
                <div style="background: #fff3cd; padding: 1.5rem; border-radius: 8px; border: 2px solid #ffc107;">
                  <h4 style="margin-top: 0; color: #856404;">🎬 Modifica Video YouTube</h4>
                  <p style="font-size: 0.9rem; color: #666; margin-bottom: 1rem;">
                    Puoi correggere l'ID YouTube se hai inserito quello sbagliato. Inserisci solo l'ID (es: dQw4w9WgXcQ) o l'URL completo.
                  </p>
                  <div class="form-group">
                    <label for="edit-youtube-id">YouTube ID o URL</label>
                    <div style="display: flex; gap: 0.5rem;">
                      <input type="text" id="edit-youtube-id" class="form-control" placeholder="dQw4w9WgXcQ o https://www.youtube.com/watch?v=dQw4w9WgXcQ" style="flex: 1;">
                      <button type="button" class="btn btn-primary" onclick="fetchYouTubeMetadata()" style="white-space: nowrap;">
                        <i class="fas fa-download"></i> Carica da YouTube
                      </button>
                    </div>
                    <small style="display: block; margin-top: 0.5rem; color: #666;">
                      Clicca "Carica da YouTube" per auto-compilare titolo e descrizione
                    </small>
                    <div id="yt_fetch_status" style="margin-top: 0.5rem; display: none;"></div>
                  </div>
                </div>
              </div>

              <!-- Pubblicazione -->
              <div class="form-group">
                <label class="checkbox-label">
                  <input type="checkbox" id="edit-is-published">
                  Pubblicato
                </label>
              </div>

              <!-- Spotlight (solo foto) -->
              <div id="edit-spotlight-section" style="display: none;">
                <div class="form-group">
                  <label class="checkbox-label">
                    <input type="checkbox" id="edit-is-spotlight">
                    In Evidenza (Spotlight)
                  </label>
                </div>
              </div>

              <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 2rem;">
                <button type="button" onclick="closeEditModal()" class="btn btn-outline">Annulla</button>
                <button type="submit" class="btn btn-primary">Salva Modifiche</button>
              </div>
            </form>
          </div>
        </div>
  </main>

  <!-- Cloudinary Manager -->
  <script src="/shared/cloudinary-manager/ui-notifications.js"></script>
  <script src="/shared/cloudinary-manager/ui-loading.js"></script>
  <script src="/shared/cloudinary-manager/client.js"></script>
  <script src="/static/js/gallery-admin.js"></script>

  <!-- SortableJS for drag & drop -->
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

  <script>
    const isNew = <%= isNew ? 'true' : 'false' %>;
    const collectionId = document.getElementById('collection-id').value;

    /**
     * Extract YouTube video ID from URL or return as-is if already an ID
     * Supports:
     * - https://www.youtube.com/watch?v=VIDEO_ID
     * - https://www.youtube.com/watch?v=VIDEO_ID&si=...
     * - https://youtu.be/VIDEO_ID
     * - https://youtu.be/VIDEO_ID?si=...
     * - https://www.youtube.com/embed/VIDEO_ID
     * - VIDEO_ID (direct ID)
     * - VIDEO_ID?si=... (ID with params)
     */
    function extractYouTubeId(input) {
      if (!input) return '';

      // Remove whitespace
      input = input.trim();

      // Direct ID (11 characters, alphanumeric + - and _)
      if (/^[A-Za-z0-9_-]{11}$/.test(input)) {
        return input;
      }

      // Extract from various YouTube URL formats
      const patterns = [
        // youtu.be/VIDEO_ID or youtu.be/VIDEO_ID?si=...
        /youtu\.be\/([A-Za-z0-9_-]{11})/,
        // youtube.com/watch?v=VIDEO_ID (with or without other params)
        /[?&]v=([A-Za-z0-9_-]{11})/,
        // youtube.com/embed/VIDEO_ID
        /youtube\.com\/embed\/([A-Za-z0-9_-]{11})/
      ];

      for (const pattern of patterns) {
        const match = input.match(pattern);
        if (match && match[1]) {
          return match[1];
        }
      }

      // If it looks like an ID with extra params (e.g., "VIDEO_ID?si=...")
      const idMatch = input.match(/^([A-Za-z0-9_-]{11})/);
      if (idMatch && idMatch[1]) {
        return idMatch[1];
      }

      // If no pattern matched, return empty string (invalid input)
      console.warn('Could not extract YouTube ID from:', input);
      return '';
    }

    // Auto-sync checkbox toggle
    const autoSyncCheckbox = document.getElementById('is_auto_sync');
    const autoSyncSettings = document.getElementById('auto-sync-settings');

    if (autoSyncCheckbox) {
      autoSyncCheckbox.addEventListener('change', function() {
        autoSyncSettings.style.display = this.checked ? 'block' : 'none';
      });
    }

    // Save collection
    document.getElementById('save-btn').addEventListener('click', async function() {
      const formData = {
        slug: document.getElementById('slug').value,
        type: document.getElementById('type').value,
        title_it: document.getElementById('title_it').value,
        title_en: document.getElementById('title_en').value,
        description_it: document.getElementById('description_it').value,
        description_en: document.getElementById('description_en').value,
        cover_cloudinary_id: document.getElementById('cover_cloudinary_id').value || null,
        cover_local_path: null,
        is_published: document.getElementById('is_published').checked,
        is_featured: document.getElementById('is_featured').checked,
        display_order: parseInt(document.getElementById('display_order').value) || 0,
        is_auto_sync: document.getElementById('is_auto_sync') ? document.getElementById('is_auto_sync').checked : false,
        auto_sync_max_videos: document.getElementById('auto_sync_max_videos') ? parseInt(document.getElementById('auto_sync_max_videos').value) : 4
      };

      try {
        const url = isNew ? '/gallery/api/collections' : `/gallery/api/collections/${collectionId}`;
        const method = isNew ? 'POST' : 'PUT';

        const response = await fetch(url, {
          method: method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData)
        });

        if (response.ok) {
          const result = await response.json();
          if (isNew) {
            // Redirect to edit page so user can add media
            window.location.href = `/gallery/collections/${result.id}/edit`;
          } else {
            // Reload to show updated data
            window.location.reload();
          }
        } else {
          alert('Errore durante il salvataggio');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Errore durante il salvataggio');
      }
    });

    // Upload cover - usa CloudinaryManager
    document.getElementById('upload-cover-btn').addEventListener('click', function() {
      CloudinaryManager.showImageDialog((result) => {
        if (!result || !result.publicId) {
          console.error('No image selected');
          return;
        }

        // Update hidden field
        document.getElementById('cover_cloudinary_id').value = result.publicId;

        // Update preview
        const coverPreview = document.querySelector('.cover-preview');
        if (coverPreview) {
          coverPreview.innerHTML = `
            <img id="cover-img" src="${result.url}" alt="Cover" style="max-width: 100%; border-radius: 8px;">
          `;
        }

        // Show remove button if not present
        if (!document.getElementById('remove-cover-btn')) {
          const uploadBtn = document.getElementById('upload-cover-btn');
          const removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.id = 'remove-cover-btn';
          removeBtn.className = 'btn btn-sm btn-danger';
          removeBtn.textContent = 'Rimuovi Copertina';
          removeBtn.addEventListener('click', function() {
            document.getElementById('cover_cloudinary_id').value = '';
            coverPreview.innerHTML = `
              <div id="cover-placeholder" class="no-cover-preview">
                <span class="icon-large">📷</span>
                <p>Nessuna immagine di copertina</p>
              </div>
            `;
            this.remove();
          });
          uploadBtn.parentElement.appendChild(removeBtn);
        }

        if (typeof showNotification === 'function') {
          showNotification('Copertina selezionata', 'success');
        }
      }, {
        folder: 'danielecamiz/gallery',
        preset: 'gallery_unsigned'
      });
    });

    // Remove cover
    const removeCoverBtn = document.getElementById('remove-cover-btn');
    if (removeCoverBtn) {
      removeCoverBtn.addEventListener('click', function() {
        document.getElementById('cover_cloudinary_id').value = '';
        const img = document.getElementById('cover-img');
        if (img) {
          img.parentElement.innerHTML = `
            <div id="cover-placeholder" class="no-cover-preview">
              <span class="icon-large">📷</span>
              <p>Nessuna immagine di copertina</p>
            </div>
          `;
        }
        this.remove();
      });
    }

    // ============================================
    // GESTIONE MEDIA (solo se non è nuova collezione)
    // ============================================
    <% if (!isNew) { %>
    const collectionType = '<%= collection.type %>';

    // Add item buttons
    document.getElementById('add-item-btn')?.addEventListener('click', showAddItemModal);
    document.getElementById('add-first-item-btn')?.addEventListener('click', showAddItemModal);

    function showAddItemModal() {
      if (collectionType === 'photo') {
        openCloudinaryPicker();
      } else if (collectionType === 'video') {
        openVideoModal();
      } else if (collectionType === 'audio') {
        openAudioModal();
      } else {
        // Mixed type collection - ask user
        const choice = prompt('Che tipo di media vuoi aggiungere?\n1 = Foto\n2 = Video\n3 = Audio');
        if (choice === '1') openCloudinaryPicker();
        else if (choice === '2') openVideoModal();
        else if (choice === '3') openAudioModal();
      }
    }

    function openCloudinaryPicker() {
      if (typeof CloudinaryManager === 'undefined') {
        alert('Cloudinary Manager non caricato. Ricarica la pagina.');
        return;
      }

      CloudinaryManager.showImageDialog((result) => {
        if (!result || !result.publicId) return;

        createPhoto({
          publicId: result.publicId,
          url: result.url,
          width: result.width || 0,
          height: result.height || 0,
          bytes: result.bytes || 0,
          format: result.format || ''
        });
      }, {
        folder: 'danielecamiz/gallery',
        preset: 'gallery_unsigned'
      });
    }

    function openVideoModal() {
      const input = prompt('Inserisci YouTube Video ID o URL completo:\n\nEsempi:\n- dQw4w9WgXcQ\n- https://www.youtube.com/watch?v=dQw4w9WgXcQ\n- https://youtu.be/dQw4w9WgXcQ');
      if (input) {
        const youtubeId = extractYouTubeId(input.trim());
        if (youtubeId) {
          createVideo(youtubeId);
        } else {
          alert('❌ ID YouTube non valido. Riprova.');
        }
      }
    }

    function openAudioModal() {
      const bandcampUrl = prompt('Inserisci URL Bandcamp:');
      if (bandcampUrl) createAudio(bandcampUrl);
    }

    async function createPhoto(photoData) {
      try {
        const response = await fetch('/gallery/api/photos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            collection_id: collectionId,
            cloudinary_id: photoData.publicId,
            cloudinary_folder: photoData.publicId.split('/').slice(0, -1).join('/'),
            width: photoData.width,
            height: photoData.height,
            file_size: photoData.bytes,
            file_format: photoData.format,
            title_it: '',
            is_published: true
          })
        });

        if (response.ok) {
          alert('✅ Foto aggiunta!');
          window.location.reload();
        } else {
          alert('❌ Errore durante il salvataggio');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('❌ Errore di connessione');
      }
    }

    async function createVideo(youtubeId) {
      try {
        // Fetch YouTube metadata first
        const metadataResponse = await fetch(`/gallery/api/videos/youtube-metadata/${youtubeId}`);
        let title = `Video ${youtubeId}`;
        let thumbnail = '';

        if (metadataResponse.ok) {
          const metadata = await metadataResponse.json();
          title = metadata.title || title;
          thumbnail = metadata.thumbnail || '';
          console.log('📹 YouTube metadata fetched:', { title, thumbnail });
        } else {
          console.warn('⚠️ Could not fetch YouTube metadata, using default title');
        }

        // Create video with fetched title
        const response = await fetch('/gallery/api/videos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            collection_id: collectionId,
            youtube_id: youtubeId,
            title_it: title,
            title_en: title,
            is_published: true,
            is_whitelisted: true
          })
        });

        if (response.ok) {
          alert('✅ Video aggiunto!');
          window.location.reload();
        } else {
          alert('❌ Errore durante il salvataggio');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('❌ Errore di connessione');
      }
    }

    async function createAudio(bandcampUrl) {
      try {
        const response = await fetch('/gallery/api/audios', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            collection_id: collectionId,
            bandcamp_url: bandcampUrl,
            title_it: 'Nuovo audio',
            is_published: true
          })
        });

        if (response.ok) {
          alert('✅ Audio aggiunto!');
          window.location.reload();
        } else {
          alert('❌ Errore durante il salvataggio');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('❌ Errore di connessione');
      }
    }

    async function deleteItem(id, type) {
      if (!confirm('Sei sicuro di voler eliminare questo elemento?')) return;

      try {
        const response = await fetch(`/gallery/api/${type}s/${id}`, {
          method: 'DELETE'
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Errore durante l\'eliminazione');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Errore durante l\'eliminazione');
      }
    }

    // Edit item
    async function editItem(id, type) {
      try {
        // Load item data
        const response = await fetch(`/gallery/api/${type}s/${id}`);
        if (!response.ok) {
          alert('Errore caricamento dati');
          return;
        }

        const item = await response.json();

        // Populate form
        document.getElementById('edit-item-id').value = id;
        document.getElementById('edit-item-type').value = type;
        document.getElementById('edit-title-it').value = item.title_it || '';
        document.getElementById('edit-title-en').value = item.title_en || '';
        document.getElementById('edit-description-it').value = item.description_it || '';
        document.getElementById('edit-description-en').value = item.description_en || '';
        document.getElementById('edit-is-published').checked = item.is_published;

        // Show/hide fields based on type
        const photoSection = document.getElementById('edit-photo-section');
        const videoSection = document.getElementById('edit-video-section');
        const altSection = document.getElementById('edit-alt-section');
        const creditsSection = document.getElementById('edit-credits-section');
        const dateSection = document.getElementById('edit-date-section');
        const spotlightSection = document.getElementById('edit-spotlight-section');

        if (type === 'photo') {
          photoSection.style.display = 'block';
          videoSection.style.display = 'none';
          altSection.style.display = 'block';
          creditsSection.style.display = 'block';
          dateSection.style.display = 'block';
          spotlightSection.style.display = 'block';

          document.getElementById('edit-cloudinary-id').value = item.cloudinary_id || '';
          document.getElementById('edit-alt-it').value = item.alt_it || '';
          document.getElementById('edit-alt-en').value = item.alt_en || '';
          document.getElementById('edit-credits').value = item.credits || '';
          document.getElementById('edit-taken-date').value = item.taken_date || '';
          document.getElementById('edit-is-spotlight').checked = item.is_spotlight;

          // Show current photo preview
          const preview = document.getElementById('current-photo-preview');
          if (item.cloudinary_id) {
            preview.innerHTML = `
              <img src="https://res.cloudinary.com/<%= process.env.CLOUDINARY_CLOUD_NAME %>/image/upload/c_fill,w_400,h_300/${item.cloudinary_id}"
                   alt="Foto attuale"
                   style="width: 100%; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            `;
          }
        } else if (type === 'video') {
          photoSection.style.display = 'none';
          videoSection.style.display = 'block';
          altSection.style.display = 'none';
          creditsSection.style.display = 'none';
          dateSection.style.display = 'none';
          spotlightSection.style.display = 'none';

          document.getElementById('edit-youtube-id').value = item.youtube_id || '';
        } else {
          photoSection.style.display = 'none';
          videoSection.style.display = 'none';
          altSection.style.display = 'none';
          creditsSection.style.display = 'none';
          dateSection.style.display = 'none';
          spotlightSection.style.display = 'none';
        }

        // Update modal title
        document.getElementById('modal-title').textContent = `Modifica ${type === 'photo' ? 'Foto' : type === 'video' ? 'Video' : 'Audio'}`;

        // Show modal
        const modal = document.getElementById('edit-item-modal');
        modal.style.display = 'flex';
      } catch (error) {
        console.error('Error:', error);
        alert('Errore caricamento dati');
      }
    }

    function closeEditModal() {
      document.getElementById('edit-item-modal').style.display = 'none';
    }

    // Fetch YouTube metadata and populate fields
    async function fetchYouTubeMetadata() {
      const youtubeInput = document.getElementById('edit-youtube-id').value.trim();
      const statusDiv = document.getElementById('yt_fetch_status');

      if (!youtubeInput) {
        statusDiv.innerHTML = '<span style="color: #f44336;">⚠️ Inserisci prima un ID o URL YouTube</span>';
        statusDiv.style.display = 'block';
        return;
      }

      // Extract YouTube ID from URL if needed
      const videoId = extractYouTubeId(youtubeInput);
      if (!videoId) {
        statusDiv.innerHTML = '<span style="color: #f44336;">❌ ID YouTube non valido</span>';
        statusDiv.style.display = 'block';
        return;
      }

      statusDiv.innerHTML = '<span style="color: #2196F3;"><i class="fas fa-spinner fa-spin"></i> Caricamento metadata da YouTube...</span>';
      statusDiv.style.display = 'block';

      try {
        const response = await fetch(`/gallery/api/videos/youtube-metadata/${videoId}`);

        if (!response.ok) {
          throw new Error('Video non trovato o errore API YouTube');
        }

        const data = await response.json();

        // Auto-popola i campi IT e EN con i dati YouTube
        if (data.title) {
          // Popola solo se i campi sono vuoti
          if (!document.getElementById('edit-title-it').value) {
            document.getElementById('edit-title-it').value = data.title;
          }
          if (!document.getElementById('edit-title-en').value) {
            document.getElementById('edit-title-en').value = data.title;
          }
        }

        if (data.description) {
          // Estrai solo il primo paragrafo (fino al primo doppio line break)
          let shortDesc = data.description.split(/\n\n|\r\n\r\n/)[0].trim();

          // Se il primo paragrafo è diverso dalla descrizione completa, aggiungi [...]
          if (shortDesc !== data.description.trim()) {
            shortDesc += ' [...]';
          }

          if (!document.getElementById('edit-description-it').value) {
            document.getElementById('edit-description-it').value = shortDesc;
          }
          if (!document.getElementById('edit-description-en').value) {
            document.getElementById('edit-description-en').value = shortDesc;
          }
        }

        // Update the YouTube ID field with cleaned ID
        document.getElementById('edit-youtube-id').value = videoId;

        statusDiv.innerHTML = '<span style="color: #4CAF50;">✅ Metadata caricati! (IT/EN popolati con i dati YouTube)</span>';

        // Hide status after 5 seconds
        setTimeout(() => {
          statusDiv.style.display = 'none';
        }, 5000);

      } catch (error) {
        console.error('Error fetching YouTube metadata:', error);
        statusDiv.innerHTML = '<span style="color: #f44336;">❌ Errore: ' + error.message + '</span>';
      }
    }

    // Handle "Change Photo" button
    document.getElementById('change-photo-btn')?.addEventListener('click', function() {
      if (typeof CloudinaryManager === 'undefined') {
        alert('Cloudinary Manager non caricato. Ricarica la pagina.');
        return;
      }

      CloudinaryManager.showImageDialog((result) => {
        if (!result || !result.publicId) return;

        // Update hidden field
        document.getElementById('edit-cloudinary-id').value = result.publicId;

        // Update preview
        const preview = document.getElementById('current-photo-preview');
        preview.innerHTML = `
          <div style="position: relative;">
            <img src="${result.url}"
                 alt="Nuova foto"
                 style="width: 100%; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <span style="position: absolute; top: 8px; right: 8px; background: #16a34a; color: white; padding: 4px 12px; border-radius: 4px; font-size: 0.875rem; font-weight: 600;">
              ✓ Nuova foto selezionata
            </span>
          </div>
        `;

        if (typeof showNotification === 'function') {
          showNotification('Nuova foto selezionata! Clicca "Salva Modifiche" per confermare.', 'success');
        }
      }, {
        folder: 'danielecamiz/gallery',
        preset: 'gallery_unsigned'
      });
    });

    // Handle edit form submit
    document.getElementById('edit-item-form').addEventListener('submit', async function(e) {
      e.preventDefault();

      const id = document.getElementById('edit-item-id').value;
      const type = document.getElementById('edit-item-type').value;

      const data = {
        title_it: document.getElementById('edit-title-it').value,
        title_en: document.getElementById('edit-title-en').value,
        description_it: document.getElementById('edit-description-it').value,
        description_en: document.getElementById('edit-description-en').value,
        is_published: document.getElementById('edit-is-published').checked
      };

      // Add photo-specific fields
      if (type === 'photo') {
        data.alt_it = document.getElementById('edit-alt-it').value;
        data.alt_en = document.getElementById('edit-alt-en').value;
        data.credits = document.getElementById('edit-credits').value;
        data.taken_date = document.getElementById('edit-taken-date').value;
        data.is_spotlight = document.getElementById('edit-is-spotlight').checked;

        // ✅ Includi cloudinary_id se è stato modificato
        const newCloudinaryId = document.getElementById('edit-cloudinary-id').value;
        if (newCloudinaryId) {
          data.cloudinary_id = newCloudinaryId;
        }
      }

      // Add video-specific fields
      if (type === 'video') {
        const youtubeInput = document.getElementById('edit-youtube-id').value.trim();
        if (youtubeInput) {
          // Extract YouTube ID from URL or use as-is if already an ID
          data.youtube_id = extractYouTubeId(youtubeInput);
        }
      }

      try {
        const response = await fetch(`/gallery/api/${type}s/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          alert('✅ Modifiche salvate!');
          window.location.reload();
        } else {
          alert('❌ Errore durante il salvataggio');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('❌ Errore di connessione');
      }
    });

    // Initialize drag & drop for reordering
    const itemsGrid = document.querySelector('.items-grid');
    if (itemsGrid) {
      new Sortable(itemsGrid, {
        animation: 150,
        handle: '.item-card',
        ghostClass: 'sortable-ghost',
        chosenClass: 'sortable-chosen',
        dragClass: 'sortable-drag',
        onEnd: async function(evt) {
          // Get all items in new order
          const items = Array.from(itemsGrid.querySelectorAll('.item-card')).map((card, index) => ({
            id: parseInt(card.dataset.id),
            display_order: index
          }));

          // Save new order
          try {
            const response = await fetch('/gallery/api/items/reorder', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items })
            });

            if (response.ok) {
              console.log('✅ Ordine salvato');
            } else {
              alert('❌ Errore salvataggio ordine');
              window.location.reload(); // Restore original order
            }
          } catch (error) {
            console.error('Error:', error);
            alert('❌ Errore di connessione');
            window.location.reload();
          }
        }
      });
    }
    <% } %>
  </script>

  <style>
    .sortable-ghost {
      opacity: 0.4;
    }
    .sortable-chosen {
      cursor: grabbing !important;
    }
    .sortable-drag {
      opacity: 0.8;
    }
    .item-card {
      cursor: grab;
    }
    .item-card:active {
      cursor: grabbing;
    }
  </style>
</body>
</html>
