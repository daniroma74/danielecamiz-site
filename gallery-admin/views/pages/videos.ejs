<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/shared/css/admin-base.css">
  <link rel="stylesheet" href="/static/css/gallery-admin.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <%- include('../../../shared/partials/admin-header') %>

  <main class="admin-container" style="max-width: 1400px; margin: 0 auto; padding: 2rem;">
    <!-- Tabs -->
    <%- include('../../../shared/partials/admin-tabs', {
      tabs: [
        { label: 'Dashboard', url: '/gallery', icon: 'home' },
        { label: 'Collezioni', url: '/gallery/collections', icon: 'folder-open' },
        { label: 'Foto', url: '/gallery/photos', icon: 'camera' },
        { label: 'Video', url: '/gallery/videos', icon: 'video' },
        { label: 'Audio', url: '/gallery/audios', icon: 'music' },
        { label: 'Categorie', url: '/gallery/categories', icon: 'tags' }
      ],
      currentPath: '/gallery/videos',
      baseUrl: 'gallery'
    }) %>

    <!-- Content -->
    <div class="content-header">
      <h2>Gestione Video</h2>
      <div class="header-actions">
        <button id="sync-youtube-btn" class="btn btn-outline">
          <i class="fas fa-sync"></i> Sincronizza YouTube
        </button>
        <button id="add-video-btn" class="btn btn-primary">Aggiungi Video</button>
      </div>
    </div>

        <% if (lastSync) { %>
          <div class="sync-info">
            <p>
              <strong>Ultima sincronizzazione:</strong>
              <%= new Date(lastSync.created_at).toLocaleDateString('it-IT', {
                year: 'numeric', month: 'long', day: 'numeric',
                hour: '2-digit', minute: '2-digit'
              }) %>
            </p>
            <p>
              <strong>Stato:</strong>
              <span class="badge badge-<%= lastSync.sync_status %>"><%= lastSync.sync_status %></span>
            </p>
            <% if (lastSync.videos_found) { %>
              <p><strong>Video trovati:</strong> <%= lastSync.videos_found %> | <strong>Importati:</strong> <%= lastSync.videos_imported %></p>
            <% } %>
            <% if (lastSync.error_message) { %>
              <p class="error"><strong>Errore:</strong> <%= lastSync.error_message %></p>
            <% } %>
          </div>
        <% } %>

        <% if (videos && videos.length > 0) { %>
          <div class="videos-grid">
            <% videos.forEach(video => { %>
              <div class="video-card <%= video.is_spotlight ? 'spotlight' : '' %>" data-id="<%= video.id %>">
                <div class="video-preview">
                  <% if (video.youtube_id) { %>
                    <img src="https://img.youtube.com/vi/<%= video.youtube_id %>/mqdefault.jpg"
                         alt="<%= video.title_it %>">
                    <a href="https://www.youtube.com/watch?v=<%= video.youtube_id %><%= video.timecode ? '&t=' + video.timecode : '' %>"
                       target="_blank"
                       class="play-overlay">
                      <span class="play-icon">▶️</span>
                    </a>
                  <% } else { %>
                    <div class="no-preview">
                      <span class="icon-large">🎬</span>
                    </div>
                  <% } %>

                  <div class="video-badges">
                    <% if (video.is_spotlight) { %>
                      <span class="badge badge-featured">Spotlight</span>
                    <% } %>
                    <% if (!video.is_published) { %>
                      <span class="badge">Bozza</span>
                    <% } %>
                    <% if (!video.is_whitelisted) { %>
                      <span class="badge badge-warning">Non abilitato</span>
                    <% } %>
                  </div>

                  <% if (video.duration) { %>
                    <span class="duration">
                      <%= Math.floor(video.duration / 60) %>:<%= String(video.duration % 60).padStart(2, '0') %>
                    </span>
                  <% } %>
                </div>

                <div class="video-info">
                  <h4><%= video.title_it || 'Senza titolo' %></h4>
                  <% if (video.title_en) { %>
                    <p class="subtitle"><%= video.title_en %></p>
                  <% } %>
                  <% if (video.youtube_id) { %>
                    <p class="youtube-id"><small>ID: <%= video.youtube_id %></small></p>
                  <% } %>
                </div>

                <div class="video-actions">
                  <button class="btn btn-sm" onclick="editVideo(<%= video.id %>)">Modifica</button>
                  <button class="btn btn-sm <%= video.is_spotlight ? 'btn-outline' : 'btn-primary' %>"
                          onclick="toggleSpotlight(<%= video.id %>, <%= video.is_spotlight ? 'false' : 'true' %>)">
                    <%= video.is_spotlight ? 'Rimuovi Spotlight' : 'Spotlight' %>
                  </button>
                  <button class="btn btn-sm btn-danger" onclick="deleteVideo(<%= video.id %>)">Elimina</button>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <span class="icon-large">🎬</span>
            <h2>Nessun video caricato</h2>
            <p>Sincronizza dal tuo canale YouTube o aggiungi video manualmente</p>
            <div class="empty-actions">
              <button id="sync-first-btn" class="btn btn-primary">Sincronizza YouTube</button>
              <button id="add-first-video-btn" class="btn btn-outline">Aggiungi Manualmente</button>
            </div>
          </div>
        <% } %>
  </main>

  <!-- Add/Edit Video Modal -->
  <div id="video-modal" class="modal" style="display: none;">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="modal-title">Aggiungi Video</h2>
        <button class="modal-close" onclick="closeVideoModal()">&times;</button>
      </div>

      <div class="modal-body">
        <input type="hidden" id="video-id">

        <div class="form-group">
          <label for="video-collection">Collezione</label>
          <select id="video-collection">
            <option value="">Nessuna collezione</option>
            <% collections.forEach(col => { %>
              <option value="<%= col.id %>"><%= col.title_it %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="video-youtube-id">YouTube Video ID *</label>
          <input type="text" id="video-youtube-id" placeholder="dQw4w9WgXcQ" required>
          <small>L'ID del video da YouTube (es: dQw4w9WgXcQ)</small>
        </div>

        <div id="video-preview-container" style="display: none;">
          <h3>Anteprima Video</h3>
          <div id="video-preview-thumbnail"></div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="video-title-it">Titolo IT *</label>
            <input type="text" id="video-title-it" required>
          </div>
          <div class="form-group">
            <label for="video-title-en">Titolo EN</label>
            <input type="text" id="video-title-en">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="video-description-it">Descrizione IT</label>
            <textarea id="video-description-it" rows="3"></textarea>
          </div>
          <div class="form-group">
            <label for="video-description-en">Descrizione EN</label>
            <textarea id="video-description-en" rows="3"></textarea>
          </div>
        </div>

        <div class="form-group">
          <label for="video-timecode">Timecode (secondi)</label>
          <input type="number" id="video-timecode" min="0" placeholder="0">
          <small>Inizia il video da un punto specifico</small>
        </div>

        <div class="form-group">
          <label for="video-duration">Durata (secondi)</label>
          <input type="number" id="video-duration" min="0">
        </div>

        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" id="video-is-spotlight">
            Video in evidenza (Spotlight)
          </label>
        </div>

        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" id="video-is-whitelisted" checked>
            Abilitato per embedding
          </label>
        </div>

        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" id="video-is-published" checked>
            Pubblicato
          </label>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-outline" onclick="closeVideoModal()">Annulla</button>
        <button id="save-video-btn" class="btn btn-primary">Salva Video</button>
      </div>
    </div>
  </div>

  <!-- YouTube Sync Modal -->
  <div id="sync-modal" class="modal" style="display: none;">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Sincronizza YouTube</h2>
        <button class="modal-close" onclick="closeSyncModal()">&times;</button>
      </div>

      <div class="modal-body">
        <p>La sincronizzazione con YouTube Data API v3 permette di importare automaticamente i video dal tuo canale.</p>

        <div class="form-group">
          <label for="sync-channel-id">Channel ID o Username</label>
          <input type="text" id="sync-channel-id" placeholder="UC...">
        </div>

        <div class="sync-options">
          <div class="form-group">
            <label class="checkbox-label">
              <input type="checkbox" id="sync-published" checked>
              Solo video pubblici
            </label>
          </div>
          <div class="form-group">
            <label class="checkbox-label">
              <input type="checkbox" id="sync-auto-publish">
              Pubblica automaticamente i video importati
            </label>
          </div>
        </div>

        <div class="alert alert-info">
          <strong>Nota:</strong> L'integrazione YouTube API richiede configurazione delle credenziali API.
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-outline" onclick="closeSyncModal()">Annulla</button>
        <button id="start-sync-btn" class="btn btn-primary">Avvia Sincronizzazione</button>
      </div>
    </div>
  </div>

  <script src="/static/js/gallery-admin.js"></script>
  <script>
    // Open add video modal
    document.getElementById('add-video-btn')?.addEventListener('click', () => openVideoModal());
    document.getElementById('add-first-video-btn')?.addEventListener('click', () => openVideoModal());

    function openVideoModal(videoData = null) {
      document.getElementById('modal-title').textContent = videoData ? 'Modifica Video' : 'Aggiungi Video';

      if (videoData) {
        document.getElementById('video-id').value = videoData.id;
        document.getElementById('video-collection').value = videoData.collection_id || '';
        document.getElementById('video-youtube-id').value = videoData.youtube_id || '';
        document.getElementById('video-title-it').value = videoData.title_it || '';
        document.getElementById('video-title-en').value = videoData.title_en || '';
        document.getElementById('video-description-it').value = videoData.description_it || '';
        document.getElementById('video-description-en').value = videoData.description_en || '';
        document.getElementById('video-timecode').value = videoData.timecode || '';
        document.getElementById('video-duration').value = videoData.duration || '';
        document.getElementById('video-is-spotlight').checked = videoData.is_spotlight || false;
        document.getElementById('video-is-whitelisted').checked = videoData.is_whitelisted !== false;
        document.getElementById('video-is-published').checked = videoData.is_published !== false;
      }

      document.getElementById('video-modal').style.display = 'flex';
    }

    function closeVideoModal() {
      document.getElementById('video-modal').style.display = 'none';
      document.getElementById('video-modal').querySelector('form')?.reset();
    }

    // Save video
    document.getElementById('save-video-btn').addEventListener('click', async function() {
      const videoId = document.getElementById('video-id').value;
      const formData = {
        collection_id: document.getElementById('video-collection').value || null,
        youtube_id: document.getElementById('video-youtube-id').value,
        title_it: document.getElementById('video-title-it').value,
        title_en: document.getElementById('video-title-en').value,
        description_it: document.getElementById('video-description-it').value,
        description_en: document.getElementById('video-description-en').value,
        timecode: document.getElementById('video-timecode').value || null,
        duration: parseInt(document.getElementById('video-duration').value) || null,
        is_spotlight: document.getElementById('video-is-spotlight').checked,
        is_whitelisted: document.getElementById('video-is-whitelisted').checked,
        is_published: document.getElementById('video-is-published').checked,
        display_order: 0
      };

      try {
        const response = await fetch('/gallery/api/videos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData)
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Errore durante il salvataggio');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Errore durante il salvataggio');
      }
    });

    // Edit video
    async function editVideo(id) {
      // Placeholder - fetch video data and populate modal
      alert('Funzionalità di modifica da implementare\n\nPermette di modificare tutti i campi del video');
    }

    // Toggle spotlight
    async function toggleSpotlight(id, isSpotlight) {
      // Placeholder - update video spotlight status
      alert(`${isSpotlight ? 'Imposta' : 'Rimuovi'} video come Spotlight\n\nFunzionalità da implementare con API endpoint dedicato`);
    }

    // Delete video
    async function deleteVideo(id) {
      if (!confirm('Sei sicuro di voler eliminare questo video?')) return;

      try {
        const response = await fetch(`/gallery/api/videos/${id}`, {
          method: 'DELETE'
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Errore durante l\'eliminazione');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Errore durante l\'eliminazione');
      }
    }

    // YouTube sync
    document.getElementById('sync-youtube-btn')?.addEventListener('click', openSyncModal);
    document.getElementById('sync-first-btn')?.addEventListener('click', openSyncModal);

    function openSyncModal() {
      document.getElementById('sync-modal').style.display = 'flex';
    }

    function closeSyncModal() {
      document.getElementById('sync-modal').style.display = 'none';
    }

    document.getElementById('start-sync-btn').addEventListener('click', async function() {
      const channelId = document.getElementById('sync-channel-id').value;

      if (!channelId) {
        alert('Inserisci un Channel ID o Username');
        return;
      }

      try {
        const response = await fetch('/gallery/api/videos/sync-youtube', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            channel_id: channelId,
            published_only: document.getElementById('sync-published').checked,
            auto_publish: document.getElementById('sync-auto-publish').checked
          })
        });

        const result = await response.json();

        if (response.ok) {
          alert('Sincronizzazione completata!\n\nQuesta funzionalità sarà implementata con YouTube Data API v3');
          closeSyncModal();
          // window.location.reload();
        } else {
          alert('Errore durante la sincronizzazione: ' + result.message);
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Errore durante la sincronizzazione');
      }
    });
  </script>
</body>
</html>
