<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/shared/css/admin-base.css">
  <link rel="stylesheet" href="/static/css/gallery-admin.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="admin-container" style="max-width: 1400px; margin: 0 auto; padding: 2rem;">
    <div class="content-header">
      <h1><i class="fas fa-images"></i> Gallery Admin</h1>
      <div class="header-actions">
        <a href="/gallery/collections/new" class="btn btn-primary">
          <i class="fas fa-plus"></i> Nuova Collezione
        </a>
      </div>
    </div>

    <!-- Stats compatte -->
    <div class="stats-grid" style="margin-bottom: 2rem;">
      <div class="stat-card">
        <h4><i class="fas fa-folder-open"></i> Collezioni</h4>
        <p class="stat-number"><%= stats.collections %></p>
      </div>
      <div class="stat-card">
        <h4><i class="fas fa-camera"></i> Foto</h4>
        <p class="stat-number"><%= stats.photos %></p>
      </div>
      <div class="stat-card">
        <h4><i class="fas fa-video"></i> Video</h4>
        <p class="stat-number"><%= stats.videos %></p>
      </div>
      <div class="stat-card">
        <h4><i class="fas fa-music"></i> Audio</h4>
        <p class="stat-number"><%= stats.audios %></p>
      </div>
    </div>

    <!-- Collezioni -->
    <% if (recentCollections && recentCollections.length > 0) { %>
      <div class="collections-grid">
        <% recentCollections.forEach(col => { %>
          <div class="collection-card" data-id="<%= col.id %>">
            <div class="collection-cover">
              <% if (col.cover_cloudinary_id) { %>
                <img src="https://res.cloudinary.com/<%= process.env.CLOUDINARY_CLOUD_NAME %>/image/upload/c_fill,w_400,h_300/<%= col.cover_cloudinary_id %>" alt="<%= col.title_it %>">
              <% } else { %>
                <div class="no-cover">
                  <span class="icon-large">
                    <% if (col.type === 'photo') { %><i class="fas fa-camera"></i>
                    <% } else if (col.type === 'video') { %><i class="fas fa-video"></i>
                    <% } else if (col.type === 'audio') { %><i class="fas fa-music"></i>
                    <% } else { %><i class="fas fa-folder-open"></i><% } %>
                  </span>
                </div>
              <% } %>
              <div class="collection-badges">
                <span class="badge badge-<%= col.type %>"><%= col.type %></span>
                <% if (col.is_featured) { %>
                  <span class="badge badge-featured">In evidenza</span>
                <% } %>
              </div>
            </div>

            <div class="collection-info">
              <h3><%= col.title_it %></h3>
              <% if (col.title_en) { %>
                <p class="subtitle"><%= col.title_en %></p>
              <% } %>
              <div class="collection-meta">
                <span class="meta-item">
                  <%= col.items_count || 0 %> elementi
                </span>
                <span class="meta-item">
                  <% if (col.is_published) { %>
                    <i class="fas fa-check-circle" style="color: green;"></i> Pubblicata
                  <% } else { %>
                    <i class="fas fa-exclamation-circle" style="color: orange;"></i> Bozza
                  <% } %>
                </span>
              </div>
            </div>

            <div class="collection-actions">
              <a href="/gallery/collections/<%= col.id %>/edit" class="btn btn-sm btn-primary">
                <i class="fas fa-edit"></i> Modifica
              </a>
              <button class="btn btn-sm btn-danger" onclick="deleteCollection(<%= col.id %>)">
                <i class="fas fa-trash"></i> Elimina
              </button>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <span class="icon-large"><i class="fas fa-folder-open"></i></span>
        <h2>Nessuna collezione</h2>
        <p>Crea la tua prima collezione per organizzare foto, video e audio</p>
        <a href="/gallery/collections/new" class="btn btn-primary btn-lg">
          <i class="fas fa-plus"></i> Crea Prima Collezione
        </a>
      </div>
    <% } %>
  </main>

  <script>
    async function deleteCollection(id) {
      if (!confirm('Sei sicuro di voler eliminare questa collezione?\n\nVerranno eliminati anche tutti i media contenuti.')) return;

      try {
        const response = await fetch(`/gallery/api/collections/${id}`, {
          method: 'DELETE'
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Errore durante l\'eliminazione');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Errore durante l\'eliminazione');
      }
    }
  </script>
</body>
</html>
