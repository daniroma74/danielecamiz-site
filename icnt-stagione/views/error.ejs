<div style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 2rem;">
  <div>
    <h1 style="font-size: 4rem; margin: 0; color: #ef4444;">Errore</h1>
    <h2 style="font-size: 1.5rem; margin: 1rem 0; color: var(--text-primary);">
      Si è verificato un errore imprevisto
    </h2>
    <p style="color: var(--text-secondary); margin: 2rem 0;">
      Ci scusiamo per l'inconveniente. Riprova più tardi.
    </p>
    <% if (typeof error !== 'undefined' && process.env.NODE_ENV === 'development') { %>
      <details style="margin: 2rem 0; text-align: left; max-width: 600px;">
        <summary style="cursor: pointer; color: var(--accent-gold);">Dettagli errore (solo sviluppo)</summary>
        <pre style="background: rgba(0,0,0,0.5); padding: 1rem; border-radius: 8px; overflow-x: auto; font-size: 0.875rem;">
<%= error.message %>
<%= error.stack %>
        </pre>
      </details>
    <% } %>
    <a href="/stagione/<%= ui?.code || '2025-26' %>" 
       style="display: inline-block; padding: 1rem 2rem; background: var(--accent-gold); color: var(--bg-primary); text-decoration: none; border-radius: 30px; font-weight: 600;">
      Torna al calendario concerti
    </a>
  </div>
</div>
