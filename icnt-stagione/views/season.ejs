<!-- Poster Sidebar - COMPLETAMENTE FISSO FUORI DAL LAYOUT -->
<aside class="poster-sidebar" id="poster_sidebar">
    <div class="poster-inner">
      <div class="poster-frame">
        <a class="poster-link" 
           href="/public/img/poster/poster-1200x1710.webp"
           data-lightbox="poster"
           aria-label="Visualizza locandina in alta risoluzione">
          <picture>
            <source type="image/webp" 
                    srcset="/public/img/poster/poster-480x684.webp 480w,
                            /public/img/poster/poster-640x912.webp 640w,
                            /public/img/poster/poster-1000x1425.webp 1000w,
                            /public/img/poster/poster-1200x1710.webp 1200w"
                    sizes="(max-width: 768px) 100vw, 380px">
            <img src="/public/img/poster/poster-1200x1710.webp"
                 alt="Locandina Stagione <%= ui.code %>"
                 loading="eager"
                 width="380" 
                 height="541"
                 class="poster-image">
          </picture>
          <div class="poster-overlay">
            <span class="poster-zoom">🔍 Ingrandisci</span>
          </div>
        </a>
      </div>
      
      <div class="poster-actions">
        <a class="btn primary small full-width"
           href="/public/img/poster/poster-1200x1710.webp"
           download="ICNT-Stagione-<%= ui.code %>.webp">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="margin-right: 6px;">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Scarica Locandina
        </a>
        <a class="btn ghost small full-width"
           href="/q.svg"
           download="ICNT-QR-<%= ui.code %>.svg">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="margin-right: 6px;">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
          </svg>
          Scarica QR Code
        </a>
      </div>
      
      <!-- Quick Stats -->
      <div class="poster-stats">
        <div class="stat-item">
          <span class="stat-value"><%= data.allCount %></span>
          <span class="stat-label">Concerti</span>
        </div>
        <div class="stat-item">
          <span class="stat-value" id="live_bookings"><%= stats?.bookings || 0 %></span>
          <span class="stat-label">Prenotazioni</span>
        </div>
      </div>
    </div>
</aside>

<!-- Layout principale senza sidebar -->
<div class="season-layout">
  <!-- Main Content Area - Scrollabile -->
  <div class="content-area">
    <div class="content-inner">
      <!-- Hero Section con Prossimo Evento -->
      <section class="hero-section card glass" id="hero_section">
        <div class="hero-content">
          <h1 class="hero-title gradient-text">
            Stagione ICNT <%= ui.code %>
          </h1>
          <p class="hero-subtitle">
            I Concerti nel Tempio • Chiesa Valdese di piazza Cavour, Roma
          </p>
          
          <% if (data.nextEvent) { %>
          <%
          // Helper function definita UNA SOLA VOLTA qui
          function asLocalDate(dateStr) {
              const [y, m, d] = (dateStr || '').split('-').map(Number);
              return new Date(y, (m || 1) - 1, d || 1);
          }
          const nextD = asLocalDate(data.nextEvent.date);
          %>
          <div class="next-event-card">
            <div class="next-event-badge">Prossimo Evento</div>
            <h2 class="next-event-title"><%= data.nextEvent.title %></h2>
            <% if (data.nextEvent.subtitle) { %>
              <p class="next-event-subtitle"><%= data.nextEvent.subtitle %></p>
            <% } %>
            <div class="next-event-info">
              <span class="next-event-date">
                📅 <%= nextD.toLocaleDateString('it-IT', { weekday:'long', year:'numeric', month:'long', day:'numeric' }) %>
              </span>
              <span class="next-event-time">
                🕐 Ora: <%= data.nextEvent.time || '20:00' %>
              </span>
            </div>
            <% if (data.nextEvent.detailUrl) { %>
            <a href="<%= data.nextEvent.detailUrl %>" 
               class="btn primary" 
               target="_blank" 
               rel="noopener">
              Maggiori informazioni →
            </a>
            <% } %>
          </div>
          <% } %>
        </div>
      </section>
      
      <!-- Mobile Poster Card -->
      <section class="mobile-poster-card card glass" id="mobile_poster_card">
        <a href="/public/img/poster/poster-1200x1710.webp" target="_blank" class="poster-card-link">
          <div class="poster-card-thumbnail">
            <img src="/public/img/poster/poster-480x684.webp" alt="Locandina Stagione <%= ui.code %>" loading="lazy">
          </div>
          <div class="poster-card-content">
            <h3>Locandina Stagione <%= ui.code %></h3>
            <p>Tocca per visualizzare la locandina completa</p>
            <div class="poster-card-actions">
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>Visualizza</span>
            </div>
          </div>
        </a>
      </section>

      <!-- Filters Section -->
      <section class="filters-section card glass" id="filters_section">
        <div class="filters-wrapper">
          <h3 class="filters-title">Filtra concerti:</h3>
          <div class="filters-chips">
            <a href="?f=all"
               class="filter-chip <%= ui.filter === 'all' ? 'active' : '' %>"
               data-filter="all">
              <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <span>Tutti i concerti</span>
              <span class="filter-count"><%= data.allCount %></span>
            </a>
            <a href="?f=icnt"
               class="filter-chip <%= ui.filter === 'icnt' ? 'active' : '' %>"
               data-filter="icnt">
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              <span>Solo ICNT</span>
              <span class="filter-count"><%= data.icntCount %></span>
            </a>
            <a href="?f=msc"
               class="filter-chip <%= ui.filter === 'msc' ? 'active' : '' %>"
               data-filter="msc">
              <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
              <span>Mozart Symphonies Challenge</span>
              <span class="filter-count"><%= data.mscCount %></span>
            </a>
          </div>
        </div>
        
        <!-- Search Bar -->
        <div class="search-wrapper">
          <input type="search" 
                 id="search_events" 
                 class="search-input"
                 placeholder="🔍 Cerca concerto..."
                 autocomplete="off">
        </div>
      </section>
      
      <!-- Events List -->
      <section class="events-section" id="events_section">
        <% if (data.events && data.events.length > 0) { %>
          <div class="events-grid">
            <% data.events.forEach((event, index) => { 
                 const d = asLocalDate(event.date);
            %>
              <article class="event-card glass animate-in" 
                       data-type="<%= event.mscNumber ? 'msc' : 'icnt' %>"
                       data-index="<%= index %>"
                       style="animation-delay: <%= index * 0.05 %>s">

                <!-- Date Column -->
                <div class="event-date-column">
                  <div class="event-date-box">
                    <div class="date-day"><%= d.getDate() %></div>
                    <div class="date-month"><%= d.toLocaleString('it', { month: 'short' }).toUpperCase() %></div>
                    <div class="date-year"><%= d.getFullYear() %></div>
                    <div class="date-weekday"><%= d.toLocaleString('it', { weekday: 'short' }).toUpperCase() %></div>
                  </div>
                </div>
                
                <!-- Content Column -->
                <div class="event-content">
                  <div class="event-header">
                    <h3 class="event-title">
                      <%= event.title %>
                      <% if (event.mscNumber) { %>
                        <span class="msc-badge" title="Musica Sacra Contemporanea">
                          MSC <%= event.mscNumber %>
                        </span>
                      <% } %>
                    </h3>
                    <% if (event.subtitle) { %>
                      <p class="event-subtitle"><%= event.subtitle %></p>
                    <% } %>
                  </div>
                  
                  <div class="event-meta">
                    <span class="event-time">🕐 <%= event.time || '20:00' %></span>
                    <% if (event.location) { %>
                      <span class="event-location">📍 <%= event.location %></span>
                    <% } %>
                  </div>
                  
                  <% if (event.description_short) { %>
                    <div class="event-description"><%- event.description_short %></div>
                  <% } %>
                </div>
                
                <!-- Actions Column -->
                <div class="event-actions">
                  <% if (event.detailUrl) { %>
                    <a href="<%= event.detailUrl %>"
                       class="btn-action primary"
                       target="_blank"
                       rel="noopener"
                       aria-label="Dettagli <%= event.title %>">
                      <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      <span>Info</span>
                    </a>
                  <% } %>

                  <button class="btn-action secondary share-btn"
                          type="button"
                          data-title="<%- (event.title || '').replace(/"/g,'&quot;') %>"
                          data-url="<%- (event.detailUrl || '') %>"
                          title="Condividi evento"
                          aria-label="Condividi <%= event.title %>">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                    </svg>
                    <span>Condividi</span>
                  </button>

                  <a href="/ics/<%= event.slug %>.ics"
                     class="btn-action secondary"
                     download
                     title="Aggiungi al calendario"
                     aria-label="Scarica calendario <%= event.title %>">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span>Calendario</span>
                  </a>
                </div>
              </article>
            <% }); %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <p class="empty-message">Nessun evento trovato per i criteri selezionati.</p>
          </div>
        <% } %>
      </section>
    </div>
  </div>
</div>

<!-- Mobile Poster Modal rimosso - ora è una card integrata -->

<script>
  // niente onclick inline: aggancio qui (la tua CSP lo consente)
  (function(){
    // Condivisione
    document.querySelectorAll('.share-btn').forEach(function(btn){
      btn.addEventListener('click', function(){
        var title = btn.getAttribute('data-title') || document.title;
        var url   = btn.getAttribute('data-url') || location.href;
        try {
          if (navigator.share && url) {
            navigator.share({ title: title, url: url }).catch(function(){});
          } else if (url) {
            window.open(url, '_blank', 'noopener');
          }
        } catch(e){
          if (url) window.open(url, '_blank', 'noopener');
        }
      });
    });

    // Mobile poster trigger rimosso - ora è una card integrata
  })();
</script>

<style>
/* Layout con poster fisso */
.season-layout {
  display: flex;
  min-height: calc(100vh - var(--header-height) - var(--footer-height));
  position: relative;
}

/* Poster Sidebar - COMPLETAMENTE FISSO */
.poster-sidebar {
  position: fixed;
  top: 0;
  left: 0;
  width: 400px;
  height: 100vh;
  padding: 2rem;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.03) 0%, transparent 100%);
  border-right: 1px solid rgba(255, 255, 255, 0.08);
  overflow: hidden;
  z-index: 10;
  display: flex;
  flex-direction: column;
}

.poster-inner {
  max-width: 360px;
  margin: 0 auto;
}

.poster-frame {
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  margin-bottom: 1.5rem;
}

.poster-link {
  display: block;
  position: relative;
  line-height: 0;
}

.poster-image {
  width: 100%;
  height: auto;
  display: block;
}

.poster-overlay {
  position: absolute;
