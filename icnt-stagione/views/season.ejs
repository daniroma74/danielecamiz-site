}

.poster-actions {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: 2rem;
}

.poster-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  padding: 1.5rem;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 2rem;
  font-weight: 700;
  color: var(--accent-gold);
  font-family: 'Playfair Display', serif;
}

.stat-label {
  display: block;
  font-size: 0.875rem;
  color: var(--text-secondary);
  margin-top: 0.25rem;
}

/* Content Area - Scrollabile */
.content-area {
  flex: 1;
  margin-left: 400px;
  overflow-y: auto;
  padding: 2rem;
  background: var(--bg-primary);
}

.content-inner {
  max-width: 900px;
  margin: 0 auto;
}

/* Mobile Poster Card */
