# Server
PORT=3121
NODE_ENV=development

# Database (usa lo stesso DB del sito cororaro)
DB_PATH=../cororaro-site/db/cororaro.db

# Session
SESSION_SECRET=cororaro-landing-secret-change-in-production

# Email (usa il servizio condiviso)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Coro Raro <noreply@cororaro.it>

# Domain
BASE_DOMAIN=cororaro.it
LANDING_SUBDOMAIN_PATTERN=*.cororaro.it

# Cloudinary (credenziali condivise)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
