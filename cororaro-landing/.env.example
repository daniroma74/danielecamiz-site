# Server
PORT=3121
NODE_ENV=development

# Database (condiviso con cororaro-site)
DB_PATH=../cororaro-site/db/cororaro.db

# Session (cambia in production!)
SESSION_SECRET=cororaro-landing-secret-change-in-production-2024

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Scegli UNA delle opzioni sotto e decommentala

# Opzione 1: SendGrid (consigliato - 100 email/giorno gratis)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=YOUR_SENDGRID_API_KEY
# EMAIL_FROM=Coro Raro <info@cororaro.it>

# Opzione 2: Gmail (facile ma limitato)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password-16-chars
# EMAIL_FROM=Coro Raro <info@cororaro.it>

# Opzione 3: Cloudflare Email Workers (gratis, 100k/giorno)
# SMTP_HOST=smtp.cloudflare.com
# SMTP_PORT=587
# SMTP_USER=info@cororaro.it
# SMTP_PASS=YOUR_CLOUDFLARE_EMAIL_PASSWORD
# EMAIL_FROM=Coro Raro <info@cororaro.it>

# Opzione 4: Server SMTP personalizzato
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=info@cororaro.it
SMTP_PASS=your-smtp-password
EMAIL_FROM=Coro Raro <info@cororaro.it>

# Domain
BASE_DOMAIN=cororaro.it
SERVER_IP=YOUR_SERVER_IP_HERE

# ============================================
# CLOUDFLARE DNS AUTO-CREATE (opzionale)
# ============================================
# Se configurato, crea automaticamente record DNS per ogni landing
# Se NON configurato, wildcard DNS (* → server) funziona comunque
#
# Per ottenere API Token:
# 1. Cloudflare Dashboard → My Profile → API Tokens
# 2. Create Token → Edit zone DNS (template)
# 3. Permessi: Zone.DNS Edit, Zone.Zone Read
# 4. Zone Resources: Include → Specific zone → cororaro.it
#
# Per trovare Zone ID:
# Cloudflare Dashboard → cororaro.it → Overview → API section (destra)

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PROXY=true

# Cloudinary (opzionale - per immagini)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
