# Nginx configuration for Coro Raro Landing System
# Gestisce sottodomini dinamici *.cororaro.it

# ============================================
# WILDCARD SUBDOMAIN (landing pubbliche)
# ============================================
# Gestisce: concerto-natale25.cororaro.it, concerto-pasqua25.cororaro.it, etc.
server {
  listen 80;
  listen [::]:80;
  server_name *.cororaro.it;

  # Redirect HTTP to HTTPS
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name *.cororaro.it;

  # SSL certificates (Let's Encrypt wildcard)
  ssl_certificate /etc/letsencrypt/live/cororaro.it/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/cororaro.it/privkey.pem;
  ssl_trusted_certificate /etc/letsencrypt/live/cororaro.it/chain.pem;

  # SSL configuration
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 10m;

  # Security headers
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-XSS-Protection "1; mode=block" always;

  # Logging
  access_log /var/log/nginx/cororaro-landing-access.log;
  error_log /var/log/nginx/cororaro-landing-error.log;

  # Proxy to Node.js app
  location / {
    proxy_pass http://localhost:3121;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_cache_bypass $http_upgrade;
  }

  # Static files (opzionale - caching)
  location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
    proxy_pass http://localhost:3121;
    expires 30d;
    add_header Cache-Control "public, immutable";
  }
}

# ============================================
# ADMIN SUBDOMAIN
# ============================================
# landing-admin.cororaro.it
server {
  listen 80;
  listen [::]:80;
  server_name landing-admin.cororaro.it;

  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name landing-admin.cororaro.it;

  # SSL certificates
  ssl_certificate /etc/letsencrypt/live/cororaro.it/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/cororaro.it/privkey.pem;
  ssl_trusted_certificate /etc/letsencrypt/live/cororaro.it/chain.pem;

  # SSL config (same as above)
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

  # Security headers
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Frame-Options "SAMEORIGIN" always;

  # Logging
  access_log /var/log/nginx/cororaro-admin-access.log;
  error_log /var/log/nginx/cororaro-admin-error.log;

  # Proxy to Node.js app (stesso server, routing interno)
  location / {
    # Basic Authentication per proteggere l'admin
    auth_basic "Coro Raro - Landing Admin";
    auth_basic_user_file /etc/nginx/.htpasswd-cororaro;

    proxy_pass http://localhost:3121;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_cache_bypass $http_upgrade;
  }
}

# ============================================
# NOTES
# ============================================
# 1. Wildcard SSL certificate required:
#    certbot certonly --dns-cloudflare --dns-cloudflare-credentials ~/.secrets/cloudflare.ini \
#    -d cororaro.it -d *.cororaro.it
#
# 2. Cloudflare DNS records needed:
#    - A record: * → your-server-ip (orange cloud OFF for wildcard)
#    - A record: landing-admin → your-server-ip
#    - A record: @ → your-server-ip (main site)
#
# 3. Create Basic Auth password file for landing-admin:
#    sudo htpasswd -c /etc/nginx/.htpasswd-cororaro admin
#    (will prompt for password - use: admin123)
#
# 4. Test configuration:
#    sudo nginx -t
#
# 5. Reload:
#    sudo systemctl reload nginx
