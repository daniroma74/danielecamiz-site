<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Coro Raro Landing Admin</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f5f5f5;
      padding: 2rem;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    .header {
      background: white;
      padding: 2rem;
      border-radius: 12px;
      margin-bottom: 2rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .header h1 {
      font-size: 2rem;
      color: #333;
      margin-bottom: 0.5rem;
    }

    .header p {
      color: #666;
      font-size: 1.1rem;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .stat-card {
      background: white;
      padding: 1.5rem;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .stat-card .icon {
      font-size: 2.5rem;
      margin-bottom: 0.5rem;
    }

    .stat-card .number {
      font-size: 2.5rem;
      font-weight: 700;
      color: #8B4513;
      margin: 0.5rem 0;
    }

    .stat-card .label {
      color: #666;
      font-size: 0.95rem;
    }

    .actions {
      background: white;
      padding: 1.5rem;
      border-radius: 12px;
      margin-bottom: 2rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .btn {
      padding: 0.9rem 1.8rem;
      border-radius: 8px;
      border: none;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: all 0.3s;
    }

    .btn-primary {
      background: linear-gradient(135deg, #8B4513, #654321);
      color: white;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(139, 69, 19, 0.3);
    }

    .btn-secondary {
      background: #4a7c59;
      color: white;
    }

    .btn-secondary:hover {
      background: #3d6849;
    }

    .send-section {
      background: white;
      padding: 2rem;
      border-radius: 12px;
      margin-bottom: 2rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .send-section h2 {
      margin-bottom: 1.5rem;
      color: #333;
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 600;
      color: #333;
    }

    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 0.9rem;
      border: 2px solid #ddd;
      border-radius: 8px;
      font-size: 1rem;
      font-family: inherit;
    }

    .form-group textarea {
      min-height: 150px;
      resize: vertical;
    }

    .subscribers-list {
      background: white;
      padding: 2rem;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .subscribers-list h2 {
      margin-bottom: 1.5rem;
      color: #333;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead {
      background: #f8f9fa;
    }

    th {
      padding: 1rem;
      text-align: left;
      font-weight: 600;
      color: #666;
      border-bottom: 2px solid #e0e0e0;
    }

    td {
      padding: 1rem;
      border-bottom: 1px solid #e0e0e0;
    }

    tr:hover {
      background: #f8f9fa;
    }

    .btn-small {
      padding: 0.5rem 1rem;
      font-size: 0.9rem;
    }

    .btn-danger {
      background: #dc3545;
      color: white;
    }

    .btn-danger:hover {
      background: #c82333;
    }

    .message {
      padding: 1rem 1.5rem;
      border-radius: 8px;
      margin-bottom: 1.5rem;
      display: none;
    }

    .message.success {
      background: #d4edda;
      color: #155724;
      border: 1px solid #c3e6cb;
      display: block;
    }

    .message.error {
      background: #f8d7da;
      color: #721c24;
      border: 1px solid #f5c6cb;
      display: block;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>📧 <%= title %></h1>
      <p>Gestisci gli iscritti alla newsletter dei concerti</p>
    </div>

    <!-- Stats -->
    <div class="stats">
      <div class="stat-card">
        <div class="icon">👥</div>
        <div class="number"><%= stats.total %></div>
        <div class="label">Iscritti Totali</div>
      </div>

      <div class="stat-card">
        <div class="icon">📅</div>
        <div class="number"><%= stats.today %></div>
        <div class="label">Iscritti Oggi</div>
      </div>

      <div class="stat-card">
        <div class="icon">📊</div>
        <div class="number"><%= stats.thisWeek %></div>
        <div class="label">Iscritti Questa Settimana</div>
      </div>
    </div>

    <!-- Actions -->
    <div class="actions">
      <a href="/admin/landing" class="btn btn-secondary">← Torna alle Landing</a>
      <a href="/admin/newsletter/export" class="btn btn-primary">📥 Esporta CSV</a>
    </div>

    <!-- Send Newsletter Form -->
    <div class="send-section">
      <h2>📨 Invia Newsletter</h2>

      <div id="newsletter-message" class="message"></div>

      <form id="newsletter-form">
        <div class="form-group">
          <label for="subject">Oggetto *</label>
          <input type="text" id="subject" name="subject" required placeholder="es: Nuovo Concerto di Natale!">
        </div>

        <div class="form-group">
          <label for="message">Messaggio *</label>
          <textarea id="message" name="message" required placeholder="Scrivi qui il messaggio della newsletter...

Ricorda: il messaggio sarà inviato da info@cororaro.it a tutti gli iscritti."></textarea>
        </div>

        <button type="submit" class="btn btn-primary">
          📧 Invia a <%= stats.total %> iscritti
        </button>
      </form>
    </div>

    <!-- Subscribers List -->
    <div class="subscribers-list">
      <h2>👥 Lista Iscritti (<%= subscribers.length %>)</h2>

      <% if (subscribers.length === 0) { %>
        <p style="color: #666; padding: 2rem; text-align: center;">
          Nessun iscritto alla newsletter al momento.
        </p>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Email</th>
              <th>Nome</th>
              <th>Iscritto il</th>
              <th>Da Concerto</th>
              <th>Azioni</th>
            </tr>
          </thead>
          <tbody>
            <% subscribers.forEach(sub => { %>
              <tr id="subscriber-<%= sub.id %>">
                <td><strong><%= sub.email %></strong></td>
                <td><%= sub.name || '-' %></td>
                <td><%= new Date(sub.subscribed_at).toLocaleDateString('it-IT') %></td>
                <td><%= sub.concert_title || '-' %></td>
                <td>
                  <button class="btn btn-danger btn-small" onclick="unsubscribe(<%= sub.id %>, '<%= sub.email %>')">
                    Rimuovi
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <script>
    // Send Newsletter
    document.getElementById('newsletter-form').addEventListener('submit', async function(e) {
      e.preventDefault();

      const subject = document.getElementById('subject').value;
      const message = document.getElementById('message').value;
      const messageDiv = document.getElementById('newsletter-message');
      const submitBtn = e.target.querySelector('button[type="submit"]');

      if (!confirm(`Vuoi davvero inviare la newsletter a <%= stats.total %> iscritti?`)) {
        return;
      }

      // Disable button
      submitBtn.disabled = true;
      submitBtn.textContent = '📧 Invio in corso...';
      messageDiv.className = 'message';
      messageDiv.textContent = '';

      try {
        const response = await fetch('/admin/newsletter/send', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ subject, message })
        });

        const data = await response.json();

        if (data.success) {
          messageDiv.className = 'message success';
          messageDiv.textContent = data.message;
          document.getElementById('newsletter-form').reset();
        } else {
          messageDiv.className = 'message error';
          messageDiv.textContent = data.message;
        }
      } catch (error) {
        messageDiv.className = 'message error';
        messageDiv.textContent = 'Errore durante l\'invio: ' + error.message;
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = '📧 Invia a <%= stats.total %> iscritti';
      }
    });

    // Unsubscribe
    async function unsubscribe(id, email) {
      if (!confirm(`Vuoi davvero rimuovere ${email} dalla newsletter?`)) {
        return;
      }

      try {
        const response = await fetch(`/admin/newsletter/${id}/unsubscribe`, {
          method: 'POST'
        });

        const data = await response.json();

        if (data.success) {
          // Remove row from table
          document.getElementById(`subscriber-${id}`).remove();
          alert('✅ Iscritto rimosso dalla newsletter');
          location.reload(); // Reload to update stats
        } else {
          alert('❌ Errore: ' + data.message);
        }
      } catch (error) {
        alert('❌ Errore: ' + error.message);
      }
    }
  </script>
</body>
</html>
