<!-- Event Fields for Landing Editor -->

<!-- Info Base (Read-only da concerts-admin) -->
<div class="info-card">
  <h3>Informazioni Base (da Concerts Admin)</h3>
  <div class="info-row">
    <div class="info-label">Titolo:</div>
    <div class="info-value"><%= event.title %></div>
  </div>
  <div class="info-row">
    <div class="info-label">Data:</div>
    <div class="info-value">
      <i class="fas fa-calendar"></i>
      <%= new Date(event.date).toLocaleDateString('it-IT', { 
        weekday: 'long', 
        day: 'numeric', 
        month: 'long', 
        year: 'numeric' 
      }) %>
    </div>
  </div>
  <div class="info-row">
    <div class="info-label">Luogo:</div>
    <div class="info-value">
      <i class="fas fa-map-marker-alt"></i>
      <%= event.location %>
    </div>
  </div>
  <div class="info-row">
    <div class="info-label">Slug:</div>
    <div class="info-value">
      <code><%= event.slug %></code>
    </div>
  </div>
</div>

<!-- Alert Modifica Base -->
<div class="alert alert-info">
  <i class="fas fa-info-circle"></i>
  <div>
    <strong>Per modificare titolo, data, luogo o programma</strong>, 
    vai su <a href="https://archive.danielecamiz.com/admin/concert/<%= event.id %>/edit" target="_blank">Concerts Admin</a>
  </div>
</div>

<!-- Form Settings -->
<div class="form-section">
  <h3>Impostazioni Landing Page</h3>
  
  <!-- Titolo Override -->
  <div class="form-group">
    <label for="event_title_override">Titolo Personalizzato (opzionale)</label>
    <input type="text" 
           id="event_title_override" 
           name="event_title_override" 
           class="form-control"
           value="<%= event.event_title_override || '' %>"
           placeholder="Lascia vuoto per usare il titolo da Concerts Admin">
    <small class="help-text">Se vuoi un titolo diverso solo per la landing page</small>
  </div>
  
  <!-- Toggle Hero Title -->
  <div class="form-group">
    <label class="toggle-switch">
      <input type="checkbox" 
             name="show_hero_title" 
             id="show_hero_title"
             <%= event.show_hero_title !== 0 ? 'checked' : '' %>>
      <span class="toggle-slider"></span>
      <span class="toggle-label">Mostra titolo e info sopra il poster hero</span>
    </label>
    <small class="help-text">Se disattivato, il poster sarà mostrato a pieno schermo senza testo sovrapposto</small>
  </div>
  
  <!-- Hero Image Override -->
  <div class="form-group">
    <label for="hero_image_override">URL Immagine Hero Personalizzata</label>
    <input type="text" 
           id="hero_image_override" 
           name="hero_image_override" 
           class="form-control"
           value="<%= event.hero_image_override || '' %>"
           placeholder="Lascia vuoto per usare il poster orizzontale">
    <small class="help-text">
      <% if (event.poster_horizontal_cloudinary) { %>
        Poster orizzontale attuale: 
        <a href="https://res.cloudinary.com/dnwhnz2xy/image/upload/<%= event.poster_horizontal_cloudinary %>" target="_blank">
          Visualizza →
        </a>
      <% } else { %>
        <span style="color: #e74c3c;">⚠️ Nessun poster orizzontale caricato in Concerts Admin</span>
      <% } %>
    </small>
  </div>
  
  <!-- Meta Description -->
  <div class="form-group">
    <label for="meta_description">Meta Description (SEO)</label>
    <textarea id="meta_description" 
              name="meta_description" 
              rows="3" 
              maxlength="160"
              placeholder="Descrizione per Google e social (max 160 caratteri)"><%= event.meta_description || '' %></textarea>
    <div class="char-count">
      <span id="meta_char_count">0</span> / 160
    </div>
  </div>
  
  <!-- Venue Capacity -->
  <div class="form-group">
    <label for="venue_capacity">Capienza Venue (posti)</label>
    <input type="number" 
           id="venue_capacity" 
           name="venue_capacity" 
           min="0"
           value="<%= event.venue_capacity || '' %>"
           placeholder="Es: 300">
  </div>
  
  <!-- Toggle Booking -->
  <div class="form-group">
    <label class="toggle-switch">
      <input type="checkbox" 
             name="booking_enabled" 
             id="booking_enabled"
             <%= event.booking_enabled !== 0 ? 'checked' : '' %>>
      <span class="toggle-slider"></span>
      <span class="toggle-label">Prenotazioni Attive</span>
    </label>
  </div>
  
  <!-- Booking Disclaimer -->
  <div class="form-group">
    <label for="booking_disclaimer">Avviso Prenotazioni</label>
    <textarea id="booking_disclaimer" 
              name="booking_disclaimer" 
              rows="2" 
              placeholder="Es: Si consiglia di arrivare 15 minuti prima dell'inizio"><%= event.booking_disclaimer || '' %></textarea>
  </div>
  
  <!-- Toggle Counter -->
  <div class="form-group">
    <label class="toggle-switch">
      <input type="checkbox" 
             name="show_counter" 
             id="show_counter"
             <%= event.show_counter ? 'checked' : '' %>>
      <span class="toggle-slider"></span>
      <span class="toggle-label">Mostra countdown evento</span>
    </label>
  </div>
  
  <!-- Toggle Share Buttons -->
  <div class="form-group">
    <label class="toggle-switch">
      <input type="checkbox" 
             name="show_share_buttons" 
             id="show_share_buttons"
             <%= event.show_share_buttons ? 'checked' : '' %>>
      <span class="toggle-slider"></span>
      <span class="toggle-label">Mostra pulsanti condivisione social</span>
    </label>
  </div>
  
  <!-- Event Description -->
  <div class="form-group">
    <label for="event_description">Note di Sala</label>
    <textarea id="event_description" 
              name="event_description" 
              rows="8" 
              placeholder="Descrizione estesa dell'evento, note di programma..."><%= event.event_description || '' %></textarea>
    <small class="help-text">Supporta HTML base (p, strong, em, ul, ol, li)</small>
  </div>
  
  <!-- Event Tags -->
  <div class="form-group">
    <label for="event_tags">Tag Evento (separati da virgola)</label>
    <input type="text" 
           id="event_tags" 
           name="event_tags" 
           value="<%= event.event_tags || '' %>"
           placeholder="Es: Beethoven, Sinfonie, Classica, Orchestra">
    <small class="help-text">Usati per categorizzazione e SEO</small>
  </div>
  
  <!-- Footer Text -->
  <div class="form-group">
    <label for="footer_text">Testo Footer</label>
    <input type="text" 
           id="footer_text" 
           name="footer_text" 
           value="<%= event.footer_text || '' %>"
           placeholder="Lascia vuoto per testo predefinito">
  </div>
</div>

<script>
// Character counter per meta description
document.addEventListener('DOMContentLoaded', () => {
  const metaTextarea = document.getElementById('meta_description');
  const charCount = document.getElementById('meta_char_count');
  
  if (metaTextarea && charCount) {
    const updateCount = () => {
      const count = metaTextarea.value.length;
      charCount.textContent = count;
      charCount.style.color = count > 160 ? '#e74c3c' : '#666';
    };
    
    metaTextarea.addEventListener('input', updateCount);
    updateCount();
  }
});
</script>