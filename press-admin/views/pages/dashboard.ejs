<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/shared/css/admin-base.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/static/css/press-admin.css">
</head>
<body>
  <!-- Unified Navigation -->
  <%- include('../../../shared/partials/admin-navbar', {
    moduleName: 'Press Admin',
    moduleIcon: 'fa-newspaper',
    moduleUrl: '/press',
    links: [
      { url: '/press', label: 'Dashboard', icon: 'fa-chart-line', active: currentPath === '/press' },
      { url: '/press/articles', label: 'Articoli', icon: 'fa-file-alt', active: currentPath.startsWith('/press/articles') },
      { url: '/press/quotes', label: 'Citazioni', icon: 'fa-quote-right', active: currentPath.startsWith('/press/quotes') }
    ]
  }) %>

  <main class="content-area" style="padding: 2rem;">
        <div class="stats-grid">
          <div class="stat-card">
            <h3>Articoli</h3>
            <p class="stat-number"><%= stats.articles %></p>
            <a href="/press/articles" class="stat-link">Visualizza tutti</a>
          </div>
          <div class="stat-card">
            <h3>Citazioni</h3>
            <p class="stat-number"><%= stats.quotes %></p>
            <a href="/press/quotes" class="stat-link">Visualizza tutti</a>
          </div>
        </div>

        <div class="content-grid">
          <div class="content-section">
            <h2>Articoli Recenti</h2>
            <% if (recentArticles && recentArticles.length > 0) { %>
              <ul class="item-list">
                <% recentArticles.forEach(article => { %>
                  <li>
                    <a href="/press/articles/<%= article.id %>/edit">
                      <%= article.title || 'Senza titolo' %>
                    </a>
                    <span class="date"><%= article.date || '' %></span>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <p>Nessun articolo presente</p>
            <% } %>
            <a href="/press/articles/new" class="btn btn-primary">Nuovo Articolo</a>
          </div>

          <div class="content-section">
            <h2>Citazioni Recenti</h2>
            <% if (recentQuotes && recentQuotes.length > 0) { %>
              <ul class="item-list">
                <% recentQuotes.forEach(quote => { %>
                  <li>
                    <strong><%= quote.source %></strong>:
                    "<%= quote.quote_it?.substring(0, 100) %><%= quote.quote_it?.length > 100 ? '...' : '' %>"
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <p>Nessuna citazione presente</p>
            <% } %>
            <a href="/press/quotes" class="btn btn-primary">Gestisci Citazioni</a>
          </div>
        </div>
  </main>

  <script src="/static/js/press-admin.js"></script>
</body>
</html>
