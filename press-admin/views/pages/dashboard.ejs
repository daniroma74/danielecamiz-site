<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/shared/css/admin-base.css">
  <link rel="stylesheet" href="/static/css/press-admin.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="admin-container" style="max-width: 1400px; margin: 0 auto; padding: 2rem;">
    <!-- Tabs -->
    <%- include('../../../shared/partials/admin-tabs', {
      tabs: [
        { label: 'Dashboard', url: '/press', icon: 'home' },
        { label: 'Rassegna Stampa', url: '/press/quotes', icon: 'newspaper' }
      ],
      currentPath: '/press',
      baseUrl: 'press'
    }) %>

        <div class="stats-grid">
          <div class="stat-card">
            <h3><i class="fas fa-newspaper"></i> Rassegna Stampa</h3>
            <p class="stat-number"><%= stats.quotes %></p>
            <a href="/press/quotes" class="stat-link">Gestisci tutti</a>
          </div>
        </div>

        <div class="content-grid">
          <div class="content-section" style="grid-column: 1/-1;">
            <h2>Contenuti Recenti</h2>
            <% if (recentQuotes && recentQuotes.length > 0) { %>
              <ul class="item-list">
                <% recentQuotes.forEach(quote => { %>
                  <li>
                    <strong><%= quote.source %></strong>
                    <% if (quote.title_it) { %>
                      - <%= quote.title_it %>
                    <% } else { %>
                      : "<%= quote.quote_it?.substring(0, 100) %><%= quote.quote_it?.length > 100 ? '...' : '' %>"
                    <% } %>
                    <span class="date"><%= quote.published_date || '' %></span>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <p>Nessun contenuto presente</p>
            <% } %>
            <a href="/press/quotes" class="btn btn-primary">Gestisci Rassegna Stampa</a>
          </div>
        </div>
  </main>

  <script src="/static/js/press-admin.js"></script>
</body>
</html>
