<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/shared/css/admin-base.css">
  <link rel="stylesheet" href="/static/css/bio-admin.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <% if (locals.useTinyMCE) { %>
  <script src="/shared/vendor/tinymce/tinymce.min.js"></script>
  <script src="/shared/config/editor-config.js"></script>
  <% } %>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="admin-container" style="max-width: 1400px; margin: 0 auto; padding: 2rem;">
    <!-- Page Header -->
    <div class="page-header" style="margin-bottom: 2rem;">
      <div>
        <h1 style="margin: 0 0 0.5rem; font-size: 2rem; color: #333;">
          <i class="fas fa-user-circle"></i> Bio Dashboard
        </h1>
        <p style="margin: 0; color: #666; font-size: 1rem;">Gestione biografia, curriculum e press kit</p>
      </div>
    </div>

    <!-- Tabs Navigation -->
    <%- include('../../../shared/partials/admin-tabs', {
      tabs: [
        { label: 'Dashboard', url: '/bio', icon: 'home' },
        { label: 'Biografia', url: '/bio/biography', icon: 'file-alt' },
        { label: 'Curriculum', url: '/bio/curriculum', icon: 'graduation-cap' },
        { label: 'Storia', url: '/bio/story', icon: 'book' },
        { label: 'Press Kit', url: '/bio/presskit', icon: 'box-open' }
      ],
      currentPath: locals.currentPath || '/bio',
      baseUrl: 'bio'
    }) %>

    <!-- Page Content -->
    <div class="page-content">
      <%- content %>
    </div>
  </main>

  <% if (locals.pageScript) { %>
    <script src="<%= pageScript %>"></script>
  <% } %>
</body>
</html>
