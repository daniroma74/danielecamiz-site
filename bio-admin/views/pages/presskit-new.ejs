<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/shared/css/admin-base.css">
  <link rel="stylesheet" href="/static/css/bio-admin.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="/shared/cloudinary-manager/ui-notifications.js"></script>
  <script src="/shared/cloudinary-manager/ui-loading.js"></script>
  <script src="/shared/cloudinary-manager/client.js"></script>
  <style>
    .presskit-section { margin-bottom: 3rem; background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .presskit-section h2 { margin: 0 0 1.5rem; font-size: 1.5rem; color: #2c3e50; border-bottom: 2px solid #d4af37; padding-bottom: 0.5rem; }
    .asset-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem; }
    .asset-card { border: 2px solid #ecf0f1; border-radius: 8px; padding: 1rem; transition: all 0.3s; background: #fafafa; }
    .asset-card:hover { border-color: #d4af37; box-shadow: 0 4px 12px rgba(212,175,55,0.2); }
    .asset-preview { width: 100%; height: 150px; background: #ecf0f1; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 3rem; margin-bottom: 1rem; overflow: hidden; }
    .asset-preview img { width: 100%; height: 100%; object-fit: cover; }
    .asset-title { font-weight: 600; font-size: 1rem; margin-bottom: 0.5rem; color: #2c3e50; }
    .asset-category { font-size: 0.85rem; color: #7f8c8d; background: #ecf0f1; padding: 0.25rem 0.75rem; border-radius: 12px; display: inline-block; margin-bottom: 0.75rem; }
    .asset-actions { display: flex; gap: 0.5rem; margin-top: 1rem; }
    .btn-add-big { background: linear-gradient(135deg, #d4af37, #f0d478); color: white; border: none; padding: 1rem 2rem; font-size: 1.1rem; border-radius: 8px; cursor: pointer; font-weight: 600; display: flex; align-items: center; gap: 0.5rem; box-shadow: 0 4px 12px rgba(212,175,55,0.3); }
    .btn-add-big:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(212,175,55,0.4); }
    .empty-state { text-align: center; padding: 3rem; color: #95a5a6; }
    .empty-state i { font-size: 4rem; margin-bottom: 1rem; opacity: 0.3; }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="admin-container" style="max-width: 1400px; margin: 0 auto; padding: 2rem;">
    <!-- Tabs -->
    <%- include('../../../shared/partials/admin-tabs', {
      tabs: [
        { label: 'Dashboard', url: '/bio', icon: 'home' },
        { label: 'Biografia', url: '/bio/biography', icon: 'file-alt' },
        { label: 'Curriculum', url: '/bio/curriculum', icon: 'graduation-cap' },
        { label: 'Storia', url: '/bio/story', icon: 'book' },
        { label: 'Press Kit', url: '/bio/presskit', icon: 'box-open' }
      ],
      currentPath: '/bio/presskit',
      baseUrl: 'bio'
    }) %>

    <div class="page-header" style="margin-bottom: 2rem;">
      <h1>📦 Press Kit Manager</h1>
      <p style="color: #7f8c8d; margin: 0.5rem 0 0;">Gestisci i materiali professionali per stampa e organizzatori. Tutto ciò che carichi qui apparirà automaticamente su <a href="/press-kit" target="_blank" style="color: #d4af37;">danielecamiz.com/press-kit</a></p>
    </div>

    <!-- SEZIONE DOCUMENTI -->
    <div class="presskit-section">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h2 style="margin: 0;">📄 Documenti (CV, Bio PDF)</h2>
        <button onclick="addDocument()" class="btn btn-primary">
          <i class="fas fa-plus"></i> Carica Documento
        </button>
      </div>

      <% const documents = assets.filter(a => a.type === 'document'); %>
      <% if (documents.length > 0) { %>
        <div class="asset-grid">
          <% documents.forEach(doc => { %>
            <div class="asset-card">
              <div class="asset-preview">📄</div>
              <div class="asset-title"><%= doc.title_it || 'Documento' %></div>
              <% if (doc.category) { %>
                <span class="asset-category"><%= doc.category === 'cv' ? 'CV' : doc.category === 'bio' ? 'Bio' : doc.category %></span>
              <% } %>
              <div class="asset-actions">
                <% if (doc.cloudinary_url) { %>
                  <a href="<%= doc.cloudinary_url %>" target="_blank" class="btn btn-sm btn-secondary" style="flex: 1;">
                    <i class="fas fa-download"></i> Scarica
                  </a>
                <% } %>
                <button onclick='editAsset(<%= JSON.stringify(doc) %>)' class="btn btn-sm btn-primary">
                  <i class="fas fa-edit"></i>
                </button>
                <button onclick="deleteAsset(<%= doc.id %>, 'documento')" class="btn btn-sm btn-danger">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <i class="fas fa-file-pdf"></i>
          <p>Nessun documento caricato. Carica il tuo CV o Bio in formato PDF.</p>
        </div>
      <% } %>
    </div>

    <!-- SEZIONE FOTO -->
    <div class="presskit-section">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h2 style="margin: 0;">📷 Foto Professionali</h2>
        <button onclick="addPhoto()" class="btn btn-primary">
          <i class="fas fa-plus"></i> Carica Foto
        </button>
      </div>

      <% const photos = assets.filter(a => a.type === 'photo'); %>
      <% if (photos.length > 0) { %>
        <div class="asset-grid">
          <% photos.forEach(photo => { %>
            <div class="asset-card">
              <div class="asset-preview">
                <% if (photo.cloudinary_id) { %>
                  <img src="https://res.cloudinary.com/dnwhnz2xy/image/upload/w_300,h_300,c_fill,q_auto/<%= photo.cloudinary_id %>" alt="<%= photo.title_it %>">
                <% } else { %>
                  📷
                <% } %>
              </div>
              <div class="asset-title"><%= photo.title_it || 'Foto' %></div>
              <% if (photo.category) { %>
                <span class="asset-category">
                  <%= photo.category === 'portrait' ? '🎭 Ritratto' : photo.category === 'action' ? '🎵 In Azione' : photo.category === 'backstage' ? '🎬 Backstage' : photo.category %>
                </span>
              <% } %>
              <div class="asset-actions">
                <% if (photo.cloudinary_id) { %>
                  <a href="https://res.cloudinary.com/dnwhnz2xy/image/upload/fl_attachment:foto-daniele-camiz/<%= photo.cloudinary_id %>" download class="btn btn-sm btn-secondary" style="flex: 1;">
                    <i class="fas fa-download"></i> Alta Ris.
                  </a>
                <% } %>
                <button onclick='editAsset(<%= JSON.stringify(photo) %>)' class="btn btn-sm btn-primary">
                  <i class="fas fa-edit"></i>
                </button>
                <button onclick="deleteAsset(<%= photo.id %>, 'foto')" class="btn btn-sm btn-danger">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <i class="fas fa-camera"></i>
          <p>Nessuna foto caricata. Carica foto professionali ad alta risoluzione.</p>
        </div>
      <% } %>
    </div>

    <!-- SEZIONE VIDEO -->
    <div class="presskit-section">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h2 style="margin: 0;">🎥 Video (YouTube)</h2>
        <button onclick="addVideo()" class="btn btn-primary">
          <i class="fas fa-plus"></i> Aggiungi Video
        </button>
      </div>

      <% const videos = assets.filter(a => a.type === 'video'); %>
      <% if (videos.length > 0) { %>
        <div class="asset-grid">
          <% videos.forEach(video => { %>
            <div class="asset-card">
              <div class="asset-preview" style="background: #000;">
                <% if (video.youtube_id) { %>
                  <img src="https://img.youtube.com/vi/<%= video.youtube_id %>/mqdefault.jpg" alt="<%= video.title_it %>">
                <% } else { %>
                  🎥
                <% } %>
              </div>
              <div class="asset-title"><%= video.title_it || 'Video' %></div>
              <div class="asset-actions">
                <% if (video.youtube_url) { %>
                  <a href="<%= video.youtube_url %>" target="_blank" class="btn btn-sm btn-secondary" style="flex: 1;">
                    <i class="fab fa-youtube"></i> Guarda
                  </a>
                <% } %>
                <button onclick='editAsset(<%= JSON.stringify(video) %>)' class="btn btn-sm btn-primary">
                  <i class="fas fa-edit"></i>
                </button>
                <button onclick="deleteAsset(<%= video.id %>, 'video')" class="btn btn-sm btn-danger">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <i class="fas fa-video"></i>
          <p>Nessun video aggiunto. Aggiungi link a video YouTube delle tue performance.</p>
        </div>
      <% } %>
    </div>

  </main>

  <!-- Edit Modal -->
  <div id="editModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 9999; overflow-y: auto;">
    <div style="max-width: 800px; margin: 50px auto; background: white; border-radius: 12px; padding: 2rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h2 style="margin: 0;">Modifica Asset</h2>
        <button onclick="closeEditModal()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer;">×</button>
      </div>

      <form id="editForm">
        <input type="hidden" id="edit_id">
        <input type="hidden" id="edit_type">

        <!-- Titoli -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
          <div>
            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Titolo (IT)</label>
            <input type="text" id="edit_title_it" class="form-control" required>
          </div>
          <div>
            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Titolo (EN)</label>
            <input type="text" id="edit_title_en" class="form-control">
          </div>
        </div>

        <!-- Categoria (solo per foto e documenti) -->
        <div id="edit_category_section" style="margin-bottom: 1rem;">
          <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Categoria</label>
          <select id="edit_category" class="form-control">
            <!-- Options will be populated dynamically -->
          </select>
        </div>

        <!-- Descrizioni -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
          <div>
            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Descrizione (IT)</label>
            <textarea id="edit_description_it" class="form-control" rows="3"></textarea>
          </div>
          <div>
            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">Descrizione (EN)</label>
            <textarea id="edit_description_en" class="form-control" rows="3"></textarea>
          </div>
        </div>

        <!-- File/URL Section -->
        <div id="edit_file_section" style="margin-bottom: 1rem; padding: 1rem; background: #f8f9fa; border-radius: 8px;">
          <!-- For photos and documents -->
          <div id="edit_cloudinary_section" style="display: none;">
            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">File Attuale</label>
            <div id="edit_current_file" style="margin-bottom: 1rem;"></div>
            <button type="button" onclick="replaceFile()" class="btn btn-secondary">
              <i class="fas fa-upload"></i> Sostituisci File
            </button>
          </div>

          <!-- For videos -->
          <div id="edit_video_section" style="display: none;">
            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">URL YouTube</label>
            <input type="text" id="edit_youtube_url" class="form-control" placeholder="https://www.youtube.com/watch?v=...">
            <small style="display: block; margin-top: 0.5rem; color: #666;">Incolla l'URL completo del video YouTube</small>
          </div>
        </div>

        <!-- Buttons -->
        <div style="display: flex; gap: 1rem; justify-content: flex-end;">
          <button type="button" onclick="closeEditModal()" class="btn btn-secondary">Annulla</button>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Salva Modifiche
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function addDocument() {
      CloudinaryManager.showImageDialog((result) => {
        showMetadataModal(result, 'document');
      }, {
        folder: 'danielecamiz/presskit',
        preset: 'gallery_unsigned',
        resourceType: 'auto',  // Auto-detect: PDF will be uploaded as 'image' to enable previews
        clientAllowedFormats: ['pdf', 'doc', 'docx']
      });
    }

    function addPhoto() {
      CloudinaryManager.showImageDialog((result) => {
        showMetadataModal(result, 'photo');
      }, {
        folder: 'danielecamiz/presskit/photos',
        preset: 'gallery_unsigned'
      });
    }

    function addVideo() {
      const url = prompt('Incolla l\'URL del video YouTube:');
      if (!url) return;

      const match = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&]+)/);
      if (!match) {
        alert('URL YouTube non valido');
        return;
      }

      const youtubeId = match[1];
      const titleIt = prompt('Titolo (Italiano):') || '';
      const titleEn = prompt('Titolo (English):') || '';

      saveAsset({
        type: 'video',
        youtube_id: youtubeId,
        youtube_url: url,
        title_it: titleIt,
        title_en: titleEn
      });
    }

    function showMetadataModal(uploadData, type) {
      const titleIt = prompt(`Titolo ${type === 'document' ? 'documento' : 'foto'} (Italiano):`);
      if (!titleIt) return;

      const titleEn = prompt('Titolo (English):') || titleIt;

      let category = null;
      if (type === 'photo') {
        const cat = prompt('Categoria (portrait/action/backstage):', 'portrait');
        category = cat || 'portrait';
      } else if (type === 'document') {
        const cat = prompt('Categoria (cv/bio):', 'cv');
        category = cat || 'cv';
      }

      saveAsset({
        type,
        category,
        cloudinary_id: uploadData.publicId,
        cloudinary_url: uploadData.url || uploadData.secure_url,
        title_it: titleIt,
        title_en: titleEn,
        width: uploadData.width,
        height: uploadData.height,
        format: uploadData.format,
        file_size: uploadData.bytes
      });
    }

    async function saveAsset(data) {
      try {
        const res = await fetch('/bio/presskit/assets', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (res.ok) {
          alert('✅ Asset salvato! Ricarico la pagina...');
          window.location.reload();
        } else {
          alert('❌ Errore durante il salvataggio');
        }
      } catch (error) {
        alert('❌ Errore di connessione');
      }
    }

    async function deleteAsset(id, tipo) {
      if (!confirm(`Sei sicuro di voler eliminare questo ${tipo}?`)) return;

      try {
        const res = await fetch(`/bio/presskit/assets/${id}`, { method: 'DELETE' });
        if (res.ok) {
          alert('✅ Eliminato!');
          window.location.reload();
        } else {
          alert('❌ Errore durante l\'eliminazione');
        }
      } catch (error) {
        alert('❌ Errore di connessione');
      }
    }

    let currentEditAsset = null;
    let newFileData = null;

    function editAsset(asset) {
      currentEditAsset = asset;
      newFileData = null;

      // Populate form
      document.getElementById('edit_id').value = asset.id;
      document.getElementById('edit_type').value = asset.type;
      document.getElementById('edit_title_it').value = asset.title_it || '';
      document.getElementById('edit_title_en').value = asset.title_en || '';
      document.getElementById('edit_description_it').value = asset.description_it || '';
      document.getElementById('edit_description_en').value = asset.description_en || '';

      // Setup category dropdown
      const categorySection = document.getElementById('edit_category_section');
      const categorySelect = document.getElementById('edit_category');

      if (asset.type === 'photo') {
        categorySection.style.display = 'block';
        categorySelect.innerHTML = `
          <option value="portrait" ${asset.category === 'portrait' ? 'selected' : ''}>🎭 Ritratto</option>
          <option value="action" ${asset.category === 'action' ? 'selected' : ''}>🎵 In Azione</option>
          <option value="backstage" ${asset.category === 'backstage' ? 'selected' : ''}>🎬 Backstage</option>
        `;
      } else if (asset.type === 'document') {
        categorySection.style.display = 'block';
        categorySelect.innerHTML = `
          <option value="cv" ${asset.category === 'cv' ? 'selected' : ''}>CV</option>
          <option value="bio" ${asset.category === 'bio' ? 'selected' : ''}>Bio</option>
        `;
      } else {
        categorySection.style.display = 'none';
      }

      // Setup file section
      const cloudinarySection = document.getElementById('edit_cloudinary_section');
      const videoSection = document.getElementById('edit_video_section');
      const currentFileDiv = document.getElementById('edit_current_file');

      if (asset.type === 'video') {
        cloudinarySection.style.display = 'none';
        videoSection.style.display = 'block';
        document.getElementById('edit_youtube_url').value = asset.youtube_url || '';
      } else {
        cloudinarySection.style.display = 'block';
        videoSection.style.display = 'none';

        if (asset.type === 'photo' && asset.cloudinary_id) {
          currentFileDiv.innerHTML = `
            <img src="https://res.cloudinary.com/dnwhnz2xy/image/upload/w_300,h_200,c_fill/${asset.cloudinary_id}"
                 style="max-width: 100%; border-radius: 8px;">
          `;
        } else if (asset.type === 'document') {
          currentFileDiv.innerHTML = `
            <p><i class="fas fa-file-pdf"></i> ${asset.title_it || 'Documento'}.${asset.format || 'pdf'}</p>
          `;
        }
      }

      // Show modal
      document.getElementById('editModal').style.display = 'block';
    }

    function closeEditModal() {
      document.getElementById('editModal').style.display = 'none';
      currentEditAsset = null;
      newFileData = null;
    }

    function replaceFile() {
      const type = currentEditAsset.type;

      if (type === 'photo') {
        CloudinaryManager.showImageDialog((result) => {
          newFileData = result;
          document.getElementById('edit_current_file').innerHTML = `
            <img src="${result.url}" style="max-width: 100%; border-radius: 8px;">
            <p style="color: #4CAF50; margin-top: 0.5rem;">✅ Nuovo file selezionato (sarà salvato dopo aver cliccato "Salva Modifiche")</p>
          `;
        }, {
          folder: 'danielecamiz/presskit/photos',
          preset: 'gallery_unsigned'
        });
      } else if (type === 'document') {
        CloudinaryManager.showImageDialog((result) => {
          newFileData = result;
          document.getElementById('edit_current_file').innerHTML = `
            <p><i class="fas fa-file-pdf"></i> Nuovo documento caricato</p>
            <p style="color: #4CAF50;">✅ Sarà salvato dopo aver cliccato "Salva Modifiche"</p>
          `;
        }, {
          folder: 'danielecamiz/presskit',
          preset: 'gallery_unsigned',
          resourceType: 'auto',
          clientAllowedFormats: ['pdf', 'doc', 'docx']
        });
      }
    }

    // Form submit handler
    document.getElementById('editForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const id = document.getElementById('edit_id').value;
      const type = document.getElementById('edit_type').value;

      const data = {
        type: type,
        title_it: document.getElementById('edit_title_it').value,
        title_en: document.getElementById('edit_title_en').value,
        description_it: document.getElementById('edit_description_it').value,
        description_en: document.getElementById('edit_description_en').value,
        is_published: currentEditAsset.is_published
      };

      // Add category if applicable
      if (type === 'photo' || type === 'document') {
        data.category = document.getElementById('edit_category').value;
      }

      // Handle file updates
      if (type === 'video') {
        const youtubeUrl = document.getElementById('edit_youtube_url').value;
        const match = youtubeUrl.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&]+)/);
        if (match) {
          data.youtube_id = match[1];
          data.youtube_url = youtubeUrl;
        } else {
          data.youtube_id = currentEditAsset.youtube_id;
          data.youtube_url = currentEditAsset.youtube_url;
        }
      } else {
        // Photo or document
        if (newFileData) {
          // New file uploaded
          data.cloudinary_id = newFileData.publicId;
          data.cloudinary_url = newFileData.url || newFileData.secure_url;
          data.width = newFileData.width;
          data.height = newFileData.height;
          data.format = newFileData.format;
          data.file_size = newFileData.bytes;
        } else {
          // Keep existing file
          data.cloudinary_id = currentEditAsset.cloudinary_id;
          data.cloudinary_url = currentEditAsset.cloudinary_url;
          data.width = currentEditAsset.width;
          data.height = currentEditAsset.height;
          data.format = currentEditAsset.format;
          data.file_size = currentEditAsset.file_size;
        }
      }

      try {
        const res = await fetch(`/bio/presskit/assets/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (res.ok) {
          alert('✅ Modifiche salvate!');
          window.location.reload();
        } else {
          alert('❌ Errore durante il salvataggio');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('❌ Errore di connessione');
      }
    });
  </script>
</body>
</html>
