# ============================================
# DANIELECAMIZ.COM - NGINX PRODUCTION CONFIG
# ============================================
#
# BACKUP PRIMA DI APPLICARE:
# sudo cp /etc/nginx/sites-available/danielecamiz.conf /etc/nginx/sites-available/danielecamiz.conf.backup-$(date +%Y%m%d)
#
# DOPO AVER COPIATO QUESTO FILE:
# sudo cp /home/daniele/danielecamiz-site/docs/danielecamiz.conf.PRODUCTION /etc/nginx/sites-available/danielecamiz.conf
# sudo nginx -t
# sudo systemctl reload nginx
# ============================================

# HTTP → HTTPS Redirect
server {
    listen 80;
    listen [::]:80;
    server_name danielecamiz.com www.danielecamiz.com;

    # Redirect all HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

# HTTPS Server Block
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name danielecamiz.com www.danielecamiz.com;

    # SSL Certificates (Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/danielecamiz.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/danielecamiz.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # ============================================
    # SECURITY HEADERS
    # ============================================

    # Basic Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Content Security Policy
    # Permite Cloudinary per immagini/video, YouTube per iframe, cdnjs per Font Awesome
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://res.cloudinary.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' https://res.cloudinary.com https://img.youtube.com data: blob:; font-src 'self' https://cdnjs.cloudflare.com data:; connect-src 'self'; media-src 'self' https://res.cloudinary.com; object-src 'none'; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self';" always;

    # Permissions Policy (disabilita geolocation, microphone, camera)
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # HSTS (HTTP Strict Transport Security) - 1 anno
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # ============================================
    # STATIC FILES OPTIMIZATION
    # ============================================

    # Sitemap.xml - serve direttamente da Nginx
    location = /sitemap.xml {
        alias /home/daniele/danielecamiz-site/frontend/sitemap.xml;
        add_header Content-Type application/xml;
        add_header Cache-Control "public, max-age=3600";
    }

    # Robots.txt - se esiste
    location = /robots.txt {
        alias /home/daniele/danielecamiz-site/frontend/robots.txt;
        add_header Content-Type text/plain;
        add_header Cache-Control "public, max-age=86400";
    }

    # ============================================
    # PROXY TO NODE.JS (CMS)
    # ============================================

    # IMPORTANTE: Scegli la porta corretta!
    # Opzione A: staging-site (porta 3001) - se usi il sito attuale
    # Opzione B: production-site (porta 3000) - se avvii nuovo processo

    location / {
        proxy_pass http://localhost:3001;  # <-- MODIFICA QUI SE NECESSARIO (3000 o 3001)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # Timeout per richieste lunghe (se necessario)
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # ============================================
    # GZIP COMPRESSION
    # ============================================

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/x-javascript
        application/xml
        application/xml+rss
        application/json
        image/svg+xml;
    gzip_disable "msie6";

    # ============================================
    # LOGGING
    # ============================================

    access_log /var/log/nginx/danielecamiz.com.access.log;
    error_log /var/log/nginx/danielecamiz.com.error.log warn;

    # ============================================
    # ERROR PAGES (opzionale)
    # ============================================

    # error_page 404 /404.html;
    # error_page 500 502 503 504 /50x.html;
}
